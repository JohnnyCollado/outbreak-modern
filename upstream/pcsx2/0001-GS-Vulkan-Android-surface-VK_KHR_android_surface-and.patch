From 06e5ee63645b4efdfd4bb75b5d231e0c7ef7c1d6 Mon Sep 17 00:00:00 2001
From: JohnnyC96 <54557697+JohnnyC96@users.noreply.github.com>
Date: Sat, 24 Oct 2026 04:18:44 -0400
Subject: [PATCH] GS/Vulkan: Android surface (VK_KHR_android_surface) and
 unversioned shaderc

For outbreak-modern's Android build of the GS (native/pcsx2_gs, Stage A1):
- WindowInfo::Type::Android, window_handle = ANativeWindow*.
- VKLoader.h defines VK_USE_PLATFORM_ANDROID_KHR on __ANDROID__;
  VKEntryPoints.inl loads vkCreateAndroidSurfaceKHR; GSDeviceVK requires
  VK_KHR_android_surface for an Android window; VKSwapChain creates the
  surface from the ANativeWindow.
- VKShaderCache loads libshaderc_shared.so without a version suffix on
  Android (an APK only carries lib*.so files).
Every change is under __ANDROID__ / VK_USE_PLATFORM_ANDROID_KHR except
the new enum value (appended last).
---
 common/WindowInfo.h                         |  3 ++-
 pcsx2/GS/Renderers/Vulkan/GSDeviceVK.cpp    |  4 ++++
 pcsx2/GS/Renderers/Vulkan/VKEntryPoints.inl |  4 ++++
 pcsx2/GS/Renderers/Vulkan/VKLoader.h        |  4 ++++
 pcsx2/GS/Renderers/Vulkan/VKShaderCache.cpp |  3 ++-
 pcsx2/GS/Renderers/Vulkan/VKSwapChain.cpp   | 18 ++++++++++++++++++
 6 files changed, 34 insertions(+), 2 deletions(-)

diff --git a/common/WindowInfo.h b/common/WindowInfo.h
index 4ccad5a..e97e6c4 100644
--- a/common/WindowInfo.h
+++ b/common/WindowInfo.h
@@ -15,7 +15,8 @@ struct WindowInfo
 		Win32,
 		X11,
 		Wayland,
-		MacOS
+		MacOS,
+		Android, // window_handle = ANativeWindow*
 	};
 
 	/// The type of the surface. Surfaceless indicates it will not be displayed on screen at all.
diff --git a/pcsx2/GS/Renderers/Vulkan/GSDeviceVK.cpp b/pcsx2/GS/Renderers/Vulkan/GSDeviceVK.cpp
index e5bba40..f2add3f 100644
--- a/pcsx2/GS/Renderers/Vulkan/GSDeviceVK.cpp
+++ b/pcsx2/GS/Renderers/Vulkan/GSDeviceVK.cpp
@@ -254,6 +254,10 @@ bool GSDeviceVK::SelectInstanceExtensions(ExtensionList* extension_list, const W
 	if (wi.type == WindowInfo::Type::Wayland && !SupportsExtension(VK_KHR_WAYLAND_SURFACE_EXTENSION_NAME, true))
 		return false;
 #endif
+#if defined(VK_USE_PLATFORM_ANDROID_KHR)
+	if (wi.type == WindowInfo::Type::Android && !SupportsExtension(VK_KHR_ANDROID_SURFACE_EXTENSION_NAME, true))
+		return false;
+#endif
 #if defined(VK_USE_PLATFORM_METAL_EXT)
 	if (wi.type == WindowInfo::Type::MacOS && !SupportsExtension(VK_EXT_METAL_SURFACE_EXTENSION_NAME, true))
 		return false;
diff --git a/pcsx2/GS/Renderers/Vulkan/VKEntryPoints.inl b/pcsx2/GS/Renderers/Vulkan/VKEntryPoints.inl
index 98adfd1..838c829 100644
--- a/pcsx2/GS/Renderers/Vulkan/VKEntryPoints.inl
+++ b/pcsx2/GS/Renderers/Vulkan/VKEntryPoints.inl
@@ -56,6 +56,10 @@ VULKAN_INSTANCE_ENTRY_POINT(vkCreateWaylandSurfaceKHR, false)
 VULKAN_INSTANCE_ENTRY_POINT(vkCreateMetalSurfaceEXT, false)
 #endif
 
+#if defined(VK_USE_PLATFORM_ANDROID_KHR)
+VULKAN_INSTANCE_ENTRY_POINT(vkCreateAndroidSurfaceKHR, false)
+#endif
+
 // VK_EXT_debug_utils
 VULKAN_INSTANCE_ENTRY_POINT(vkCmdBeginDebugUtilsLabelEXT, false)
 VULKAN_INSTANCE_ENTRY_POINT(vkCmdEndDebugUtilsLabelEXT, false)
diff --git a/pcsx2/GS/Renderers/Vulkan/VKLoader.h b/pcsx2/GS/Renderers/Vulkan/VKLoader.h
index 65c11f8..75d0055 100644
--- a/pcsx2/GS/Renderers/Vulkan/VKLoader.h
+++ b/pcsx2/GS/Renderers/Vulkan/VKLoader.h
@@ -26,6 +26,10 @@ class Error;
 #define VK_USE_PLATFORM_METAL_EXT
 #endif
 
+#if defined(__ANDROID__)
+#define VK_USE_PLATFORM_ANDROID_KHR
+#endif
+
 #include "vulkan/vulkan.h"
 
 #if defined(X11_API)
diff --git a/pcsx2/GS/Renderers/Vulkan/VKShaderCache.cpp b/pcsx2/GS/Renderers/Vulkan/VKShaderCache.cpp
index 5f8b2ba..2d65f42 100644
--- a/pcsx2/GS/Renderers/Vulkan/VKShaderCache.cpp
+++ b/pcsx2/GS/Renderers/Vulkan/VKShaderCache.cpp
@@ -139,7 +139,8 @@ bool dyn_shaderc::Open()
 
 	Error error;
 
-#ifdef _WIN32
+#if defined(_WIN32) || defined(__ANDROID__)
+	// Android: an APK only carries lib*.so files, so no version suffix.
 	const std::string libname = DynamicLibrary::GetVersionedFilename("shaderc_shared");
 #else
 	// Use versioned, bundle post-processing adds it..
diff --git a/pcsx2/GS/Renderers/Vulkan/VKSwapChain.cpp b/pcsx2/GS/Renderers/Vulkan/VKSwapChain.cpp
index 4de995d..e17f03b 100644
--- a/pcsx2/GS/Renderers/Vulkan/VKSwapChain.cpp
+++ b/pcsx2/GS/Renderers/Vulkan/VKSwapChain.cpp
@@ -103,6 +103,24 @@ VkSurfaceKHR VKSwapChain::CreateVulkanSurface(VkInstance instance, VkPhysicalDev
 	}
 #endif
 
+#if defined(VK_USE_PLATFORM_ANDROID_KHR)
+	if (wi->type == WindowInfo::Type::Android)
+	{
+		VkAndroidSurfaceCreateInfoKHR surface_create_info = {VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR, nullptr, 0,
+			static_cast<ANativeWindow*>(wi->window_handle)};
+
+		VkSurfaceKHR surface;
+		VkResult res = vkCreateAndroidSurfaceKHR(instance, &surface_create_info, nullptr, &surface);
+		if (res != VK_SUCCESS)
+		{
+			LOG_VULKAN_ERROR(res, "vkCreateAndroidSurfaceKHR failed: ");
+			return VK_NULL_HANDLE;
+		}
+
+		return surface;
+	}
+#endif
+
 #if defined(VK_USE_PLATFORM_METAL_EXT)
 	if (wi->type == WindowInfo::Type::MacOS)
 	{
-- 
2.46.2.windows.1

