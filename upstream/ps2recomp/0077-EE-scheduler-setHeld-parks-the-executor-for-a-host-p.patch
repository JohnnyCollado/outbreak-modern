From: JohnnyC96 <54557697+JohnnyC96@users.noreply.github.com>
Date: Mon, 26 Oct 2026 15:31:06 -0400
Subject: [PATCH 77/79] EE scheduler: setHeld parks the executor for a host
 pause (no guest code, events, timers or IOP cycles while held); paced host
 deadlines move forward by the time held, so no vsync burst after

---
 ps2xRuntime/include/runtime/ee_scheduler.h | 12 ++++
 ps2xRuntime/src/lib/Kernel/EeScheduler.cpp | 57 ++++++++++++++++--
 ps2xTest/src/ps2_gs_external_tests.cpp     | 69 ++++++++++++++++++++++
 3 files changed, 133 insertions(+), 5 deletions(-)

diff --git a/ps2xRuntime/include/runtime/ee_scheduler.h b/ps2xRuntime/include/runtime/ee_scheduler.h
index 4c9a2ae..1d35c83 100644
--- a/ps2xRuntime/include/runtime/ee_scheduler.h
+++ b/ps2xRuntime/include/runtime/ee_scheduler.h
@@ -284,6 +284,12 @@ public:
     // GS's frame queue) allow. A test-speed switch; default true. Set before reset.
     void setPaced(bool paced) noexcept { m_paced = paced; }
     [[nodiscard]] bool paced() const noexcept { return m_paced; }
+    // Patch 0077: the host's pause (a menu over the game). setHeld(true), from any thread, parks the EE executor at
+    // its next checkpoint or wait: no guest code, events, EE timers or IOP cycles run, so guest time stands still.
+    // setHeld(false) resumes it, with the paced host deadlines moved forward by the time held (no burst of vsyncs to
+    // catch up). Returns once the executor has parked or resumed, or is not running; false after timeout.
+    bool setHeld(bool held, std::chrono::milliseconds timeout = std::chrono::milliseconds(500));
+    [[nodiscard]] bool held() const noexcept { return m_heldAck.load(std::memory_order_acquire); }
     void run();
     void requestStop();
     void postEvent(EeEvent event);
@@ -468,4 +474,10 @@ private:
     PS2DiagHooks *m_diag = nullptr;
     uint64_t m_pacingWaitNs = 0;
     bool m_paced = true; // setPaced
+
+    // setHeld (patch 0077): requested by the host, acknowledged by the executor in parkIfHeld (both under m_eventMutex).
+    void parkIfHeld();
+    std::atomic<bool> m_holdRequested{false};
+    std::atomic<bool> m_heldAck{false};
+    std::condition_variable m_holdCv;
 };
diff --git a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
index ff19f9a..97290cf 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -358,7 +358,49 @@ void EeScheduler::requestStop()
 {
     m_stopRequested.store(true, std::memory_order_release);
     m_checkpointPending.store(true, std::memory_order_release);
+    {
+        std::lock_guard lock(m_eventMutex);
+    }
     m_eventCv.notify_all();
+    m_holdCv.notify_all();
+}
+
+bool EeScheduler::setHeld(bool held, std::chrono::milliseconds timeout)
+{
+    std::unique_lock lock(m_eventMutex);
+    m_holdRequested.store(held, std::memory_order_release);
+    if (held)
+        m_checkpointPending.store(true, std::memory_order_release); // a running guest returns to the scheduler
+    m_eventCv.notify_all();                                         // a waiting one wakes
+    m_holdCv.notify_all();
+    return m_holdCv.wait_for(lock, timeout, [this, held]()
+                             { return m_heldAck.load(std::memory_order_acquire) == held ||
+                                      m_stopRequested.load(std::memory_order_acquire) ||
+                                      !m_running.load(std::memory_order_acquire); });
+}
+
+void EeScheduler::parkIfHeld()
+{
+    if (!m_holdRequested.load(std::memory_order_acquire))
+        return;
+    std::unique_lock lock(m_eventMutex);
+    if (!m_holdRequested.load(std::memory_order_acquire))
+        return;
+    const auto start = std::chrono::steady_clock::now();
+    m_heldAck.store(true, std::memory_order_release);
+    m_holdCv.notify_all();
+    m_holdCv.wait(lock, [this]()
+                  { return !m_holdRequested.load(std::memory_order_acquire) ||
+                           m_stopRequested.load(std::memory_order_acquire); });
+    // Paced deadlines (VBlank, alarms) were set against the wall clock: move them past the pause, so guest time
+    // continues where it stopped. Unpaced ones are always due and only the guest cycle decides.
+    const auto heldFor = std::chrono::steady_clock::now() - start;
+    if (m_paced)
+        for (ScheduledEvent &item : m_deadlines)
+            if (item.hostDeadline != kUnpacedHostDeadline && item.hostDeadline != std::chrono::steady_clock::time_point{})
+                item.hostDeadline += heldFor;
+    m_heldAck.store(false, std::memory_order_release);
+    m_holdCv.notify_all();
 }
 
 void EeScheduler::postEvent(EeEvent event)
@@ -1767,6 +1809,7 @@ void EeScheduler::applyPendingPreemption()
 void EeScheduler::processPendingEvents()
 {
     assertExecutor();
+    parkIfHeld();
     processDueDeadlines();
     const uint32_t timerInterrupts = m_pendingEeTimerInterrupts;
     m_pendingEeTimerInterrupts = 0u;
@@ -1801,7 +1844,8 @@ void EeScheduler::processPendingEvents()
