+    // Patch 0077 (setHeld): the guest waits vsyncs and records each resume's tick and wall time.
+    struct HeldSample
+    {
+        uint64_t tick;
+        std::chrono::steady_clock::time_point at;
+    };
+    std::vector<HeldSample> s_heldSeen;
+    std::mutex s_heldMutex;
+    constexpr uint32_t kHeldVSyncs = 40u;
+
+    void heldDrive(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        EeScheduler &ee = runtime->eeScheduler();
+        {
+            std::lock_guard lock(s_heldMutex);
+            s_heldSeen.push_back(HeldSample{ee.currentVSyncTick(), std::chrono::steady_clock::now()});
+            if (s_heldSeen.size() > kHeldVSyncs)
+            {
+                ctx->pc = 0u;
+                runtime->requestStop();
+                return;
+            }
+        }
+        ctx->pc = kDrivePc;
+        ee.waitVSync(ee.currentVSyncTick());
+    }
+
     // Wall milliseconds for kPacingVSyncs vsyncs; the vsync ticks seen in seen.
     double runPacing(bool paced, std::vector<uint64_t> &seen)
     {
@@ -656,6 +685,46 @@ void register_ps2_gs_external_tests()
             std::filesystem::remove_all(dir, ec);
         });
 
+        tc.Run("held (patch 0077): guest time stands still while held, and no vsync burst after", [](TestCase &t)
+        {
+            std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0u);
+            PS2Runtime runtime;
+            runtime.registerFunction(kDrivePc, heldDrive);
+            {
+                std::lock_guard lock(s_heldMutex);
+                s_heldSeen.clear();
+            }
+            R5900Context mainContext{};
+            mainContext.pc = kDrivePc;
+            EeScheduler &ee = runtime.eeScheduler();
+            std::thread game([&]()
+                             { ee.reset(rdram.data(), mainContext);
+                               ee.run(); });
+            std::this_thread::sleep_for(std::chrono::milliseconds(150));
+            const bool parked = ee.setHeld(true);
+            const uint64_t tickAtHold = ee.currentVSyncTick();
+            std::this_thread::sleep_for(std::chrono::milliseconds(300));
+            const uint64_t tickAfterHold = ee.currentVSyncTick();
+            const bool heldFlag = ee.held();
+            const auto released = std::chrono::steady_clock::now();
+            const bool resumed = ee.setHeld(false);
+            game.join();
+
+            t.IsTrue(parked, "setHeld(true) returns once the executor parked");
+            t.IsTrue(heldFlag, "held() while parked");
+            t.IsTrue(resumed, "setHeld(false) returns once it resumed");
+            t.Equals(tickAfterHold, tickAtHold, "no vsync while held (300 ms = ~18 vsyncs)");
+            uint32_t within50ms = 0;
+            {
+                std::lock_guard lock(s_heldMutex);
+                for (const HeldSample &s : s_heldSeen)
+                    if (s.at >= released && s.at - released < std::chrono::milliseconds(50))
+                        ++within50ms;
+                t.Equals(s_heldSeen.size(), static_cast<size_t>(kHeldVSyncs + 1u), "every wait resumed after the hold");
+            }
+            t.IsTrue(within50ms <= 4u, "no catch-up burst: " + std::to_string(within50ms) + " vsyncs in the first 50 ms");
+        });
+
         tc.Run("unpaced (PS2X_PACING=0): the same vsync ticks, without waiting for the wall clock", [](TestCase &t)
