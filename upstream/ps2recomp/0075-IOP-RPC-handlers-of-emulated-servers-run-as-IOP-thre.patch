From: JohnnyC96 <54557697+JohnnyC96@users.noreply.github.com>
Date: Mon, 26 Oct 2026 06:38:55 -0400
Subject: [PATCH 75/76] IOP: RPC handlers of emulated servers run as IOP
 threads (the server thread's priority) until they return, so they can block
 on driver threads; handler stacks reused

---
 ps2xIOP/src/emulator/core/iop_kernel.cpp  | 46 +++++++++++
 ps2xIOP/src/emulator/core/iop_kernel.h    | 12 +++
 ps2xIOP/src/emulator/iop_emulator.cpp     | 57 +++++++++++++-
 ps2xIOP/src/emulator/iop_emulator_const.h |  6 +-
 ps2xIOP/src/emulator/services/iop_rpc.cpp | 19 +++--
 ps2xIOP/src/emulator/services/iop_rpc.h   | 15 ++++
 ps2xIOP/tests/iop_emulator_tests.cpp      | 94 +++++++++++++++++++++++
 7 files changed, 241 insertions(+), 8 deletions(-)

diff --git a/ps2xIOP/src/emulator/core/iop_kernel.cpp b/ps2xIOP/src/emulator/core/iop_kernel.cpp
index ece5ee2..03fa06b 100644
--- a/ps2xIOP/src/emulator/core/iop_kernel.cpp
+++ b/ps2xIOP/src/emulator/core/iop_kernel.cpp
@@ -841,6 +841,52 @@ namespace ps2x::iop::detail
         }
     }
 
+    int IopKernel::createInternalThread(uint32_t entry, uint32_t gp, uint32_t priority, uint32_t stackBase,
+                                        uint32_t stackSize, uint32_t a0, uint32_t a1, uint32_t a2,
+                                        uint32_t returnSentinel)
+    {
+        if (stackBase == 0u || stackSize < 0x100u)
+            return -400;
+        IopThread thread;
+        thread.id = static_cast<int>(m_nextThreadId++);
+        thread.entry = entry;
+        thread.stackSize = stackSize;
+        thread.priority = std::clamp<uint32_t>(priority, 1u, 126u);
+        thread.initialPriority = thread.priority;
+        thread.cpu = {};
+        thread.cpu.pc = entry;
+        thread.cpu.gpr[4] = a0;
+        thread.cpu.gpr[5] = a1;
+        thread.cpu.gpr[6] = a2;
+        thread.cpu.gpr[28] = gp;
+        thread.cpu.gpr[29] = ((stackBase + stackSize) & ~15u) - 16u;
+        thread.cpu.gpr[31] = returnSentinel;
+        thread.state = IopThreadState::Ready; // stackBase stays 0: the caller's stack is not freed with the thread
+        const int id = thread.id;
+        m_threads.emplace(id, std::move(thread));
+        return id;
+    }
+
+    const IopThread *IopKernel::findThread(int id) const
+    {
+        const auto it = m_threads.find(id);
+        return it == m_threads.end() ? nullptr : &it->second;
+    }
+
+    void IopKernel::deleteInternalThread(int id)
+    {
+        const auto it = m_threads.find(id);
+        if (it == m_threads.end())
+            return;
+        if (m_currentThread == &it->second)
+            m_currentThread = nullptr;
+        if (m_headThreadId == id)
+            m_headThreadId = -1;
+        if (it->second.stackBase != 0u)
+            (void)m_memory.freeAllocation(it->second.stackBase);
+        m_threads.erase(it);
+    }
+
     void IopKernel::sleepCurrent(IopCpuState &cpu)
     {
         if (m_currentThread == nullptr)
