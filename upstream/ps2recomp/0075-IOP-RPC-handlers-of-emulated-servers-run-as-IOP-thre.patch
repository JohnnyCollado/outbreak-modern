+        // cpu.gpr[2]).
+        [[nodiscard]] int createInternalThread(uint32_t entry, uint32_t gp, uint32_t priority, uint32_t stackBase,
+                                               uint32_t stackSize, uint32_t a0, uint32_t a1, uint32_t a2,
+                                               uint32_t returnSentinel);
+        [[nodiscard]] const IopThread *findThread(int id) const;
+        void deleteInternalThread(int id);
+        // The running thread's priority (an RPC server registering from its thread); 0x40 outside a thread.
+        [[nodiscard]] uint32_t currentPriority() const noexcept { return m_currentThread ? m_currentThread->priority : 0x40u; }
+
         void sleepCurrent(IopCpuState &cpu);
         void delayCurrentUntil(uint64_t wakeCycle, IopCpuState &cpu);
 
diff --git a/ps2xIOP/src/emulator/iop_emulator.cpp b/ps2xIOP/src/emulator/iop_emulator.cpp
index cac2298..8ba047d 100644
--- a/ps2xIOP/src/emulator/iop_emulator.cpp
+++ b/ps2xIOP/src/emulator/iop_emulator.cpp
@@ -125,6 +125,7 @@ namespace ps2x::iop::detail
 
         void reset()
         {
+            freeRpcStacks.clear(); // their blocks go with memory.reset()
             memory.reset();
             kernel.reset();
             modules.clear();
@@ -590,6 +591,59 @@ namespace ps2x::iop::detail
             return callFunction(address, a0, a1, a2, a3, gp);
         }
 
+        uint32_t executeGuestFunctionOnThread(uint32_t address,
+                                              uint32_t a0,
+                                              uint32_t a1,
+                                              uint32_t a2,
+                                              uint32_t gp,
+                                              uint32_t priority,
+                                              bool &finished) override
+        {
+            // Patch 0075: the scheduler runs (this thread first at its priority; the others while it blocks) until
+            // it is back at the sentinel. Small steps: a handler that never blocks ends within its first slice, as
+            // the nested call did. The budget (one IOP second) only guards against a handler that never returns.
+            finished = false;
+            if (freeRpcStacks.empty())
+            {
+                const uint32_t stack = memory.allocate(kRpcThreadStackSize + kStackGuardBytes, 16u);
+                if (stack == 0u)
+                {
+                    log(LogLevel::Error, "[IOP] no IOP memory for an RPC handler thread's stack");
+                    return 0u;
+                }
+                freeRpcStacks.push_back(stack);
+            }
+            const uint32_t stack = freeRpcStacks.back();
+            freeRpcStacks.pop_back();
+            const int id = kernel.createInternalThread(address, gp, priority, stack, kRpcThreadStackSize, a0, a1, a2,
+                                                       kThreadReturnSentinel);
+            if (id <= 0)
+            {
+                freeRpcStacks.push_back(stack);
+                return 0u;
+            }
+            uint64_t ran = 0u;
+            for (;;)
+            {
+                const IopThread *thread = kernel.findThread(id);
+                if (thread == nullptr || thread->state == IopThreadState::Dormant || thread->state == IopThreadState::Dead)
+                    break;
+                if (ran >= kRpcThreadBudgetCycles)
+                {
+                    log(LogLevel::Warning, "[IOP] RPC handler thread did not return within its budget");
+                    break;
+                }
+                runCycles(kRpcThreadStepCycles);
+                ran += kRpcThreadStepCycles;
+            }
+            const IopThread *thread = kernel.findThread(id);
+            finished = thread != nullptr && thread->state == IopThreadState::Dormant;
+            const uint32_t result = thread != nullptr ? thread->cpu.gpr[2] : 0u;
+            kernel.deleteInternalThread(id);
+            freeRpcStacks.push_back(stack);
+            return finished ? result : 0u;
+        }
+
         uint32_t executeGuestFunctionWithBudget(uint32_t address,
                                                 uint32_t a0,
                                                 uint32_t a1,
@@ -971,7 +1025,8 @@ namespace ps2x::iop::detail
         };
         std::map<int, PendingDma> pendingDmaInterrupts;
         uint64_t nextDmaCompletionCycle = UINT64_MAX; // earliest completionCycle above (patch 0049), and nextSpu2Cycle
-        uint64_t nextSpu2Cycle = 0;                   // when the external SPU2 is next due (patch 0056); 0 = at once
+        uint64_t nextSpu2Cycle = 0;
+        std::vector<uint32_t> freeRpcStacks; // RPC handler thread stacks, allocated once and reused (patch 0075)                   // when the external SPU2 is next due (patch 0056); 0 = at once
         std::multimap<uint64_t, ScheduledGuestCallback> pendingGuestCallbacks;
         uint32_t nextModuleId = 1;
         uint32_t moduleCursor = kModuleLoadBase;
