     void writeRelocatableRpcServerIrx(TestHost &host, uint32_t address)
     {
         constexpr uint32_t codeOffset = 0x100u;
@@ -1206,6 +1268,38 @@ int main()
     if (!expect(iop.debugSnapshot().emulatorInstructions > soundInstructionsBefore,
                 "Sound RPC did not execute the physical IOP handler")) return 1;
 
+    {
+        // RPC handlers run as IOP threads (patch 0075): one that sleeps (DelayThread) resumes and returns, and it
+        // runs on a thread of its own (GetThreadId != 0), as in the server thread's sceSifRpcLoop on a PS2.
+        iop.reset();
+        writeBlockingRpcServerIrx(host, 0x100u);
+        const ModuleLoadResult blockingModule = iop.loadModuleBuffer(0x100u);
+        if (!expect(blockingModule.handled && blockingModule.startResult == 0 && iop.canBindRpc(0xB10C0001u),
+                    "Blocking RPC server IRX did not start")) return 1;
+        std::memset(host.guest.data() + 0xA00u, 0, sizeof(uint32_t));
+        RpcRequest blockingRequest{};
+        blockingRequest.sid = 0xB10C0001u;
+        blockingRequest.receive = {0xA00u, sizeof(uint32_t)};
+        const RpcResult blockingResult = iop.handleRpc(blockingRequest);
+        uint32_t handlerThreadId = 0u;
+        std::memcpy(&handlerThreadId, host.guest.data() + 0xA00u, sizeof(handlerThreadId));
+        if (!expect(blockingResult.handled && handlerThreadId != 0u,
+                    "an RPC handler must run on an IOP thread that can block (DelayThread) and then return")) return 1;
+        // Handler threads reuse their stacks: IOP heap blocks are not reused once freed (bump allocator), so a stack
+        // per call ran the heap out after a few hundred calls.
+        bool everyCallRan = true;
+        for (int call = 0; call < 300 && everyCallRan; ++call)
+        {
+            std::memset(host.guest.data() + 0xA00u, 0, sizeof(uint32_t));
+            const RpcResult repeated = iop.handleRpc(blockingRequest);
+            uint32_t id = 0u;
+            std::memcpy(&id, host.guest.data() + 0xA00u, sizeof(id));
+            everyCallRan = repeated.handled && id != 0u;
+        }
+        if (!expect(everyCallRan, "300 RPC calls in a row must each run their handler thread")) return 1;
+    }
+
+    iop.reset();
     constexpr uint32_t relocatableRpcSid = 0xA11CE001u;
     writeRelocatableRpcServerIrx(host, 0x100u);
     const ModuleLoadResult relocatableRpcModule = iop.loadModuleBuffer(0x100u);
