+    // An RPC server (SID 0xB10C0001) whose handler blocks (patch 0075): DelayThread(100), then it stores
+    // GetThreadId() in its buffer and returns the buffer.
+    void writeBlockingRpcServerIrx(TestHost &host, uint32_t address)
+    {
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t loadAddress = 0x00010000u;
+        constexpr uint32_t sifcmdStub = loadAddress + 0x60u + 20u;
+        constexpr uint32_t delayStub = loadAddress + 0xA0u + 20u;
+        constexpr uint32_t threadIdStub = delayStub + 8u;
+        const auto jal = [](uint32_t target) { return 0x0C000000u | ((target >> 2u) & 0x03FFFFFFu); };
+
+        ElfHeader header{};
+        header.ident[0] = 0x7Fu; header.ident[1] = 'E'; header.ident[2] = 'L'; header.ident[3] = 'F';
+        header.ident[4] = 1u; header.ident[5] = 1u; header.ident[6] = 1u;
+        header.type = 2u; header.machine = 8u; header.version = 1u;
+        header.entry = loadAddress; header.phoff = sizeof(ElfHeader);
+        header.ehsize = sizeof(ElfHeader); header.phentsize = sizeof(ProgramHeader); header.phnum = 1u;
+
+        const uint32_t entry[] = {
+            0x27BDFFE0u, 0xAFBF001Cu,
+            0x3C040001u, 0x34840200u, // a0 = server data
+            0x3C05B10Cu, 0x34A50001u, // a1 = 0xB10C0001
+            0x3C060001u, 0x34C60300u, // a2 = handler
+            0x3C070001u, 0x34E70400u, // a3 = buffer
+            0xAFA00010u, 0xAFA00014u, 0xAFA00018u,
+            jal(sifcmdStub), 0x00000000u, // sceSifRegisterRpc
+            0x8FBF001Cu, 0x00001021u, 0x27BD0020u, 0x03E00008u, 0x00000000u,
+        };
+        const uint32_t sifcmdImports[] = {
+            0x41E00000u, 0u, 0x00000101u, 0x63666973u, 0x0000646Du, // "sifcmd"
+            0x03E00008u, 0x24000011u, 0u, 0u,                     // 17 sceSifRegisterRpc
+        };
+        const uint32_t thbaseImports[] = {
+            0x41E00000u, 0u, 0x00000101u, 0x61626874u, 0x00006573u, // "thbase"
+            0x03E00008u, 0x24000021u,                             // 33 DelayThread
+            0x03E00008u, 0x24000014u,                             // 20 GetThreadId
+            0u, 0u,
+        };
+        const uint32_t handler[] = {
+            0x27BDFFE0u, 0xAFBF001Cu, 0xAFA50018u, // save ra and the buffer (a1)
+            0x34040064u, jal(delayStub), 0x00000000u, // DelayThread(100)
+            jal(threadIdStub), 0x00000000u,          // GetThreadId()
+            0x8FA50018u, 0x00000000u,                // lw a1, 0x18(sp) + load delay slot
+            0xACA20000u, 0x00A01021u,                // *buffer = id; return buffer
+            0x8FBF001Cu, 0x27BD0020u, 0x03E00008u, 0x00000000u,
+        };
+
+        ProgramHeader program{};
+        program.type = 1u; program.offset = codeOffset; program.vaddr = loadAddress; program.paddr = loadAddress;
+        program.filesz = 0x340u; program.memsz = 0x500u; program.flags = 7u; program.align = 4u;
+
+        std::vector<uint8_t> segment(program.filesz, 0u);
+        std::memcpy(segment.data(), entry, sizeof(entry));
+        std::memcpy(segment.data() + 0x60u, sifcmdImports, sizeof(sifcmdImports));
+        std::memcpy(segment.data() + 0xA0u, thbaseImports, sizeof(thbaseImports));
+        std::memcpy(segment.data() + 0x300u, handler, sizeof(handler));
+        std::fill(host.guest.begin() + address, host.guest.end(), 0u);
+        std::memcpy(host.guest.data() + address, &header, sizeof(header));
+        std::memcpy(host.guest.data() + address + sizeof(header), &program, sizeof(program));
+        std::memcpy(host.guest.data() + address + codeOffset, segment.data(), segment.size());
+    }
