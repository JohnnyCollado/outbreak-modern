 constexpr int kSpu2Irq = 9;
 constexpr int kSpu2Dma4Irq = 0x24;
-constexpr int kSpu2Dma7Irq = 0x28;
\ No newline at end of file
+constexpr int kSpu2Dma7Irq = 0x28;
