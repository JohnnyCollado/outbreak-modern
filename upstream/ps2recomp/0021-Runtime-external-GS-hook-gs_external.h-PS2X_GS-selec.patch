diff --git a/ps2xTest/src/ps2_gs_external_tests.cpp b/ps2xTest/src/ps2_gs_external_tests.cpp
new file mode 100644
index 0000000..7b4c05b
--- /dev/null
+++ b/ps2xTest/src/ps2_gs_external_tests.cpp
@@ -0,0 +1,165 @@
+#include "MiniTest.h"
+#include "ps2_runtime.h"
+#include "runtime/ee_scheduler.h"
+#include "runtime/gs/gs_external.h"
+#include "runtime/gs/gs_frontend.h"
+
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace
+{
+    struct ExternalGSEvent
+    {
+        char kind = 0; // p packet, w priv write, v vsync, s snapshot, r reset, l readback
+        uint32_t a = 0;
+        uint64_t b = 0;
+        uint64_t c = 0;
+        std::vector<uint8_t> data;
+    };
+
+    class RecordingExternalGS : public PS2ExternalGS
+    {
+    public:
+        std::vector<ExternalGSEvent> events;
+
+        void gifPacket(GifPathId path, const uint8_t *data, uint32_t sizeBytes) override
+        {
+            events.push_back({'p', static_cast<uint32_t>(path), 0u, 0u, std::vector<uint8_t>(data, data + sizeBytes)});
+        }
+        void privWrite(uint32_t offset, uint64_t value) override
+        {
+            events.push_back({'w', offset, value, 0u, {}});
+        }
+        void vsync(uint64_t tick, const GSRegisters &regs) override
+        {
+            events.push_back({'v', 0u, tick, regs.pmode, {}});
+            events.back().a = static_cast<uint32_t>(regs.csr.load() & 0x2000ull);
+        }
+        uint32_t readLocalToHost(uint8_t *dst, uint32_t maxBytes) override
+        {
+            events.push_back({'l', maxBytes, 0u, 0u, {}});
+            std::memset(dst, 0x5A, maxBytes);
+            return maxBytes;
+        }
+        void reset() override
+        {
+            events.push_back({'r', 0u, 0u, 0u, {}});
+        }
+        bool snapshot(std::vector<uint8_t> &rgba, uint32_t &width, uint32_t &height) override
+        {
+            events.push_back({'s', 0u, 0u, 0u, {}});
+            rgba = {1u, 2u, 3u, 255u, 4u, 5u, 6u, 255u};
+            width = 2u;
+            height = 1u;
+            return true;
+        }
+    };
+
+    struct ExternalGSScope
+    {
+        explicit ExternalGSScope(PS2ExternalGS *gs) { ps2SetExternalGS(gs); }
+        ~ExternalGSScope() { ps2SetExternalGS(nullptr); }
+    };
+
+    constexpr uint32_t kDrivePc = 0x00170000u;
+    constexpr uint32_t kResumePc = 0x00170010u;
+    constexpr uint32_t kGsPmode = 0x12000000u;
+    constexpr uint32_t kGsDispfb2Hi = 0x12000094u;
+    constexpr uint32_t kGsCsr = 0x12001000u;
+    constexpr uint64_t kPmodeValue = 0x0000000000000066ull;
+    constexpr uint64_t kCsrReset = 1ull << 9u;
+
+    // One PACKED A+D GIFtag (NLOOP 1, EOP) and its data qword, tagged by path.
+    std::vector<uint8_t> makeGifPacket(uint8_t path)
+    {
+        const uint64_t q[4] = {1ull | (1ull << 15) | (1ull << 60), 0xEull, 0x1000ull + path, 0x4Cull};
+        std::vector<uint8_t> bytes(sizeof(q));
+        std::memcpy(bytes.data(), q, sizeof(q));
+        return bytes;
+    }
+
+    void externalGsDrive(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        PS2Memory &mem = runtime->memory();
+        const std::vector<uint8_t> p3 = makeGifPacket(3u), p2 = makeGifPacket(2u), p1 = makeGifPacket(1u);
+        mem.submitGifPacket(GifPathId::Path3, p3.data(), static_cast<uint32_t>(p3.size()), false);
+        mem.submitGifPacket(GifPathId::Path2, p2.data(), static_cast<uint32_t>(p2.size()), false);
+        mem.submitGifPacket(GifPathId::Path1, p1.data(), static_cast<uint32_t>(p1.size()), true);
+        mem.write64(kGsPmode, kPmodeValue);
+        mem.write32(kGsDispfb2Hi, 0x00ABCDEFu);
+        mem.write64(kGsCsr, kCsrReset);
+        ctx->pc = kResumePc;
+        runtime->eeScheduler().waitVSync(runtime->eeScheduler().currentVSyncTick());
+    }
+
+    void externalGsResume(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+}
+
+void register_ps2_gs_external_tests()
+{
+    MiniTest::Case("PS2ExternalGS", [](TestCase &tc)
+    {
+        tc.Run("external GS hook sees arbiter packets, privileged writes and vsync in order", [](TestCase &t)
+        {
+            std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0u);
+            PS2Runtime runtime;
+            uint32_t cpuPackets = 0u;
+            runtime.gifArbiter().setProcessPacketFn([&cpuPackets](const uint8_t *, uint32_t) { ++cpuPackets; });
+            runtime.memory().setGifArbiter(&runtime.gifArbiter());
+            runtime.memory().gs().dispfb2 = 0x0000000011112222ull;
+            runtime.registerFunction(kDrivePc, externalGsDrive);
+            runtime.registerFunction(kResumePc, externalGsResume);
+
+            RecordingExternalGS rec;
+            ExternalGSScope scope(&rec);
+            R5900Context mainContext{};
+            mainContext.pc = kDrivePc;
+            runtime.eeScheduler().reset(rdram.data(), mainContext);
+            runtime.eeScheduler().run();
+
+            const std::vector<ExternalGSEvent> &ev = rec.events;
+            t.Equals(ev.size(), static_cast<size_t>(9u), "3 packets, 3 privileged writes, a reset, a vsync, a snapshot");
+            if (ev.size() != 9u)
+                return;
+            for (uint32_t i = 0; i < 3u; ++i)
+            {
+                t.Equals(ev[i].kind, 'p', "packets come first");
+                t.Equals(ev[i].a, i + 1u, "packets arrive in arbiter order (PATH1, PATH2, PATH3)");
+                t.IsTrue(ev[i].data == makeGifPacket(static_cast<uint8_t>(i + 1u)), "packet payload is the whole packet");
+            }
+            t.Equals(cpuPackets, 3u, "the CPU GS sink still gets every packet");
+            t.Equals(ev[3].kind, 'w', "PMODE write follows the packets");
+            t.Equals(ev[3].a, 0x0u, "PMODE offset");
+            t.Equals(ev[3].b, kPmodeValue, "PMODE value");
+            t.Equals(ev[4].kind, 'w', "DISPFB2 half write");
+            t.Equals(ev[4].a, 0x90u, "DISPFB2 offset is 8-aligned");
+            t.Equals(ev[4].b, 0x00ABCDEF11112222ull, "DISPFB2 value is the whole register after the write");
+            t.Equals(ev[5].kind, 'w', "CSR write");
+            t.Equals(ev[5].a, 0x1000u, "CSR offset");
+            t.Equals(ev[6].kind, 'r', "CSR RESET bit resets the external GS");
+            t.Equals(ev[7].kind, 'v', "vsync after the writes");
+            t.Equals(ev[7].b, 1ull, "first vsync tick");
+            t.Equals(ev[7].c, kPmodeValue, "vsync passes the privileged registers");
+            t.Equals(ev[7].a, 0x2000u, "vsync comes after the CSR FIELD set");
+            t.Equals(ev[8].kind, 's', "snapshot right after vsync");
+
+            runtime.gs().latchHostPresentationFrame();
+            std::vector<uint8_t> pixels;
+            uint32_t width = 0u, height = 0u;
+            t.IsTrue(runtime.gs().copyLatchedHostPresentationFrame(pixels, width, height), "published frame is latched");
+            t.Equals(width, 2u, "latched width");
+            t.Equals(height, 1u, "latched height");
+            t.IsTrue(pixels == std::vector<uint8_t>{1u, 2u, 3u, 255u, 4u, 5u, 6u, 255u}, "latched pixels");
+
+            uint8_t readback[8] = {};
+            t.Equals(runtime.gs().consumeLocalToHostBytes(readback, 8u), 8u, "readback comes from the external GS");
+            t.Equals(readback[7], static_cast<uint8_t>(0x5Au), "readback bytes");
+        });
+    });
+}
