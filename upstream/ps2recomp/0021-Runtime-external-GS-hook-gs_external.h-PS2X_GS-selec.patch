     src/lib/gs/ps2_gif_arbiter.cpp
     src/lib/ps2_audio.cpp
     src/lib/ps2_audio_vag.cpp
@@ -509,6 +516,15 @@ target_include_directories(ps2_runtime PUBLIC
 )
 
 target_link_libraries(ps2_runtime PUBLIC ps2_host_backend ffmpeg ps2_iop)
+
+if(PS2X_EXTERNAL_GS_DIR)
+    add_subdirectory("${PS2X_EXTERNAL_GS_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/external_gs")
