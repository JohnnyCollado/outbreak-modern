diff --git a/ps2xRuntime/src/lib/gs/gs_external.cpp b/ps2xRuntime/src/lib/gs/gs_external.cpp
new file mode 100644
index 0000000..957c3b8
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_external.cpp
@@ -0,0 +1,18 @@
+#include "runtime/gs/gs_external.h"
+
+#include <atomic>
+
+namespace
+{
+    std::atomic<PS2ExternalGS *> s_externalGS{nullptr};
+}
+
+PS2ExternalGS *ps2ExternalGS()
+{
+    return s_externalGS.load(std::memory_order_acquire);
+}
+
+void ps2SetExternalGS(PS2ExternalGS *gs)
+{
+    s_externalGS.store(gs, std::memory_order_release);
+}
