+        m_hasHostPresentationFrame = static_cast<bool>(m_externalFrame);
+        return;
+    }
+
     GSPresentationRequest request{};
     {
         std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
@@ -1629,7 +1647,18 @@ bool GS::clearActiveFramebuffer(uint32_t rgba)
 uint32_t GS::consumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
 {
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
-    return m_backend ? m_backend->ConsumeLocalToHostBytes(dst, maxBytes) : 0u;
+    const uint32_t bytes = m_backend ? m_backend->ConsumeLocalToHostBytes(dst, maxBytes) : 0u;
+    // An external GS owns the readback; the CPU backend is still drained above
+    // so its transfer state stays as without the hook.
+    if (PS2ExternalGS *externalGS = ps2ExternalGS())
+        return externalGS->readLocalToHost(dst, maxBytes);
+    return bytes;
+}
+
+void GS::publishExternalFrame(PresentationFrame &&frame)
+{
