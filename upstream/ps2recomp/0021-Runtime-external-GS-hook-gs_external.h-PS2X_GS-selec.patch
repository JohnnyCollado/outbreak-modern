diff --git a/ps2xRuntime/include/runtime/gs/gs_external.h b/ps2xRuntime/include/runtime/gs/gs_external.h
new file mode 100644
index 0000000..65e8117
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_external.h
@@ -0,0 +1,30 @@
+#ifndef PS2_GS_EXTERNAL_H
+#define PS2_GS_EXTERNAL_H
+
+#include <cstdint>
+#include <vector>
+
+#include "runtime/gs/ps2_gif_arbiter.h"
+
+struct GSRegisters;
+
+// Optional external GS: when set, it receives the GS input stream in the
+// order the runtime produces it and supplies the presented frame and the
+// local-to-host readback. Unset (the default), the CPU GS alone runs.
+class PS2ExternalGS {
+public:
+  virtual ~PS2ExternalGS() = default;
+  virtual void gifPacket(GifPathId path, const uint8_t *data, uint32_t sizeBytes) = 0; // whole packet as the arbiter drains it
+  virtual void privWrite(uint32_t offset, uint64_t value) = 0; // offset from 0x12000000, 8-aligned; value = whole 64-bit register after the write (32-bit half writes included)
+  virtual void vsync(uint64_t tick, const GSRegisters &regs) = 0; // VBlankStart, after the CSR FIELD set/clear, before script->onVSync
+  virtual uint32_t readLocalToHost(uint8_t *dst, uint32_t maxBytes) = 0; // replaces the backend's ConsumeLocalToHostBytes when a hook is set
+  virtual void reset() = 0; // GS::reset() and CSR RESET bit writes
+  virtual bool snapshot(std::vector<uint8_t> &rgba, uint32_t &width, uint32_t &height) = 0; // called right after vsync; RGBA8
+};
+PS2ExternalGS *ps2ExternalGS();           // null = CPU GS
+void ps2SetExternalGS(PS2ExternalGS *gs); // tests and startup
+#ifdef PS2X_EXTERNAL_GS
+PS2ExternalGS *ps2CreateExternalGS(const char *mode); // defined by the external library; null = failure
+#endif
+
+#endif
