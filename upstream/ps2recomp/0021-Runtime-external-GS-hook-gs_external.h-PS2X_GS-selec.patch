     }
 
+    // Forward a landed privileged write to the external GS, if one is set:
+    // the whole 64-bit register as it now stands. writtenBits is the write
+    // positioned in the 64-bit register (a CSR RESET bit there resets it).
+    inline void notifyExternalGsPrivWrite(GSRegisters &gs, uint32_t address, uint64_t writtenBits)
+    {
+        PS2ExternalGS *const externalGS = ps2ExternalGS();
+        if (!externalGS)
+            return;
+        constexpr uint64_t kCsrResetBit = 1ull << 9u;
+        const uint32_t regOff = (address - PS2_GS_PRIV_REG_BASE) & ~0x7u;
+        if (regOff == kGsCsrRegOffset)
+        {
+            externalGS->privWrite(regOff, gs.csr.load());
+            if (writtenBits & kCsrResetBit)
+                externalGS->reset();
+        }
+        else if (const uint64_t *reg = gsRegPtr(gs, address))
+        {
+            externalGS->privWrite(regOff, *reg);
+        }
+    }
+
     constexpr std::array<uint32_t, 4> kEeTimerBases = {
         0x10000000u,
         0x10000800u,
