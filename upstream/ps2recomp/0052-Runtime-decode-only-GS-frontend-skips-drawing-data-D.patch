diff --git a/ps2xTest/src/ps2_gs_external_tests.cpp b/ps2xTest/src/ps2_gs_external_tests.cpp
index ab245f1..e68ee4a 100644
--- a/ps2xTest/src/ps2_gs_external_tests.cpp
+++ b/ps2xTest/src/ps2_gs_external_tests.cpp
@@ -302,6 +302,48 @@ namespace
         return out;
     }
 
+    // Patch 0052: a packet of a PACKED vertex tag (3 x XYZ2), a REGLIST tag (RGBAQ, XYZ2) and a PACKED A+D FINISH.
+    // Decode-only must skip the first two whole and still land on the FINISH (CSR bit 1).
+    std::vector<uint8_t> makeVertexThenFinishPacket()
+    {
+        const uint64_t q[] = {
+            3ull | (1ull << 60), 0x5ull,                         // PACKED, NLOOP 3, NREG 1: XYZ2
+            0x11ull, 0x12ull, 0x21ull, 0x22ull, 0x31ull, 0x32ull, // 3 qwords of vertex data
+            1ull | (1ull << 58) | (2ull << 60), 0x51ull,         // REGLIST, NLOOP 1, NREG 2: RGBAQ, XYZ2
+            0x41ull, 0x42ull,                                    // 2 x 8 bytes (even: no padding)
+            1ull | (1ull << 15) | (1ull << 60), 0xEull,          // PACKED A+D, EOP
+            0x0ull, 0x61ull,                                     // FINISH
+        };
+        std::vector<uint8_t> bytes(sizeof(q));
+        std::memcpy(bytes.data(), q, sizeof(q));
+        return bytes;
+    }
+
+    struct DecodeOnlyRun
+    {
+        bool decodeOnly = false;
+        bool finish = false;
+        size_t hookPackets = 0u;
+    };
+
+    DecodeOnlyRun runVertexThenFinish(bool withHook)
+    {
+        DecodeOnlyRun out;
+        PS2Runtime runtime;
+        if (!runtime.memory().initialize() || !runtime.syncCoreSubsystems())
+            return out;
+        RecordingExternalGS rec;
+        ExternalGSScope scope(withHook ? &rec : nullptr);
+        runtime.gs().useNullBackendForExternalGS();
+        out.decodeOnly = runtime.gs().decodeOnly();
+        const std::vector<uint8_t> pkt = makeVertexThenFinishPacket();
+        runtime.memory().submitGifPacket(GifPathId::Path3, pkt.data(), static_cast<uint32_t>(pkt.size()), true);
+        out.finish = (runtime.memory().gs().csr.load() & 0x2ull) != 0u;
+        for (const ExternalGSEvent &ev : rec.events)
+            out.hookPackets += ev.kind == 'p' && ev.data == pkt;
+        return out;
+    }
+
     // PS2X_FRAME_TIME: the guest waits kFrameTimeVSyncs vsyncs (resuming at itself), then stops.
     constexpr uint32_t kFrameTimeVSyncs = 3u;
     uint32_t s_frameTimeVSyncsSeen = 0u;
@@ -372,6 +414,17 @@ void register_ps2_gs_external_tests()
 {
     MiniTest::Case("PS2ExternalGS", [](TestCase &tc)
     {
+        tc.Run("decode-only skips vertex PACKED and REGLIST data and still decodes the A+D FINISH", [](TestCase &t)
+        {
+            const DecodeOnlyRun ext = runVertexThenFinish(true);
+            t.IsTrue(ext.decodeOnly, "an external GS makes the frontend decode-only");
+            t.IsTrue(ext.finish, "decode-only: the FINISH after the skipped tags sets CSR FINISH");
+            t.Equals(ext.hookPackets, static_cast<size_t>(1u), "the hook still receives the whole packet");
+            const DecodeOnlyRun cpu = runVertexThenFinish(false);
+            t.IsFalse(cpu.decodeOnly, "no hook: the CPU backend decodes everything");
+            t.IsTrue(cpu.finish, "full decode: the same FINISH");
+        });
+
         tc.Run("external GS hook sees arbiter packets, privileged writes and vsync in order", [](TestCase &t)
         {
             std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0u);
