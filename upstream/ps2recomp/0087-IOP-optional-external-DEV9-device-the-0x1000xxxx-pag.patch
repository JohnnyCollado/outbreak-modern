diff --git a/ps2xIOP/include/ps2x/iop/iop_dev9.h b/ps2xIOP/include/ps2x/iop/iop_dev9.h
new file mode 100644
index 0000000..2a785ea
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/iop_dev9.h
@@ -0,0 +1,48 @@
+#pragma once
+
+#include <cstdint>
+
+namespace ps2x::iop
+{
+    // Optional external DEV9 (the expansion bay: network adapter). Unset (the default), the DEV9 page is plain
+    // storage and nothing answers, so a DEV9 driver finds no hardware. Set, the IOP hands it every access to the
+    // SPEED/SMAP/flash page 0x10000000..0x1000FFFF and to the revision register 0x1F80146E (8 and 16 bits), each at
+    // the width the guest used (a 32-bit read of the SMAP receive FIFO pops data: no width is built from another), and
+    // every transfer on DMA channel 8, as PCSX2's IopMem.cpp, ps2/Iop/IopHwRead.cpp / IopHwWrite.cpp (HW_DEV9_DATA)
+    // and IopDma.cpp psxDma8 do. The device raises its interrupt (INTC line 13, PCSX2 dev9Interrupt) and ends channel-8
+    // transfers (psxDMA8Interrupt) at any time, as a network card does when a frame arrives, so the IOP runs it with
+    // its clock like the SPU2 device. Time is the IOP cycle count; all calls come from the thread running the IOP.
+    class Dev9Device
+    {
+    public:
+        enum Event : uint32_t
+        {
+            EventIrq = 1u,  // DEV9 interrupt (INTC line 13)
+            EventDma8 = 2u, // channel-8 transfer done
+        };
+
+        virtual ~Dev9Device() = default;
+        virtual uint8_t read8(uint32_t phys) = 0;
+        virtual uint16_t read16(uint32_t phys) = 0;
+        virtual uint32_t read32(uint32_t phys) = 0;
+        virtual void write8(uint32_t phys, uint8_t value) = 0;
+        virtual void write16(uint32_t phys, uint16_t value) = 0;
+        virtual void write32(uint32_t phys, uint32_t value) = 0;
+        // A transfer started on channel 8 (CHCR 0x01000201, IOP RAM to DEV9, or 0x01000200, DEV9 to IOP RAM); bcr =
+        // block size in words (low 16 bits) and block count (high 16), as psxDma8. The device moves the bytes now;
+        // false for a CHCR psxDma8 does not take (the channel stays busy). The end comes as EventDma8.
+        virtual bool dma(uint8_t *iopRam, uint32_t ramSize, uint32_t madr, uint32_t bcr, uint32_t chcr) = 0;
+        virtual void advance(uint64_t cycle) = 0;           // run the device up to cycle
+        [[nodiscard]] virtual uint64_t nextEventCycle() = 0; // when advance is next due; UINT64_MAX = never
+        virtual uint32_t takeEvents() = 0;                  // Event bits raised since the last call
+    };
+
+    constexpr uint32_t kDev9DeviceBase = 0x10000000u;
+    constexpr uint32_t kDev9DeviceEnd = 0x10010000u;
+    constexpr uint32_t kDev9Revision = 0x1F80146Eu; // PCSX2 HW_DEV9_DATA
+    constexpr uint32_t kDmaDev9Chcr = 0x1F801518u;  // channel 8
+    constexpr int kDev9Irq = 13;
+
+    void setDev9Device(Dev9Device *device); // startup and tests; null = none
+    [[nodiscard]] Dev9Device *dev9Device();
+}
