+                unsigned a = 0, b = 0, c = 0, d = 0;
+                char tail = 0;
+                if (eq == std::string::npos ||
+                    std::sscanf(entry.c_str() + eq + 1, "%u.%u.%u.%u%c", &a, &b, &c, &d, &tail) != 4 || (a | b | c | d) > 255)
