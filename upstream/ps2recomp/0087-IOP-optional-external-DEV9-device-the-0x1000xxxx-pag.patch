+        // PS2X_DEV9 selects the network adapter: unset or "off" = none (the disc's DEV9 driver finds no hardware, as
+        // before; single player never starts the network); "pcsx2" = the external library's DEV9 (PCSX2's, Sockets
+        // adapter) as the IOP's Dev9Device, on interface PS2X_NET_IF ("" = automatic), with PS2X_NET_HOSTS =
+        // "name=a.b.c.d;..." answered by its DNS. An adapter that cannot start leaves it off with one log line.
+#ifdef PS2X_EXTERNAL_GS
+        const char *dev9Env = std::getenv("PS2X_DEV9");
+        const std::string dev9Mode = (dev9Env && *dev9Env) ? dev9Env : "off";
+        if (dev9Mode == "pcsx2")
+        {
+            std::vector<PS2Dev9Host> hosts;
+            const char *hostsEnv = std::getenv("PS2X_NET_HOSTS");
+            std::string list = hostsEnv ? hostsEnv : "";
+            for (size_t start = 0; start < list.size();)
+            {
+                size_t end = list.find(';', start);
+                if (end == std::string::npos)
+                    end = list.size();
+                const std::string entry = list.substr(start, end - start);
+                start = end + 1;
