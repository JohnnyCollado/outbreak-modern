+    void IopMemory::startDev9Dma(Dev9Device &dev9, uint32_t chcr)
+    {
+        // PCSX2 IopDma.cpp psxDma8: the bytes move at the CHCR write; DEV9 ends the transfer itself
+        // (psxDMA8Interrupt, Dev9Device::EventDma8), then MADR points past it and the channel interrupt follows.
+        // A CHCR psxDma8 does not take stays busy with no interrupt, as there.
+        const uint32_t channelBase = kDmaDev9Chcr - 8u; // MADR
+        const uint32_t madr = readHardware32(channelBase) & (RamSize - 1u);
+        const uint32_t bcr = readHardware32(channelBase + 4u);
+        const uint32_t bytes = (bcr >> 16u) * (bcr & 0xFFFFu) * 4u;
+        if (!dev9.dma(m_ram.data(), RamSize, madr, bcr, chcr))
+            return;
+        m_hardware[kDmaDev9Chcr] = chcr & ~kDmaStart;
+        if ((chcr & 1u) == 0u) // DEV9 to IOP RAM
+            markOwned(madr, std::min<uint32_t>(bytes, RamSize - madr));
+        m_dmaStart = DmaStart{kDmaDev9Irq, 0u, channelBase, madr + bytes, true};
+    }
+
     void IopMemory::completeDma(const DmaStart &dma)
     {
         if (dma.channelBase != 0u)
