+    {
+        // External DEV9 device (network adapter): the 0x1000xxxx page at every width and the revision register
+        // (8/16-bit) go to it unsplit, DMA 8 hands it the transfer and waits for its DMA event, and the emulator runs
+        // it with its clock, ending the transfer on EventDma8.
+        struct FakeDev9 final : ps2x::iop::Dev9Device
+        {
+            std::vector<std::pair<uint32_t, int>> reads, writes; // (phys, width in bits)
+            uint32_t dmaMadr = 0u, dmaBcr = 0u, dmaChcr = 0u;
+            uint64_t advances = 0u, lastAdvance = 0u;
+            uint32_t pending = 0u;
+            uint8_t read8(uint32_t phys) override { reads.emplace_back(phys, 8); return 0x32u; }
+            uint16_t read16(uint32_t phys) override { reads.emplace_back(phys, 16); return 0x1234u; }
+            uint32_t read32(uint32_t phys) override { reads.emplace_back(phys, 32); return 0xCAFEF00Du; }
+            void write8(uint32_t phys, uint8_t) override { writes.emplace_back(phys, 8); }
+            void write16(uint32_t phys, uint16_t) override { writes.emplace_back(phys, 16); }
+            void write32(uint32_t phys, uint32_t) override { writes.emplace_back(phys, 32); }
+            bool dma(uint8_t *ram, uint32_t, uint32_t madr, uint32_t bcr, uint32_t chcr) override
+            {
+                dmaMadr = madr;
+                dmaBcr = bcr;
+                dmaChcr = chcr;
+                if ((chcr & 1u) == 0u)
+                    ram[madr] = 0x77u;
+                pending |= EventDma8;
+                return (chcr & 0x01000200u) == 0x01000200u;
+            }
+            void advance(uint64_t cycle) override
+            {
+                ++advances;
+                lastAdvance = cycle;
+            }
+            uint64_t nextEventCycle() override { return lastAdvance + 512u; }
+            uint32_t takeEvents() override { return std::exchange(pending, 0u); }
+        } fake;
+
+        ps2x::iop::setDev9Device(&fake);
+        ps2x::iop::detail::IopMemory memory;
+        const uint32_t fifo = memory.read32(0xB0001200u);   // kseg1 address of a SMAP register
+        const uint16_t half = memory.read16(0x1000002Au);
+        const uint8_t revision = memory.read8(0x1F80146Eu);
+        memory.write32(0x10002008u, 0x8000u);
+        memory.write16(0x10003F00u, 0x8000u);
+        memory.write8(0x1F80146Eu, 1u);
+        const bool unsplit = fifo == 0xCAFEF00Du && half == 0x1234u && revision == 0x32u &&
+                             fake.reads == std::vector<std::pair<uint32_t, int>>{{0x10001200u, 32}, {0x1000002Au, 16}, {0x1F80146Eu, 8}} &&
+                             fake.writes == std::vector<std::pair<uint32_t, int>>{{0x10002008u, 32}, {0x10003F00u, 16}, {0x1F80146Eu, 8}};
+        memory.write32(0x1F801510u, 0x4000u);            // channel 8 MADR
+        memory.write32(0x1F801514u, (3u << 16) | 0x10u); // BCR: 3 blocks of 16 words
+        memory.write32(0x1F801518u, 0x01000200u);        // CHCR: start, DEV9 to RAM
+        const auto dma8 = memory.takeDmaStart();
+        const uint32_t chcrAfter = memory.read32(0x1F801518u);
+        ps2x::iop::setDev9Device(nullptr);
+        if (!expect(unsplit, "DEV9 page and revision register accesses must reach the external device at their width")) return 1;
+        if (!expect(fake.dmaMadr == 0x4000u && fake.dmaBcr == ((3u << 16) | 0x10u) && fake.dmaChcr == 0x01000200u &&
+                        memory.read8(0x4000u) == 0x77u,
+                    "a DMA 8 start must hand the device its RAM address, BCR and CHCR")) return 1;
+        if (!expect(dma8.has_value() && dma8->deviceCompletes && dma8->irq == 0x29 && dma8->endAddress == 0x4000u + 192u &&
+                        (chcrAfter & 0x01000000u) == 0u,
+                    "a DMA 8 transfer must wait for the device and end with the channel 8 interrupt (0x29)")) return 1;
+
+        // The DEV9 driver's way in: dmacman sceSetSliceDMA(8, ...) + sceStartDMA(8), then the IOP's clock.
+        fake.advances = 0u;
+        ps2x::iop::setDev9Device(&fake);
+        writeSio2DriverIrx(host, 0x600u, 8u);
+        const ModuleLoadResult driver = iop.loadModuleBuffer(0x600u);
+        iop.runEeCycles(8u * 4096u);
+        iop.syncEe();
+        ps2x::iop::setDev9Device(nullptr);
+        if (!expect(driver.handled && (driver.startResult >> 4) == 1 && fake.dmaMadr == 0x2000u &&
+                        fake.dmaBcr == ((1u << 16) | 4u) && (fake.dmaChcr & 0x01000201u) == 0x01000201u,
+                    "sceSetSliceDMA + sceStartDMA on channel 8 must start the external DEV9's DMA")) return 1;
+        if (!expect(fake.advances > 0u, "the emulator must run the external DEV9 with its clock")) return 1;
+    }
+
     iop.reset();
     writeVblankSchedulingIrx(host, 0x100u);
     const ModuleLoadResult vblankModule = iop.loadModuleBuffer(0x100u);
