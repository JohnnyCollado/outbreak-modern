diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/Pad2.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/Pad2.cpp
new file mode 100644
index 0000000..1a88349
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/Pad2.cpp
@@ -0,0 +1,211 @@
+#include "Common.h"
+#include "Pad.h"
+#include "Pad2.h"
+
+// libpad2 keeps one "socket" per controller (port, slot) instead of libpad's
+// port/slot pairs. Each socket here maps onto a libpad port opened in
+// DualShock 2 mode, so the host input, the override used by tests and the
+// debug snapshot are shared with libpad.
+//
+// Layout of the data scePad2Read returns (SCE libpad2, DualShock 2 profile):
+//   [0..1]  buttons, active-low, big-endian (SELECT..LEFT, L2..SQUARE)
+//   [2..5]  right stick x/y, left stick x/y
+//   [6..17] button pressures, same order as libpad
+// That is libpad's scePadRead buffer from byte 2 on.
+namespace ps2_stubs
+{
+    namespace
+    {
+        constexpr size_t kPad2SocketCount = 4;
+        constexpr size_t kPad2DataSize = 32;
+        constexpr int32_t kPad2StateConnected = 1;
+        constexpr int32_t kPad2StateDisconnected = 0;
+        constexpr int32_t kPad2DualShock2DataLength = 18;
+        constexpr int32_t kPad2Error = -1;
+
+        // scePad2SocketParam
+        constexpr uint32_t kPad2ParamPortOffset = 4;
+        constexpr uint32_t kPad2ParamSlotOffset = 8;
+
+        struct Pad2Socket
+        {
+            bool open = false;
+            int port = 0;
+            int slot = 0;
+        };
+
+        std::mutex g_pad2Mutex;
+        bool g_pad2Initialised = false;
+        Pad2Socket g_pad2Sockets[kPad2SocketCount]{};
+
+        Pad2Socket *lookupSocketLocked(uint32_t socket)
+        {
+            if (socket >= kPad2SocketCount)
+            {
+                return nullptr;
+            }
+            return &g_pad2Sockets[socket];
+        }
+    }
+
+    void sceDbcInit(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)rdram;
+        (void)runtime;
+        setReturnS32(ctx, 1);
+    }
+
+    void sceDbcEnd(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)rdram;
+        (void)runtime;
+        setReturnS32(ctx, 1);
+    }
+
+    void scePad2Init(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)rdram;
+        (void)runtime;
+        std::lock_guard<std::mutex> lock(g_pad2Mutex);
+        g_pad2Initialised = true;
+        for (auto &socket : g_pad2Sockets)
+        {
+            socket = Pad2Socket{};
+        }
+        setReturnS32(ctx, 1);
+    }
+
+    void scePad2End(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)rdram;
+        (void)runtime;
+        std::lock_guard<std::mutex> lock(g_pad2Mutex);
+        for (auto &socket : g_pad2Sockets)
+        {
+            if (socket.open)
+            {
+                padClosePortForPad2(socket.port, socket.slot);
+            }
+            socket = Pad2Socket{};
+        }
+        g_pad2Initialised = false;
+        setReturnS32(ctx, 1);
+    }
+
+    // s32 scePad2CreateSocket(scePad2SocketParam *param, void *buffer)
+    // Returns the socket number, or a negative value.
+    void scePad2CreateSocket(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)runtime;
+        const uint32_t paramAddr = getRegU32(ctx, 4);
+        const uint8_t *param = getMemPtr(rdram, paramAddr);
+        std::lock_guard<std::mutex> lock(g_pad2Mutex);
+        if (!g_pad2Initialised || !param)
+        {
+            setReturnS32(ctx, kPad2Error);
+            return;
+        }
+
+        uint32_t port32 = 0u;
+        uint32_t slot32 = 0u;
+        std::memcpy(&port32, param + kPad2ParamPortOffset, sizeof(port32));
+        std::memcpy(&slot32, param + kPad2ParamSlotOffset, sizeof(slot32));
+        const int port = static_cast<int>(port32);
+        const int slot = static_cast<int>(slot32);
+
+        for (size_t i = 0; i < kPad2SocketCount; ++i)
+        {
+            Pad2Socket &socket = g_pad2Sockets[i];
+            if (socket.open)
+            {
+                continue;
+            }
+            if (!padOpenPortForPad2(port, slot))
+            {
+                break;
+            }
+            socket.open = true;
+            socket.port = port;
+            socket.slot = slot;
+            setReturnS32(ctx, static_cast<int32_t>(i));
+            return;
+        }
+
+        setReturnS32(ctx, kPad2Error);
+    }
+
+    void scePad2DeleteSocket(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)rdram;
+        (void)runtime;
+        std::lock_guard<std::mutex> lock(g_pad2Mutex);
+        Pad2Socket *socket = lookupSocketLocked(getRegU32(ctx, 4));
+        if (!socket || !socket->open)
+        {
+            setReturnS32(ctx, kPad2Error);
+            return;
+        }
+        padClosePortForPad2(socket->port, socket->slot);
+        *socket = Pad2Socket{};
+        setReturnS32(ctx, 1);
+    }
+
+    // s32 scePad2GetState(s32 socket): 1 = connected and ready, 0 = not (yet).
+    void scePad2GetState(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)rdram;
+        (void)runtime;
+        std::lock_guard<std::mutex> lock(g_pad2Mutex);
+        const Pad2Socket *socket = lookupSocketLocked(getRegU32(ctx, 4));
+        setReturnS32(ctx, (socket && socket->open) ? kPad2StateConnected : kPad2StateDisconnected);
+    }
+
+    // s32 scePad2Read(s32 socket, u8 *data): the data length, or a negative value.
+    void scePad2Read(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t dataAddr = getRegU32(ctx, 5);
+        uint8_t *data = getMemPtr(rdram, dataAddr);
+        Pad2Socket socket;
+        {
+            std::lock_guard<std::mutex> lock(g_pad2Mutex);
+            const Pad2Socket *shared = lookupSocketLocked(getRegU32(ctx, 4));
+            if (!shared || !shared->open || !data)
+            {
+                setReturnS32(ctx, kPad2Error);
+                return;
+            }
+            socket = *shared;
+        }
+
+        uint8_t padData[kPadDebugDataSize]{};
+        if (!padReadPortForPad2(socket.port, socket.slot, runtime, padData, dataAddr))
+        {
+            setReturnS32(ctx, kPad2Error);
+            return;
+        }
+
+        ps2TraceGuestRangeWrite(rdram, dataAddr, static_cast<uint32_t>(kPad2DataSize), "scePad2Read", ctx);
+        std::memset(data, 0, kPad2DataSize);
+        std::memcpy(data, padData + 2, static_cast<size_t>(kPad2DualShock2DataLength));
+        setReturnS32(ctx, kPad2DualShock2DataLength);
+    }
+
+    // s32 scePad2GetButtonProfile(s32 socket, u8 profile[4])
+    // One bit per button the pad has; a DualShock 2 has them all.
+    void scePad2GetButtonProfile(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)runtime;
+        const uint32_t profileAddr = getRegU32(ctx, 5);
+        uint8_t *profile = getMemPtr(rdram, profileAddr);
+        std::lock_guard<std::mutex> lock(g_pad2Mutex);
+        const Pad2Socket *socket = lookupSocketLocked(getRegU32(ctx, 4));
+        if (!socket || !socket->open || !profile)
+        {
+            setReturnS32(ctx, kPad2Error);
+            return;
+        }
+        ps2TraceGuestRangeWrite(rdram, profileAddr, 4u, "scePad2GetButtonProfile", ctx);
+        std::memset(profile, 0xFF, 4);
+        setReturnS32(ctx, 4);
+    }
+}
diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/Pad2.h b/ps2xRuntime/src/lib/Kernel/Stubs/Pad2.h
new file mode 100644
index 0000000..0693f89
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/Pad2.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include "ps2_stubs.h"
+
+#include <cstdint>
+
+// libpad2 (scePad2*) and libdbc (sceDbc*): the socket-based controller library
+// used by later SCE SDKs. It is served by the same host input as libpad.
+namespace ps2_stubs
+{
+    void sceDbcInit(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
+    void sceDbcEnd(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
+    void scePad2Init(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
+    void scePad2End(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
+    void scePad2CreateSocket(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
+    void scePad2DeleteSocket(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
+    void scePad2GetState(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
+    void scePad2Read(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
+    void scePad2GetButtonProfile(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime);
+}
diff --git a/ps2xTest/src/pad_input_tests.cpp b/ps2xTest/src/pad_input_tests.cpp
index 07f9b7a..0316807 100644
--- a/ps2xTest/src/pad_input_tests.cpp
+++ b/ps2xTest/src/pad_input_tests.cpp
@@ -2,7 +2,9 @@
 #include "ps2_stubs.h"
 #include "ps2_syscalls.h"
 #include "Stubs/Pad.h"
+#include "ps2_runtime_calls.h"
 
+#include <cstring>
 #include <vector>
 #include <cstdint>
 #include <string>
@@ -529,5 +531,74 @@ void register_pad_input_tests()
             const char *reqStr = reinterpret_cast<const char *>(rdram.data() + kPadDataAddr + 64);
             t.IsTrue(std::string(reqStr).find("COMPLETE") != std::string::npos, "req string should include COMPLETE");
         });
+
+        // libpad2: Outbreak (SLPM-65428) opens one socket per port with
+        // scePad2CreateSocket, waits for scePad2GetState == 1, reads the
+        // button profile once and then scePad2Read every frame; a profile with
+        // bits in 0xFFF00000 makes it treat the pad as a DualShock 2 and read
+        // the 12 pressure bytes after the sticks.
+        tc.Run("libpad2: sockets open, connect, and read DualShock 2 data from the host pad", [](TestCase &t)
+               {
+            std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0);
+            R5900Context ctx;
+            constexpr uint32_t kParamAddr = kPadDataAddr + 0x100u;
+            constexpr uint32_t kProfileAddr = kPadDataAddr + 0x140u;
+
+            t.IsTrue(ps2_runtime_calls::isStubName("scePad2Read") && ps2_runtime_calls::isStubName("sceDbcInit"),
+                     "the recompiler must route scePad2*/sceDbc* to the runtime");
+
+            ps2_stubs::sceDbcInit(rdram.data(), &ctx, nullptr);
+            t.Equals(static_cast<uint32_t>(getRegU32(&ctx, 2)), 1u, "sceDbcInit returns 1");
+            setRegU32(ctx, 4, 0u);
+            ps2_stubs::scePad2Init(rdram.data(), &ctx, nullptr);
+            t.Equals(static_cast<uint32_t>(getRegU32(&ctx, 2)), 1u, "scePad2Init returns 1");
+
+            // scePad2SocketParam { number, port, slot, flag }
+            uint32_t param[4] = {0u, 1u, 0u, 2u};
+            std::memcpy(rdram.data() + kParamAddr, param, sizeof(param));
+            setRegU32(ctx, 4, kParamAddr);
+            setRegU32(ctx, 5, kPadDataAddr + 0x400u);
+            ps2_stubs::scePad2CreateSocket(rdram.data(), &ctx, nullptr);
+            const int32_t socket = static_cast<int32_t>(getRegU32(&ctx, 2));
+            t.IsTrue(socket >= 0, "scePad2CreateSocket returns a socket");
+
+            setRegU32(ctx, 4, static_cast<uint32_t>(socket));
+            ps2_stubs::scePad2GetState(rdram.data(), &ctx, nullptr);
+            t.Equals(static_cast<uint32_t>(getRegU32(&ctx, 2)), 1u, "scePad2GetState is 1 (connected)");
+
+            setRegU32(ctx, 4, static_cast<uint32_t>(socket));
+            setRegU32(ctx, 5, kProfileAddr);
+            ps2_stubs::scePad2GetButtonProfile(rdram.data(), &ctx, nullptr);
+            t.IsTrue(static_cast<int32_t>(getRegU32(&ctx, 2)) >= 0, "scePad2GetButtonProfile succeeds");
+            uint32_t profile = 0u;
+            std::memcpy(&profile, rdram.data() + kProfileAddr, sizeof(profile));
+            t.IsTrue((profile & 0xFFF00000u) != 0u, "the profile reports a DualShock 2");
+
+            const uint16_t buttons = static_cast<uint16_t>(0xFFFFu & ~kPadBtnCross & ~kPadBtnLeft);
+            ps2_stubs::setPadOverrideState(buttons, 0x20, 0x30, 0x40, 0x50);
+            setRegU32(ctx, 4, static_cast<uint32_t>(socket));
+            setRegU32(ctx, 5, kPadDataAddr);
+            ps2_stubs::scePad2Read(rdram.data(), &ctx, nullptr);
+            t.IsTrue(static_cast<int32_t>(getRegU32(&ctx, 2)) >= 0, "scePad2Read succeeds");
+            const uint8_t *d = rdram.data() + kPadDataAddr;
+            const uint16_t guestButtons = static_cast<uint16_t>((d[0] << 8) | d[1]);
+            t.Equals(guestButtons, static_cast<uint16_t>((buttons & 0xFFu) << 8 | (buttons >> 8)),
+                     "buttons are the libpad bytes in order (SELECT..LEFT, then L2..SQUARE), active-low");
+            t.Equals(d[2], static_cast<uint8_t>(0x40), "d[2] is the right stick x");
+            t.Equals(d[3], static_cast<uint8_t>(0x50), "d[3] is the right stick y");
+            t.Equals(d[4], static_cast<uint8_t>(0x20), "d[4] is the left stick x");
+            t.Equals(d[5], static_cast<uint8_t>(0x30), "d[5] is the left stick y");
+            t.Equals(d[6 + 1], static_cast<uint8_t>(0xFF), "pressure byte 1 (left) is full when LEFT is held");
+            t.Equals(d[6 + 6], static_cast<uint8_t>(0xFF), "pressure byte 6 (cross) is full when CROSS is held");
+            t.Equals(d[6 + 5], static_cast<uint8_t>(0x00), "pressure byte 5 (circle) is zero when released");
+            ps2_stubs::clearPadOverrideState();
+
+            setRegU32(ctx, 4, static_cast<uint32_t>(socket));
+            ps2_stubs::scePad2DeleteSocket(rdram.data(), &ctx, nullptr);
+            setRegU32(ctx, 4, static_cast<uint32_t>(socket));
+            ps2_stubs::scePad2GetState(rdram.data(), &ctx, nullptr);
+            t.Equals(static_cast<uint32_t>(getRegU32(&ctx, 2)), 0u, "a deleted socket is disconnected");
+            ps2_stubs::scePad2End(rdram.data(), &ctx, nullptr);
+        });
     });
 }
