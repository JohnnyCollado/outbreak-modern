@@ -6,15 +6,76 @@
 #include "ps2_runtime_macros.h"
 #include "Stubs/DMA.h"
 #include "Stubs/GS.h"
+#include "runtime/ps2_ipu_external.h"
 
 #include <algorithm>
 #include <cstdint>
 #include <cstdio>
 #include <cstring>
+#include <string>
 #include <vector>
 
 namespace
 {
+    // Records what PS2Memory hands an external IPU (patch 0060) and reports the events a test asks for.
+    class FakeIpu final : public ps2x::IpuDevice
+    {
+    public:
+        std::vector<std::string> log;
+        uint32_t quadIn[4] = {};
+        bool dmacEnabled = false, dmacSuspended = true;
+        uint64_t lastCycle = 0u, next = UINT64_MAX, nowCycle = 0u; // nowCycle: the clock at the last DMAC update
+        uint32_t pending = 0u;
+
+        uint32_t read32(uint32_t address, uint64_t cycle) override
+        {
+            lastCycle = cycle;
+            log.push_back("r" + std::to_string(address & 0xFFFFu));
+            return 0xC0DE0000u | (address & 0xFFu);
+        }
+        void write32(uint32_t address, uint32_t value, uint64_t cycle) override
+        {
+            lastCycle = cycle;
+            log.push_back("w" + std::to_string(address & 0xFFFFu) + "=" + std::to_string(value));
+        }
+        void fifoRead(uint32_t quad[4], uint64_t) override
+        {
+            for (uint32_t i = 0; i < 4; ++i)
+                quad[i] = 0x11110000u + i;
+            log.push_back("fifo-out");
+        }
+        void fifoWrite(const uint32_t quad[4], uint64_t) override
+        {
+            std::memcpy(quadIn, quad, sizeof(quadIn));
+            log.push_back("fifo-in");
+        }
+        uint32_t dmaRead(uint32_t address) override { return 0xD0000000u | (address & 0xFFFFu); }
+        void dmaWrite(uint32_t address, uint32_t value, uint64_t) override
+        {
+            log.push_back("d" + std::to_string(address & 0xFFFFu) + "=" + std::to_string(value));
+        }
+        void dmacState(bool enabled, bool suspended, uint64_t cycle) override
+        {
+            nowCycle = cycle;
+            dmacEnabled = enabled;
+            dmacSuspended = suspended;
+        }
+        void advance(uint64_t cycle) override
+        {
+            lastCycle = cycle;
+            if (cycle >= next)
+                next = UINT64_MAX;
+        }
+        uint64_t nextEvent() override { return next; }
+        uint32_t takeEvents() override
+        {
+            const uint32_t e = next == UINT64_MAX ? pending : 0u;
+            if (e)
+                pending = 0u;
+            return e;
+        }
+    };
+
     uint32_t makeVifCmd(uint8_t opcode, uint8_t num, uint16_t imm)
     {
         return (static_cast<uint32_t>(opcode) << 24) |
@@ -2505,5 +2566,67 @@ void register_ps2_memory_tests()
             t.IsTrue(threwRead32, "unaligned read32 should throw");
