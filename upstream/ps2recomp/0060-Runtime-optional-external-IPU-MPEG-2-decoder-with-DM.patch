+
+        tc.Run("an external IPU gets its registers, FIFOs, channels 3/4 and DMAC state, and its events raise interrupts", [](TestCase &t)
+        {
+            // Patch 0060: Resident Evil Outbreak's movies run Sony's libmpeg/libipu on the IPU, fed and drained by
+            // DMA channels 4 and 3; without an IPU the channel starts were ignored and no picture was decoded.
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            FakeIpu ipu;
+            ps2x::setIpuDevice(&ipu);
+            t.IsTrue(ipu.dmacEnabled && !ipu.dmacSuspended, "installing the IPU tells it the DMAC runs");
+            if (!ipu.dmacEnabled)
+            {
+                // Not installed: the accesses below would take the old register/DMA paths instead.
+                ps2x::setIpuDevice(nullptr);
+                return;
+            }
+
+            mem.write32(0x10002010u, 0x40000000u); // IPU_CTRL reset
+            mem.write64(0x10002000u, 0x2C010000ull); // IPU_CMD as a 64-bit store: the high half is not a command
+            t.Equals(mem.read32(0x10002010u), 0xC0DE0010u, "IPU_CTRL reads come from the IPU");
+            t.Equals(mem.read64(0x10002000u), 0xC0DE0004C0DE0000ull, "64-bit IPU_CMD reads (libipu's ld) come from the IPU");
+            const bool regs = ipu.log.size() >= 5 && ipu.log[0] == "w8208=1073741824" && ipu.log[1] == "w8192=738263040" &&
+                              ipu.log[2] == "r8208" && ipu.log[3] == "r8192" && ipu.log[4] == "r8196";
+            t.IsTrue(regs, "IPU_CTRL and IPU_CMD writes reach the IPU once each, then the reads, in order");
+
+            alignas(16) uint32_t quad[4] = {1u, 2u, 3u, 4u};
+            mem.write128(0x10007010u, _mm_load_si128(reinterpret_cast<const __m128i *>(quad)));
+            t.IsTrue(ipu.quadIn[0] == 1u && ipu.quadIn[3] == 4u && ipu.log.back() == "fifo-in",
+                     "a 128-bit store to IPU_in is one quadword into the IPU");
+            alignas(16) uint32_t out[4] = {};
+            _mm_store_si128(reinterpret_cast<__m128i *>(out), mem.read128(0x10007000u));
+            t.IsTrue(out[0] == 0x11110000u && out[3] == 0x11110003u, "a 128-bit load from IPU_out is one quadword from the IPU");
+
+            mem.write32(0x1000B410u, 0x1000u);  // D4_MADR
+            mem.write32(0x1000B400u, 0x101u);   // D4_CHCR: start
+            mem.write32(0x1000B000u, 0x100u);   // D3_CHCR: start
+            t.IsTrue(ipu.log.back() == "d45056=256" && ipu.log[ipu.log.size() - 2] == "d46080=257",
+                     "channel 3/4 register writes, starts included, reach the IPU");
+            t.Equals(mem.read32(0x1000B420u), 0xD000B420u, "channel 4 reads come from the IPU");
+            mem.write32(0x1000F590u, 0x10000u); // D_ENABLEW: suspend
+            t.IsTrue(ipu.dmacSuspended, "a DMAC suspend is mirrored to the IPU");
+            mem.write32(0x1000F590u, 0u);
+            mem.write32(0x1000E000u, 0u);       // D_CTRL: DMAE off
+            t.IsTrue(!ipu.dmacEnabled && !ipu.dmacSuspended, "resume and DMAE are mirrored to the IPU");
+            mem.write32(0x1000E000u, 1u);
+
+            mem.consumeCompletedDmacCauses();
+            ipu.next = ipu.nowCycle + 5000u; // the IPU clock is the EE cycles PS2Memory has counted so far
+            ipu.pending = ps2x::IpuDevice::EventIntc | ps2x::IpuDevice::EventDma3 | ps2x::IpuDevice::EventDma4;
+            mem.write32(0x10002010u, 0u); // any IPU access refreshes the next event
+            t.IsTrue(mem.cyclesUntilNextEeTimerInterrupt() <= 5000u, "the IPU's next event bounds the idle wait");
+            uint32_t raised = mem.advanceEeTimers(1000u);
+            t.Equals(raised & ((1u << 8) | (1u << 31)), 0u, "nothing is raised before the IPU's event");
+            raised = mem.advanceEeTimers(4000u);
+            t.Equals(raised & (1u << 8), 1u << 8, "the IPU interrupt comes back as INTC cause 8");
+            t.Equals(raised & (1u << 31), 1u << 31, "a channel 3/4 end asks for its DMAC handlers");
+            t.Equals(mem.readIORegister(0x1000E010u) & 0x18u, 0x18u, "D_STAT bits 3 and 4 are set");
+            const std::vector<uint32_t> causes = mem.consumeCompletedDmacCauses();
+            t.IsTrue(causes.size() == 2u && causes[0] == 3u && causes[1] == 4u, "DMAC causes 3 and 4 are queued");
+            ps2x::setIpuDevice(nullptr);
+        });
+
     });
