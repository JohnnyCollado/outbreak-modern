 #include <vector>
 
 #include "runtime/ps2_vu1_external.h"
+#include "runtime/ps2_ipu_external.h"
 
 namespace
 {
+    // External IPU (ps2_ipu_external.h). File-local so ps2_memory.h (seen by generated code) is unchanged. Its clock is
+    // the EE cycle count advanceEeTimers accumulates; the next event is cached after every call into the device.
+    struct ExternalIpu
+    {
+        ps2x::IpuDevice *device = nullptr;
+        uint64_t cycle = 0u;
+        uint64_t nextEvent = std::numeric_limits<uint64_t>::max();
+        uint32_t fifoIn[4] = {};  // 0x10007010-0x1000701C written as words: the quadword goes in with the last
+        uint32_t fifoOut[4] = {}; // 0x10007000 read as words: the first read pulls the quadword
+        bool fifoOutValid = false;
+    };
+
+    ExternalIpu &externalIpu()
+    {
+        static ExternalIpu ipu;
+        return ipu;
+    }
+
+    void refreshIpuNextEvent()
+    {
+        ExternalIpu &ipu = externalIpu();
+        ipu.nextEvent = ipu.device ? ipu.device->nextEvent() : std::numeric_limits<uint64_t>::max();
+    }
+
+    bool isIpuAddress(uint32_t address)
+    {
+        return (address >= 0x10002000u && address < 0x10002040u) || (address >= 0x10007000u && address < 0x10007020u) ||
+               (address >= 0x1000B000u && address < 0x1000B100u) || (address >= 0x1000B400u && address < 0x1000B500u);
+    }
+
     // VU1 memories an external VU1 backend handed PS2Memory (ps2_vu1_external.h vu1Memory): the backend
     // owns them, so PS2Memory never delete[]s them. File-local so ps2_memory.h (seen by generated code) is unchanged.
     std::vector<const uint8_t *> &externalVu1Buffers()
@@ -457,12 +488,55 @@ void PS2Memory::resetEeTimers() noexcept
     m_eeTimers = {};
 }
 
+void ps2x::setIpuDevice(IpuDevice *device)
+{
+    ExternalIpu &ipu = externalIpu();
+    ipu.device = device;
+    ipu.fifoOutValid = false;
+    if (device)
+        device->dmacState(true, false, ipu.cycle);
+    refreshIpuNextEvent();
+}
+
+ps2x::IpuDevice *ps2x::ipuDevice()
+{
+    return externalIpu().device;
+}
+
 uint32_t PS2Memory::advanceEeTimers(uint64_t eeCycles) noexcept
 {
     if (eeCycles == 0u)
     {
         return 0u;
     }
+    uint32_t ipuInterrupt = 0u;
+    ExternalIpu &ipu = externalIpu();
+    ipu.cycle += eeCycles;
+    if (ipu.device && ipu.cycle >= ipu.nextEvent)
+    {
+        // Events the IPU reports: INTC cause 8 (returned with the timer causes) and the end of channel 3/4, which
+        // sets D_STAT 3/4 (CIS as the GIF path does) and queues the channel's DMAC handlers.
+        ipu.device->advance(ipu.cycle);
+        refreshIpuNextEvent();
+        const uint32_t events = ipu.device->takeEvents();
+        if (events & ps2x::IpuDevice::EventIntc)
+            ipuInterrupt = 1u << 8;
+        for (const uint32_t channel : {3u, 4u})
+        {
+            if ((events & (channel == 3u ? ps2x::IpuDevice::EventDma3 : ps2x::IpuDevice::EventDma4)) == 0u)
+                continue;
+            constexpr uint32_t kDStat = 0x1000E010u;
+            uint32_t dstat = m_ioRegisters.count(kDStat) ? m_ioRegisters[kDStat] : 0u;
+            dstat |= 1u << channel;
+            if (((dstat & 0x3FFu) & ((dstat >> 16u) & 0x3FFu)) != 0u)
+                dstat |= 1u << 31u;
+            else
+                dstat &= ~(1u << 31u);
+            m_ioRegisters[kDStat] = dstat;
+            queueCompletedDmacCause(channel);
+            ipuInterrupt |= 1u << 31; // tells the scheduler to drain the queued DMAC handlers
+        }
+    }
 
     constexpr uint32_t kGifStat = 0x10003020u;
     constexpr uint32_t kGifFqcMask = 0x1F000000u;
@@ -530,12 +604,17 @@ uint32_t PS2Memory::advanceEeTimers(uint64_t eeCycles) noexcept
             interruptMask |= 1u << index;
         }
     }
-    return interruptMask;
+    return interruptMask | ipuInterrupt;
 }
 
 uint64_t PS2Memory::cyclesUntilNextEeTimerInterrupt() const noexcept
 {
     uint64_t nearest = std::numeric_limits<uint64_t>::max();
+    // The external IPU's next event counts as a timer deadline, so an idle EE (every thread waiting on its DMAC
+    // handler) still reaches it.
+    const ExternalIpu &ipu = externalIpu();
+    if (ipu.device && ipu.nextEvent != std::numeric_limits<uint64_t>::max())
+        nearest = ipu.nextEvent > ipu.cycle ? ipu.nextEvent - ipu.cycle : 1u;
     for (const EeTimer &timer : m_eeTimers)
     {
         if ((timer.mode & kEeTimerModeCue) == 0u)
@@ -876,6 +955,9 @@ uint64_t PS2Memory::read64(uint32_t address)
     // to avoid any side-effects from read32 handlers.
     if (isIoRegister(address))
     {
+        // The external IPU's registers read through it (libipu reads IPU_CMD and IPU_TOP with ld).
+        if (externalIpu().device && isIpuAddress(address))
+            return static_cast<uint64_t>(readIORegister(address)) | (static_cast<uint64_t>(readIORegister(address + 4u)) << 32);
         uint32_t lo = m_ioRegisters.count(address) ? m_ioRegisters[address] : 0u;
         uint32_t hi = m_ioRegisters.count(address + 4) ? m_ioRegisters[address + 4] : 0u;
         return static_cast<uint64_t>(lo) | (static_cast<uint64_t>(hi) << 32);
@@ -911,6 +993,15 @@ __m128i PS2Memory::read128(uint32_t address)
         return _mm_loadu_si128(reinterpret_cast<const __m128i *>(vuMem + vuOffset));
     }
 
+    if (ExternalIpu &ipu = externalIpu(); ipu.device && physAddr == 0x10007000u)
+    {
+        // IPU_out: one quadword (ps2_ipu_external.h).
+        alignas(16) uint32_t quad[4] = {};
+        ipu.device->fifoRead(quad, ipu.cycle);
+        refreshIpuNextEvent();
+        return _mm_load_si128(reinterpret_cast<const __m128i *>(quad));
+    }
+
     // 128-bit reads are primarily for quad-word loads in the EE, which are only valid for RAM areas
     // Return zeroes for unsupported areas
     return _mm_setzero_si128();
@@ -1179,6 +1270,41 @@ void PS2Memory::write128(uint32_t address, __m128i value)
 
 bool PS2Memory::writeIORegister(uint32_t address, uint32_t value)
 {
+    if (ExternalIpu &ipu = externalIpu(); ipu.device)
+    {
+        // External IPU (ps2_ipu_external.h): its registers, FIFOs and channels 3/4 go to it; the DMAC master enable
+        // and suspend are mirrored to it and then stored as usual.
+        if (isIpuAddress(address))
+        {
+            if (address >= 0x10007000u && address < 0x10007020u)
+            {
+                if (address >= 0x10007010u)
+                {
+                    ipu.fifoIn[(address >> 2) & 3u] = value;
+                    if ((address & 0xFu) == 0xCu)
+                        ipu.device->fifoWrite(ipu.fifoIn, ipu.cycle);
+                }
+            }
+            else if (address < 0x10002040u)
+            {
+                if ((address & 0xFu) == 0u) // CMD, CTRL (the 64-bit halves, BP and TOP are read-only)
+                    ipu.device->write32(address, value, ipu.cycle);
+            }
+            else
+            {
+                ipu.device->dmaWrite(address, value, ipu.cycle);
+            }
+            refreshIpuNextEvent();
+            return true;
+        }
+        if (address == 0x1000E000u || address == 0x1000F590u)
+        {
+            const uint32_t dctrl = address == 0x1000E000u ? value : (m_ioRegisters.count(0x1000E000u) ? m_ioRegisters[0x1000E000u] : 1u);
+            const uint32_t enablew = address == 0x1000F590u ? value : (m_ioRegisters.count(0x1000F590u) ? m_ioRegisters[0x1000F590u] : 0u);
+            ipu.device->dmacState((dctrl & 1u) != 0u, (enablew & 0x10000u) != 0u, ipu.cycle);
+            refreshIpuNextEvent();
+        }
+    }
     size_t timerIndex = 0u;
     uint32_t timerOffset = 0u;
     if (decodeEeTimerRegister(address, timerIndex, timerOffset))
@@ -2366,6 +2492,36 @@ int PS2Memory::pollDmaRegisters()
 
 uint32_t PS2Memory::readIORegister(uint32_t address)
 {
+    if (ExternalIpu &ipu = externalIpu(); ipu.device && isIpuAddress(address))
+    {
+        uint32_t value = 0u;
+        if (address >= 0x10007000u && address < 0x10007020u)
+        {
+            if (address < 0x10007010u)
+            {
+                // IPU_out read as words: the first word pulls one quadword, the next three return the rest.
+                const uint32_t word = (address >> 2) & 3u;
+                if (word == 0u || !ipu.fifoOutValid)
+                {
+                    ipu.device->fifoRead(ipu.fifoOut, ipu.cycle);
+                    ipu.fifoOutValid = true;
+                }
+                value = ipu.fifoOut[word];
+                if (word == 3u)
+                    ipu.fifoOutValid = false;
+            }
+        }
+        else if (address < 0x10002040u)
+        {
+            value = ipu.device->read32(address, ipu.cycle);
+        }
+        else
+        {
+            value = ipu.device->dmaRead(address);
+        }
+        refreshIpuNextEvent();
+        return value;
+    }
     size_t timerIndex = 0u;
     uint32_t timerOffset = 0u;
     if (decodeEeTimerRegister(address, timerIndex, timerOffset))
