diff --git a/ps2xRuntime/include/runtime/ps2_ipu_external.h b/ps2xRuntime/include/runtime/ps2_ipu_external.h
new file mode 100644
index 0000000..b76a73a
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_ipu_external.h
@@ -0,0 +1,47 @@
+#ifndef PS2_IPU_EXTERNAL_H
+#define PS2_IPU_EXTERNAL_H
+
+#include <cstdint>
+
+// Optional external IPU (the EE's MPEG-2 decoder) with its DMA channels 3 (fromIPU) and 4 (toIPU), from the same
+// external library as the GS (PS2X_EXTERNAL_GS_DIR). PS2X_IPU = pcsx2 (the default when built) | off. When one is
+// installed, PS2Memory hands it every access to the IPU registers (0x10002000-0x1000203F), the FIFOs (0x10007000 out,
+// 0x10007010 in; 128-bit, or as four 32-bit words) and the channel 3/4 registers (0x1000B000-0x1000B0FF,
+// 0x1000B400-0x1000B4FF), tells it D_CTRL.DMAE and the D_ENABLEW suspend bit, advances it with the EE cycle count
+// (PS2Memory::advanceEeTimers) and raises what it reports: INTC cause 8 and D_STAT 3/4 with their DMAC handlers.
+// Without one, those addresses stay plain register storage (no decoding, channel starts ignored).
+namespace ps2x
+{
+    class IpuDevice
+    {
+    public:
+        enum : uint32_t
+        {
+            EventIntc = 1, // INTC cause 8 (IPU)
+            EventDma3 = 2, // channel 3 finished: D_STAT bit 3
+            EventDma4 = 4, // channel 4 finished: D_STAT bit 4
+        };
+
+        virtual ~IpuDevice() = default;
+        virtual uint32_t read32(uint32_t address, uint64_t cycle) = 0;
+        virtual void write32(uint32_t address, uint32_t value, uint64_t cycle) = 0;
+        virtual void fifoRead(uint32_t quad[4], uint64_t cycle) = 0;
+        virtual void fifoWrite(const uint32_t quad[4], uint64_t cycle) = 0;
+        virtual uint32_t dmaRead(uint32_t address) = 0;
+        virtual void dmaWrite(uint32_t address, uint32_t value, uint64_t cycle) = 0;
+        virtual void dmacState(bool enabled, bool suspended, uint64_t cycle) = 0;
+        virtual void advance(uint64_t cycle) = 0;
+        virtual uint64_t nextEvent() = 0; // UINT64_MAX: none
+        virtual uint32_t takeEvents() = 0; // Event* bits since the last call
+    };
+
+    // Installs (or with null removes) the device PS2Memory routes to; the caller keeps ownership.
+    void setIpuDevice(IpuDevice *device);
+    IpuDevice *ipuDevice();
+}
+
+#ifdef PS2X_EXTERNAL_GS
+ps2x::IpuDevice *ps2CreateExternalIpu(uint8_t *rdram, uint32_t ramSize, uint8_t *scratchpad, uint32_t scratchpadSize); // null = failure
+#endif
+
+#endif
