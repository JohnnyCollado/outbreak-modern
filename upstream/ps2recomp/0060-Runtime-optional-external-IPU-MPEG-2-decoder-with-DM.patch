index 4e88ede..ff19f9a 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -1777,6 +1777,16 @@ void EeScheduler::processPendingEvents()
             dispatchIrq(false, 9u + timer);
         }
     }
+    // The external IPU (ps2_ipu_external.h) reports through advanceEeTimers too: bit 8 = INTC cause 8, bit 31 = its
+    // DMA channel 3/4 ended (D_STAT set, causes queued), whose DMAC handlers no guest store drains on its own.
+    if ((timerInterrupts & (1u << 8)) != 0u)
+    {
+        dispatchIrq(false, 8u);
+    }
+    if ((timerInterrupts & (1u << 31)) != 0u)
+    {
+        m_runtime.drainCompletedDmacHandlers(m_rdram);
+    }
     std::deque<EeEvent> pending;
     {
         std::lock_guard lock(m_eventMutex);
