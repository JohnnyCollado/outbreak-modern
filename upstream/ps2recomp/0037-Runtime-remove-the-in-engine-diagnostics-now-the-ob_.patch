@@ -1,131 +0,0 @@
-#ifndef PS2_INPUT_SCRIPT_H
-#define PS2_INPUT_SCRIPT_H
-
-#include <atomic>
-#include <cstdint>
-#include <functional>
-#include <mutex>
-#include <ostream>
-#include <string>
-#include <vector>
-
-// Scripted pad input (PS2X_INPUT_SCRIPT=<file>). One step per line, '#' comments, numbers dec or 0x:
-//   timeout <secs>                        header, whole-script wall clock (default 600)
-//   wait vsync <n>
-//   wait mem <ref> <1|2|4> <==|!=> <value>  ref = <addr> or *<ptraddr>+<off> (null pointer = not satisfied)
-//   press <btn[+btn..]> <held vsyncs>       then released for 1 vsync before the next step
-//   capture <screen> <n>                  completes after n frames dumped as <screen>-<k>.png
-//   watch <ref> <1|2|4>                   non-blocking; logs every change for the rest of the run
-//   log <text>
-//   quit
-// Threads: onVSync (vsync thread) steps; buttons() (game thread) reads; takeCapture/commitCapture and
-// timedOut (main thread). No raylib dependency.
-class Ps2InputScript
-{
-public:
-    enum class Op
-    {
-        WaitVsync,
-        WaitMem,
-        Press,
-        Capture,
-        Watch,
-        Log,
-        Quit
-    };
-
-    struct MemRef
-    {
-        uint32_t addr = 0;
-        bool deref = false;
-        uint32_t offset = 0;
-    };
-
-    struct Step
-    {
-        Op op = Op::Log;
-        int line = 0;
-        std::string text;
-        MemRef ref;
-        uint32_t width = 4;
-        bool equal = true;
-        uint32_t value = 0;
-        uint16_t mask = 0;     // press: pressed buttons (bits of the active-low pad word)
-        uint32_t count = 0;    // wait vsync n, press held vsyncs, capture n
-        std::string name;      // capture screen, log text
-    };
-
-    // Reads <width> bytes of guest memory at a guest address; false when out of range.
-    using ReadMem = std::function<bool(uint32_t addr, uint32_t width, uint32_t &out)>;
-
-    // Parses a whole script; on failure returns false with "line <L>: <reason>" in error.
-    bool parse(const std::string &text, std::string &error);
-    bool loadFile(const std::string &path, std::string &error);
-
-    const std::vector<Step> &steps() const { return m_steps; }
-    double timeoutSeconds() const { return m_timeoutSeconds; }
-    bool hasCaptureSteps() const;
-
-    // Vsync thread: advance the script at guest vsync <tick>.
-    void onVSync(uint64_t tick, const ReadMem &read, std::ostream &log);
-
-    // Game thread: active-low pad button word (0xFFFF = nothing held).
-    uint16_t buttons() const { return m_buttons.load(std::memory_order_acquire); }
-    bool quitRequested() const { return m_quit.load(std::memory_order_acquire); }
-
-    // Main thread: when a capture step is active and <latchedTick> is new, reserves frame k and
-    // returns true with the file name "<screen>-<k>.png"; commitCapture(true) counts the frame as
-    // written, commitCapture(false) gives k back for the next tick.
-    // Frames older than the capture step's first tick are refused (an external GS frame can be stale).
-    bool takeCapture(uint64_t latchedTick, std::string &fileName, std::string &screen, uint32_t &k);
-    void commitCapture(bool written);
-    // Any thread: a capture step is active and still needs frames (the external GS snapshot demand).
-    bool captureWanted() const;
-
-    // Main thread: wall-clock timeout, measured from start(). On timeout, message holds
-    // "[script] TIMEOUT step <i> line <L>: <text>".
-    void start(double nowSeconds);
-    bool timedOut(double nowSeconds, std::string &message) const;
-
-    // Main thread, after the run loop ends: 0 once quit was reached; otherwise 4 with message
-    // "[script] game ended before quit at step <i> line <L>: <text>".
-    int loopEndExitCode(std::string &message) const;
-
-private:
-    struct Watch
-    {
-        MemRef ref;
-        uint32_t width = 4;
-        bool valid = false;
-        uint32_t value = 0;
-        std::string label;
-    };
-
-    bool readRef(const MemRef &ref, uint32_t width, const ReadMem &read, uint32_t &out) const;
-    void beginStep(uint64_t tick, const ReadMem &read, std::ostream &log);
-
-    std::vector<Step> m_steps;
-    double m_timeoutSeconds = 600.0;
-    double m_startSeconds = 0.0;
-
-    mutable std::mutex m_mutex;
-    size_t m_index = 0;
-    bool m_begun = false;
-    uint64_t m_stepTick = 0;
-    std::vector<Watch> m_watches;
-    bool m_captureActive = false;
-    uint32_t m_captureTaken = 0;
-    uint32_t m_captureWritten = 0;
-    uint64_t m_lastCaptureTick = 0;
-    uint64_t m_captureStartTick = 0;
-    bool m_hasCaptureTick = false;
-
-    std::atomic<uint16_t> m_buttons{0xFFFFu};
-    std::atomic<bool> m_quit{false};
-};
-
-// The process-wide script (nullptr without PS2X_INPUT_SCRIPT).
-Ps2InputScript *ps2ActiveInputScript();
-void ps2SetActiveInputScript(Ps2InputScript *script);
-
-#endif
diff --git a/ps2xRuntime/include/runtime/ps2_pc_sampler.h b/ps2xRuntime/include/runtime/ps2_pc_sampler.h
deleted file mode 100644
index a6e45c1..0000000
--- a/ps2xRuntime/include/runtime/ps2_pc_sampler.h
+++ /dev/null
@@ -1,92 +0,0 @@
-#pragma once
-
-// PS2X_PC_SAMPLE=<path.csv>: guest PC sampling profiler.
-//
-// When the variable is set, EeScheduler::reset starts a host thread that samples, at ~1 kHz
-// (the host sleep granularity: 1 ms once the process runs with a 1 ms timer, as raylib sets),
-// the pc of the guest context the EE executor is running, the guest thread id, the vsync tick,
-// and which of a few runtime sections the executor is inside (flags below). The aggregate is
-// written as CSV "tick,tid,pc,count,vu1,iop,gs,gsvsync": one row per (tick bucket, thread, pc),
-// tick = first vsync of a kTickBucket-wide bucket, count = samples, the flag columns = how
-// many of those samples had the flag set. pc 0 / tid 0 = the executor was not inside guest
-// code (scheduler, event processing, idle wait). The file is rewritten every ~2 s (via
-// <path>.tmp + rename) and at stop, so a killed run loses at most the last two seconds.
-//
-// Reads of ctx->pc race with the generated code's plain stores; that is accepted for a
-// profiler (a sample may see a stale pc). The read itself goes through std::atomic_ref so it is
-// a real load each time. Unset: no thread; each flag site costs one relaxed bool load.
-
-#include <atomic>
-#include <cstdint>
-#include <memory>
-#include <string>
-
-struct R5900Context;
-
-namespace ps2x::pcsample
-{
-    enum Flag : uint32_t
-    {
-        Vu1 = 0,     // VU1Interpreter::run (VU1 microcode)
-        Iop = 1,     // IOP subsystem calls on the EE executor (RPC, SIF transfer, runEeCycles)
-        Gs = 2,      // PS2ExternalGS::gifPacket from the GIF arbiter (PCSX2 GS)
-        GsVsync = 3, // PS2ExternalGS::vsync + snapshot from the scheduler's VBlankStart (PCSX2 GS)
-        kFlagCount = 4
-    };
-
-    constexpr uint64_t kTickBucket = 64u;
-
-    struct State
-    {
-        std::atomic<bool> enabled{false};
-        std::atomic<R5900Context *> context{nullptr}; // guest context being executed, or null
-        std::atomic<int32_t> threadId{0};
-        std::atomic<const std::atomic<uint64_t> *> tick{nullptr};
-        std::atomic<int32_t> depth[kFlagCount]{};
-    };
-
-    State &state() noexcept;
-
-    // RAII flag: counts nesting, so overlapping scopes of one flag are fine.
-    class Scope
-    {
-    public:
-        explicit Scope(Flag flag) noexcept
-            : m_flag(flag), m_on(state().enabled.load(std::memory_order_relaxed))
-        {
-            if (m_on)
-                state().depth[m_flag].fetch_add(1, std::memory_order_relaxed);
-        }
-        ~Scope()
-        {
-            if (m_on)
-                state().depth[m_flag].fetch_sub(1, std::memory_order_relaxed);
-        }
-        Scope(const Scope &) = delete;
-        Scope &operator=(const Scope &) = delete;
-
-    private:
-        Flag m_flag;
-        bool m_on;
-    };
-
-    class Sampler
-    {
-    public:
-        // Starts the sampling thread writing to path; tickSource is read for the vsync tick.
-        Sampler(std::string path, const std::atomic<uint64_t> *tickSource);
-        ~Sampler(); // stop()
-        void stop(); // joins the thread and writes the final CSV; idempotent
-
-        Sampler(const Sampler &) = delete;
-        Sampler &operator=(const Sampler &) = delete;
-
-        struct Impl;
-
-    private:
-        std::unique_ptr<Impl> m_impl;
-    };
-
-    // Reads PS2X_PC_SAMPLE; returns a running sampler or null when unset/empty.
-    std::unique_ptr<Sampler> startFromEnvironment(const std::atomic<uint64_t> *tickSource);
-}
diff --git a/ps2xRuntime/include/runtime/ps2_vu1_capture.h b/ps2xRuntime/include/runtime/ps2_vu1_capture.h
deleted file mode 100644
index edbf8b9..0000000
--- a/ps2xRuntime/include/runtime/ps2_vu1_capture.h
+++ /dev/null
@@ -1,185 +0,0 @@
-#pragma once
-
-// PS2X_VU1_CAPTURE=<dir>[,N[,K]]: VU1 microprogram capture.
-//
-// When the variable names a directory, every VU1 run started by VIF1 MSCAL/MSCALF/MSCNT
-// (PS2Runtime's two callbacks) is offered to a Recorder. A run is written when
-//   - fewer than N files were written so far (default 200),
-//   - its key (kind, start pc, hash of the 16 KB micro memory) has fewer than K files (default 4),
-//   - no run with the same inputs (key + data memory + VU1 state + TOP/ITOP/FBRST) was written.
-// One file per written run, "<dir>/vu1-<index6>-<pc4>.cap", little-endian:
-//   FileHeader | code[codeBytes] | dataBefore[dataBytes] | StateRecord before |
-//   dataAfter[dataBytes] | StateRecord after | packetCount x { u32 size, size bytes }
-// The packets are every PATH1 packet (XGKICK) the run sent, in order. "<dir>/summary.txt" is
-// rewritten every 4096 runs and at each written file: totals plus one line per key seen
-// (pc, code hash, code generation first seen, runs, interpreter cycles), so the stream of
-// unwritten runs is still accounted for. Unset: no Recorder, the callbacks cost one null check.
-//
-// The PATH1 tap below is also how an offline tool collects the interpreter's packets.
-
-#include <cstdint>
-#include <cstring>
-#include <memory>
-#include <string>
-
-#include "runtime/ps2_vu1.h"
-
-namespace ps2x::vu1capture
-{
-    constexpr char kMagic[8] = {'O', 'B', 'V', 'U', '1', 'C', 'A', 'P'};
-    constexpr uint32_t kVersion = 1u;
-
-    enum Kind : uint32_t
-    {
-        Mscal = 0, // MSCAL / MSCALF: VU1Interpreter::execute(startPC)
-        Mscnt = 1  // MSCNT: VU1Interpreter::resume (continues at state.pc)
-    };
-
-    enum HeaderFlags : uint32_t
-    {
-        FlagBudgetHit = 1u << 0 // the run used its whole cycle budget (program not ended)
-    };
-
-    // VU1State with floats as raw bits and a fixed layout.
-    struct StateRecord
-    {
-        uint32_t vf[32][4];
-        int32_t vi[16];
-        uint32_t acc[4];
-        uint32_t q, p, i, r;
-        uint32_t pc, mac, clip, status;
-        uint64_t cycles;
-        uint8_t ebit, haltAfterDelaySlot, dBitEnabled, tBitEnabled;
-        uint8_t stoppedByD, stoppedByT, branchPending, reserved0;
-        uint32_t top, itop, branchTarget, branchDelay;
-    };
-    static_assert(sizeof(StateRecord) == 512 + 64 + 16 + 16 + 16 + 8 + 8 + 16, "StateRecord layout");
-
-    struct FileHeader
-    {
-        char magic[8];
-        uint32_t version;
-        uint32_t headerBytes;   // sizeof(FileHeader)
-        uint32_t kind;          // Kind
-        uint32_t flags;         // HeaderFlags
-        uint32_t runIndex;      // 0-based count of VU1 runs seen before this one
-        uint32_t startPC;       // MSCAL: byte address passed to execute; MSCNT: state.pc on entry
-        uint32_t top, itop;     // VIF1 TOP/ITOP passed to the run
-        uint32_t fbrst;         // EE-side VU0 FBRST (D enable bit 10, T enable bit 11)
-        uint32_t vpuStatBefore; // EE-side VPU_STAT before / after the callback
-        uint32_t vpuStatAfter;
-        uint32_t maxCycles;     // cycle budget passed to the run
-        uint64_t cyclesRun;     // interpreter cycles the run took (state.cycles after - before)
-        uint64_t codeGeneration;// PS2Memory::getVU1CodeGeneration() at the run
-        uint64_t codeHash;      // hash64 of the 16 KB micro memory
-        uint64_t inputHash;     // dedupe hash of all inputs
-        uint32_t codeBytes, dataBytes, stateBytes, packetCount;
-    };
-    static_assert(sizeof(FileHeader) == 104, "FileHeader layout");
-
-    inline uint32_t floatBits(float f)
-    {
-        uint32_t u;
-        std::memcpy(&u, &f, 4);
-        return u;
-    }
-    inline float bitsFloat(uint32_t u)
-    {
-        float f;
-        std::memcpy(&f, &u, 4);
-        return f;
-    }
-
-    inline StateRecord toRecord(const VU1State &s)
-    {
-        StateRecord r{};
-        for (int reg = 0; reg < 32; ++reg)
-            for (int lane = 0; lane < 4; ++lane)
-                r.vf[reg][lane] = floatBits(s.vf[reg][lane]);
-        for (int k = 0; k < 16; ++k)
-            r.vi[k] = s.vi[k];
-        for (int lane = 0; lane < 4; ++lane)
-            r.acc[lane] = floatBits(s.acc[lane]);
-        r.q = floatBits(s.q);
-        r.p = floatBits(s.p);
-        r.i = floatBits(s.i);
-        r.r = s.r;
-        r.pc = s.pc;
-        r.mac = s.mac;
-        r.clip = s.clip;
-        r.status = s.status;
-        r.cycles = s.cycles;
-        r.ebit = s.ebit;
-        r.haltAfterDelaySlot = s.haltAfterDelaySlot;
-        r.dBitEnabled = s.dBitEnabled;
-        r.tBitEnabled = s.tBitEnabled;
-        r.stoppedByD = s.stoppedByD;
-        r.stoppedByT = s.stoppedByT;
-        r.branchPending = s.branchPending;
-        r.top = s.top;
-        r.itop = s.itop;
-        r.branchTarget = s.branchTarget;
-        r.branchDelay = s.branchDelay;
-        return r;
-    }
-
-    inline void fromRecord(const StateRecord &r, VU1State &s)
-    {
-        for (int reg = 0; reg < 32; ++reg)
-            for (int lane = 0; lane < 4; ++lane)
-                s.vf[reg][lane] = bitsFloat(r.vf[reg][lane]);
-        for (int k = 0; k < 16; ++k)
-            s.vi[k] = r.vi[k];
-        for (int lane = 0; lane < 4; ++lane)
-            s.acc[lane] = bitsFloat(r.acc[lane]);
-        s.q = bitsFloat(r.q);
-        s.p = bitsFloat(r.p);
-        s.i = bitsFloat(r.i);
-        s.r = r.r;
-        s.pc = r.pc;
-        s.mac = r.mac;
-        s.clip = r.clip;
-        s.status = r.status;
-        s.cycles = r.cycles;
-        s.ebit = r.ebit != 0;
-        s.haltAfterDelaySlot = r.haltAfterDelaySlot != 0;
-        s.dBitEnabled = r.dBitEnabled != 0;
-        s.tBitEnabled = r.tBitEnabled != 0;
-        s.stoppedByD = r.stoppedByD != 0;
-        s.stoppedByT = r.stoppedByT != 0;
-        s.branchPending = r.branchPending != 0;
-        s.top = r.top;
