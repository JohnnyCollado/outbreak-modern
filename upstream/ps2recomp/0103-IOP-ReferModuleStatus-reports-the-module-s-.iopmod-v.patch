 .../emulator/services/iop_module_loader.cpp   | 32 +++++++++++++++++++
 .../src/emulator/services/iop_module_loader.h |  3 ++
 ps2xIOP/tests/iop_emulator_tests.cpp          | 26 ++++++++-------
 4 files changed, 52 insertions(+), 12 deletions(-)

