diff --git a/ps2xTest/src/ps2_game_source_tests.cpp b/ps2xTest/src/ps2_game_source_tests.cpp
index 757e5d3..20c19a2 100644
--- a/ps2xTest/src/ps2_game_source_tests.cpp
+++ b/ps2xTest/src/ps2_game_source_tests.cpp
@@ -6,6 +6,7 @@
 #include "ps2_syscalls.h"
 #include "ps2x/iop/iso9660.h"
 #include "runtime/ps2_game_source.h"
+#include "runtime/ps2_path_utf8.h"
 
 #include <chrono>
 #include <cstring>
@@ -154,6 +155,18 @@ void register_ps2_game_source_tests()
 {
     MiniTest::Case("GameSource", [](TestCase &tc)
     {
+        tc.Run("a UTF-8 path keeps every character, as u8path did (patch 0082)", [](TestCase &t)
+        {
+            // "games/Biohazard <e-acute>.iso": two UTF-8 bytes for one character, which the path must keep.
+            const std::filesystem::path p = ps2path::fromUtf8("games/Biohazard \xC3\xA9.iso");
+            t.IsTrue(p.filename().u8string() == std::u8string(u8"Biohazard é.iso"), "the name round-trips to UTF-8");
+            t.IsTrue(p.parent_path().u8string() == std::u8string(u8"games"), "the folder is kept");
+#if defined(_WIN32)
+            t.IsTrue(p.filename().wstring() == std::wstring(L"Biohazard é.iso"), "Windows: one UTF-16 unit for the é");
+#endif
+            t.IsTrue(ps2path::fromUtf8("").empty(), "empty stays empty");
+        });
+
         tc.Run("ISO 9660: directory lookup ignores case, separators, device and ;1", [](TestCase &t)
         {
             TempDir dir;
