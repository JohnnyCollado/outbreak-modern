diff --git a/ps2xRuntime/src/main.cpp b/ps2xRuntime/src/main.cpp
index ce31d73..c28d8af 100644
--- a/ps2xRuntime/src/main.cpp
+++ b/ps2xRuntime/src/main.cpp
@@ -1,4 +1,5 @@
 #include "runtime/ps2_ui_external.h"
+#include "runtime/ps2_path_utf8.h"
 #include <cstring>
 #include "ps2_runtime.h"
 #include "games_database.h"
@@ -151,7 +152,7 @@ namespace
         if (argc >= 2 && argv[1] && argv[1][0] != '\0')
         {
             std::cout << "Using argv boot path" << std::endl;
-            return std::filesystem::u8path(argv[1]);
