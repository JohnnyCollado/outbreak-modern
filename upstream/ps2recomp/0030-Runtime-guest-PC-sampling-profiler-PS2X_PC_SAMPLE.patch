+
+    // PS2X_PC_SAMPLE: the guest spins for kPcSampleSpinMs with ctx->pc at kPcSampleLoopPc, then stops.
+    constexpr uint32_t kPcSampleEntryPc = 0x00171000u;
+    constexpr uint32_t kPcSampleLoopPc = 0x00171010u;
+    constexpr int kPcSampleSpinMs = 400;
+
+    void pcSampleSpin(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const auto end = std::chrono::steady_clock::now() + std::chrono::milliseconds(kPcSampleSpinMs);
+        while (std::chrono::steady_clock::now() < end)
+            ctx->pc = kPcSampleLoopPc;
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+
+    void setPcSampleEnv(const char *value)
+    {
+#ifdef _MSC_VER
+        _putenv_s("PS2X_PC_SAMPLE", value);
+#else
+        if (value && *value)
+            setenv("PS2X_PC_SAMPLE", value, 1);
+        else
+            unsetenv("PS2X_PC_SAMPLE");
+#endif
+    }
 }
 
 void register_ps2_gs_external_tests()
@@ -548,5 +575,64 @@ void register_ps2_gs_external_tests()
                      "an idle guest is busy for under a quarter of the frame (busy " + std::to_string(busySum) +
                          " us of wall " + std::to_string(wallSum) + " us)");
         });
+
+        tc.Run("PS2X_PC_SAMPLE writes a pc histogram whose top entry is the pc the guest spins on", [](TestCase &t)
+        {
+            const std::filesystem::path path =
+                std::filesystem::temp_directory_path() /
+                ("ps2x-pc-sample-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()) + ".csv");
+            std::error_code ec;
+            std::filesystem::remove(path, ec);
+            const std::string pathStr = path.string();
+            setPcSampleEnv(pathStr.c_str());
+            {
+                std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0u);
+                PS2Runtime runtime;
+                runtime.registerFunction(kPcSampleEntryPc, pcSampleSpin);
+                R5900Context mainContext{};
+                mainContext.pc = kPcSampleEntryPc;
+                runtime.eeScheduler().reset(rdram.data(), mainContext);
+                runtime.eeScheduler().run();
+            }
+            setPcSampleEnv("");
+
+            std::ifstream in(path);
+            t.IsTrue(in.is_open(), "the pc-sample CSV exists");
+            std::string header;
+            std::getline(in, header);
+            t.IsTrue(header == "tick,tid,pc,count,vu1,iop,gs,gsvsync", "header line (got '" + header + "')");
+            std::unordered_map<uint32_t, uint64_t> byPc;
+            uint64_t total = 0u;
+            for (std::string line; std::getline(in, line);)
+            {
+                if (line.empty())
+                    continue;
+                std::vector<std::string> cols;
+                std::stringstream ss(line);
+                for (std::string col; std::getline(ss, col, ',');)
+                    cols.push_back(col);
+                if (cols.size() != 8u)
+                    continue;
+                const uint32_t pc = static_cast<uint32_t>(std::stoul(cols[2], nullptr, 16));
+                const uint64_t count = std::stoull(cols[3]);
+                byPc[pc] += count;
+                total += count;
+            }
+            in.close();
+            std::filesystem::remove(path, ec);
+
+            uint32_t topPc = 0u;
+            uint64_t topCount = 0u;
+            for (const auto &[pc, count] : byPc)
+                if (count > topCount)
+                {
+                    topPc = pc;
+                    topCount = count;
+                }
+            t.IsTrue(total >= 10u, "at least 10 samples over the spin (got " + std::to_string(total) + ")");
+            t.IsTrue(topPc == kPcSampleLoopPc,
+                     "the top pc is the spin pc (top 0x" + [&] { std::ostringstream o; o << std::hex << topPc; return o.str(); }() +
+                         " with " + std::to_string(topCount) + " of " + std::to_string(total) + ")");
+        });
     });
