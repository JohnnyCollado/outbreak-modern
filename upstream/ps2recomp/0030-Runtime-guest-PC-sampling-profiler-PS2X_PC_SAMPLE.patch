diff --git a/ps2xRuntime/src/lib/ps2_pc_sampler.cpp b/ps2xRuntime/src/lib/ps2_pc_sampler.cpp
new file mode 100644
index 0000000..010ae28
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_pc_sampler.cpp
@@ -0,0 +1,142 @@
+#include "runtime/ps2_pc_sampler.h"
+
+#include "ps2_runtime_api.h"
+
+#include <chrono>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <thread>
+#include <tuple>
+
+namespace ps2x::pcsample
+{
+    State &state() noexcept
+    {
+        static State s;
+        return s;
+    }
+
+    struct Sampler::Impl
+    {
+        struct Key
+        {
+            uint64_t tick = 0u;
+            int32_t tid = 0;
+            uint32_t pc = 0u;
+            bool operator<(const Key &o) const
+            {
+                return std::tie(tick, tid, pc) < std::tie(o.tick, o.tid, o.pc);
+            }
+        };
+        struct Counts
+        {
+            uint64_t count = 0u;
+            uint64_t flags[kFlagCount]{};
+        };
+
+        std::string path;
+        std::thread thread;
+        std::atomic<bool> stopRequested{false};
+        bool stopped = false;
+        std::map<Key, Counts> counts; // sampler thread only (the final write runs after join)
+
+        void sampleOnce()
+        {
+            State &st = state();
+            Key key{};
+            const std::atomic<uint64_t> *tick = st.tick.load(std::memory_order_relaxed);
+            if (tick)
+                key.tick = (tick->load(std::memory_order_relaxed) / kTickBucket) * kTickBucket;
+            if (R5900Context *ctx = st.context.load(std::memory_order_acquire))
+            {
+                key.pc = std::atomic_ref<uint32_t>(ctx->pc).load(std::memory_order_relaxed);
+                key.tid = st.threadId.load(std::memory_order_relaxed);
+            }
+            Counts &c = counts[key];
+            ++c.count;
+            for (uint32_t f = 0; f < kFlagCount; ++f)
+                if (st.depth[f].load(std::memory_order_relaxed) > 0)
+                    ++c.flags[f];
+        }
+
+        void write() const
+        {
+            const std::string tmp = path + ".tmp";
+            {
+                std::ofstream out(tmp, std::ios::out | std::ios::trunc);
+                if (!out.is_open())
+                    return;
+                out << "tick,tid,pc,count,vu1,iop,gs,gsvsync\n";
+                for (const auto &[key, c] : counts)
+                {
+                    out << key.tick << ',' << key.tid << ",0x" << std::hex << key.pc << std::dec << ',' << c.count;
+                    for (uint32_t f = 0; f < kFlagCount; ++f)
+                        out << ',' << c.flags[f];
+                    out << '\n';
+                }
+            }
+            std::error_code ec;
+            std::filesystem::rename(tmp, path, ec);
+        }
+
+        void loop()
+        {
+            using clock = std::chrono::steady_clock;
+            auto nextWrite = clock::now() + std::chrono::seconds(2);
+            while (!stopRequested.load(std::memory_order_acquire))
+            {
+                std::this_thread::sleep_for(std::chrono::milliseconds(1));
+                sampleOnce();
+                if (clock::now() >= nextWrite)
+                {
+                    write();
+                    nextWrite = clock::now() + std::chrono::seconds(2);
+                }
+            }
+        }
+    };
+
+    Sampler::Sampler(std::string path, const std::atomic<uint64_t> *tickSource)
+        : m_impl(std::make_unique<Impl>())
+    {
+        m_impl->path = std::move(path);
+        State &st = state();
+        st.context.store(nullptr, std::memory_order_relaxed);
+        st.threadId.store(0, std::memory_order_relaxed);
+        st.tick.store(tickSource, std::memory_order_relaxed);
+        for (auto &d : st.depth)
+            d.store(0, std::memory_order_relaxed);
+        st.enabled.store(true, std::memory_order_release);
+        m_impl->thread = std::thread([impl = m_impl.get()] { impl->loop(); });
+    }
+
+    Sampler::~Sampler()
+    {
+        stop();
+    }
+
+    void Sampler::stop()
+    {
+        if (!m_impl || m_impl->stopped)
+            return;
+        m_impl->stopped = true;
+        m_impl->stopRequested.store(true, std::memory_order_release);
+        if (m_impl->thread.joinable())
+            m_impl->thread.join();
+        State &st = state();
+        st.enabled.store(false, std::memory_order_release);
+        st.context.store(nullptr, std::memory_order_relaxed);
+        st.tick.store(nullptr, std::memory_order_relaxed);
+        m_impl->write();
+    }
+
+    std::unique_ptr<Sampler> startFromEnvironment(const std::atomic<uint64_t> *tickSource)
+    {
+        const char *path = std::getenv("PS2X_PC_SAMPLE");
+        if (!path || !*path)
+            return nullptr;
+        return std::make_unique<Sampler>(path, tickSource);
+    }
+}
