From 203d10a08128ebc9dab26fc208c10e8f3ffa29c1 Mon Sep 17 00:00:00 2001
From: JohnnyC96 <54557697+JohnnyC96@users.noreply.github.com>
Date: Tue, 27 Oct 2026 08:38:14 -0400
Subject: [PATCH 94/94] IOP cdvdman: sceCdReadClock (24) returns the host's
 local time

sceCdReadClock(clock) fills sceCdCLOCK (status, second, minute, hour, pad, day, month, year; BCD) and returns 1,
as the EE's sceCdReadClock stub (ps2xRuntime Stubs/CD.cpp) already does. Was an unhandled import: Resident Evil
Outbreak's network stack (USBSRCH.IRX) polls it (21 warnings per drive to the network menu).

The sceCdRI test module becomes a generic cdvdman caller (import number, two buffer bytes to return).

Test: iop_emulator_tests, a module calling sceCdReadClock with the status preset to 0xFF gets status 0, a BCD
month and return 1. Fails without: IOP 4/5.
---
 ps2xIOP/src/emulator/imports/iop_cdvd.cpp | 21 +++++++++++++
 ps2xIOP/tests/iop_emulator_tests.cpp      | 36 +++++++++++++++--------
 2 files changed, 44 insertions(+), 13 deletions(-)

diff --git a/ps2xIOP/src/emulator/imports/iop_cdvd.cpp b/ps2xIOP/src/emulator/imports/iop_cdvd.cpp
index 5ce5776..74d4853 100644
--- a/ps2xIOP/src/emulator/imports/iop_cdvd.cpp
+++ b/ps2xIOP/src/emulator/imports/iop_cdvd.cpp
@@ -11,6 +11,7 @@
 #include <array>
 #include <cctype>
 #include <cstring>
+#include <ctime>
 #include <filesystem>
 #include <limits>
 #include <string>
@@ -292,6 +293,26 @@ namespace ps2x::iop::detail
                 cpu.gpr[2] = 1u;
                 return true;
 
+            case 24: // sceCdReadClock(sceCdCLOCK *clock): status, second, minute, hour, pad, day, month, year (BCD),
+                     // from the host's local time as the EE's sceCdReadClock (Stubs/CD.cpp); returns 1.
+                if (a0 != 0u)
+                {
+                    const std::time_t now = std::time(nullptr);
+                    std::tm local{};
+#ifdef _WIN32
+                    localtime_s(&local, &now);
+#else
+                    localtime_r(&now, &local);
+#endif
+                    const auto bcd = [](int value) { return static_cast<uint8_t>(((value / 10) << 4) | (value % 10)); };
+                    const uint8_t fields[8] = {0u, bcd(local.tm_sec), bcd(local.tm_min), bcd(local.tm_hour), 0u,
+                                               bcd(local.tm_mday), bcd(local.tm_mon + 1), bcd(local.tm_year % 100)};
+                    for (uint32_t i = 0; i < 8u; ++i)
+                        memory.write8(a0 + i, fields[i]);
+                }
+                cpu.gpr[2] = 1u;
+                return true;
+
             case 28: // sceCdStatus
                 cpu.gpr[2] = kCdvdStatusPause;
                 return true;
diff --git a/ps2xIOP/tests/iop_emulator_tests.cpp b/ps2xIOP/tests/iop_emulator_tests.cpp
index a53cf38..12b92b0 100644
--- a/ps2xIOP/tests/iop_emulator_tests.cpp
+++ b/ps2xIOP/tests/iop_emulator_tests.cpp
@@ -337,14 +337,15 @@ namespace
         std::memcpy(host.guest.data() + address + codeOffset + 0x80u, imports, sizeof(imports));
     }
 
-    // A module reading the console ID: sceCdRI(buf, &result) with result preset to -1; returns buf[0] | buf[7] << 8 |
-    // (result & 0xFF) << 16 | sceCdRI's return << 24 (NETCNF keys its settings files' encoding on this ID).
-    void writeCdRiIrx(TestHost &host, uint32_t address)
+    // A module calling cdvdman import `number` as f(buf, &result), buf[0] and result preset to -1; returns
+    // buf[first] | buf[second] << 8 | (result & 0xFF) << 16 | f's return << 24. sceCdRI (22): the console ID NETCNF
+    // keys its settings files' encoding on; sceCdReadClock (24): the clock USBSRCH polls.
+    void writeCdvdCallIrx(TestHost &host, uint32_t address, uint32_t loadAddress, uint32_t number, uint32_t first,
+                          uint32_t second)
     {
         constexpr uint32_t codeOffset = 0x100u;
-        constexpr uint32_t loadAddress = 0x00015000u;
-        constexpr uint32_t tableAddress = loadAddress + 0x80u;
-        constexpr uint32_t stub22 = tableAddress + 20u;
+        const uint32_t tableAddress = loadAddress + 0x80u;
+        const uint32_t stub = tableAddress + 20u;
         ElfHeader header{};
         header.ident[0] = 0x7Fu; header.ident[1] = 'E'; header.ident[2] = 'L'; header.ident[3] = 'F';
         header.ident[4] = 1u; header.ident[5] = 1u; header.ident[6] = 1u;
@@ -354,21 +355,21 @@ namespace
         ProgramHeader program{};
         program.type = 1u; program.offset = codeOffset; program.vaddr = loadAddress; program.paddr = loadAddress;
         program.filesz = 0x100u; program.memsz = 0x100u; program.flags = 7u; program.align = 4u;
-        const uint32_t jal22 = 0x0C000000u | ((stub22 >> 2) & 0x03FFFFFFu);
+        const uint32_t jal = 0x0C000000u | ((stub >> 2) & 0x03FFFFFFu);
         const uint32_t code[] = {
             0x27BDFFE0u, 0xAFBF001Cu,              // addiu sp,-32; sw ra,28(sp)
-            0x2408FFFFu, 0xAFA80010u,              // result (16(sp)) = -1
-            0x27A40008u, jal22, 0x27A50010u,       // sceCdRI(sp+8, sp+16)
-            0x93A80008u, 0x93A9000Fu, 0x8FAA0010u, 0u, // lbu buf[0]; lbu buf[7]; lw result (+ load delay)
+            0x2408FFFFu, 0xAFA80010u, 0xA3A80008u, // result (16(sp)) = -1, buf[0] (8(sp)) = 0xFF
+            0x27A40008u, jal, 0x27A50010u,       // f(sp+8, sp+16)
+            0x93A80008u | first, 0x93A90008u | second, 0x8FAA0010u, 0u, // lbu buf[first], buf[second]; lw result
             0x00094A00u, 0x00021600u, 0x314A00FFu, 0x000A5400u,
-            0x00481025u, 0x00491025u, 0x004A1025u, // v0 = v0 << 24 | buf[0] | buf[7] << 8 | (result & 0xFF) << 16
+            0x00481025u, 0x00491025u, 0x004A1025u, // v0 = v0 << 24 | first | second << 8 | (result & 0xFF) << 16
             0x8FBF001Cu, 0u,                       // lw ra (+ load delay)
             0x03E00008u, 0x27BD0020u,              // jr ra; addiu sp,32
         };
         const uint32_t imports[] = {
             0x41E00000u, 0u, 0x00000101u,
             0x64766463u, 0x006E616Du, // "cdvdman"
-            0x03E00008u, 0x24000016u, // 22 sceCdRI
+            0x03E00008u, 0x24000000u | number,
             0u, 0u,
         };
         std::memset(host.guest.data() + address, 0, codeOffset + program.filesz);
@@ -1822,11 +1823,20 @@ int main()
                     "get_ctype_table()['F'] upper+hex (0x41)")) return 1;
 
         // The console ID (sceCdRI): eight fixed bytes, *result 0, return 1.
-        writeCdRiIrx(host, 0x1000u);
+        writeCdvdCallIrx(host, 0x1000u, 0x00015000u, 22u, 0u, 7u);
         const ModuleLoadResult cdri = iop.loadModuleBuffer(0x1000u);
         if (!expect(cdri.handled && static_cast<uint32_t>(cdri.startResult) == 0x0100AAAAu,
                     "sceCdRI must fill the 8-byte ID (0xAA), clear *result and return 1")) return 1;
 
+        // The clock (sceCdReadClock, polled by USBSRCH): status 0, BCD fields from the host's local time, return 1.
+        writeCdvdCallIrx(host, 0x1200u, 0x00016000u, 24u, 0u, 6u);
+        const ModuleLoadResult clock = iop.loadModuleBuffer(0x1200u);
+        const uint32_t month = (static_cast<uint32_t>(clock.startResult) >> 8) & 0xFFu;
+        const bool bcdMonth = (month >= 0x01u && month <= 0x09u) || (month >= 0x10u && month <= 0x12u);
+        if (!expect(clock.handled && (static_cast<uint32_t>(clock.startResult) >> 24) == 1u &&
+                        (clock.startResult & 0xFF) == 0 && bcdMonth,
+                    "sceCdReadClock must clear the status, write a BCD month (0x01-0x12) and return 1")) return 1;
+
         // A module loading another through modload 19 + 8 (Capcom's LOADHIGH.IRX for its network stack).
         writeArgvIrx(host, 0xA00u);
         host.files["argv.irx"].assign(host.guest.begin() + 0xA00, host.guest.begin() + 0xA00 + 0x200);
-- 
