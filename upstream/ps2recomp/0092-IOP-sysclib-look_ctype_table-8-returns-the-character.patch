From 7bc34f8c0bd3f7d16886fdef295a74479829ee86 Mon Sep 17 00:00:00 2001
From: JohnnyC96 <54557697+JohnnyC96@users.noreply.github.com>
Date: Tue, 27 Oct 2026 06:29:53 -0400
Subject: [PATCH 92/92] IOP sysclib: look_ctype_table (8) returns the
 character's class flags (ps2sdk ctype.h: _U 1, _L 2, _N 4, _S 8, _P 0x10, _C
 0x20, _X 0x40, _B 0x80) and get_ctype_table (9) a 256-entry table of them,
 instead of 0: an IRX's isdigit never matched, so NETCNFIF rejected
 'thpri=123' and refused to stay resident

---
 ps2xIOP/src/emulator/imports/iop_sysclib.cpp | 40 +++++++++++++--
 ps2xIOP/src/emulator/imports/iop_sysclib.h   |  1 +
 ps2xIOP/tests/iop_emulator_tests.cpp         | 51 ++++++++++++++++++++
 3 files changed, 89 insertions(+), 3 deletions(-)

diff --git a/ps2xIOP/src/emulator/imports/iop_sysclib.cpp b/ps2xIOP/src/emulator/imports/iop_sysclib.cpp
index 0517478..4f13a05 100644
--- a/ps2xIOP/src/emulator/imports/iop_sysclib.cpp
+++ b/ps2xIOP/src/emulator/imports/iop_sysclib.cpp
@@ -11,6 +11,31 @@
 
 namespace ps2x::iop::detail
 {
+    namespace
+    {
+        // The character class flags sysclib's look_ctype_table returns (ps2sdk iop/system/sysclib/include/ctype.h:
+        // _U 0x01 upper, _L 0x02 lower, _N 0x04 digit, _S 0x08 space, _P 0x10 punctuation, _C 0x20 control,
+        // _X 0x40 hex letter, _B 0x80 blank); isdigit(c) is look_ctype_table(c) & _N. ASCII only; 128-255 have none.
+        uint8_t ctypeFlags(uint8_t c)
+        {
+            if (c >= 128u)
+                return 0u;
+            if (c >= '0' && c <= '9')
+                return 0x04u;
+            if (c >= 'A' && c <= 'Z')
+                return static_cast<uint8_t>(0x01u | (c <= 'F' ? 0x40u : 0u));
+            if (c >= 'a' && c <= 'z')
+                return static_cast<uint8_t>(0x02u | (c <= 'f' ? 0x40u : 0u));
+            if (c == ' ')
+                return 0x08u | 0x80u;
+            if (c >= '\t' && c <= '\r')
+                return 0x20u | 0x08u;
+            if (c < 32u || c == 127u)
+                return 0x20u;
+            return 0x10u; // the rest of 33..126
+        }
+    } // namespace
+
     IopSysclib::IopSysclib(IopMemory &memory) noexcept
         : m_memory(memory)
     {
@@ -73,9 +98,18 @@ namespace ps2x::iop::detail
         case 7:
             setV0(static_cast<uint32_t>(std::tolower(static_cast<unsigned char>(a0))));
             return true;
-        case 8:
-        case 9: // ctype table is optional for most IRXs.
-            setV0(0);
+        case 8: // look_ctype_table(c): the class flags of c (isdigit and friends test them)
+            setV0(ctypeFlags(static_cast<uint8_t>(a0)));
+            return true;
+        case 9: // get_ctype_table(): a 256-entry table of the same flags, made once in IOP memory
+            // (made again if an IOP reset reused that memory: '0' must still read as a digit)
+            if (m_ctypeTable == 0u || m_memory.read8(m_ctypeTable + '0') != 0x04u)
+            {
+                m_ctypeTable = m_memory.allocate(256u, 16u);
+                for (uint32_t c = 0; m_ctypeTable && c < 256u; ++c)
+                    m_memory.write8(m_ctypeTable + c, ctypeFlags(static_cast<uint8_t>(c)));
+            }
+            setV0(m_ctypeTable);
             return true;
         case 10: // memchr
             for (uint32_t i = 0; i < a2; ++i)
diff --git a/ps2xIOP/src/emulator/imports/iop_sysclib.h b/ps2xIOP/src/emulator/imports/iop_sysclib.h
index a462a6e..e36880b 100644
--- a/ps2xIOP/src/emulator/imports/iop_sysclib.h
+++ b/ps2xIOP/src/emulator/imports/iop_sysclib.h
@@ -16,5 +16,6 @@ namespace ps2x::iop::detail
 
     private:
         IopMemory &m_memory;
+        uint32_t m_ctypeTable = 0; // get_ctype_table's table in IOP memory, made on first use
     };
 }
diff --git a/ps2xIOP/tests/iop_emulator_tests.cpp b/ps2xIOP/tests/iop_emulator_tests.cpp
index 5dafb5d..4738cc7 100644
--- a/ps2xIOP/tests/iop_emulator_tests.cpp
+++ b/ps2xIOP/tests/iop_emulator_tests.cpp
@@ -293,6 +293,50 @@ namespace
         std::memcpy(host.guest.data() + address + codeOffset + 0xD0u, "xy", 3);
     }
 
+    // A module returning sysclib's character classes: look_ctype_table('7') | ('a') << 8 | (' ') << 16 |
+    // get_ctype_table()['F'] << 24 (isdigit and friends in an IRX's argument parser).
+    void writeCtypeIrx(TestHost &host, uint32_t address)
+    {
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t loadAddress = 0x00014000u;
+        constexpr uint32_t tableAddress = loadAddress + 0x80u;
+        constexpr uint32_t stub8 = tableAddress + 20u;
+        constexpr uint32_t stub9 = stub8 + 8u;
+        ElfHeader header{};
+        header.ident[0] = 0x7Fu; header.ident[1] = 'E'; header.ident[2] = 'L'; header.ident[3] = 'F';
+        header.ident[4] = 1u; header.ident[5] = 1u; header.ident[6] = 1u;
+        header.type = 2u; header.machine = 8u; header.version = 1u;
+        header.entry = loadAddress; header.phoff = sizeof(ElfHeader);
+        header.ehsize = sizeof(ElfHeader); header.phentsize = sizeof(ProgramHeader); header.phnum = 1u;
+        ProgramHeader program{};
+        program.type = 1u; program.offset = codeOffset; program.vaddr = loadAddress; program.paddr = loadAddress;
+        program.filesz = 0x100u; program.memsz = 0x100u; program.flags = 7u; program.align = 4u;
+        const uint32_t jal8 = 0x0C000000u | ((stub8 >> 2) & 0x03FFFFFFu);
+        const uint32_t jal9 = 0x0C000000u | ((stub9 >> 2) & 0x03FFFFFFu);
+        const uint32_t code[] = {
+            0x27BDFFE0u, 0xAFBF001Cu, 0xAFB00018u, // addiu sp,-32; sw ra,28(sp); sw s0,24(sp)
+            0x24040037u, jal8, 0u, 0x00408025u,    // look_ctype_table('7') -> s0
+            0x24040061u, jal8, 0u, 0x00021200u, 0x02028025u, // ('a') << 8
+            0x24040020u, jal8, 0u, 0x00021400u, 0x02028025u, // (' ') << 16
+            jal9, 0u, 0x90430046u, 0u,             // get_ctype_table(); lbu v1,'F'(v0) (+ load delay)
+            0x00031E00u, 0x02031025u,              // v0 = s0 | v1 << 24
+            0x8FB00018u, 0x8FBF001Cu, 0u,          // lw s0; lw ra (+ load delay)
+            0x03E00008u, 0x27BD0020u,              // jr ra; addiu sp,32
+        };
+        const uint32_t imports[] = {
+            0x41E00000u, 0u, 0x00000101u,
+            0x63737973u, 0x0062696Cu, // "sysclib"
+            0x03E00008u, 0x24000008u, // 8 look_ctype_table
+            0x03E00008u, 0x24000009u, // 9 get_ctype_table
+            0u, 0u,
+        };
+        std::memset(host.guest.data() + address, 0, codeOffset + program.filesz);
+        std::memcpy(host.guest.data() + address, &header, sizeof(header));
+        std::memcpy(host.guest.data() + address + sizeof(header), &program, sizeof(program));
+        std::memcpy(host.guest.data() + address + codeOffset, code, sizeof(code));
+        std::memcpy(host.guest.data() + address + codeOffset + 0x80u, imports, sizeof(imports));
+    }
+
     // writeMinimalIrx's module with a .iopmod header naming it.
     void writeNamedMinimalIrx(TestHost &host, uint32_t address, const char *name)
     {
@@ -1729,6 +1773,13 @@ int main()
         if (!expect(((started.startResult >> 16) & 0xFF) == 'b',
                     "module start must get argv[0] = the module's name (buffer@0x800)")) return 1;
 
+        // sysclib's character classes (NETCNFIF's "thpri=123" parser uses isdigit = look_ctype_table(c) & 0x04).
+        writeCtypeIrx(host, 0xE00u);
+        const ModuleLoadResult ctype = iop.loadModuleBuffer(0xE00u);
+        if (!expect(ctype.handled && static_cast<uint32_t>(ctype.startResult) == 0x41884204u,
+                    "look_ctype_table must class '7' digit (0x04), 'a' lower+hex (0x42), ' ' space+blank (0x88), and "
+                    "get_ctype_table()['F'] upper+hex (0x41)")) return 1;
+
         // A module loading another through modload 19 + 8 (Capcom's LOADHIGH.IRX for its network stack).
         writeArgvIrx(host, 0xA00u);
         host.files["argv.irx"].assign(host.guest.begin() + 0xA00, host.guest.begin() + 0xA00 + 0x200);
-- 
