diff --git a/ps2xRuntime/src/lib/ps2_diag.cpp b/ps2xRuntime/src/lib/ps2_diag.cpp
new file mode 100644
index 0000000..2467c75
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_diag.cpp
@@ -0,0 +1,125 @@
+#include "runtime/ps2_diag_hooks.h"
+
+#include <atomic>
+#include <cstdlib>
+#include <filesystem>
+#include <iostream>
+#include <string>
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#include <unistd.h>
+#endif
+
+#ifndef PS2X_DIAG_NAME
+#define PS2X_DIAG_NAME "ob_diag"
+#endif
+
+namespace
+{
+    std::atomic<PS2DiagHooks *> s_diagHooks{nullptr};
+
+    std::filesystem::path exeDirectory()
+    {
+#if defined(_WIN32)
+        wchar_t buffer[MAX_PATH * 4];
+        const DWORD n = GetModuleFileNameW(nullptr, buffer, static_cast<DWORD>(sizeof(buffer) / sizeof(buffer[0])));
+        if (n == 0u || n >= sizeof(buffer) / sizeof(buffer[0]))
+            return {};
+        return std::filesystem::path(std::wstring(buffer, n)).parent_path();
+#else
+        std::error_code ec;
+        const std::filesystem::path exe = std::filesystem::read_symlink("/proc/self/exe", ec);
+        return ec ? std::filesystem::path{} : exe.parent_path();
+#endif
+    }
+
+    // Opens the library and resolves the entry point; null on failure (message in error).
+    PS2DiagCreateFn openPlugin(const std::filesystem::path &path, std::string &error)
+    {
+#if defined(_WIN32)
+        HMODULE module = LoadLibraryW(path.wstring().c_str());
+        if (!module)
+        {
+            error = "LoadLibrary failed, error " + std::to_string(GetLastError());
+            return nullptr;
+        }
+        auto fn = reinterpret_cast<PS2DiagCreateFn>(GetProcAddress(module, PS2_DIAG_ENTRY_NAME));
+#else
+        void *module = dlopen(path.string().c_str(), RTLD_NOW | RTLD_LOCAL);
+        if (!module)
+        {
+            const char *e = dlerror();
+            error = e ? e : "dlopen failed";
+            return nullptr;
+        }
+        auto fn = reinterpret_cast<PS2DiagCreateFn>(dlsym(module, PS2_DIAG_ENTRY_NAME));
+#endif
+        if (!fn)
+            error = std::string("no entry point ") + PS2_DIAG_ENTRY_NAME;
+        return fn; // the library stays loaded for the life of the process
+    }
+}
+
+PS2DiagHooks *ps2DiagHooks()
+{
+    return s_diagHooks.load(std::memory_order_acquire);
+}
+
+void ps2SetDiagHooks(PS2DiagHooks *hooks)
+{
+    s_diagHooks.store(hooks, std::memory_order_release);
+}
+
+int ps2LoadDiagPlugin(const PS2DiagHost &host)
+{
+    std::filesystem::path path;
+    bool named = false;
+    if (const char *env = std::getenv("PS2X_DIAG"); env && *env)
+    {
+        path = std::filesystem::u8path(env);
+        named = true;
+    }
+    else
+    {
+#if defined(_WIN32)
+        const char *suffix = ".dll";
+#elif defined(__APPLE__)
+        const char *suffix = ".dylib";
+#else
+        const char *suffix = ".so";
+#endif
+        const std::filesystem::path dir = exeDirectory();
+        std::error_code ec;
+        if (dir.empty() || !std::filesystem::is_regular_file(dir / (std::string(PS2X_DIAG_NAME) + suffix), ec))
+            return 0; // no plugin: the play build
+        path = dir / (std::string(PS2X_DIAG_NAME) + suffix);
+    }
+
+    std::string error;
+    const PS2DiagCreateFn create = openPlugin(path, error);
+    if (!create)
+    {
+        std::cerr << "[diag] cannot load " << path.string() << ": " << error << std::endl;
+        return named ? 2 : 0; // a plugin found beside the exe that does not load is skipped
+    }
+    int exitCode = 0;
+    PS2DiagHooks *hooks = create(&host, &exitCode);
+    if (!hooks)
+    {
+        if (exitCode != 0)
+            std::cerr << "[diag] " << path.string() << " refused to start, exit " << exitCode << std::endl;
+        return exitCode;
+    }
+    ps2SetDiagHooks(hooks);
+    std::cout << "[diag] plugin " << path.string() << std::endl;
+    return 0;
+}
