+namespace
+{
+    // Records what the engine hands a diagnostics plugin.
+    class RecordingDiagHooks final : public PS2DiagHooks
+    {
+    public:
+        std::vector<uint64_t> vsyncTicks;
+        std::vector<uint64_t> idleWaits;
+        uint32_t guestEnters = 0, guestLeaves = 0;
+        uint32_t *lastPc = nullptr;
+        int32_t lastThread = -1;
+        uint32_t sectionEnters[4]{}, sectionLeaves[4]{};
+        uint64_t wantTick = 0;
+        uint16_t padWord = 0;
+        bool ownPad = false;
+
+        void onVsync(uint64_t tick, uint64_t idleWaitNs) override
+        {
+            vsyncTicks.push_back(tick);
+            idleWaits.push_back(idleWaitNs);
+        }
+        bool wantsFrame(uint64_t tick) override { return tick == wantTick; }
+        void onGuestEnter(uint32_t *pc, int32_t threadId) override
+        {
+            ++guestEnters;
+            lastPc = pc;
+            lastThread = threadId;
+        }
+        void onGuestLeave() override { ++guestLeaves; }
+        void onSectionEnter(PS2DiagSection s) override { ++sectionEnters[static_cast<uint32_t>(s)]; }
+        void onSectionLeave(PS2DiagSection s) override { ++sectionLeaves[static_cast<uint32_t>(s)]; }
+        bool padButtons(int, uint16_t &buttons) override
+        {
+            buttons = padWord;
+            return ownPad;
+        }
+    };
+
+    struct DiagScope
+    {
+        explicit DiagScope(PS2DiagHooks *hooks) { ps2SetDiagHooks(hooks); }
+        ~DiagScope() { ps2SetDiagHooks(nullptr); }
+    };
+
+    // A minimal external GS: counts vsyncs and snapshots, remembering the tick of each snapshot.
+    class CountingExternalGS final : public PS2ExternalGS
+    {
+    public:
+        uint64_t lastVsync = 0;
+        std::vector<uint64_t> snapshotTicks;
+        uint32_t packets = 0;
+        void gifPacket(GifPathId, const uint8_t *, uint32_t) override { ++packets; }
+        void privWrite(uint32_t, uint64_t) override {}
+        void vsync(uint64_t tick, const GSRegisters &) override { lastVsync = tick; }
+        uint32_t readLocalToHost(uint8_t *, uint32_t) override { return 0u; }
+        void reset() override {}
+        bool snapshot(std::vector<uint8_t> &rgba, uint32_t &w, uint32_t &h) override
+        {
+            snapshotTicks.push_back(lastVsync);
+            rgba.assign(4u, 0xFFu);
+            w = h = 1u;
+            return true;
+        }
+    };
+
+    constexpr uint32_t kDiagDrivePc = 0x00173000u;
+    constexpr uint32_t kDiagVSyncs = 5u;
+    uint32_t s_diagVSyncsSeen = 0u;
+    RecordingDiagHooks *s_rec = nullptr;
+    bool s_pcPointerMatched = true;
+
+    // Waits kDiagVSyncs vsyncs (resuming at itself), checking the hook got this context's pc.
+    void diagDrive(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        if (s_rec && s_rec->lastPc != &ctx->pc)
+            s_pcPointerMatched = false;
+        if (s_diagVSyncsSeen++ >= kDiagVSyncs)
+        {
+            ctx->pc = 0u;
+            runtime->requestStop();
+            return;
+        }
+        ctx->pc = kDiagDrivePc;
+        runtime->eeScheduler().waitVSync(runtime->eeScheduler().currentVSyncTick());
+    }
+
+    void runDiagDrive(PS2Runtime &runtime)
+    {
+        static std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0u);
+        runtime.registerFunction(kDiagDrivePc, diagDrive);
+        s_diagVSyncsSeen = 0u;
+        s_pcPointerMatched = true;
+        R5900Context mainContext{};
+        mainContext.pc = kDiagDrivePc;
+        runtime.eeScheduler().reset(rdram.data(), mainContext);
+        runtime.eeScheduler().run();
+    }
