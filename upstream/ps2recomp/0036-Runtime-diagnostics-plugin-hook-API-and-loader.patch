diff --git a/ps2xRuntime/include/runtime/ps2_diag_hooks.h b/ps2xRuntime/include/runtime/ps2_diag_hooks.h
new file mode 100644
index 0000000..2b692d3
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_diag_hooks.h
@@ -0,0 +1,125 @@
+#ifndef PS2_DIAG_HOOKS_H
+#define PS2_DIAG_HOOKS_H
+
+// Diagnostics hook API. Diagnostics (scripted input, frame captures, frame timing, profilers, VU1 capture) live
+// outside the engine, in an optional plugin library; mods can reuse the same API later. The engine keeps one
+// PS2DiagHooks pointer: null = no plugin (a play build), and every hook site is one load and null check.
+//
+// Loading (ps2LoadDiagPlugin, once at start-up, main thread): the library PS2X_DIAG=<path> names, else
+// <exe dir>/<PS2X_DIAG_NAME><shared library suffix> if that file exists, else none. Its C entry point
+// PS2_DIAG_ENTRY_NAME,
+//     PS2DiagHooks *ps2_diag_create(const PS2DiagHost *host, int *exitCode);
+// returns the hooks (alive until the process exits) or null: *exitCode 0 = nothing to do (the engine runs
+// without hooks), anything else = the engine exits with that code (a bad script, a version mismatch).
+// A plugin talks to the engine only through this header (plain types and the PS2DiagHost callbacks) and the
+// VU1State layout; it refuses a host whose apiVersion or vu1StateBytes differ from its own.
+//
+// Threads: the EE executor (scheduler) thread, the game thread (pad polls) and the main (window) thread call
+// different hooks, as marked; a plugin synchronises its own state.
+
+#include <cstdint>
+
+struct VU1State;
+
+#define PS2_DIAG_API_VERSION 1u
+#define PS2_DIAG_ENTRY_NAME "ps2_diag_create"
+
+// Engine services for a plugin.
+struct PS2DiagHost
+{
+    uint32_t apiVersion;    // PS2_DIAG_API_VERSION the engine was built with
+    uint32_t vu1StateBytes; // sizeof(VU1State) in the engine
+    void *user;             // passed back to each callback
+    // Reads <bytes> of EE RAM at a guest address (segment bits ignored); false when out of range. Any thread.
+    bool (*readGuest)(void *user, uint32_t guestAddr, void *dst, uint32_t bytes);
+    // The current guest vsync tick. Any thread.
+    uint64_t (*vsyncTick)(void *user);
+};
+
+// Engine sections a profiler can attribute time to.
+enum class PS2DiagSection : uint32_t
+{
+    Vu1 = 0,     // a VU1 microprogram run (interpreter or external VU1)
+    Iop = 1,     // IOP work on the EE executor (RPC, SIF transfer, IOP cycles)
+    Gs = 2,      // an external GS packet from the GIF arbiter
+    GsVsync = 3, // the external GS vsync and snapshot at VBlankStart
+    Count = 4
+};
+
+// One VU1 run started by VIF1 MSCAL/MSCALF (kind 0) or MSCNT (kind 1).
+struct PS2DiagVu1Run
+{
+    uint32_t kind;
+    uint32_t startPc;     // bytes; MSCNT: the state's pc on entry
+    uint32_t top, itop;   // VIF1 TOP/ITOP
+    uint32_t fbrst;       // EE-side FBRST (D enable bit 10, T enable bit 11)
+    uint32_t vpuStat;     // EE-side VPU_STAT before the run
+    uint32_t cycleBudget; // the interpreter's per-run budget
+    uint64_t codeGeneration;
+    const uint8_t *code;  // 16 KB micro memory
+    const uint8_t *data;  // 16 KB data memory before the run
+    const VU1State *state;
+};
+
+class PS2DiagHooks
+{
+public:
+    virtual ~PS2DiagHooks() = default;
+
+    // EE executor thread.
+    virtual void onVsync(uint64_t tick, uint64_t idleWaitNs) {} // each VBlankStart, after the external GS vsync;
+                                                                // idleWaitNs = total scheduler sleep so far (pacing)
+    virtual bool wantsFrame(uint64_t tick) { return false; }    // right after onVsync: true = deliver this tick's
+                                                                // frame to onFrame (external GS: one readback)
+    virtual void onGuestEnter(uint32_t *pc, int32_t threadId) {} // entering guest code; *pc is the live guest pc
+                                                                 // (the engine writes it without synchronisation)
+    virtual void onGuestLeave() {}
+    virtual void onSectionEnter(PS2DiagSection section) {}
+    virtual void onSectionLeave(PS2DiagSection section) {}
+    virtual void onVu1Begin(const PS2DiagVu1Run &run) {}
+    virtual void onVu1Path1(const uint8_t *packet, uint32_t bytes) {} // each XGKICK (PATH1) packet a VU1 run sends
+    virtual void onVu1End(const uint8_t *data, const VU1State &after, uint32_t vpuStat) {}
+    virtual void onRunEnd() {} // the scheduler's run loop ended: flush files
+
+    // Game thread: a pad poll. true = the plugin owns the pad; buttons = the active-low button word to report.
+    virtual bool padButtons(int port, uint16_t &buttons) { return false; }
+
+    // Main thread.
+    virtual void onFrame(uint64_t tick, const uint8_t *rgba, uint32_t width, uint32_t height) {} // packed RGBA8
+    virtual int onHostFrame(double nowSeconds) { return 0; } // each host loop pass: 0 go on, 1 stop the run,
+                                                             // >= 2 exit the process with that code now
+    virtual int onShutdown() { return 0; }                   // after the host loop: non-zero = process exit code
+};
+
+PS2DiagHooks *ps2DiagHooks();               // null = no plugin
+void ps2SetDiagHooks(PS2DiagHooks *hooks);  // the loader and tests
+
+// Marks a section for the plugin; one load and null check without one.
+class PS2DiagSectionScope
+{
+public:
+    explicit PS2DiagSectionScope(PS2DiagSection section) : m_hooks(ps2DiagHooks()), m_section(section)
+    {
+        if (m_hooks)
+            m_hooks->onSectionEnter(m_section);
+    }
+    ~PS2DiagSectionScope()
+    {
+        if (m_hooks)
+            m_hooks->onSectionLeave(m_section);
+    }
+    PS2DiagSectionScope(const PS2DiagSectionScope &) = delete;
+    PS2DiagSectionScope &operator=(const PS2DiagSectionScope &) = delete;
+
+private:
+    PS2DiagHooks *m_hooks;
+    PS2DiagSection m_section;
+};
+
+// Start-up: loads the plugin as described above and sets the hooks. Returns 0 (hooks set, or no plugin) or the
+// exit code the engine should stop with. Messages go to stderr ("[diag] ...").
+int ps2LoadDiagPlugin(const PS2DiagHost &host);
+
+using PS2DiagCreateFn = PS2DiagHooks *(*)(const PS2DiagHost *host, int *exitCode);
+
+#endif
