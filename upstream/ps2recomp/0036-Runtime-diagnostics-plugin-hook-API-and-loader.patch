+void register_ps2_diag_hooks_tests()
+{
+    MiniTest::Case("DiagHooks", [](TestCase &tc)
+    {
+        tc.Run("onVsync once per VBlankStart with the idle wait; guest enter/leave with the live pc", [](TestCase &t)
+        {
+            RecordingDiagHooks rec;
+            DiagScope scope(&rec);
+            s_rec = &rec;
+            PS2Runtime runtime;
+            runDiagDrive(runtime);
+            s_rec = nullptr;
+            t.IsTrue(rec.vsyncTicks.size() >= kDiagVSyncs, "one onVsync per vsync the guest waited");
+            bool increasing = true, waitsGrow = true;
+            for (size_t i = 0; i < rec.vsyncTicks.size(); ++i)
+            {
+                increasing = increasing && rec.vsyncTicks[i] == i + 1u;
+                waitsGrow = waitsGrow && (i == 0 || rec.idleWaits[i] >= rec.idleWaits[i - 1]);
+            }
+            t.IsTrue(increasing, "ticks 1, 2, 3, ...");
+            t.IsTrue(waitsGrow, "the idle wait is cumulative");
+            t.IsTrue(!rec.idleWaits.empty() && rec.idleWaits.back() > 0u, "an idle guest leaves the scheduler waiting");
+            t.IsTrue(rec.guestEnters > kDiagVSyncs && rec.guestEnters == rec.guestLeaves, "enter/leave pair up");
+            t.IsTrue(s_pcPointerMatched, "onGuestEnter gets the running context's pc");
+            t.IsTrue(rec.lastThread > 0, "and its guest thread id");
+        });
+
+        tc.Run("wantsFrame decides the external GS snapshot; GS packets and vsync are sections", [](TestCase &t)
+        {
+            RecordingDiagHooks rec;
+            rec.wantTick = 3u;
+            CountingExternalGS gs;
+            DiagScope scope(&rec);
+            ps2SetExternalGS(&gs);
+            ps2SetExternalGSFrameDemand([](uint64_t tick)
+                                        { PS2DiagHooks *d = ps2DiagHooks(); return d && d->wantsFrame(tick); });
+            PS2Runtime runtime;
+            runtime.gifArbiter().setProcessPacketFn([](const uint8_t *, uint32_t) {});
+            runtime.memory().setGifArbiter(&runtime.gifArbiter());
+            const uint64_t tag[2] = {1ull | (1ull << 15) | (1ull << 60), 0xEull};
+            const uint64_t ad[2] = {0x1000ull, 0x4Cull};
+            uint8_t pkt[32];
+            std::memcpy(pkt, tag, 16);
+            std::memcpy(pkt + 16, ad, 16);
+            runtime.memory().submitGifPacket(GifPathId::Path3, pkt, sizeof(pkt), true);
+            runDiagDrive(runtime);
+            ps2SetExternalGSFrameDemand(nullptr);
+            ps2SetExternalGS(nullptr);
+            t.IsTrue(gs.snapshotTicks == std::vector<uint64_t>{3u}, "one snapshot, at the tick the plugin wanted");
+            const uint32_t gsIdx = static_cast<uint32_t>(PS2DiagSection::Gs);
+            const uint32_t vsIdx = static_cast<uint32_t>(PS2DiagSection::GsVsync);
+            t.Equals(gs.packets, 1u, "the packet reached the external GS");
+            t.Equals(rec.sectionEnters[gsIdx], 1u, "one GS section");
+            t.Equals(rec.sectionLeaves[gsIdx], 1u, "closed");
+            t.IsTrue(rec.sectionEnters[vsIdx] >= kDiagVSyncs + 1u, "vsync sections (vsync + the one snapshot)");
+            t.Equals(rec.sectionEnters[vsIdx], rec.sectionLeaves[vsIdx], "closed");
+        });
+
+        tc.Run("a plugin that owns the pad replaces the host pad", [](TestCase &t)
+        {
+            RecordingDiagHooks rec;
+            rec.ownPad = true;
+            rec.padWord = static_cast<uint16_t>(0xFFFFu & ~0x2000u);
+            DiagScope scope(&rec);
+            PSPadBackend pad;
+            uint8_t data[32] = {};
+            t.IsTrue(pad.readState(0, 0, data, sizeof(data)), "pad read");
+            t.Equals(data[2], static_cast<uint8_t>(0xFFu), "low byte");
+            t.Equals(data[3], static_cast<uint8_t>(0xDFu), "high byte: circle held");
+        });
+
+        tc.Run("loader: no PS2X_DIAG and no plugin beside the exe = no hooks; a missing PS2X_DIAG = exit 2", [](TestCase &t)
+        {
+            const PS2DiagHost host{PS2_DIAG_API_VERSION, 0u, nullptr, nullptr, nullptr};
+            setEnv("PS2X_DIAG", "");
+            t.Equals(ps2LoadDiagPlugin(host), 0, "nothing to load: start normally");
+            t.IsTrue(ps2DiagHooks() == nullptr, "no hooks");
+            setEnv("PS2X_DIAG", "Z:/no/such/ob_diag.dll");
+            t.Equals(ps2LoadDiagPlugin(host), 2, "a named plugin that does not load stops start-up");
+            t.IsTrue(ps2DiagHooks() == nullptr, "still no hooks");
+            setEnv("PS2X_DIAG", "");
+        });
+    });
+}
