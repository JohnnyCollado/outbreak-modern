diff --git a/ps2xTest/src/ps2_gs_external_tests.cpp b/ps2xTest/src/ps2_gs_external_tests.cpp
index f6116b6..156d570 100644
--- a/ps2xTest/src/ps2_gs_external_tests.cpp
+++ b/ps2xTest/src/ps2_gs_external_tests.cpp
@@ -182,6 +182,74 @@ namespace
         out.events = rec.events;
         return out;
     }
+
+    // One PACKED A+D GIF packet (NLOOP 9, EOP): draw environment for FRAME 0
+    // (FBW 1, CT32, no Z, scissor 8x8, ATE/ZTE off) and a flat 8x8 sprite at (0,0).
+    std::vector<uint8_t> makeSpritePacket()
+    {
+        const uint64_t regs[9][2] = {
+            {(1ull << 16) | (static_cast<uint64_t>(GS_PSM_CT32) << 24), GS_REG_FRAME_1},
+            {1ull << 32, GS_REG_ZBUF_1},
+            {(7ull << 16) | (7ull << 48), GS_REG_SCISSOR_1},
+            {0ull, GS_REG_XYOFFSET_1},
+            {0x30000ull, GS_REG_TEST_1},
+            {static_cast<uint64_t>(GS_PRIM_SPRITE), GS_REG_PRIM},
+            {0x80FF00FFull, GS_REG_RGBAQ},
+            {0ull, GS_REG_XYZ2},
+            {(8ull * 16ull) | ((8ull * 16ull) << 16), GS_REG_XYZ2},
+        };
+        std::vector<uint64_t> q = {9ull | (1ull << 15) | (1ull << 60), 0xEull};
+        for (const auto &r : regs)
+        {
+            q.push_back(r[0]);
+            q.push_back(r[1]);
+        }
+        std::vector<uint8_t> bytes(q.size() * sizeof(uint64_t));
+        std::memcpy(bytes.data(), q.data(), bytes.size());
+        return bytes;
+    }
+
+    struct SpriteDrawRun
+    {
+        size_t hookPackets = 0u;
+        bool hookPacketIsSprite = false;
+        bool vramNonZero = false;      // the runtime's GS VRAM, where the CPU backend draws
+        uint32_t snapshotBytes = 0u;   // GS::refreshDisplaySnapshot + lockDisplaySnapshot
+        size_t snapshotNonZero = 0u;
+    };
+
+    // The runtime's selection: hook (or not), then GS::useNullBackendForExternalGS,
+    // then one sprite packet through the real arbiter.
+    SpriteDrawRun runSpriteDraw(bool withHook)
+    {
+        SpriteDrawRun out;
+        PS2Runtime runtime;
+        if (!runtime.memory().initialize() || !runtime.syncCoreSubsystems())
+            return out;
+        RecordingExternalGS rec;
+        ExternalGSScope scope(withHook ? &rec : nullptr);
+        runtime.gs().useNullBackendForExternalGS();
+
+        const std::vector<uint8_t> pkt = makeSpritePacket();
+        runtime.memory().submitGifPacket(GifPathId::Path3, pkt.data(), static_cast<uint32_t>(pkt.size()), true);
+
+        for (const ExternalGSEvent &ev : rec.events)
+        {
+            if (ev.kind != 'p')
+                continue;
+            ++out.hookPackets;
+            out.hookPacketIsSprite = ev.data == pkt;
+        }
+        const uint8_t *vram = runtime.memory().getGSVRAM();
+        for (uint32_t i = 0; vram && i < 8192u; ++i)
+            out.vramNonZero = out.vramNonZero || vram[i] != 0u;
+        runtime.gs().refreshDisplaySnapshot();
+        const uint8_t *snap = runtime.gs().lockDisplaySnapshot(out.snapshotBytes);
+        for (uint32_t i = 0; snap && i < out.snapshotBytes; ++i)
+            out.snapshotNonZero += snap[i] != 0u;
+        runtime.gs().unlockDisplaySnapshot();
+        return out;
+    }
 }
 
 void register_ps2_gs_external_tests()
@@ -331,5 +399,19 @@ void register_ps2_gs_external_tests()
             t.Equals(rec.events[1].a, 1280u, "resize width");
             t.Equals(rec.events[1].b, 896ull, "resize height");
         });
+
+        tc.Run("with an external GS the CPU backend is replaced by no-ops; without one it still draws", [](TestCase &t)
+        {
+            const SpriteDrawRun cpu = runSpriteDraw(false);
+            t.Equals(cpu.hookPackets, static_cast<size_t>(0u), "control: no hook, no packets teed");
+            t.IsTrue(cpu.vramNonZero, "control: the CPU backend draws the sprite into GS VRAM");
+            t.IsTrue(cpu.snapshotBytes != 0u && cpu.snapshotNonZero != 0u, "control: the VRAM snapshot shows the sprite");
+
+            const SpriteDrawRun ext = runSpriteDraw(true);
+            t.Equals(ext.hookPackets, static_cast<size_t>(1u), "the hook still receives the arbiter packet");
+            t.IsTrue(ext.hookPacketIsSprite, "the hook receives the whole sprite packet");
+            t.IsFalse(ext.vramNonZero, "the decode-only backend leaves GS VRAM untouched");
+            t.Equals(ext.snapshotNonZero, static_cast<size_t>(0u), "the VRAM snapshot is empty or all zero");
+        });
     });
 }
