diff --git a/ps2xIOP/include/ps2x/iop/iop_spu2.h b/ps2xIOP/include/ps2x/iop/iop_spu2.h
new file mode 100644
index 0000000..203102f
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/iop_spu2.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <cstdint>
+
+namespace ps2x::iop
+{
+    // Optional external SPU2 (sound chip). Unset (the default), SPU2 registers are plain storage and SPU2 DMA
+    // completes after a modelled delay (iop_memory.cpp). Set, the IOP hands it every register access in
+    // 0x1F900000..0x1F900FFF and every SPU2 DMA (channels 4 and 7) with its RAM range, and the device decides
+    // when a transfer finishes and when the SPU2 interrupt (INTC line 9) fires, as PCSX2's SPU2 does through
+    // IopDma.cpp spu2DMA4Irq/spu2DMA7Irq and IopIrq.cpp spu2Irq. Time is the IOP cycle count; all calls come
+    // from the thread running the IOP.
+    class Spu2Device
+    {
+    public:
+        enum Event : uint32_t
+        {
+            EventIrq = 1u,  // SPU2 interrupt (INTC line 9)
+            EventDma4 = 2u, // core 0 transfer done (DMA channel 4)
+            EventDma7 = 4u, // core 1 transfer done (DMA channel 7)
+        };
+
+        virtual ~Spu2Device() = default;
+        virtual uint16_t read16(uint32_t phys, uint64_t cycle) = 0;
+        virtual void write16(uint32_t phys, uint16_t value, uint64_t cycle) = 0;
+        // core 0 = channel 4, 1 = channel 7; halfwords at IOP RAM madr, to the SPU2 (CHCR bit 0) or from it.
+        virtual void dma(uint32_t core, uint32_t madr, uint32_t halfwords, bool toSpu2, uint64_t cycle) = 0;
+        virtual void advance(uint64_t cycle) = 0;           // run the device up to cycle
+        [[nodiscard]] virtual uint64_t nextEventCycle() = 0; // when advance is next due; UINT64_MAX = never
+        virtual uint32_t takeEvents() = 0;                  // Event bits raised since the last call
+    };
+
+    constexpr uint32_t kSpu2DeviceBase = 0x1F900000u;
+    constexpr uint32_t kSpu2DeviceEnd = 0x1F901000u;
+
+    void setSpu2Device(Spu2Device *device); // startup and tests; null = none
+    [[nodiscard]] Spu2Device *spu2Device();
+}
