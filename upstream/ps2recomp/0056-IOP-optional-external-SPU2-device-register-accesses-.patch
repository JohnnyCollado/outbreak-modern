+    {
+        // External SPU2 device (patch 0056): register accesses in 0x1F900000..0x1F900FFF and SPU2 DMA go to it,
+        // a transfer it takes waits for its DMA event, and the emulator runs it at its next event cycle.
+        struct FakeSpu2 final : ps2x::iop::Spu2Device
+        {
+            std::unordered_map<uint32_t, uint16_t> regs;
+            uint32_t dmaCore = 99u, dmaMadr = 0u, dmaHalfwords = 0u;
+            bool dmaToSpu2 = false;
+            uint64_t advances = 0u, lastAdvance = 0u;
+            uint16_t read16(uint32_t phys, uint64_t) override { return regs[phys]; }
+            void write16(uint32_t phys, uint16_t value, uint64_t) override { regs[phys] = value; }
+            void dma(uint32_t core, uint32_t madr, uint32_t halfwords, bool toSpu2, uint64_t) override
+            {
+                dmaCore = core;
+                dmaMadr = madr;
+                dmaHalfwords = halfwords;
+                dmaToSpu2 = toSpu2;
+            }
+            void advance(uint64_t cycle) override
+            {
+                ++advances;
+                lastAdvance = cycle;
+            }
+            uint64_t nextEventCycle() override { return lastAdvance + 768u; }
+            uint32_t takeEvents() override { return 0u; }
+        } fake;
+        ps2x::iop::setSpu2Device(&fake);
+        ps2x::iop::detail::IopMemory memory;
+        memory.write16(0x1F900200u, 0x1234u);
+        memory.write32(0x1F900300u, 0xAABBCCDDu);
+        memory.write8(0x1F900301u, 0x55u);
+        const bool routed = fake.regs[0x1F900200u] == 0x1234u && memory.read16(0x1F900200u) == 0x1234u &&
+                            fake.regs[0x1F900300u] == 0x55DDu && fake.regs[0x1F900302u] == 0xAABBu &&
+                            memory.read32(0x1F900300u) == 0xAABB55DDu;
