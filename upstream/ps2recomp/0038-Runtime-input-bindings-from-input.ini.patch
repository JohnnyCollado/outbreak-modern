+
+        std::string upper(std::string s)
+        {
+            for (char &c : s)
+                c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+            return s;
+        }
+
+        std::string trim(const std::string &s)
+        {
+            size_t b = 0, e = s.size();
+            while (b < e && std::isspace(static_cast<unsigned char>(s[b])))
+                ++b;
+            while (e > b && std::isspace(static_cast<unsigned char>(s[e - 1])))
+                --e;
+            return s.substr(b, e - b);
+        }
+
+        template <size_t N>
+        bool lookup(const Named (&table)[N], std::string name, const char *prefix, int &value)
+        {
+            name = upper(trim(name));
+            const std::string p = prefix;
+            if (name.compare(0, p.size(), p) == 0)
+                name = name.substr(p.size());
+            for (const Named &n : table)
+                if (name == n.name)
+                {
+                    value = n.value;
+                    return true;
+                }
+            return false;
+        }
+
+        // Splits "A, B ,C" into trimmed names; an empty value or NONE = no names.
+        std::vector<std::string> splitNames(const std::string &value)
+        {
+            std::vector<std::string> out;
+            const std::string v = trim(value);
+            if (v.empty() || upper(v) == "NONE")
+                return out;
+            std::stringstream ss(v);
+            std::string item;
+            while (std::getline(ss, item, ','))
+                out.push_back(trim(item));
+            return out;
+        }
+
+        CodeList codes(std::initializer_list<int> values)
+        {
+            CodeList list;
+            for (int v : values)
+                list.codes[list.count++] = static_cast<int16_t>(v);
+            return list;
+        }
+
+        bool raylibKeyDown(void *, int key) { return IsKeyDown(key); }
+        bool raylibGamepadAvailable(void *, int device) { return IsGamepadAvailable(device); }
+        bool raylibGamepadButtonDown(void *, int device, int button) { return IsGamepadButtonDown(device, button); }
+        float raylibGamepadAxis(void *, int device, int axis) { return GetGamepadAxisMovement(device, axis); }
+
+        InputBindings &activeStorage()
+        {
+            static InputBindings s_active = defaultInputBindings();
+            return s_active;
+        }
+
+        std::filesystem::path exeDirectory()
+        {
+#if defined(_WIN32)
+            wchar_t buffer[1040];
+            const unsigned long n = GetModuleFileNameW(nullptr, buffer, 1040u);
+            if (n == 0u || n >= 1040u)
+                return {};
+            return std::filesystem::path(std::wstring(buffer, n)).parent_path();
+#else
+            std::error_code ec;
+            const std::filesystem::path exe = std::filesystem::read_symlink("/proc/self/exe", ec);
+            return ec ? std::filesystem::path{} : exe.parent_path();
+#endif
+        }
+    }
