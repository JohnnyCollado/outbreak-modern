@@ -0,0 +1,86 @@
+#ifndef PS2_INPUT_BINDINGS_H
+#define PS2_INPUT_BINDINGS_H
+
+// Host input bindings: which keyboard keys and gamepad buttons/axes drive the PS2 pad. One table, built once at
+// start-up from input.ini (PS2X_INPUT_INI=<path> overrides <exe dir>/input.ini); no file = the defaults, which are
+// the mapping PSPadBackend had hard-coded (gamepad 0 when present, else the keyboard; no dead zone).
+//
+// input.ini (case-insensitive names; ';' or '#' starts a comment; several codes per button comma-separated):
+//   [keyboard]                     raylib key names without KEY_: X, ENTER, RIGHT_SHIFT, KP_0, ...
+//   cross = X, SPACE
+//   stick_left = W, S, A, D        four keys: up, down, left, right (default: none)
+//   [gamepad]                      raylib names without GAMEPAD_BUTTON_ / GAMEPAD_AXIS_
+//   device = 0                     raylib gamepad index
+//   deadzone = 0.15                0..1, per axis, the rest rescaled to 0..1 (default 0)
+//   cross = RIGHT_FACE_DOWN
+//   stick_left = LEFT_X, LEFT_Y    two axes: x, y
+// Buttons: up down left right cross circle square triangle l1 r1 l2 r2 l3 r3 start select. An empty value or NONE
+// unbinds. A bad line is reported once ("[input] line N: ...") and that entry keeps its default.
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace ps2input
+{
+    enum PadButton : uint8_t
+    {
+        Up, Down, Left, Right, Cross, Circle, Square, Triangle, L1, R1, L2, R2, L3, R3, Start, Select,
+        ButtonCount
+    };
+
+    constexpr size_t kMaxCodesPerButton = 8;
+
+    struct CodeList
+    {
+        uint8_t count = 0;
+        int16_t codes[kMaxCodesPerButton] = {};
+    };
+
+    struct InputBindings
+    {
+        CodeList keys[ButtonCount];        // raylib KeyboardKey values
+        int16_t keyStick[2][4] = {};       // [left, right][up, down, left, right] keys; 0 = none
+        CodeList padButtons[ButtonCount];  // raylib GamepadButton values
+        int16_t padStick[2][2] = {{0, 1}, {2, 3}}; // [left, right][x, y] raylib GamepadAxis; -1 = none
+        int device = 0;
+        float deadzone = 0.0f;
+    };
+
+    uint16_t padButtonMask(PadButton button); // libpad active-low bit (bytes 2-3 of the pad data)
+    const char *padButtonName(PadButton button);
+
+    InputBindings defaultInputBindings();
+
+    // Applies ini text on top of `bindings`. Each bad line appends one "[input] line N: ..." message and leaves its
+    // entry as it was.
+    void parseInputIni(const std::string &text, InputBindings &bindings, std::vector<std::string> &messages);
+
+    // Host input, injectable for tests.
+    struct InputSource
+    {
+        void *user;
+        bool (*keyDown)(void *user, int key);
+        bool (*gamepadAvailable)(void *user, int device);
+        bool (*gamepadButtonDown)(void *user, int device, int button);
+        float (*gamepadAxis)(void *user, int device, int axis);
+    };
+    InputSource raylibInputSource();
+
+    // -1..1 to the pad byte (128 + v * 127, truncated, as before), after the dead zone.
+    uint8_t axisToPadByte(float value, float deadzone);
+
+    // One pad poll: buttons (active-low) and sticks in pad data order (bytes 4-7: rx, ry, lx, ly). The gamepad
+    // `device`, when available, is the only source; else the keyboard.
+    void evaluateInput(const InputBindings &bindings, const InputSource &source, uint16_t &buttons, uint8_t sticks[4]);
+
+    const InputBindings &activeInputBindings();
+    void setActiveInputBindings(const InputBindings &bindings); // start-up and tests; not while the game polls
+
+    // Start-up (main thread, before the game thread): PS2X_INPUT_INI, else <exe dir>/input.ini when present.
+    // Messages go to stdout. Returns true when a file was read.
+    bool loadInputBindingsAtStartup();
+}
+
+#endif
