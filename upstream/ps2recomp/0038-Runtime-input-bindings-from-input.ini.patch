+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+// raylib.h and windows.h clash (CloseWindow, ShowCursor, Rectangle...): declare the one call needed.
+extern "C" __declspec(dllimport) unsigned long __stdcall GetModuleFileNameW(void *module, wchar_t *name,
+                                                                           unsigned long size);
+#endif
