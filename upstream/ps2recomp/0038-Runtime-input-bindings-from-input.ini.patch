+    uint16_t padButtonMask(PadButton button) { return button < ButtonCount ? kButtonMasks[button] : 0u; }
+    const char *padButtonName(PadButton button) { return button < ButtonCount ? kButtonNames[button] : "?"; }
+
+    // The mapping PSPadBackend::readState had hard-coded (ps2_pad.cpp before input.ini).
+    InputBindings defaultInputBindings()
+    {
+        InputBindings b;
+        b.keys[Up] = codes({KEY_UP, KEY_W});
+        b.keys[Down] = codes({KEY_DOWN, KEY_S});
+        b.keys[Left] = codes({KEY_LEFT, KEY_A});
+        b.keys[Right] = codes({KEY_RIGHT, KEY_D});
+        b.keys[Cross] = codes({KEY_X, KEY_SPACE});
+        b.keys[Circle] = codes({KEY_C, KEY_ESCAPE});
+        b.keys[Square] = codes({KEY_Z, KEY_KP_0});
+        b.keys[Triangle] = codes({KEY_V, KEY_KP_1});
+        b.keys[L1] = codes({KEY_Q});
+        b.keys[R1] = codes({KEY_E});
+        b.keys[L2] = codes({KEY_LEFT_SHIFT});
+        b.keys[R2] = codes({KEY_RIGHT_SHIFT});
+        b.keys[Start] = codes({KEY_ENTER});
+        b.keys[Select] = codes({KEY_TAB});
+        // L3/R3 and the sticks: no keys.
+
+        b.padButtons[Up] = codes({GAMEPAD_BUTTON_LEFT_FACE_UP});
+        b.padButtons[Down] = codes({GAMEPAD_BUTTON_LEFT_FACE_DOWN});
+        b.padButtons[Left] = codes({GAMEPAD_BUTTON_LEFT_FACE_LEFT});
+        b.padButtons[Right] = codes({GAMEPAD_BUTTON_LEFT_FACE_RIGHT});
+        b.padButtons[Cross] = codes({GAMEPAD_BUTTON_RIGHT_FACE_DOWN});
+        b.padButtons[Circle] = codes({GAMEPAD_BUTTON_RIGHT_FACE_RIGHT});
+        b.padButtons[Square] = codes({GAMEPAD_BUTTON_RIGHT_FACE_LEFT});
+        b.padButtons[Triangle] = codes({GAMEPAD_BUTTON_RIGHT_FACE_UP});
+        b.padButtons[L1] = codes({GAMEPAD_BUTTON_LEFT_TRIGGER_1});
+        b.padButtons[R1] = codes({GAMEPAD_BUTTON_RIGHT_TRIGGER_1});
+        b.padButtons[L2] = codes({GAMEPAD_BUTTON_LEFT_TRIGGER_2});
+        b.padButtons[R2] = codes({GAMEPAD_BUTTON_RIGHT_TRIGGER_2});
+        b.padButtons[L3] = codes({GAMEPAD_BUTTON_LEFT_THUMB});
+        b.padButtons[R3] = codes({GAMEPAD_BUTTON_RIGHT_THUMB});
+        b.padButtons[Start] = codes({GAMEPAD_BUTTON_MIDDLE_RIGHT});
+        b.padButtons[Select] = codes({GAMEPAD_BUTTON_MIDDLE_LEFT});
+        b.padStick[0][0] = GAMEPAD_AXIS_LEFT_X;
+        b.padStick[0][1] = GAMEPAD_AXIS_LEFT_Y;
+        b.padStick[1][0] = GAMEPAD_AXIS_RIGHT_X;
+        b.padStick[1][1] = GAMEPAD_AXIS_RIGHT_Y;
+        b.device = 0;
+        b.deadzone = 0.0f;
+        return b;
+    }
+
+    void parseInputIni(const std::string &text, InputBindings &bindings, std::vector<std::string> &messages)
+    {
+        enum Section
+        {
+            None,
+            Keyboard,
+            Gamepad,
+            Unknown
+        } section = None;
+        std::stringstream in(text);
+        std::string raw;
+        int lineNo = 0;
+        auto bad = [&messages, &lineNo](const std::string &why)
+        { messages.push_back("[input] line " + std::to_string(lineNo) + ": " + why); };
+
+        while (std::getline(in, raw))
+        {
+            ++lineNo;
+            const size_t comment = raw.find_first_of(";#");
+            const std::string line = trim(comment == std::string::npos ? raw : raw.substr(0, comment));
+            if (line.empty())
+                continue;
+            if (line.front() == '[')
+            {
+                const std::string name = upper(trim(line.substr(1, line.size() - 2)));
+                if (line.size() < 2 || line.back() != ']')
+                {
+                    bad("section header without ']'");
+                    section = Unknown;
+                }
+                else if (name == "KEYBOARD")
+                    section = Keyboard;
+                else if (name == "GAMEPAD")
+                    section = Gamepad;
+                else
+                {
+                    bad("unknown section [" + name + "] (keyboard, gamepad); its lines are ignored");
+                    section = Unknown;
+                }
+                continue;
+            }
+            if (section == Unknown)
+                continue;
+            const size_t eq = line.find('=');
+            if (eq == std::string::npos)
+            {
+                bad("expected <name> = <value>");
+                continue;
+            }
+            if (section == None)
+            {
+                bad("entry outside [keyboard] or [gamepad]");
+                continue;
+            }
+            const std::string key = upper(trim(line.substr(0, eq)));
+            const std::string value = trim(line.substr(eq + 1));
+            const std::vector<std::string> names = splitNames(value);
+
+            int button = -1;
+            for (int i = 0; i < ButtonCount; ++i)
+                if (key == upper(kButtonNames[i]))
+                    button = i;
+
+            if (button >= 0)
+            {
+                if (names.size() > kMaxCodesPerButton)
+                {
+                    bad(std::string("more than ") + std::to_string(kMaxCodesPerButton) + " codes for " +
+                        kButtonNames[button]);
+                    continue;
+                }
+                CodeList list;
+                bool ok = true;
+                for (const std::string &n : names)
+                {
+                    int v = 0;
+                    const bool found = section == Keyboard ? lookup(kKeys, n, "KEY_", v)
+                                                           : lookup(kPadButtons, n, "GAMEPAD_BUTTON_", v);
+                    if (!found)
+                    {
+                        bad(std::string("unknown ") + (section == Keyboard ? "key" : "gamepad button") + " '" + n +
+                            "' for " + kButtonNames[button]);
+                        ok = false;
+                        break;
+                    }
+                    list.codes[list.count++] = static_cast<int16_t>(v);
+                }
+                if (ok)
+                    (section == Keyboard ? bindings.keys : bindings.padButtons)[button] = list;
+                continue;
+            }
+
+            if (key == "STICK_LEFT" || key == "STICK_RIGHT")
+            {
+                const int stick = key == "STICK_LEFT" ? 0 : 1;
+                if (section == Keyboard)
+                {
+                    int16_t keys[4] = {};
+                    bool ok = names.empty() || names.size() == 4;
+                    if (!ok)
+                        bad("stick needs four keys (up, down, left, right) or none");
+                    for (size_t i = 0; ok && i < names.size(); ++i)
+                    {
+                        int v = 0;
+                        if (!lookup(kKeys, names[i], "KEY_", v))
+                        {
+                            bad("unknown key '" + names[i] + "' for " + upper(key));
+                            ok = false;
+                        }
+                        keys[i] = static_cast<int16_t>(v);
+                    }
+                    if (ok)
+                        std::copy(keys, keys + 4, bindings.keyStick[stick]);
+                }
+                else
+                {
+                    int16_t axes[2] = {-1, -1};
+                    bool ok = names.empty() || names.size() == 2;
+                    if (!ok)
+                        bad("stick needs two axes (x, y) or none");
+                    for (size_t i = 0; ok && i < names.size(); ++i)
+                    {
+                        int v = 0;
+                        if (!lookup(kAxes, names[i], "GAMEPAD_AXIS_", v))
+                        {
+                            bad("unknown gamepad axis '" + names[i] + "' for " + upper(key));
+                            ok = false;
+                        }
+                        axes[i] = static_cast<int16_t>(v);
+                    }
+                    if (ok)
+                        std::copy(axes, axes + 2, bindings.padStick[stick]);
+                }
+                continue;
+            }
+
+            if (section == Gamepad && key == "DEVICE")
+            {
+                char *end = nullptr;
+                const long v = std::strtol(value.c_str(), &end, 10);
+                if (value.empty() || *end != '\0' || v < 0 || v > 3)
+                    bad("device must be a gamepad index 0..3");
+                else
+                    bindings.device = static_cast<int>(v);
+                continue;
+            }
+            if (section == Gamepad && key == "DEADZONE")
+            {
+                char *end = nullptr;
+                const float v = std::strtof(value.c_str(), &end);
+                if (value.empty() || *end != '\0' || !(v >= 0.0f && v <= 1.0f))
+                    bad("deadzone must be a number 0..1");
+                else
+                    bindings.deadzone = v;
+                continue;
+            }
+            bad("unknown entry '" + trim(line.substr(0, eq)) + "'");
+        }
+    }
+
+    InputSource raylibInputSource()
+    {
+        return InputSource{nullptr, &raylibKeyDown, &raylibGamepadAvailable, &raylibGamepadButtonDown,
+                           &raylibGamepadAxis};
+    }
+
+    uint8_t axisToPadByte(float value, float deadzone)
+    {
+        if (deadzone > 0.0f)
+        {
+            const float a = value < 0.0f ? -value : value;
+            if (a <= deadzone)
+                value = 0.0f;
+            else
+            {
+                const float scaled = std::min(1.0f, (a - deadzone) / (1.0f - deadzone));
+                value = value < 0.0f ? -scaled : scaled;
+            }
+        }
+        return static_cast<uint8_t>(128 + value * 127); // the old conversion, unchanged
+    }
+
+    void evaluateInput(const InputBindings &b, const InputSource &src, uint16_t &buttons, uint8_t sticks[4])
+    {
+        buttons = 0xFFFFu;
+        sticks[0] = sticks[1] = sticks[2] = sticks[3] = 0x80u;
+        if (src.gamepadAvailable(src.user, b.device))
+        {
+            for (int i = 0; i < ButtonCount; ++i)
+            {
+                const CodeList &l = b.padButtons[i];
+                for (uint8_t k = 0; k < l.count; ++k)
+                    if (src.gamepadButtonDown(src.user, b.device, l.codes[k]))
+                    {
+                        buttons = static_cast<uint16_t>(buttons & ~kButtonMasks[i]);
+                        break;
+                    }
+            }
+            // Pad data order: rx, ry, lx, ly.
+            for (int s = 0; s < 2; ++s)
+                for (int a = 0; a < 2; ++a)
+                    if (b.padStick[s][a] >= 0)
+                        sticks[(s == 0 ? 2 : 0) + a] =
+                            axisToPadByte(src.gamepadAxis(src.user, b.device, b.padStick[s][a]), b.deadzone);
+            return;
+        }
+        for (int i = 0; i < ButtonCount; ++i)
+        {
+            const CodeList &l = b.keys[i];
+            for (uint8_t k = 0; k < l.count; ++k)
+                if (src.keyDown(src.user, l.codes[k]))
+                {
+                    buttons = static_cast<uint16_t>(buttons & ~kButtonMasks[i]);
+                    break;
+                }
+        }
+        for (int s = 0; s < 2; ++s)
+        {
+            const int16_t *k = b.keyStick[s];
+            if (k[0] == 0 && k[1] == 0 && k[2] == 0 && k[3] == 0)
+                continue;
+            float x = 0.0f, y = 0.0f;
+            if (k[0] && src.keyDown(src.user, k[0]))
+                y -= 1.0f;
+            if (k[1] && src.keyDown(src.user, k[1]))
+                y += 1.0f;
+            if (k[2] && src.keyDown(src.user, k[2]))
+                x -= 1.0f;
+            if (k[3] && src.keyDown(src.user, k[3]))
+                x += 1.0f;
+            sticks[(s == 0 ? 2 : 0) + 0] = axisToPadByte(x, 0.0f);
+            sticks[(s == 0 ? 2 : 0) + 1] = axisToPadByte(y, 0.0f);
+        }
+    }
+
+    const InputBindings &activeInputBindings() { return activeStorage(); }
+    void setActiveInputBindings(const InputBindings &bindings) { activeStorage() = bindings; }
+
+    bool loadInputBindingsAtStartup()
+    {
+        std::filesystem::path path;
+        bool named = false;
+        if (const char *env = std::getenv("PS2X_INPUT_INI"); env && *env)
+        {
+            path = std::filesystem::u8path(env);
+            named = true;
+        }
+        else
+        {
+            const std::filesystem::path dir = exeDirectory();
+            if (dir.empty())
+                return false;
+            path = dir / "input.ini";
+        }
+        std::ifstream file(path, std::ios::binary);
+        if (!file)
+        {
+            if (named)
+                std::cout << "[input] cannot open PS2X_INPUT_INI=" << path.string() << ": default bindings"
+                          << std::endl;
+            return false;
+        }
+        std::stringstream text;
+        text << file.rdbuf();
+        InputBindings bindings = defaultInputBindings();
+        std::vector<std::string> messages;
+        parseInputIni(text.str(), bindings, messages);
+        for (const std::string &m : messages)
+            std::cout << m << std::endl;
+        setActiveInputBindings(bindings);
+        std::cout << "[input] bindings from " << path.string() << " (" << messages.size() << " bad line(s))"
+                  << std::endl;
+        return true;
+    }
+}
