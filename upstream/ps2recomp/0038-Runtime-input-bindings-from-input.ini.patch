+
+// raylib values, written out so the old mapping below reads as it did in ps2_pad.cpp.
+namespace
+{
+    enum : int
+    {
+        K_SPACE = 32, K_A = 65, K_C = 67, K_D = 68, K_E = 69, K_J = 74, K_K = 75, K_Q = 81, K_S = 83, K_V = 86,
+        K_W = 87, K_X = 88, K_Z = 90, K_ESCAPE = 256, K_ENTER = 257, K_TAB = 258, K_RIGHT = 262, K_LEFT = 263,
+        K_DOWN = 264, K_UP = 265, K_KP_0 = 320, K_KP_1 = 321, K_LEFT_SHIFT = 340, K_RIGHT_SHIFT = 344,
+        K_LEFT_CONTROL = 341
+    };
+    enum : int
+    {
+        B_LEFT_FACE_UP = 1, B_LEFT_FACE_RIGHT, B_LEFT_FACE_DOWN, B_LEFT_FACE_LEFT, B_RIGHT_FACE_UP,
+        B_RIGHT_FACE_RIGHT, B_RIGHT_FACE_DOWN, B_RIGHT_FACE_LEFT, B_LEFT_TRIGGER_1, B_LEFT_TRIGGER_2,
+        B_RIGHT_TRIGGER_1, B_RIGHT_TRIGGER_2, B_MIDDLE_LEFT, B_MIDDLE, B_MIDDLE_RIGHT, B_LEFT_THUMB, B_RIGHT_THUMB
+    };
+    constexpr uint16_t PAD_LEFT = 0x0080u, PAD_DOWN = 0x0040u, PAD_RIGHT = 0x0020u, PAD_UP = 0x0010u,
+                       PAD_START = 0x0008u, PAD_R3 = 0x0004u, PAD_L3 = 0x0002u, PAD_SELECT = 0x0001u,
+                       PAD_SQUARE = 0x8000u, PAD_CROSS = 0x4000u, PAD_CIRCLE = 0x2000u, PAD_TRIANGLE = 0x1000u,
+                       PAD_R1 = 0x0800u, PAD_L1 = 0x0400u, PAD_R2 = 0x0200u, PAD_L2 = 0x0100u;
+
+    // The hard-coded mapping of PSPadBackend::readState before input.ini (ps2_pad.cpp at patch 0037).
+    const std::vector<std::pair<int, uint16_t>> kOldKeys = {
+        {K_UP, PAD_UP}, {K_W, PAD_UP}, {K_DOWN, PAD_DOWN}, {K_S, PAD_DOWN}, {K_LEFT, PAD_LEFT}, {K_A, PAD_LEFT},
+        {K_RIGHT, PAD_RIGHT}, {K_D, PAD_RIGHT}, {K_X, PAD_CROSS}, {K_SPACE, PAD_CROSS}, {K_C, PAD_CIRCLE},
+        {K_ESCAPE, PAD_CIRCLE}, {K_Z, PAD_SQUARE}, {K_KP_0, PAD_SQUARE}, {K_V, PAD_TRIANGLE},
+        {K_KP_1, PAD_TRIANGLE}, {K_Q, PAD_L1}, {K_E, PAD_R1}, {K_LEFT_SHIFT, PAD_L2}, {K_RIGHT_SHIFT, PAD_R2},
+        {K_ENTER, PAD_START}, {K_TAB, PAD_SELECT}};
+    const std::vector<std::pair<int, uint16_t>> kOldPadButtons = {
+        {B_LEFT_FACE_UP, PAD_UP}, {B_LEFT_FACE_DOWN, PAD_DOWN}, {B_LEFT_FACE_LEFT, PAD_LEFT},
+        {B_LEFT_FACE_RIGHT, PAD_RIGHT}, {B_RIGHT_FACE_DOWN, PAD_CROSS}, {B_RIGHT_FACE_RIGHT, PAD_CIRCLE},
+        {B_RIGHT_FACE_LEFT, PAD_SQUARE}, {B_RIGHT_FACE_UP, PAD_TRIANGLE}, {B_LEFT_TRIGGER_1, PAD_L1},
+        {B_RIGHT_TRIGGER_1, PAD_R1}, {B_LEFT_TRIGGER_2, PAD_L2}, {B_RIGHT_TRIGGER_2, PAD_R2},
+        {B_MIDDLE_RIGHT, PAD_START}, {B_MIDDLE_LEFT, PAD_SELECT}, {B_LEFT_THUMB, PAD_L3}, {B_RIGHT_THUMB, PAD_R3}};
+
+    uint8_t oldAxis(float v) { return static_cast<uint8_t>(128 + v * 127); }
+
+    struct FakeInput
+    {
+        std::set<int> keys;
+        int gamepad = -1; // available device, -1 = none
+        std::set<int> buttons;
+        float axes[6] = {};
+        int keyCalls = 0;
+
+        ps2input::InputSource source()
+        {
+            return ps2input::InputSource{
+                this,
+                [](void *u, int k)
+                {
+                    auto *f = static_cast<FakeInput *>(u);
+                    ++f->keyCalls;
+                    return f->keys.count(k) != 0;
+                },
+                [](void *u, int d) { return static_cast<FakeInput *>(u)->gamepad == d; },
+                [](void *u, int d, int b)
+                {
+                    auto *f = static_cast<FakeInput *>(u);
+                    return f->gamepad == d && f->buttons.count(b) != 0;
+                },
+                [](void *u, int, int a) { return static_cast<FakeInput *>(u)->axes[a]; }};
+        }
+    };
+
+    uint16_t poll(const ps2input::InputBindings &b, FakeInput &in, uint8_t sticks[4])
+    {
+        uint16_t buttons = 0;
+        ps2input::evaluateInput(b, in.source(), buttons, sticks);
+        return buttons;
+    }
+
+    void setEnv(const char *name, const char *value)
+    {
+#if defined(_WIN32)
+        _putenv_s(name, value);
+#else
+        if (*value)
+            setenv(name, value, 1);
+        else
+            unsetenv(name);
+#endif
+    }
+
+    bool hasLine(const std::vector<std::string> &messages, int line)
+    {
+        const std::string prefix = "[input] line " + std::to_string(line) + ": ";
+        for (const std::string &m : messages)
+            if (m.compare(0, prefix.size(), prefix) == 0)
+                return true;
+        return false;
+    }
+}
+
+void register_ps2_input_bindings_tests()
+{
+    MiniTest::Case("InputBindings", [](TestCase &tc)
+    {
+        tc.Run("defaults equal the old hard-coded mapping (keyboard, gamepad 0, axes, no dead zone)", [](TestCase &t)
+        {
+            const ps2input::InputBindings b = ps2input::defaultInputBindings();
+            uint8_t sticks[4];
+            FakeInput idle;
+            t.Equals(poll(b, idle, sticks), static_cast<uint16_t>(0xFFFFu), "nothing held");
+            t.Equals(sticks[0], static_cast<uint8_t>(0x80u), "sticks centred");
+            t.Equals(sticks[3], static_cast<uint8_t>(0x80u), "sticks centred");
+            t.Equals(idle.keyCalls, 22, "one poll per bound key, as the old code (22 IsKeyDown)");
+
+            for (const auto &[key, mask] : kOldKeys)
+            {
+                FakeInput in;
+                in.keys.insert(key);
+                t.Equals(poll(b, in, sticks), static_cast<uint16_t>(0xFFFFu & ~mask),
+                         "key " + std::to_string(key));
+                t.Equals(sticks[2], static_cast<uint8_t>(0x80u), "no keyboard stick by default");
+            }
+            FakeInput unbound;
+            unbound.keys = {K_LEFT_CONTROL, K_J, K_K, 49 /* ONE */};
+            t.Equals(poll(b, unbound, sticks), static_cast<uint16_t>(0xFFFFu), "keys the old code ignored");
+
+            for (const auto &[button, mask] : kOldPadButtons)
+            {
+                FakeInput in;
+                in.gamepad = 0;
+                in.buttons.insert(button);
+                in.keys.insert(K_X); // the keyboard is ignored while gamepad 0 is present
+                t.Equals(poll(b, in, sticks), static_cast<uint16_t>(0xFFFFu & ~mask),
+                         "gamepad button " + std::to_string(button));
+            }
+            FakeInput pad;
+            pad.gamepad = 0;
+            const float values[4] = {-1.0f, 0.2f, 0.5f, 1.0f}; // LEFT_X, LEFT_Y, RIGHT_X, RIGHT_Y
+            for (int a = 0; a < 4; ++a)
+                pad.axes[a] = values[a];
+            poll(b, pad, sticks);
+            t.Equals(sticks[2], oldAxis(-1.0f), "lx = 128 + v * 127");
+            t.Equals(sticks[3], oldAxis(0.2f), "ly: no dead zone");
+            t.Equals(sticks[0], oldAxis(0.5f), "rx");
+            t.Equals(sticks[1], oldAxis(1.0f), "ry");
+
+            FakeInput second;
+            second.gamepad = 1; // only gamepad 0 counted before
+            second.keys.insert(K_C);
+            t.Equals(poll(b, second, sticks), static_cast<uint16_t>(0xFFFFu & ~PAD_CIRCLE), "gamepad 1 ignored");
+        });
+
+        tc.Run("a file overrides a binding; the rest keep their defaults", [](TestCase &t)
+        {
+            ps2input::InputBindings b = ps2input::defaultInputBindings();
+            std::vector<std::string> messages;
+            ps2input::parseInputIni("; comment\n[Keyboard]\ncross = j, KEY_K   # two keys\n"
+                                    "stick_left = W, S, A, D\n[gamepad]\ndevice = 1\ncircle = RIGHT_FACE_DOWN\n"
+                                    "stick_right = right_y, right_x\n",
+                                    b, messages);
+            t.Equals(messages.size(), static_cast<size_t>(0), "no bad lines");
+            uint8_t sticks[4];
+            FakeInput j;
+            j.keys = {K_J};
+            t.Equals(poll(b, j, sticks), static_cast<uint16_t>(0xFFFFu & ~PAD_CROSS), "J = cross");
+            FakeInput x;
+            x.keys = {K_X};
+            t.Equals(poll(b, x, sticks), static_cast<uint16_t>(0xFFFFu), "X no longer cross");
+            FakeInput c;
+            c.keys = {K_C};
+            t.Equals(poll(b, c, sticks), static_cast<uint16_t>(0xFFFFu & ~PAD_CIRCLE), "C still circle");
+            FakeInput w;
+            w.keys = {K_W, K_D};
+            const uint16_t wb = poll(b, w, sticks);
+            t.Equals(wb, static_cast<uint16_t>(0xFFFFu & ~(PAD_UP | PAD_RIGHT)), "W/D still the d-pad");
+            t.Equals(sticks[3], oldAxis(-1.0f), "W = left stick up");
+            t.Equals(sticks[2], oldAxis(1.0f), "D = left stick right");
+            FakeInput pad;
+            pad.gamepad = 1;
+            pad.buttons = {B_RIGHT_FACE_DOWN};
+            pad.axes[2] = 1.0f;  // RIGHT_X
+            pad.axes[3] = -1.0f; // RIGHT_Y
+            t.Equals(poll(b, pad, sticks), static_cast<uint16_t>(0xFFFFu & ~(PAD_CROSS | PAD_CIRCLE)),
+                     "device 1; RIGHT_FACE_DOWN = cross (default) and circle (file)");
+            t.Equals(sticks[0], oldAxis(-1.0f), "rx from RIGHT_Y (swapped in the file)");
+            t.Equals(sticks[1], oldAxis(1.0f), "ry from RIGHT_X");
+
+            // Through the start-up loader and PS2X_INPUT_INI.
+            const std::string path = std::string(PS2X_TEST_BINARY_DIR) + "/input-bindings-test.ini";
+            {
+                std::ofstream f(path, std::ios::binary);
+                f << "[keyboard]\r\nstart = K\r\n";
+            }
+            setEnv("PS2X_INPUT_INI", path.c_str());
+            t.IsTrue(ps2input::loadInputBindingsAtStartup(), "file read");
+            FakeInput k;
+            k.keys = {K_K};
+            t.Equals(poll(ps2input::activeInputBindings(), k, sticks), static_cast<uint16_t>(0xFFFFu & ~PAD_START),
+                     "active table: K = start");
+            setEnv("PS2X_INPUT_INI", "Z:/no/such/input.ini");
+            t.IsFalse(ps2input::loadInputBindingsAtStartup(), "missing file: not read");
+            setEnv("PS2X_INPUT_INI", "");
+            ps2input::setActiveInputBindings(ps2input::defaultInputBindings());
+        });
+
+        tc.Run("a bad line is reported once and its entry keeps the default", [](TestCase &t)
+        {
+            ps2input::InputBindings b = ps2input::defaultInputBindings();
+            std::vector<std::string> messages;
+            ps2input::parseInputIni("[keyboard]\n"            // 1
+                                    "cross = J, NOPE\n"       // 2 unknown key: cross stays X, SPACE
+                                    "circle = J\n"            // 3 fine
+                                    "triangle\n"              // 4 no '='
+                                    "jump = X\n"              // 5 unknown entry
+                                    "stick_left = W, S\n"     // 6 needs four keys
+                                    "[gamepad]\n"             // 7
+                                    "deadzone = 1.5\n"        // 8 out of range
+                                    "device = two\n"          // 9 not a number
+                                    "square = LEFT_FACE_UPP\n" // 10 unknown button
+                                    "[mouse]\n"               // 11 unknown section
+                                    "cross = LEFT\n",         // 12 ignored with its section
+                                    b, messages);
+            t.Equals(messages.size(), static_cast<size_t>(8), "one message per bad line");
+            for (int line : {2, 4, 5, 6, 8, 9, 10, 11})
+                t.IsTrue(hasLine(messages, line), "line " + std::to_string(line) + " reported");
+            t.IsFalse(hasLine(messages, 3), "good line not reported");
+            uint8_t sticks[4];
+            FakeInput x;
+            x.keys = {K_X};
+            t.Equals(poll(b, x, sticks), static_cast<uint16_t>(0xFFFFu & ~PAD_CROSS), "cross keeps X");
+            FakeInput j;
+            j.keys = {K_J};
+            t.Equals(poll(b, j, sticks), static_cast<uint16_t>(0xFFFFu & ~PAD_CIRCLE), "J = circle (good line)");
+            t.IsTrue(b.deadzone == 0.0f, "deadzone kept");
+            t.Equals(b.device, 0, "device kept");
+            t.Equals(static_cast<int>(b.keyStick[0][0]), 0, "stick_left kept (none)");
+            t.Equals(static_cast<int>(b.padButtons[ps2input::Square].count), 1, "square kept");
+            t.Equals(static_cast<int>(b.padButtons[ps2input::Square].codes[0]), static_cast<int>(B_RIGHT_FACE_LEFT),
+                     "square kept");
+        });
+
+        tc.Run("deadzone applies to the gamepad axes", [](TestCase &t)
+        {
+            ps2input::InputBindings b = ps2input::defaultInputBindings();
+            std::vector<std::string> messages;
+            ps2input::parseInputIni("[gamepad]\ndeadzone = 0.25\n", b, messages);
+            t.Equals(messages.size(), static_cast<size_t>(0), "no bad lines");
+            t.IsTrue(b.deadzone == 0.25f, "read");
+            FakeInput pad;
+            pad.gamepad = 0;
+            pad.axes[0] = 0.2f;    // LEFT_X inside the dead zone
+            pad.axes[1] = -0.625f; // LEFT_Y: (0.625 - 0.25) / 0.75 = 0.5
+            pad.axes[2] = 1.0f;    // RIGHT_X: full stays full
+            pad.axes[3] = -0.25f;  // RIGHT_Y: on the edge = centre
+            uint8_t sticks[4];
+            poll(b, pad, sticks);
+            t.Equals(sticks[2], static_cast<uint8_t>(128u), "lx centred");
+            t.Equals(sticks[3], oldAxis(-0.5f), "ly rescaled");
+            t.Equals(sticks[0], oldAxis(1.0f), "rx full");
+            t.Equals(sticks[1], static_cast<uint8_t>(128u), "ry centred");
+            t.Equals(ps2input::axisToPadByte(0.2f, 0.0f), oldAxis(0.2f), "deadzone 0 = the old conversion");
+        });
+    });
+}
