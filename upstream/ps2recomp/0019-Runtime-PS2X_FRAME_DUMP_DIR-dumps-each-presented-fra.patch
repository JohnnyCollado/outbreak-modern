index 0000000..7676cf7
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_frame_dump.h
@@ -0,0 +1,10 @@
+#ifndef PS2_FRAME_DUMP_H
+#define PS2_FRAME_DUMP_H
+
+#include <cstdint>
+
+// Writes one presented RGBA8 frame as <dir>/frame-<vsyncTick, 8 digits>.png at its native size.
+// Returns false on a null or empty dir, null pixels, a zero size, or a failed write.
+bool ps2DumpPresentedFrame(const char *dir, uint64_t vsyncTick, const uint8_t *rgba, uint32_t width, uint32_t height);
+
+#endif
diff --git a/ps2xRuntime/src/lib/ps2_frame_dump.cpp b/ps2xRuntime/src/lib/ps2_frame_dump.cpp
new file mode 100644
index 0000000..5297fac
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_frame_dump.cpp
@@ -0,0 +1,39 @@
+#include "runtime/ps2_frame_dump.h"
+#include "ps2_host_backend.h"
+
+#include <cstdio>
+#include <filesystem>
+#include <string>
+#include <system_error>
+
+bool ps2DumpPresentedFrame(const char *dir, uint64_t vsyncTick, const uint8_t *rgba, uint32_t width, uint32_t height)
+{
+    if (dir == nullptr || dir[0] == '\0' || rgba == nullptr || width == 0u || height == 0u)
+    {
+        return false;
+    }
+
+    static std::string s_createdDir;
+    if (s_createdDir != dir)
+    {
+        std::error_code ec;
+        std::filesystem::create_directories(dir, ec);
+        if (ec)
+        {
+            return false;
+        }
+        s_createdDir = dir;
+    }
+
+    char name[32];
+    std::snprintf(name, sizeof(name), "frame-%08llu.png", static_cast<unsigned long long>(vsyncTick));
+    const std::string path = (std::filesystem::path(dir) / name).string();
+
+    Image image{};
+    image.data = const_cast<uint8_t *>(rgba);
+    image.width = static_cast<int>(width);
+    image.height = static_cast<int>(height);
+    image.mipmaps = 1;
+    image.format = PIXELFORMAT_UNCOMPRESSED_R8G8B8A8;
+    return ExportImage(image, path.c_str());
+}
