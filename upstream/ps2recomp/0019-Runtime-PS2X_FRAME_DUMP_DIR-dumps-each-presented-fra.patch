diff --git a/ps2xTest/src/ps2_frame_dump_tests.cpp b/ps2xTest/src/ps2_frame_dump_tests.cpp
new file mode 100644
index 0000000..48c4273
--- /dev/null
+++ b/ps2xTest/src/ps2_frame_dump_tests.cpp
@@ -0,0 +1,61 @@
+#include "MiniTest.h"
+#include "runtime/ps2_frame_dump.h"
+#include "ps2_host_backend.h"
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <string>
+
+namespace
+{
+    std::filesystem::path frameDumpTestDir()
+    {
+        return std::filesystem::path(PS2X_TEST_BINARY_DIR) / "frame_dump_test";
+    }
+}
+
+void register_ps2_frame_dump_tests()
+{
+    MiniTest::Case("FrameDump", [](TestCase &tc)
+                   {
+        tc.Run("writes frame-<tick>.png with the presented pixels", [](TestCase &t)
+               {
+            const std::filesystem::path dir = frameDumpTestDir();
+            std::error_code ec;
+            std::filesystem::remove_all(dir, ec);
+
+            const std::array<uint8_t, 3u * 2u * 4u> pixels = {
+                255u, 0u, 0u, 255u, 0u, 255u, 0u, 255u, 0u, 0u, 255u, 255u,
+                10u, 20u, 30u, 255u, 40u, 50u, 60u, 128u, 70u, 80u, 90u, 0u};
+            const std::string dirText = dir.string();
+            t.IsTrue(ps2DumpPresentedFrame(dirText.c_str(), 42u, pixels.data(), 3u, 2u), "dump succeeds");
+
+            const std::filesystem::path file = dir / "frame-00000042.png";
+            t.IsTrue(std::filesystem::exists(file), "frame-00000042.png exists");
+
+            Image image = LoadImage(file.string().c_str());
+            t.IsTrue(image.data != nullptr, "png loads");
+            t.Equals(image.width, 3, "width");
+            t.Equals(image.height, 2, "height");
+            if (image.data != nullptr)
+            {
+                ImageFormat(&image, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8);
+                t.IsTrue(std::memcmp(image.data, pixels.data(), pixels.size()) == 0, "pixels equal");
+            }
+            UnloadImage(image); });
+
+        tc.Run("null dir returns false and writes nothing", [](TestCase &t)
+               {
+            const std::filesystem::path dir = frameDumpTestDir() / "null_dir";
+            std::error_code ec;
+            std::filesystem::remove_all(dir, ec);
+
+            const std::array<uint8_t, 4u> pixel = {1u, 2u, 3u, 4u};
+            t.IsFalse(ps2DumpPresentedFrame(nullptr, 7u, pixel.data(), 1u, 1u), "null dir fails");
+            t.IsFalse(ps2DumpPresentedFrame("", 7u, pixel.data(), 1u, 1u), "empty dir fails");
+            t.IsFalse(std::filesystem::exists("frame-00000007.png"), "nothing written to the working dir");
+            t.IsFalse(std::filesystem::exists(dir), "nothing written to the test dir"); });
+    });
+}
