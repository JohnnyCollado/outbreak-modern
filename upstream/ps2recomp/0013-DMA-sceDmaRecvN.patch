From 32576e0850d0b70e01e1dc875d0b49e2c454d185 Mon Sep 17 00:00:00 2001
From: JohnnyC96 <54557697+JohnnyC96@users.noreply.github.com>
Date: Wed, 21 Oct 2026 10:41:55 -0400
Subject: [PATCH] DMA: sceDmaRecvN

sceDmaRecvN was a TODO stub. Like libdma: MADR = addr, QWC = qwc, then
CHCR = (CHCR & ~(MOD | DIR)) | STR, a normal-mode transfer into memory.
The source side (SADR for the from-scratchpad channel) is set by the
caller. Completed DMAC causes are dispatched as in sceDmaSend.

Found with Resident Evil Outbreak (SLPM-65428), which copies the 16 KB
scratchpad to main RAM with sceDmaGetChan(8), chan->sadr = ..., then
sceDmaRecvN(chan, dst, 0x400); the stub stopped the game.
---
 ps2xRuntime/src/lib/Kernel/Stubs/DMA.cpp | 21 +++++++++++++-
 ps2xTest/src/ps2_memory_tests.cpp        | 36 ++++++++++++++++++++++++
 2 files changed, 56 insertions(+), 1 deletion(-)

diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/DMA.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/DMA.cpp
index b32e44a..a877885 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/DMA.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/DMA.cpp
@@ -167,7 +167,26 @@ namespace ps2_stubs
 
     void sceDmaRecvN(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
-        TODO_NAMED("sceDmaRecvN", rdram, ctx, runtime);
+        // libdma: MADR = addr, QWC = qwc, CHCR = (CHCR & ~(MOD | DIR)) | STR. The source side
+        // (e.g. SADR for the from-scratchpad channel) is set by the caller beforehand.
+        const uint32_t channelBase = runtime ? resolveDmaChannelBase(rdram, getRegU32(ctx, 4)) : 0u;
+        if (channelBase == 0u)
+        {
+            setReturnS32(ctx, -1);
+            return;
+        }
+
+        PS2Memory &mem = runtime->memory();
+        mem.writeIORegister(channelBase + 0x10u, toDmaPhys(getRegU32(ctx, 5)));
+        mem.writeIORegister(channelBase + 0x20u, getRegU32(ctx, 6) & 0xFFFFu);
+        mem.writeIORegister(channelBase + 0x00u, (mem.readIORegister(channelBase + 0x00u) & ~0xDu) | 0x100u);
+        mem.processPendingTransfers();
+
+        for (const uint32_t completedCause : mem.consumeCompletedDmacCauses())
+        {
+            ps2_syscalls::dispatchDmacHandlersForCause(rdram, runtime, completedCause);
+        }
+        setReturnS32(ctx, 0);
     }
 
     void sceDmaReset(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
diff --git a/ps2xTest/src/ps2_memory_tests.cpp b/ps2xTest/src/ps2_memory_tests.cpp
index 0b22fe0..edce9c9 100644
--- a/ps2xTest/src/ps2_memory_tests.cpp
+++ b/ps2xTest/src/ps2_memory_tests.cpp
@@ -2044,6 +2044,42 @@ void register_ps2_memory_tests()
                      "preserved TTE should deliver the tag high-half VIFcode");
         });
 
+        tc.Run("sceDmaRecvN copies from scratchpad in normal mode", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            t.IsTrue(runtime.memory().initialize(), "PS2Memory initialize should succeed");
+
+            // Resident Evil Outbreak: chan = sceDmaGetChan(8); chan->sadr = 0x40;
+            // sceDmaRecvN(chan, dst, qwc). The caller sets SADR, libdma sets MADR/QWC/CHCR.
+            constexpr uint32_t kFromSprCh = 0x1000D000u;
+            constexpr uint32_t kDst = 0x0024AB40u;
+            PS2Memory &mem = runtime.memory();
+            uint8_t *rdram = mem.getRDRAM();
+            for (uint32_t i = 0; i < 8u; ++i)
+            {
+                mem.write32(PS2_SCRATCHPAD_BASE + 0x40u + i * 4u, 0xA0B0C000u + i);
+            }
+            t.IsTrue(mem.writeIORegister(kFromSprCh + 0x80u, 0x40u), "guest sets SADR");
+
+            R5900Context ctx{};
+            setRegU32(ctx, 4, kFromSprCh);
+            setRegU32(ctx, 5, kDst);
+            setRegU32(ctx, 6, 2u); // quadwords
+            ps2_stubs::sceDmaRecvN(rdram, &ctx, &runtime);
+
+            t.Equals(static_cast<int32_t>(::getRegU32(&ctx, 2)), 0, "sceDmaRecvN should return 0");
+            bool copied = true;
+            for (uint32_t i = 0; i < 8u; ++i)
+            {
+                uint32_t word = 0;
+                std::memcpy(&word, rdram + kDst + i * 4u, sizeof(word));
+                copied = copied && word == 0xA0B0C000u + i;
+            }
+            t.IsTrue(copied, "32 bytes from scratchpad+0x40 should land at the destination");
+            t.Equals(mem.readIORegister(kFromSprCh + 0x00u) & 0x100u, 0u, "STR should be clear when done");
+            t.Equals(mem.readIORegister(kFromSprCh + 0x20u), 0u, "QWC should count down to 0");
+        });
+
         tc.Run("VIF1 DMA DIRECT image packet reaches GS through arbiter", [](TestCase &t)
         {
             PS2Memory mem;
-- 
