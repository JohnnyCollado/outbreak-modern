+        if (!expect(fake.regs[0x1F808200u] == 0x00040641u && queue == 0x00040641u && fake.bytesIn.size() == 1u &&
+                        fake.bytesIn[0] == 0x81u && fifo == 0xABu,
+                    "SIO2 register, DATAIN and FIFO accesses must reach the external device")) return 1;
+        if (!expect(noIrqYet && irq.has_value() && irq->irq == 17 && irq->delayCycles == 0u,
+                    "a SIO2 interrupt must be queued as INTC line 17 at once")) return 1;
+        if (!expect(fake.dmaChannel == 12u && fake.dmaMadr == 0x3000u && fake.dmaBcr == ((2u << 16) | 0x20u) &&
