+    void IopMemory::writeSio2(Sio2Device &sio2, uint32_t phys, uint32_t value)
+    {
+        sio2.write32(phys, value);
+        // PCSX2 raises INTC line 17 inside the CTRL write that starts a transfer (Sio2::SetCtrl -> Interrupt):
+        // dispatched with the DMA interrupts, at once.
+        if (sio2.takeInterrupt())
+            m_dmaStart = DmaStart{kSio2Irq, 0u, 0u, 0u};
+    }
+
+    void IopMemory::startSio2Dma(Sio2Device &sio2, uint32_t chcrAddress, uint32_t chcr)
+    {
+        // PCSX2 IopDma.cpp psxDma11/psxDma12: the bytes move at the CHCR write; MADR ends past them and the
+        // channel interrupt (32 + channel, as intrman numbers it) follows PSX_INT's delay. A CHCR the SIO2 does not
+        // take (another direction or mode) stays busy with no interrupt, as there.
+        const uint32_t channelBase = chcrAddress - 8u; // MADR
+        const uint32_t channel = chcrAddress == kDmaSio2InChcr ? 11u : 12u;
+        const uint32_t madr = readHardware32(channelBase) & (RamSize - 1u);
+        const uint32_t bcr = readHardware32(channelBase + 4u);
+        const uint32_t bytes = (bcr >> 16u) * (bcr & 0xFFFFu) * 4u;
+        const uint32_t delay = sio2.dma(channel, m_ram.data(), RamSize, madr, bcr, chcr);
+        if (delay == kSio2DmaIgnored)
+            return;
+        m_hardware[chcrAddress] = chcr & ~kDmaStart;
+        if (channel == 12u)
+            markOwned(madr, std::min<uint32_t>(bytes, RamSize - madr));
+        m_dmaStart = DmaStart{static_cast<int>(0x20u + channel), delay, channelBase, madr + bytes};
+    }
+
     void IopMemory::completeDma(const DmaStart &dma)
     {
         if (dma.channelBase != 0u)
