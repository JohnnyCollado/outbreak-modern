diff --git a/ps2xIOP/include/ps2x/iop/iop_sio2.h b/ps2xIOP/include/ps2x/iop/iop_sio2.h
new file mode 100644
index 0000000..1ad1b13
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/iop_sio2.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <cstdint>
+
+namespace ps2x::iop
+{
+    // Optional external SIO2 (the serial interface of the pads and memory cards). Unset (the default), SIO2 registers
+    // are plain storage and nothing answers on the ports. Set, the IOP hands it every access to the SIO2 registers
+    // (0x1F808200..0x1F8082FF: the 32-bit registers, byte-wide DATAIN 0x1F808260 and FIFO 0x1F808264) and the
+    // transfers on DMA channels 11 (SIO2 in) and 12 (SIO2 out), and asks it for the SIO2 interrupt (INTC line 17),
+    // as PCSX2's IopHwRead.cpp / IopHwWrite.cpp, IopDma.cpp psxDma11/psxDma12 and Sio2.cpp Sio2::Interrupt do.
+    // The card authentication secrman does for the card driver (SecrAuthCard) is answered by the device too.
+    // All calls come from the thread running the IOP.
+    class Sio2Device
+    {
+    public:
+        virtual ~Sio2Device() = default;
+        virtual uint32_t read32(uint32_t phys) = 0;
+        virtual void write32(uint32_t phys, uint32_t value) = 0;
+        virtual uint8_t read8(uint32_t phys) = 0;               // 0x1F808264: the next byte out of the FIFO
+        virtual void write8(uint32_t phys, uint8_t value) = 0;  // 0x1F808260: a command byte in
+        // A transfer started on channel 11 (CHCR 0x01000201, IOP RAM to SIO2) or 12 (CHCR 0x41000200, SIO2 to IOP
+        // RAM): bcr = block size in words (low 16 bits) and block count (high 16), as psxDma11/psxDma12. The device
+        // moves the bytes now and returns the IOP cycles until the channel's DMA interrupt (PSX_INT delay), or
+        // kSio2DmaIgnored for a CHCR it does not take (psxDma11/12 return without a transfer).
+        virtual uint32_t dma(uint32_t channel, uint8_t *iopRam, uint32_t ramSize, uint32_t madr, uint32_t bcr,
+                             uint32_t chcr) = 0;
+        [[nodiscard]] virtual bool takeInterrupt() = 0; // the SIO2 raised INTC line 17 since the last call
+        // SecrAuthCard(port, slot, cnum) (secrman ordinal 6): 1 when a card answers there, as the real secrman's
+        // MagicGate exchange with PCSX2's MemoryCardProtocol (AuthXor/AuthF3/AuthF7) always ends.
+        [[nodiscard]] virtual bool authCard(uint32_t port, uint32_t slot) = 0;
+    };
+
+    constexpr uint32_t kSio2DmaIgnored = 0xFFFFFFFFu;
+    constexpr uint32_t kSio2DeviceBase = 0x1F808200u;
+    constexpr uint32_t kSio2DeviceEnd = 0x1F808300u;
+    constexpr uint32_t kSio2DataIn = 0x1F808260u;
+    constexpr uint32_t kSio2Fifo = 0x1F808264u;
+
+    void setSio2Device(Sio2Device *device); // startup and tests; null = none
+    [[nodiscard]] Sio2Device *sio2Device();
+}
