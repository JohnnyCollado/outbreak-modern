From 61cd99bb00eea24487f25e94bbf9484894c4704a Mon Sep 17 00:00:00 2001
From: JohnnyC96 <54557697+JohnnyC96@users.noreply.github.com>
Date: Mon, 26 Oct 2026 06:44:48 -0400
Subject: [PATCH 76/76] IOP CPU: LWL/LWR merge into a load still pending from
 the previous instruction on the same register (no delay between an LWL/LWR
 pair)

---
 ps2xIOP/src/emulator/core/iop_cpu.cpp | 11 +++++--
 ps2xIOP/tests/iop_emulator_tests.cpp  | 46 +++++++++++++++++++++++++++
 2 files changed, 55 insertions(+), 2 deletions(-)

diff --git a/ps2xIOP/src/emulator/core/iop_cpu.cpp b/ps2xIOP/src/emulator/core/iop_cpu.cpp
index e09642e..6a6ae4f 100644
--- a/ps2xIOP/src/emulator/core/iop_cpu.cpp
+++ b/ps2xIOP/src/emulator/core/iop_cpu.cpp
@@ -96,6 +96,13 @@ namespace ps2x::iop::detail
         {
             scheduleLoad(reg, value, scheduledLoad, scheduledReg, scheduledValue);
         };
+        // LWL/LWR merge into rt as the previous instruction's load left it: an LWL/LWR pair on one register needs no
+        // delay between them (psx-spx "Unaligned Load/Store"), so the second sees the first's still-pending value
+        // (patch 0076: Resident Evil Outbreak's mc2_s1 copies the card's specs reply this way).
+        auto mergeBase = [&](uint32_t reg)
+        {
+            return cpu.pendingLoad && cpu.pendingLoadReg == reg ? cpu.pendingLoadValue : cpu.gpr[reg];
+        };
         auto overflowAdd = [&](int32_t lhs, int32_t rhs, uint32_t reg)
         {
             const int64_t result = static_cast<int64_t>(lhs) + rhs;
@@ -356,7 +363,7 @@ namespace ps2x::iop::detail
         {
             const uint32_t address = cpu.gpr[rs] + static_cast<uint32_t>(simm);
             const uint32_t memory = m_memory.read32(address & ~3u);
-            const uint32_t old = cpu.gpr[rt];
+            const uint32_t old = mergeBase(rt);
             static constexpr uint32_t masks[4] = {0x00FFFFFFu, 0x0000FFFFu, 0x000000FFu, 0x00000000u};
             static constexpr uint32_t shifts[4] = {24u, 16u, 8u, 0u};
             load(rt, (old & masks[address & 3u]) | (memory << shifts[address & 3u]));
@@ -377,7 +384,7 @@ namespace ps2x::iop::detail
         {
             const uint32_t address = cpu.gpr[rs] + static_cast<uint32_t>(simm);
             const uint32_t memory = m_memory.read32(address & ~3u);
-            const uint32_t old = cpu.gpr[rt];
+            const uint32_t old = mergeBase(rt);
             static constexpr uint32_t masks[4] = {0x00000000u, 0xFF000000u, 0xFFFF0000u, 0xFFFFFF00u};
             static constexpr uint32_t shifts[4] = {0u, 8u, 16u, 24u};
             load(rt, (old & masks[address & 3u]) | (memory >> shifts[address & 3u]));
diff --git a/ps2xIOP/tests/iop_emulator_tests.cpp b/ps2xIOP/tests/iop_emulator_tests.cpp
index d41fefd..1a559bd 100644
--- a/ps2xIOP/tests/iop_emulator_tests.cpp
+++ b/ps2xIOP/tests/iop_emulator_tests.cpp
@@ -288,6 +288,43 @@ namespace
                     importTable, sizeof(importTable));
     }
 
+    // Start function: an unaligned word load as compilers emit it, lwl then lwr on one register with no delay between
+    // them, at loadAddress + 0x81 over the bytes 11 22 33 44 55 66; returns the word (patch 0076: 0x55443322).
+    void writeUnalignedLoadIrx(TestHost &host, uint32_t address)
+    {
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t loadAddress = 0x00010000u;
+
+        ElfHeader header{};
+        header.ident[0] = 0x7Fu; header.ident[1] = 'E'; header.ident[2] = 'L'; header.ident[3] = 'F';
+        header.ident[4] = 1u; header.ident[5] = 1u; header.ident[6] = 1u;
+        header.type = 2u; header.machine = 8u; header.version = 1u;
+        header.entry = loadAddress; header.phoff = sizeof(ElfHeader);
+        header.ehsize = sizeof(ElfHeader); header.phentsize = sizeof(ProgramHeader); header.phnum = 1u;
+
+        const uint32_t code[] = {
+            0x3C040001u, 0x34840081u, // a0 = loadAddress + 0x81
+            0x00001021u,              // v0 = 0
+            0x88820003u,              // lwl v0, 3(a0)
+            0x98820000u,              // lwr v0, 0(a0)  (no delay between them)
+            0x00000000u,              // load delay slot
+            0x03E00008u, 0x00000000u, // return v0
+        };
+        const uint8_t data[] = {0x11u, 0x22u, 0x33u, 0x44u, 0x55u, 0x66u, 0x77u, 0x88u};
+
+        ProgramHeader program{};
+        program.type = 1u; program.offset = codeOffset; program.vaddr = loadAddress; program.paddr = loadAddress;
+        program.filesz = 0x100u; program.memsz = 0x100u; program.flags = 7u; program.align = 4u;
+
+        std::vector<uint8_t> segment(program.filesz, 0u);
+        std::memcpy(segment.data(), code, sizeof(code));
+        std::memcpy(segment.data() + 0x80u, data, sizeof(data));
+        std::fill(host.guest.begin() + address, host.guest.end(), 0u);
+        std::memcpy(host.guest.data() + address, &header, sizeof(header));
+        std::memcpy(host.guest.data() + address + sizeof(header), &program, sizeof(program));
+        std::memcpy(host.guest.data() + address + codeOffset, segment.data(), segment.size());
+    }
+
     // An RPC server (SID 0xB10C0001) whose handler blocks (patch 0075): DelayThread(100), then it stores
     // GetThreadId() in its buffer and returns the buffer.
     void writeBlockingRpcServerIrx(TestHost &host, uint32_t address)
@@ -1268,6 +1305,15 @@ int main()
     if (!expect(iop.debugSnapshot().emulatorInstructions > soundInstructionsBefore,
                 "Sound RPC did not execute the physical IOP handler")) return 1;
 
+    {
+        // LWL/LWR back to back on one register (patch 0076): the second merges into the first's pending load.
+        iop.reset();
+        writeUnalignedLoadIrx(host, 0x100u);
+        const ModuleLoadResult unaligned = iop.loadModuleBuffer(0x100u);
+        if (!expect(unaligned.handled && static_cast<uint32_t>(unaligned.startResult) == 0x55443322u,
+                    "lwl then lwr with no delay must load the unaligned word 0x55443322")) return 1;
+    }
+
     {
         // RPC handlers run as IOP threads (patch 0075): one that sleeps (DelayThread) resumes and returns, and it
         // runs on a thread of its own (GetThreadId != 0), as in the server thread's sceSifRpcLoop on a PS2.
