@@ -0,0 +1,27 @@
+// Support for ps2_runtime_api_tests.cpp: that file sees only the game-facing API, where
+// PS2Runtime is incomplete, so the runtime is created and set up here.
+#include "ps2_runtime.h"
+#include "runtime/ps2_memory.h"
+
+PS2Runtime *ps2ApiTestRuntimeCreate()
+{
+    auto *runtime = new PS2Runtime();
+    runtime->memory().initialize();
+    runtime->syncCoreSubsystems();
+    return runtime;
+}
+
+void ps2ApiTestRuntimeDestroy(PS2Runtime *runtime)
+{
+    delete runtime;
+}
+
+uint8_t *ps2ApiTestRuntimeRdram(PS2Runtime *runtime)
+{
+    return runtime->memory().getRDRAM();
+}
+
+void ps2ApiTestRegisterFunction(PS2Runtime *runtime, uint32_t address, Ps2RecompiledFunction fn)
+{
+    runtime->registerFunction(address, fn);
+}
diff --git a/ps2xTest/src/ps2_runtime_api_tests.cpp b/ps2xTest/src/ps2_runtime_api_tests.cpp
new file mode 100644
index 0000000..85289df
--- /dev/null
+++ b/ps2xTest/src/ps2_runtime_api_tests.cpp
@@ -0,0 +1,272 @@
+// The game-facing runtime API (ps2_runtime_api.h), exercised the way generated code
+// uses it. This translation unit includes exactly what a generated source includes
+// (the API header and the macros) and nothing from the runtime's internals: with
+// ps2_runtime.h it would compile anyway, so this file is the test that the API
+// header is self-sufficient. PS2Runtime stays incomplete here; the support file
+// (ps2_runtime_api_support.cpp) creates the runtime behind a pointer.
+#include "MiniTest.h"
+#include "ps2_runtime_api.h"
+#include "ps2_runtime_macros.h"
+
+#include <cstdint>
+#include <cstring>
+#include <exception>
+#include <filesystem>
+#include <fstream>
+#include <set>
+#include <string>
+#include <vector>
+
+// ps2_runtime_api_support.cpp (sees the full runtime).
+PS2Runtime *ps2ApiTestRuntimeCreate();
+void ps2ApiTestRuntimeDestroy(PS2Runtime *runtime);
+uint8_t *ps2ApiTestRuntimeRdram(PS2Runtime *runtime);
+void ps2ApiTestRegisterFunction(PS2Runtime *runtime, uint32_t address, Ps2RecompiledFunction fn);
+
+namespace
+{
+    constexpr uint32_t kCalleeAddress = 0x00003000u;
+    constexpr uint32_t kCallerPc = 0x00002000u;
+    constexpr uint32_t kFallthroughPc = 0x00002008u;
+
+    bool g_calleeRan = false;
+
+    // A recompiled callee that returns normally: pc stays at its entry, which the
+    // dispatcher converts to the caller's fallthrough.
+    void apiTestCallee(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        (void)rdram;
+        (void)runtime;
+        g_calleeRan = true;
+        SET_GPR_U32(ctx, 2, 0x00ABCDEFu);
+    }
+
+    uint32_t exceptionCode(const R5900Context &ctx)
+    {
+        return (ctx.cop0_cause >> 2) & 0x1Fu;
+    }
+
+    // Every quoted include reachable from `header`, resolved against the include paths a
+    // generated source sees (relative to ps2xRuntime/), as paths relative to the root that
+    // resolved them ("runtime/ps2_address.h").
+    std::set<std::string> runtimeIncludeClosure(const std::vector<std::string> &headers)
+    {
+        const std::filesystem::path runtimeDir(PS2X_RUNTIME_SOURCE_DIR);
+        const std::filesystem::path roots[] = {runtimeDir / "include", runtimeDir / "src/lib", runtimeDir / "src/lib/Kernel"};
+        std::set<std::string> seen;
+        std::vector<std::string> pending(headers);
+        while (!pending.empty())
+        {
+            const std::string current = pending.back();
+            pending.pop_back();
+            if (!seen.insert(current).second)
+                continue;
+            for (const std::filesystem::path &root : roots)
+            {
+                std::ifstream in(root / current);
+                if (!in)
+                    continue;
+                std::string line;
+                while (std::getline(in, line))
+                {
+                    const size_t hash = line.find_first_not_of(" \t");
+                    if (hash == std::string::npos || line.compare(hash, 8, "#include") != 0)
+                        continue;
+                    const size_t open = line.find('"', hash);
+                    const size_t close = open == std::string::npos ? open : line.find('"', open + 1);
+                    if (close != std::string::npos)
+                        pending.push_back(line.substr(open + 1, close - open - 1));
+                }
+                break;
+            }
+        }
+        return seen;
+    }
+
+    struct ApiRuntime
+    {
+        PS2Runtime *runtime = nullptr;
+        uint8_t *rdram = nullptr;
+        R5900Context ctx{};
+
+        ApiRuntime()
+        {
+            runtime = ps2ApiTestRuntimeCreate();
+            rdram = ps2ApiTestRuntimeRdram(runtime);
+        }
+        ~ApiRuntime()
+        {
+            ps2ApiTestRuntimeDestroy(runtime);
+        }
+        ApiRuntime(const ApiRuntime &) = delete;
+        ApiRuntime &operator=(const ApiRuntime &) = delete;
+    };
+}
+
+void register_ps2_runtime_api_tests()
+{
+    MiniTest::Case("PS2RuntimeApi", [](TestCase &tc)
+    {
+        tc.Run("what generated code includes reaches no runtime-internal header", [](TestCase &t)
+        {
+            // The runtime headers function_emitter.cpp writes into every generated source.
+            const std::set<std::string> closure = runtimeIncludeClosure(
+                {"ps2_runtime_macros.h", "ps2_runtime_api.h", "ps2_syscalls.h", "ps2_stubs.h", "ps2_log.h"});
+
+            t.IsTrue(closure.count("runtime/ps2_address.h") == 1u && closure.count("Stubs/Unimplemented.h") == 1u,
+                     "the walk follows includes into runtime/ and Kernel/");
+            for (const std::string &header : closure)
+            {
+                const bool internal = header == "ps2_runtime.h" ||
+                                      (header.rfind("runtime/", 0) == 0 && header != "runtime/ps2_memory_map.h" &&
+                                       header != "runtime/ps2_address.h");
+                t.IsFalse(internal, "generated code must not include " + header);
+            }
+        });
+
+        tc.Run("dispatchGuestBranch runs a registered callee and resumes at the fallthrough", [](TestCase &t)
+        {
+            ApiRuntime r;
+            ps2ApiTestRegisterFunction(r.runtime, kCalleeAddress, &apiTestCallee);
+            g_calleeRan = false;
+            r.ctx.pc = kCallerPc;
+
+            const bool resumed = ps2x_dispatchGuestBranch(r.runtime, r.rdram, &r.ctx, kCalleeAddress, kCallerPc, kFallthroughPc,
+                                                          Ps2GuestBranchKind::DirectCall, "JAL");
+
+            t.IsTrue(g_calleeRan, "the callee runs");
+            t.IsTrue(resumed, "a call that returns resumes at the fallthrough");
+            t.Equals(r.ctx.pc, kFallthroughPc, "pc is the fallthrough");
+            const R5900Context *ctx = &r.ctx;
+            t.Equals(GPR_U32(ctx, 2), 0x00ABCDEFu, "the callee's register writes are visible");
+        });
+
+        tc.Run("eeCheckpointDue on a fresh scheduler is not due", [](TestCase &t)
+        {
+            ApiRuntime r;
+            t.IsFalse(ps2x_eeCheckpointDue(r.runtime), "default charge: nothing pending");
+            t.IsFalse(ps2x_eeCheckpointDue(r.runtime, 8u), "explicit charge: nothing pending");
+        });
+
+        tc.Run("handleSyscall refuses a delay slot", [](TestCase &t)
+        {
+            ApiRuntime r;
+            r.ctx.in_delay_slot = true;
+            bool threw = false;
+            try
+            {
+                ps2x_handleSyscall(r.runtime, r.rdram, &r.ctx, 0x3Cu);
+            }
+            catch (const std::exception &)
+            {
+                threw = true;
+            }
+            t.IsTrue(threw, "a syscall in a delay slot throws");
+        });
+
+        tc.Run("handleBreak, SignalException and handleTrap raise COP0 exceptions", [](TestCase &t)
+        {
+            ApiRuntime r;
+            r.ctx.pc = 0x00004000u;
+            r.ctx.cop0_status = 0u;
+            r.ctx.cop0_cause = 0u;
+            ps2x_handleBreak(r.runtime, r.rdram, &r.ctx);
+            t.Equals(r.ctx.cop0_epc, 0x00004000u, "BREAK: EPC is the faulting pc");
+            t.Equals(exceptionCode(r.ctx), static_cast<uint32_t>(EXCEPTION_BREAKPOINT), "BREAK: cause code 9");
+            t.IsTrue((r.ctx.cop0_status & 0x2u) != 0u, "BREAK: STATUS.EXL set");
+
+            r.ctx = R5900Context{};
+            r.ctx.pc = 0x00004010u;
+            r.ctx.cop0_status = 0u;
+            ps2x_SignalException(r.runtime, &r.ctx, EXCEPTION_ADDRESS_ERROR_LOAD);
+            t.Equals(r.ctx.cop0_epc, 0x00004010u, "SignalException: EPC is the faulting pc");
+            t.Equals(exceptionCode(r.ctx), static_cast<uint32_t>(EXCEPTION_ADDRESS_ERROR_LOAD), "SignalException: cause code 4");
+
+            r.ctx = R5900Context{};
+            r.ctx.pc = 0x00004020u;
+            r.ctx.cop0_status = 0u;
+            ps2x_handleTrap(r.runtime, r.rdram, &r.ctx);
+            t.Equals(exceptionCode(r.ctx), static_cast<uint32_t>(EXCEPTION_TRAP), "handleTrap: cause code 13");
+        });
+
+        tc.Run("clearLLBit clears the LL/SC reservation", [](TestCase &t)
+        {
+            ApiRuntime r;
+            r.ctx.llbit = 1u;
+            r.ctx.lladdr = 0x00001234u;
+            ps2x_clearLLBit(r.runtime, &r.ctx);
+            t.Equals(r.ctx.llbit, 0u, "llbit cleared");
+            t.Equals(r.ctx.lladdr, 0u, "lladdr cleared");
+        });
+
+        tc.Run("Store and Load of every width go through the runtime's memory", [](TestCase &t)
+        {
+            ApiRuntime r;
+            const uint32_t base = 0x00123450u;
+            ps2x_Store8(r.runtime, r.rdram, &r.ctx, base + 0x00u, 0xA5u);
+            ps2x_Store16(r.runtime, r.rdram, &r.ctx, base + 0x10u, 0xBEEFu);
+            ps2x_Store32(r.runtime, r.rdram, &r.ctx, base + 0x20u, 0xCAFEBABEu);
+            ps2x_Store64(r.runtime, r.rdram, &r.ctx, base + 0x30u, 0x0123456789ABCDEFull);
+            ps2x_Store128(r.runtime, r.rdram, &r.ctx, base + 0x40u, _mm_set_epi32(4, 3, 2, 1));
+
+            t.Equals(ps2x_Load8(r.runtime, r.rdram, &r.ctx, base + 0x00u), static_cast<uint8_t>(0xA5u), "8-bit round trip");
+            t.Equals(ps2x_Load16(r.runtime, r.rdram, &r.ctx, base + 0x10u), static_cast<uint16_t>(0xBEEFu), "16-bit round trip");
+            t.Equals(ps2x_Load32(r.runtime, r.rdram, &r.ctx, base + 0x20u), 0xCAFEBABEu, "32-bit round trip");
+            t.Equals(ps2x_Load64(r.runtime, r.rdram, &r.ctx, base + 0x30u), 0x0123456789ABCDEFull, "64-bit round trip");
+            alignas(16) uint32_t lanes[4] = {};
+            _mm_storeu_si128(reinterpret_cast<__m128i *>(lanes), ps2x_Load128(r.runtime, r.rdram, &r.ctx, base + 0x40u));
+            t.IsTrue(lanes[0] == 1u && lanes[1] == 2u && lanes[2] == 3u && lanes[3] == 4u, "128-bit round trip");
+
+            uint32_t raw = 0u;
+            std::memcpy(&raw, r.rdram + (base + 0x20u), sizeof(raw));
+            t.Equals(raw, 0xCAFEBABEu, "a store lands in RDRAM where generated code's fast path reads it");
+        });
+
+        tc.Run("READ/WRITE macros take the fast path in RDRAM and the runtime path for special addresses", [](TestCase &t)
+        {
+            ApiRuntime r;
+            // The macros expand against these three names, as in generated code.
+            PS2Runtime *runtime = r.runtime;
+            uint8_t *rdram = r.rdram;
+            R5900Context *ctx = &r.ctx;
+
+            WRITE32(0x00200000u, 0x11223344u);
+            t.Equals(READ32(0x00200000u), 0x11223344u, "RDRAM: fast path round trip");
+            t.Equals(FAST_READ32(0x00200000u), 0x11223344u, "RDRAM: the fast path sees the write");
+
+            const uint32_t scratch = PS2_SCRATCHPAD_BASE + 0x10u;
+            t.IsTrue(Ps2IsSpecialAddress(scratch), "the scratchpad is a special address");
+            WRITE32(scratch, 0x55667788u);
+            t.Equals(READ32(scratch), 0x55667788u, "scratchpad: runtime path round trip");
+            t.Equals(ps2x_Load32(runtime, rdram, ctx, scratch), 0x55667788u, "scratchpad: the runtime sees the macro's write");
+
+            WRITE64(0x00200010u, 0x8877665544332211ull);
+            t.Equals(READ64(0x00200010u), 0x8877665544332211ull, "RDRAM: 64-bit round trip");
+            WRITE8(0x00200020u, 0x7Fu);
+            t.Equals(static_cast<uint32_t>(READ8(0x00200020u)), 0x7Fu, "RDRAM: 8-bit round trip");
+        });
+
+        tc.Run("vu0StartMicroProgram outside VU0 code memory seeds the idle result", [](TestCase &t)
+        {
+            ApiRuntime r;
+            r.ctx.vu0_q = 5.0f;
+            r.ctx.vu0_status = 0xFFFFu;
