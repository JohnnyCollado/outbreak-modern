 ps2xRuntime/include/ps2_runtime_api.h         | 338 ++++++++++++++++++
 ps2xRuntime/include/ps2_runtime_macros.h      |  42 +--
 ps2xRuntime/include/ps2_stubs.h               |   2 +-
