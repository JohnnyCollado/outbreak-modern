                 return false;
+            if (cpu.pc == kIomanReturnSentinel)
+            {
+                ioman.finishCall(cpu);
+                ++totalInstructions;
+                ++totalCycles;
+                return true;
+            }
             if (cpu.pc == kThreadReturnSentinel || cpu.pc == kCallReturnSentinel)
             {
                 cpu.stopped = true;
diff --git a/ps2xIOP/src/emulator/iop_emulator_const.h b/ps2xIOP/src/emulator/iop_emulator_const.h
index 3ab1423..3057320 100644
