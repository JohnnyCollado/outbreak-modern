index 3eb4119..7f3f1da 100644
--- a/ps2xIOP/src/emulator/imports/iop_ioman.cpp
+++ b/ps2xIOP/src/emulator/imports/iop_ioman.cpp
@@ -2,9 +2,11 @@
 
 #include "../core/iop_cpu.h"
 #include "../core/iop_memory.h"
+#include "../iop_emulator_const.h"
 #include "../services/iop_rpc.h"
 
 #include <algorithm>
+#include <cctype>
 
 namespace ps2x::iop::detail
 {
@@ -13,9 +15,124 @@ namespace ps2x::iop::detail
     {
     }
 
+    namespace
+    {
+        // Byte offsets in ps2sdk ioman.h: iop_file_t {mode, unit, device, privdata}; iop_device_t {name, type,
+        // version, desc, ops}; iop_device_ops_t {init, deinit, format, open, close, read, write, lseek, ioctl,
+        // remove, mkdir, rmdir, dopen, dclose, dread, getstat, chstat}.
+        constexpr uint32_t kFileMode = 0u, kFileUnit = 4u, kFileDevice = 8u;
+        constexpr uint32_t kDeviceOps = 16u;
+        constexpr uint32_t kOpFormat = 8u, kOpOpen = 12u, kOpClose = 16u, kOpRead = 20u, kOpWrite = 24u,
+                           kOpLseek = 28u, kOpIoctl = 32u, kOpRemove = 36u, kOpMkdir = 40u, kOpRmdir = 44u,
+                           kOpDopen = 48u, kOpDclose = 52u, kOpDread = 56u, kOpGetstat = 60u, kOpChstat = 64u;
+        constexpr int32_t kEbadf = -9, kEnodev = -19, kEmfile = -24;
+        // What finishCall does with the device's result: Pass returns it; Open returns the fd (or the error,
+        // freeing the slot); Close and Once (a name-only operation on a temporary slot) free the slot.
+        constexpr uint32_t kPass = 0u, kOpen = 1u, kClose = 2u, kOnce = 3u;
+        // The caller's frame below its sp: 16 bytes the device function may store its arguments in (o32), then
+        // the caller's ra, gp, the slot and the kind.
+        constexpr uint32_t kFrameSize = 32u;
+    }
+
     void IopIoman::reset()
     {
         m_devices.clear();
+        m_files = 0u;
+        m_fileDevices.assign(kMaxFiles, 0u);
+    }
+
+    const IopIoman::Device *IopIoman::fileDevice(uint32_t fd) const
+    {
+        if (fd >= m_fileDevices.size() || m_fileDevices[fd] == 0u)
+            return nullptr;
+        const auto device = std::find_if(m_devices.begin(), m_devices.end(),
+                                         [&](const Device &candidate) { return candidate.address == m_fileDevices[fd]; });
+        return device != m_devices.end() ? &*device : nullptr;
+    }
+
+    // "mc0:/BWNETCNF/BWNETCNF": the device named by the letters before the unit number and ':'; a free slot whose
+    // iop_file_t gets mode, unit and device; path = the guest address after ':'. Returns the slot or an error.
+    int32_t IopIoman::openSlot(uint32_t nameAddress, uint32_t mode, const Device *&device, uint32_t &path)
+    {
+        const std::string name = m_memory.readString(nameAddress, 256u);
+        const size_t colon = name.find(':');
+        if (colon == std::string::npos)
+            return kEnodev;
+        size_t unitStart = colon;
+        while (unitStart > 0u && std::isdigit(static_cast<unsigned char>(name[unitStart - 1u])))
+            --unitStart;
+        const std::string deviceName = name.substr(0u, unitStart);
+        const auto found = std::find_if(m_devices.begin(), m_devices.end(),
+                                        [&](const Device &candidate) { return candidate.name == deviceName; });
+        if (found == m_devices.end())
+            return kEnodev;
+        if (m_files == 0u)
+            m_files = m_memory.allocate(kMaxFiles * kFileSize, 16u);
+        if (m_fileDevices.size() < kMaxFiles)
+            m_fileDevices.resize(kMaxFiles, 0u);
+        const auto free = std::find(m_fileDevices.begin(), m_fileDevices.end(), 0u);
+        if (m_files == 0u || free == m_fileDevices.end())
+            return kEmfile;
+        const uint32_t slot = static_cast<uint32_t>(free - m_fileDevices.begin());
+        const uint32_t file = m_files + slot * kFileSize;
+        uint32_t unit = 0u;
+        for (size_t i = unitStart; i < colon; ++i)
+            unit = unit * 10u + static_cast<uint32_t>(name[i] - '0');
+        for (uint32_t i = 0; i < kFileSize; i += 4u)
+            m_memory.write32(file + i, 0u);
+        m_memory.write32(file + kFileMode, mode);
+        m_memory.write32(file + kFileUnit, unit);
+        m_memory.write32(file + kFileDevice, found->address);
+        m_fileDevices[slot] = found->address;
+        device = &*found;
+        path = nameAddress + static_cast<uint32_t>(colon) + 1u;
+        return static_cast<int32_t>(slot);
+    }
+
+    void IopIoman::callDevice(IopCpuState &cpu, const Device &device, uint32_t operation, uint32_t slot,
+                              uint32_t kind, uint32_t a1, uint32_t a2, uint32_t a3)
+    {
+        const uint32_t ops = m_memory.read32(device.address + kDeviceOps);
+        const uint32_t function = ops != 0u ? m_memory.read32(ops + operation) : 0u;
+        if (function == 0u)
+        {
+            if (kind != kPass)
+                m_fileDevices[slot] = 0u;
+            cpu.gpr[2] = static_cast<uint32_t>(kEnodev);
+            return; // the caller goes on at ra
+        }
+        const uint32_t sp = cpu.gpr[29] - kFrameSize;
+        m_memory.write32(sp + 16u, cpu.gpr[31]);
+        m_memory.write32(sp + 20u, cpu.gpr[28]);
+        m_memory.write32(sp + 24u, slot);
+        m_memory.write32(sp + 28u, kind);
+        cpu.gpr[29] = sp;
+        cpu.gpr[4] = m_files + slot * kFileSize;
+        cpu.gpr[5] = a1;
+        cpu.gpr[6] = a2;
+        cpu.gpr[7] = a3;
+        cpu.gpr[28] = device.gp;
+        cpu.gpr[31] = kIomanReturnSentinel;
+        cpu.pc = function;
+        cpu.branchPending = false;
+    }
+
+    void IopIoman::finishCall(IopCpuState &cpu)
+    {
+        const uint32_t sp = cpu.gpr[29];
+        const uint32_t ra = m_memory.read32(sp + 16u);
+        const uint32_t gp = m_memory.read32(sp + 20u);
+        const uint32_t slot = m_memory.read32(sp + 24u);
+        const uint32_t kind = m_memory.read32(sp + 28u);
+        const int32_t result = static_cast<int32_t>(cpu.gpr[2]);
+        if (slot < m_fileDevices.size() && (kind == kClose || kind == kOnce || (kind == kOpen && result < 0)))
+            m_fileDevices[slot] = 0u;
+        if (kind == kOpen && result >= 0)
+            cpu.gpr[2] = slot;
+        cpu.gpr[29] = sp + kFrameSize;
+        cpu.gpr[28] = gp;
+        cpu.pc = ra;
+        cpu.branchPending = false;
     }
 
     bool IopIoman::dispatchImport(uint16_t ordinal, IopCpuState &cpu, IopGuestExecutor &executor)
@@ -84,6 +201,63 @@ namespace ps2x::iop::detail
             setV0(0u);
             return true;
         }
+        case 4:  // open(name, flags)
+        case 13: // dopen(name)
+        case 10: // remove(name)
+        case 11: // mkdir(name)
+        case 12: // rmdir(name)
+        case 16: // getstat(name, stat)
+        case 17: // chstat(name, stat, mask)
+        case 18: // format(name)
+        {
+            const Device *device = nullptr;
+            uint32_t path = 0u;
+            const int32_t slot = openSlot(a0, ordinal == 4u ? cpu.gpr[5] : 0u, device, path);
+            if (slot < 0)
+            {
+                setV0(static_cast<uint32_t>(slot));
+                return true;
+            }
+            const uint32_t s = static_cast<uint32_t>(slot);
+            switch (ordinal)
+            {
+            case 4: callDevice(cpu, *device, kOpOpen, s, kOpen, path, cpu.gpr[5], 0u); break;
+            case 13: callDevice(cpu, *device, kOpDopen, s, kOpen, path, 0u, 0u); break;
+            case 10: callDevice(cpu, *device, kOpRemove, s, kOnce, path, 0u, 0u); break;
+            case 11: callDevice(cpu, *device, kOpMkdir, s, kOnce, path, 0u, 0u); break;
+            case 12: callDevice(cpu, *device, kOpRmdir, s, kOnce, path, 0u, 0u); break;
+            case 16: callDevice(cpu, *device, kOpGetstat, s, kOnce, path, cpu.gpr[5], 0u); break;
+            case 17: callDevice(cpu, *device, kOpChstat, s, kOnce, path, cpu.gpr[5], cpu.gpr[6]); break;
+            default: callDevice(cpu, *device, kOpFormat, s, kOnce, 0u, 0u, 0u); break;
+            }
+            return true;
+        }
+        case 5:  // close(fd)
+        case 14: // dclose(fd)
+        case 6:  // read(fd, buffer, size)
+        case 7:  // write(fd, buffer, size)
+        case 8:  // lseek(fd, offset, whence)
+        case 9:  // ioctl(fd, command, argument)
+        case 15: // dread(fd, dirent)
+        {
+            const Device *device = fileDevice(a0);
+            if (device == nullptr)
+            {
+                setV0(static_cast<uint32_t>(kEbadf));
+                return true;
+            }
+            switch (ordinal)
+            {
+            case 5: callDevice(cpu, *device, kOpClose, a0, kClose, 0u, 0u, 0u); break;
+            case 14: callDevice(cpu, *device, kOpDclose, a0, kClose, 0u, 0u, 0u); break;
+            case 6: callDevice(cpu, *device, kOpRead, a0, kPass, cpu.gpr[5], cpu.gpr[6], 0u); break;
+            case 7: callDevice(cpu, *device, kOpWrite, a0, kPass, cpu.gpr[5], cpu.gpr[6], 0u); break;
+            case 8: callDevice(cpu, *device, kOpLseek, a0, kPass, cpu.gpr[5], cpu.gpr[6], 0u); break;
+            case 9: callDevice(cpu, *device, kOpIoctl, a0, kPass, cpu.gpr[5], cpu.gpr[6], 0u); break;
+            default: callDevice(cpu, *device, kOpDread, a0, kPass, cpu.gpr[5], 0u, 0u); break;
+            }
+            return true;
+        }
         default:
             return false;
         }
