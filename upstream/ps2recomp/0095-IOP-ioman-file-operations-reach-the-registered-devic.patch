 constexpr uint32_t kThreadReturnSentinel = 0x1FFFFF00u;
 constexpr uint32_t kCallReturnSentinel = 0x1FFFFF04u;
+// A device function called by ioman (patch 0095) returns here: ioman turns its result into the caller's.
+constexpr uint32_t kIomanReturnSentinel = 0x1FFFFF08u;
 constexpr uint64_t kIopClockHz = 36'864'000ull;
 // NTSC field cadence (approximately 59.94 Hz).  VBlank imports are
 // scheduler waits, not no-op timing hints: returning immediately lets
diff --git a/ps2xIOP/tests/iop_emulator_tests.cpp b/ps2xIOP/tests/iop_emulator_tests.cpp
index 12b92b0..cffc709 100644
--- a/ps2xIOP/tests/iop_emulator_tests.cpp
+++ b/ps2xIOP/tests/iop_emulator_tests.cpp
@@ -337,6 +337,74 @@ namespace
         std::memcpy(host.guest.data() + address + codeOffset + 0x80u, imports, sizeof(imports));
     }
 
+    // A module with an ioman device "tst" (patch 0095): AddDrv, open("tst3:/ab", 1), read 4 bytes, close, then
+    // open("nod0:/x"). The device's open stores path[1] (path = after the colon) + unit + flags in the file's
+    // privdata; its read writes that byte to the buffer and returns the size. Returns byte | read count << 8 |
+    // fd << 16 | (second open & 0xFF) << 24.
+    void writeIomanIrx(TestHost &host, uint32_t address)
+    {
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t loadAddress = 0x00017000u;
+        ElfHeader header{};
+        header.ident[0] = 0x7Fu; header.ident[1] = 'E'; header.ident[2] = 'L'; header.ident[3] = 'F';
+        header.ident[4] = 1u; header.ident[5] = 1u; header.ident[6] = 1u;
+        header.type = 2u; header.machine = 8u; header.version = 1u;
+        header.entry = loadAddress; header.phoff = sizeof(ElfHeader);
+        header.ehsize = sizeof(ElfHeader); header.phentsize = sizeof(ProgramHeader); header.phnum = 1u;
+        ProgramHeader program{};
+        program.type = 1u; program.offset = codeOffset; program.vaddr = loadAddress; program.paddr = loadAddress;
+        program.filesz = 0x400u; program.memsz = 0x400u; program.flags = 7u; program.align = 4u;
+        const auto jal = [](uint32_t target) { return 0x0C000000u | ((target >> 2) & 0x03FFFFFFu); };
+        const uint32_t stubAddDrv = loadAddress + 0x194u, stubOpen = loadAddress + 0x19Cu,
+                       stubRead = loadAddress + 0x1A4u, stubClose = loadAddress + 0x1ACu;
+        const uint32_t code[] = {
+            0x27BDFFE0u, 0xAFBF001Cu, 0xAFB00018u, 0xAFB10014u, // frame; save ra, s0, s1
+            0x3C040001u, jal(stubAddDrv), 0x34847200u,          // AddDrv(&device @0x17200)
+            0x24050001u, 0x3C040001u, jal(stubOpen), 0x34847248u, // open("tst3:/ab", 1)
+            0x00408025u,                                        // s0 = fd
+            0x02002025u, 0x3C050001u, 0x34A57300u, jal(stubRead), 0x24060004u, // read(fd, @0x17300, 4)
+            0x00408825u,                                        // s1 = count
+            jal(stubClose), 0x02002025u,                        // close(fd)
+            0x3C040001u, jal(stubOpen), 0x34847258u,            // open("nod0:/x", ...)
+            0x00021600u, 0x00118A00u, 0x00511025u, 0x00108400u, 0x00501025u, // v0 = v0 << 24 | s1 << 8 | s0 << 16
+            0x3C080001u, 0x91097300u, 0u, 0x00491025u,          // | buffer[0]
+            0x8FB10014u, 0x8FB00018u, 0x8FBF001Cu, 0u,
+            0x03E00008u, 0x27BD0020u,
+        };
+        const uint32_t functions[] = {
+            0x03E00008u, 0x24020000u,                           // @0x100 return 0
+            0x90A80001u, 0x8C890004u, 0u, 0x01094021u, 0x01064021u, 0xAC88000Cu, 0x03E00008u, 0x24020000u, // @0x108 open
+            0x8C88000Cu, 0u, 0xA0A80000u, 0x03E00008u, 0x00C01021u, // @0x128 read
+        };
+        const uint32_t imports[] = {
+            0x41E00000u, 0u, 0x00000104u,
+            0x616D6F69u, 0x0000006Eu, // "ioman"
+            0x03E00008u, 0x24000014u, // 20 AddDrv
+            0x03E00008u, 0x24000004u, // 4 open
+            0x03E00008u, 0x24000006u, // 6 read
+            0x03E00008u, 0x24000005u, // 5 close
+            0u, 0u,
+        };
+        const uint32_t device[] = {loadAddress + 0x240u, 0x10u, 0x100u, 0u, loadAddress + 0x260u};
+        uint32_t ops[17];
+        for (uint32_t &op : ops)
+            op = loadAddress + 0x100u;
+        ops[3] = loadAddress + 0x108u; // open
+        ops[5] = loadAddress + 0x128u; // read
+        uint8_t *image = host.guest.data() + address + codeOffset;
+        std::memset(host.guest.data() + address, 0, codeOffset + program.filesz);
+        std::memcpy(host.guest.data() + address, &header, sizeof(header));
+        std::memcpy(host.guest.data() + address + sizeof(header), &program, sizeof(program));
+        std::memcpy(image, code, sizeof(code));
+        std::memcpy(image + 0x100u, functions, sizeof(functions));
+        std::memcpy(image + 0x180u, imports, sizeof(imports));
+        std::memcpy(image + 0x200u, device, sizeof(device));
+        std::memcpy(image + 0x240u, "tst", 4);
+        std::memcpy(image + 0x248u, "tst3:/ab", 9);
+        std::memcpy(image + 0x258u, "nod0:/x", 8);
+        std::memcpy(image + 0x260u, ops, sizeof(ops));
+    }
