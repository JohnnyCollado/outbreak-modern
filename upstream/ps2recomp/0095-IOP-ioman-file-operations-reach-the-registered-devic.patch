+                        uint32_t a1, uint32_t a2, uint32_t a3);
+        [[nodiscard]] int32_t openSlot(uint32_t nameAddress, uint32_t mode, const Device *&device, uint32_t &path);
+        [[nodiscard]] const Device *fileDevice(uint32_t fd) const;
+
         IopMemory &m_memory;
         std::vector<Device> m_devices;
+        uint32_t m_files = 0u;                      // guest iop_file_t table, kMaxFiles * kFileSize
+        std::vector<uint32_t> m_fileDevices;        // per slot: the device's iop_device_t address; 0 = free
     };
 }
