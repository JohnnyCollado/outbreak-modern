From d0da8fa396dec110d64f10111e7b093e351d3345 Mon Sep 17 00:00:00 2001
From: JohnnyC96 <54557697+JohnnyC96@users.noreply.github.com>
Date: Wed, 21 Oct 2026 10:36:48 -0400
Subject: [PATCH 10/12] EE threads: accept priority 0

CreateThread and ChangeThreadPriority rejected priority 0 with
KE_ILLEGAL_PRIORITY. EE priorities are 0-127 (ps2sdk: MAX_PRIORITY 128);
only the IOP kernel reserves 0. ps2sdk's own InitThread creates its
KernelTopThread at initial_priority 0 and treats a failure as an error, so
the hardware accepts it. The runtime already starts the main thread at 0.

Found with Resident Evil Outbreak (SLPM-65428): CRI ADX creates its server
threads with the main thread's priority; every CreateThread failed, no
ADX thread existed, and the file system never finished loading.
---
 ps2xRuntime/src/lib/Kernel/EeScheduler.cpp |  5 +--
 ps2xTest/src/ps2_runtime_kernel_tests.cpp  | 41 ++++++++++++++++++++++
 2 files changed, 44 insertions(+), 2 deletions(-)

diff --git a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
index c5e31c4..20e8af3 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -423,7 +423,8 @@ void EeScheduler::setupCurrentThread(uint32_t stack, uint32_t stackSize, uint32_
 int EeScheduler::createThread(const EeThreadCreateParams &params)
 {
     assertExecutor();
-    if (params.priority < 1 || params.priority >= kPriorityCount)
+    // EE priorities are 0-127; only the IOP kernel reserves 0.
+    if (params.priority < 0 || params.priority >= kPriorityCount)
     {
         return KE_ILLEGAL_PRIORITY;
     }
@@ -701,7 +702,7 @@ int EeScheduler::cancelWakeup(int id)
 int EeScheduler::changePriority(int id, int priority, bool interruptSafe, int &oldPriority)
 {
     assertExecutor();
-    if (priority < 1 || priority >= kPriorityCount)
+    if (priority < 0 || priority >= kPriorityCount)
     {
         return KE_ILLEGAL_PRIORITY;
     }
diff --git a/ps2xTest/src/ps2_runtime_kernel_tests.cpp b/ps2xTest/src/ps2_runtime_kernel_tests.cpp
index 63b12d9..22b149d 100644
--- a/ps2xTest/src/ps2_runtime_kernel_tests.cpp
+++ b/ps2xTest/src/ps2_runtime_kernel_tests.cpp
@@ -22,6 +22,7 @@ namespace
 
     constexpr int KE_OK = 0;
     constexpr int KE_ERROR = -1;
+    constexpr int KE_ILLEGAL_PRIORITY = -403;
     constexpr int KE_ILLEGAL_THID = -406;
     constexpr int KE_UNKNOWN_THID = -407;
     constexpr int KE_UNKNOWN_SEMID = -408;
@@ -572,6 +573,46 @@ void register_ps2_runtime_kernel_tests()
                      "SET_GPR_U32 must preserve the upper 64 bits of the 128-bit GPR");
         });
 
+        tc.Run("EE thread priorities are 0-127: 0 is valid for CreateThread and ChangeThreadPriority", [](TestCase &t)
+        {
+            // Unlike the IOP kernel, the EE kernel accepts priority 0 (ps2sdk: MAX_PRIORITY 128).
+            // CRI ADX creates its server threads at priority 0 and its V-sync handler switches
+            // the main thread to priority 0; rejecting it left Outbreak's file system without threads.
+            TestEnv env;
+            EeThreadCreateAbi threadParam{};
+            threadParam.func = K_SCHED_HIGH;
+            threadParam.stack = 0x00018000u;
+            threadParam.stack_size = 0x1000;
+            threadParam.initial_priority = 0;
+            std::memcpy(env.rdram.data() + K_PARAM_ADDR, &threadParam, sizeof(threadParam));
+            setRegU32(env.ctx, 4, K_PARAM_ADDR);
+            CreateThread(env.rdram.data(), &env.ctx, &env.runtime);
+            const int threadId = getRegS32(env.ctx, 2);
+            const GuestThread *thread = env.runtime.eeScheduler().thread(threadId);
+            t.IsTrue(threadId >= 2 && thread != nullptr, "CreateThread must accept initial_priority 0");
+
+            setRegU32(env.ctx, 4, static_cast<uint32_t>(threadId));
+            setRegU32(env.ctx, 5, 9u);
+            ChangeThreadPriority(env.rdram.data(), &env.ctx, &env.runtime);
+            setRegU32(env.ctx, 4, static_cast<uint32_t>(threadId));
+            setRegU32(env.ctx, 5, 0u);
+            ChangeThreadPriority(env.rdram.data(), &env.ctx, &env.runtime);
+            t.IsTrue(getRegS32(env.ctx, 2) >= 0, "ChangeThreadPriority to 0 must succeed");
+            t.Equals(thread ? thread->currentPriority : -1, 0, "the thread must now be at priority 0");
+
+            threadParam.initial_priority = 128;
+            std::memcpy(env.rdram.data() + K_PARAM_ADDR, &threadParam, sizeof(threadParam));
+            setRegU32(env.ctx, 4, K_PARAM_ADDR);
+            CreateThread(env.rdram.data(), &env.ctx, &env.runtime);
+            t.Equals(getRegS32(env.ctx, 2), KE_ILLEGAL_PRIORITY, "priority 128 is out of range");
+
+            threadParam.initial_priority = -1;
+            std::memcpy(env.rdram.data() + K_PARAM_ADDR, &threadParam, sizeof(threadParam));
+            setRegU32(env.ctx, 4, K_PARAM_ADDR);
+            CreateThread(env.rdram.data(), &env.ctx, &env.runtime);
+            t.Equals(getRegS32(env.ctx, 2), KE_ILLEGAL_PRIORITY, "a negative priority is out of range");
+        });
+
         tc.Run("CreateThread and CreateSema decode the exact PS2SDK EE layouts", [](TestCase &t)
         {
             TestEnv env;
-- 
