index 2ac76ba..37a9c42 100644
--- a/ps2xTest/src/ps2_memory_tests.cpp
+++ b/ps2xTest/src/ps2_memory_tests.cpp
@@ -9,6 +9,7 @@
 
 #include <algorithm>
 #include <cstdint>
+#include <cstdio>
 #include <cstring>
 #include <vector>
 
@@ -153,12 +154,127 @@ namespace
         appendU64(packet, 0u);
     }
 
+    // Patch 0053: random VIF1 streams for the UNPACK equivalence check. Deterministic (xorshift, fixed seed): every
+    // UNPACK format (V1..V4 x 32/16/8 bit, V4-5, the unhandled vl=3 forms), mask on/off, mode 0-3, STCYCL cl/wl
+    // (cl >= wl and cl < wl), TOPS-relative addresses, zero/sign extension, between STCYCL/STMOD/STMASK/STROW/STCOL/
+    // BASE/OFFSET. The payload size follows the interpreter's formula so the stream stays in sync.
+    struct VifRng
+    {
+        uint64_t s;
+        uint32_t next()
+        {
+            s ^= s << 13u;
+            s ^= s >> 7u;
+            s ^= s << 17u;
+            return static_cast<uint32_t>(s >> 11u);
+        }
+        uint32_t below(uint32_t n) { return next() % n; }
+    };
+
+    uint32_t vifUnpackPayloadBytes(uint8_t opcode, uint32_t num, uint32_t cycle)
+    {
+        const uint32_t vn = (opcode >> 2) & 3u, vl = opcode & 3u;
+        const uint32_t components = vn + 1u;
+        const uint32_t bits = vl == 0u ? 32u : vl == 1u ? 16u : vl == 2u ? 8u : (vn == 3u ? 4u : 16u);
+        const uint32_t bitsPerVector = (vl == 3u && vn == 3u) ? 16u : components * bits;
+        const uint32_t bytesPerVector = (bitsPerVector + 7u) / 8u;
+        const uint32_t writes = num == 0u ? 256u : num;
+        uint32_t cl = cycle & 0xFFu, wl = (cycle >> 8) & 0xFFu;
+        if (cl == 0u)
+            cl = 1u;
+        if (wl == 0u)
+            wl = 1u;
+        uint32_t source = writes;
+        if (cl < wl)
+            source = (writes / wl) * cl + std::min(writes % wl, cl);
+        return (source * bytesPerVector + 3u) & ~3u;
+    }
+
+    std::vector<uint8_t> makeRandomVifSegment(VifRng &rng, uint32_t &cycle)
+    {
+        std::vector<uint8_t> s;
+        for (uint32_t k = 0; k < 160u; ++k)
+        {
+            switch (rng.below(10u))
+            {
+            case 0:
+                cycle = (rng.below(5u)) | (rng.below(5u) << 8);
+                appendU32(s, makeVifCmd(0x01u, 0u, static_cast<uint16_t>(cycle))); // STCYCL
+                break;
+            case 1:
+                appendU32(s, makeVifCmd(0x05u, 0u, static_cast<uint16_t>(rng.below(4u)))); // STMOD
+                break;
+            case 2:
+                appendU32(s, makeVifCmd(0x20u, 0u, 0u)); // STMASK
+                appendU32(s, rng.next() ^ (rng.next() << 16));
+                break;
+            case 3:
+                appendU32(s, makeVifCmd(rng.below(2u) ? 0x30u : 0x31u, 0u, 0u)); // STROW / STCOL
+                for (int i = 0; i < 4; ++i)
+                    appendU32(s, rng.next());
+                break;
+            case 4:
+                appendU32(s, makeVifCmd(rng.below(2u) ? 0x03u : 0x02u, 0u, static_cast<uint16_t>(rng.below(0x400u)))); // BASE/OFFSET
+                break;
+            default:
+            {
+                const uint8_t opcode = static_cast<uint8_t>(0x60u | rng.below(0x20u));
+                const uint32_t num = rng.below(16u) == 0u ? 0u : 1u + rng.below(40u);
+                const uint16_t imm = static_cast<uint16_t>(rng.below(0x400u) | (rng.below(2u) << 15) | (rng.below(2u) << 14));
+                appendU32(s, makeVifCmd(opcode, static_cast<uint8_t>(num), imm));
+                const uint32_t bytes = vifUnpackPayloadBytes(opcode, num, cycle);
+                for (uint32_t b = 0; b < bytes; ++b)
+                    s.push_back(static_cast<uint8_t>(rng.next()));
+                break;
+            }
+            }
+        }
+        return s;
+    }
+
+    uint64_t fnv1a(uint64_t h, const void *data, size_t size)
+    {
+        const uint8_t *p = static_cast<const uint8_t *>(data);
+        for (size_t i = 0; i < size; ++i)
+            h = (h ^ p[i]) * 0x100000001B3ull;
+        return h;
+    }
+
 }
 
 void register_ps2_memory_tests()
 {
     MiniTest::Case("PS2Memory", [](TestCase &tc)
     {
+        tc.Run("VIF1 UNPACK: 8 random segments give the recorded VU1 data and ROW/COL hashes", [](TestCase &t)
+        {
+            // Recorded with the pre-0053 interpreter (per-field loop): the faster UNPACK must reproduce them bit for bit.
+            static const uint64_t kExpected[8] = {
+                0x0CB077BA16DCA3F8ull, 0x8E5F0DD28A8A1244ull, 0x378F08F85CFD52EDull, 0xB1572F6CA4109B78ull,
+                0x07E8400B67DDD127ull, 0x2BE3A67BC5B00A44ull, 0x89B233BCA5CBE720ull, 0x2EB9C99D0808E4D4ull,
+            };
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            uint8_t *vu1 = mem.getVU1Data();
+            for (uint32_t i = 0; i < PS2_VU1_DATA_SIZE; ++i)
+                vu1[i] = static_cast<uint8_t>(i * 7u + 3u);
+            VifRng rng{0x9E3779B97F4A7C15ull};
+            uint32_t cycle = 0x0101u;
+            bool all = true;
+            for (int seg = 0; seg < 8; ++seg)
+            {
+                const std::vector<uint8_t> stream = makeRandomVifSegment(rng, cycle);
+                mem.processVIF1Data(stream.data(), static_cast<uint32_t>(stream.size()));
+                uint64_t h = fnv1a(0xCBF29CE484222325ull, vu1, PS2_VU1_DATA_SIZE);
+                h = fnv1a(h, mem.vif1_regs.row, sizeof(mem.vif1_regs.row));
+                h = fnv1a(h, mem.vif1_regs.col, sizeof(mem.vif1_regs.col));
+                std::printf("  vif1 unpack segment %d: 0x%016llXull (%zu bytes)\n", seg, static_cast<unsigned long long>(h),
+                            stream.size());
+                all = all && h == kExpected[seg];
+            }
+            t.IsTrue(all, "VU1 data / ROW / COL hashes equal the recorded ones");
+        });
+
         tc.Run("uncached aliases map to same RDRAM bytes", [](TestCase &t)
         {
             PS2Memory mem;
