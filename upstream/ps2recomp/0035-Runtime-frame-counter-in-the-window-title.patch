 ps2xRuntime/src/lib/ps2_runtime.cpp           | 18 +++++++
 ps2xTest/CMakeLists.txt                       |  1 +
 ps2xTest/src/main.cpp                         |  2 +
 ps2xTest/src/ps2_fps_counter_tests.cpp        | 32 ++++++++++++
 5 files changed, 103 insertions(+)
 create mode 100644 ps2xRuntime/include/runtime/ps2_fps_counter.h
 create mode 100644 ps2xTest/src/ps2_fps_counter_tests.cpp

diff --git a/ps2xRuntime/include/runtime/ps2_fps_counter.h b/ps2xRuntime/include/runtime/ps2_fps_counter.h
new file mode 100644
index 0000000..162e0fd
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_fps_counter.h
@@ -0,0 +1,50 @@
+#ifndef PS2_FPS_COUNTER_H
+#define PS2_FPS_COUNTER_H
+
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+// Frame counter for the window title: guest vsyncs per wall-clock second, recomputed once per second.
+// Main thread: update() once per presented host frame (one subtraction and compare); the caller sets the
+// title only when update() returns true, i.e. once per second.
+class Ps2FpsCounter
+{
+public:
+    // True when at least one second passed since the previous rate (or since the first call): fps() is new.
+    bool update(double nowSeconds, uint64_t vsyncTick)
+    {
+        if (!m_started)
+        {
+            m_started = true;
+            m_startSeconds = nowSeconds;
+            m_startTick = vsyncTick;
+            return false;
+        }
+        const double elapsed = nowSeconds - m_startSeconds;
+        if (elapsed < 1.0)
+            return false;
+        m_fps = static_cast<double>(vsyncTick - m_startTick) / elapsed;
+        m_startSeconds = nowSeconds;
+        m_startTick = vsyncTick;
+        return true;
+    }
+
+    double fps() const { return m_fps; }
+
+    // "<base> | 59.9 fps"
+    static std::string title(const std::string &base, double fps)
+    {
+        char rate[32];
+        std::snprintf(rate, sizeof(rate), "%.1f", fps);
+        return base + " | " + rate + " fps";
+    }
+
+private:
+    bool m_started = false;
+    double m_startSeconds = 0.0;
+    uint64_t m_startTick = 0;
+    double m_fps = 0.0;
+};
+
+#endif
