diff --git a/ps2xTest/src/ps2_fps_counter_tests.cpp b/ps2xTest/src/ps2_fps_counter_tests.cpp
new file mode 100644
index 0000000..f95ac27
--- /dev/null
+++ b/ps2xTest/src/ps2_fps_counter_tests.cpp
@@ -0,0 +1,32 @@
+#include "MiniTest.h"
+#include "runtime/ps2_fps_counter.h"
+
+#include <cmath>
+#include <string>
+
+void register_ps2_fps_counter_tests()
+{
+    MiniTest::Case("FpsCounter", [](TestCase &tc)
+    {
+        tc.Run("counts guest vsyncs per wall second, recomputed once per second", [](TestCase &t)
+        {
+            Ps2FpsCounter c;
+            t.IsFalse(c.update(100.0, 1000u), "the first call only starts the window");
+            t.IsFalse(c.update(100.5, 1030u), "no rate before one second");
+            t.IsFalse(c.update(100.99, 1059u), "still under one second");
+            t.IsTrue(c.update(101.0, 1060u), "a rate after one second");
+            t.IsTrue(std::fabs(c.fps() - 60.0) < 1e-9, "60 vsyncs in 1.0 s = 60 fps");
+            t.IsFalse(c.update(101.5, 1074u), "the window restarted at the last rate");
+            t.IsTrue(c.update(102.25, 1087u), "next rate after 1.25 s");
+            t.IsTrue(std::fabs(c.fps() - 27.0 / 1.25) < 1e-9, "27 vsyncs in 1.25 s = 21.6 fps");
+            t.IsTrue(c.update(104.25, 1087u), "a stalled guest still gets a rate");
+            t.IsTrue(c.fps() == 0.0, "no vsyncs = 0 fps");
+        });
+
+        tc.Run("title is '<base> | <rate, one decimal> fps'", [](TestCase &t)
+        {
+            t.Equals(Ps2FpsCounter::title("Outbreak", 59.94), std::string("Outbreak | 59.9 fps"), "one decimal");
+            t.Equals(Ps2FpsCounter::title("Outbreak", 27.0), std::string("Outbreak | 27.0 fps"), "trailing zero kept");
+        });
+    });
+}
