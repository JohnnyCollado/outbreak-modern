+static std::string s_windowTitle;
+static bool s_windowHidden = false;
+
 static void UploadFrame(Texture2D &tex, PS2Runtime *rt, uint32_t &outWidth, uint32_t &outHeight)
 {
     static const char *s_frameDumpDir = std::getenv("PS2X_FRAME_DUMP_DIR");
@@ -977,6 +983,8 @@ bool PS2Runtime::initialize(const char *title)
         const unsigned int windowFlags = hidden ? (FLAG_WINDOW_RESIZABLE | FLAG_WINDOW_HIDDEN) : FLAG_WINDOW_RESIZABLE;
         SetConfigFlags(windowFlags);
         InitWindow(HOST_WINDOW_WIDTH, HOST_WINDOW_HEIGHT, title);
+        s_windowTitle = title ? title : "";
+        s_windowHidden = hidden;
         if (hidden)
         {
             SetExitKey(KEY_NULL); // a hidden window is never closed by input
@@ -2781,6 +2789,16 @@ void PS2Runtime::run()
         }
         EndDrawing();
 
+        // Frame counter: guest vsyncs per wall second, in the title once per second.
+        static Ps2FpsCounter s_fps;
+        if (s_fps.update(std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count(),
+                         m_eeScheduler->currentVSyncTick()))
+        {
+            SetWindowTitle(Ps2FpsCounter::title(s_windowTitle, s_fps.fps()).c_str());
+            if (s_windowHidden)
+                std::cout << "[fps] " << Ps2FpsCounter::title("tick " + std::to_string(m_eeScheduler->currentVSyncTick()), s_fps.fps()) << std::endl;
+        }
+
         if (const Ps2InputScript *script = ps2ActiveInputScript())
         {
             std::string timeoutMessage;
