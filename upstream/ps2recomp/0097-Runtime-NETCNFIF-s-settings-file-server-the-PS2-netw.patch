+void register_ps2_netcnf_tests()
+{
+    using namespace ps2x::netcnf;
+
+    MiniTest::Case("Netcnf", [](TestCase &tc)
+    {
+        tc.Run("scrambling: each 16-bit word rotated left by the console ID's key, then inverted", [](TestCase &t)
+        {
+            // ID byte 0xAA gives rotations 6, 3, 3. "# " = 0x2023 rotated left 6 = 0x08C8, inverted = 0xF737.
+            t.IsTrue(scramble(bytes("# ")) == std::vector<uint8_t>{0x37u, 0xF7u}, "first word with rotation 6");
+            // Another ID: 0x01 gives (0 + 1, 0 + 1, 1 + 1) = 1, 1, 2: 0x2023 rotated left 1 = 0x4046, inverted 0xBFB9.
+            std::array<uint8_t, 8> other{};
+            other.fill(0x01u);
+            t.IsTrue(scramble(bytes("# "), other) == std::vector<uint8_t>{0xB9u, 0xBFu}, "the key follows the ID");
+            // An odd last byte is rotated within 8 bits: 'd' = 0x64 rotated left 3 = 0x23, inverted 0xDC.
+            const std::vector<uint8_t> odd = scramble(bytes("odd"));
+            t.Equals(odd.size(), static_cast<size_t>(3), "odd length kept");
+            t.IsTrue(odd.size() == 3 && odd[2] == 0xDCu, "odd last byte");
+        });
+
+        tc.Run("the DHCP settings set equals the reference writer's bytes", [](TestCase &t)
+        {
+            NetworkConfig config;
+            const std::vector<SettingsFile> files = settingsFiles(config);
+            t.Equals(files.size(), static_cast<size_t>(4), "index, combination, interface, device");
+            if (files.size() != 4)
+                return;
+            t.Equals(files[0].name, std::string("BWNETCNF"), "index name");
+            t.Equals(files[1].name, std::string("net000.cnf"), "combination name");
+            t.Equals(files[2].name, std::string("ifc000.dat"), "interface name");
+            t.Equals(files[3].name, std::string("dev000.dat"), "device name");
+            t.IsTrue(files[0].data == fromHex(kIndexHex), "index bytes");
+            t.IsTrue(files[1].data == fromHex(kCombinationHex), "combination bytes");
+            t.IsTrue(files[2].data == fromHex(kInterfaceHex), "interface bytes (scrambled 'type eth', 'dhcp')");
+            t.IsTrue(files[3].data == fromHex(kDeviceHex), "device bytes (scrambled vendor/product/phy_config)");
+        });
+
+        tc.Run("a fixed address writes netcnf's address keywords instead of dhcp", [](TestCase &t)
+        {
+            NetworkConfig config;
+            config.dhcp = false;
+            config.address = "192.168.1.20";
+            config.netmask = "255.255.255.0";
+            config.gateway = "192.168.1.1";
+            config.dns1 = "192.168.1.1";
+            const std::vector<SettingsFile> files = settingsFiles(config);
+            // The interface file, unscrambled by the inverse of the test's own formula, must hold the keywords
+            // netcnf's parser knows (netcnfif.c prints them as "address", "netmask", "gateway", "dns1_address",
+            // "dns2_address") and no "dhcp" line.
+            t.Equals(files.size(), static_cast<size_t>(4), "four files");
+            if (files.size() != 4)
+                return;
+            // Scramble the expected plain text and compare the scrambled bytes.
+            const std::vector<uint8_t> expected = scramble(bytes(
+                "# <Sony Computer Entertainment Inc.>\n\ntype eth\naddress 192.168.1.20\nnetmask 255.255.255.0\n"
+                "gateway 192.168.1.1\ndns1_address 192.168.1.1\n"));
+            t.IsTrue(files[2].data == expected, "static interface file");
+        });
+
+        tc.Run("PS2X_NETCNF selects the configuration", [](TestCase &t)
+        {
+            t.IsFalse(configFromEnvironment(nullptr).has_value(), "unset = none");
+            t.IsFalse(configFromEnvironment("").has_value(), "empty = none");
+            t.IsFalse(configFromEnvironment("off").has_value(), "off = none");
+            t.IsFalse(configFromEnvironment("maybe").has_value(), "unknown = none");
+            const auto dhcp = configFromEnvironment("dhcp");
+            t.IsTrue(dhcp.has_value() && dhcp->dhcp, "dhcp");
+            const auto fixed = configFromEnvironment("static:10.0.0.5,255.0.0.0,10.0.0.1,8.8.8.8,8.8.4.4");
+            t.IsTrue(fixed.has_value() && !fixed->dhcp && fixed->address == "10.0.0.5" && fixed->netmask == "255.0.0.0" &&
+                         fixed->gateway == "10.0.0.1" && fixed->dns1 == "8.8.8.8" && fixed->dns2 == "8.8.4.4",
+                     "static with five addresses");
+            t.IsFalse(configFromEnvironment("static:10.0.0.5").has_value(), "static needs at least four");
+        });
+
+        tc.Run("RPC 12/13/14 open, read and close the files by their path's last name", [](TestCase &t)
+        {
+            SettingsServer server{NetworkConfig{}};
+            std::vector<uint8_t> reply;
+            t.IsTrue(server.call(12u, openRequest("mc0:", "/BWNETCNF/BWNETCNF"), reply), "open served");
+            const uint32_t fd = getU32(reply, 0);
+            t.IsTrue(static_cast<int32_t>(fd) >= 0, "open returns a handle");
+            t.Equals(getU32(reply, 4), 99u, "open returns the index file's size");
+
+            t.IsTrue(server.call(13u, readRequest(fd, 0u, 99u), reply), "read served");
+            t.Equals(getU32(reply, 0), 99u, "read returns the count");
+            t.IsTrue(reply.size() >= 4 + 99 && std::vector<uint8_t>(reply.begin() + 4, reply.begin() + 4 + 99) == fromHex(kIndexHex),
+                     "the data follows the count");
+
+            t.IsTrue(server.call(13u, readRequest(fd, 95u, 50u), reply), "a read past the end is served");
+            t.Equals(getU32(reply, 0), 4u, "and clipped to the file");
+
+            t.IsTrue(server.call(14u, closeRequest(fd), reply), "close served");
+            t.Equals(getU32(reply, 0), 0u, "close returns 0");
+            t.IsTrue(server.call(13u, readRequest(fd, 0u, 4u), reply) && static_cast<int32_t>(getU32(reply, 0)) < 0,
+                     "a closed handle reads an error");
+
+            t.IsTrue(server.call(12u, openRequest("mc0:", "/BWNETCNF/ifc000.dat"), reply), "open the interface file");
+            t.Equals(getU32(reply, 4), 52u, "its size");
+            const uint32_t fd2 = getU32(reply, 0);
+            t.IsTrue(server.call(12u, openRequest("mc0:", "/BWNETCNF/dev000.dat"), reply), "open the device file too");
+            t.Equals(getU32(reply, 4), 113u, "its size");
+            t.IsTrue(getU32(reply, 0) != fd2, "a different handle while both are open");
+
+            t.IsTrue(server.call(12u, openRequest("mc0:", "/BWNETCNF/nothere.cnf"), reply), "an unknown name is answered");
+            t.IsTrue(static_cast<int32_t>(getU32(reply, 0)) < 0, "with an error");
+            t.IsFalse(server.call(2u, closeRequest(0u), reply), "other functions are not this server's");
+        });
+    });
+}
