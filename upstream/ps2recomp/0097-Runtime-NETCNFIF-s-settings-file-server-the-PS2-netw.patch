+#include "MiniTest.h"
+#include "runtime/ps2_netcnf.h"
+
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace
+{
+    // The four files for "network adapter, DHCP" as the reference writer (outbreak-modern tools/ob/mcd.py
+    // netcnf, checked against the game's netcnf.irx) produces them; hex from `mcd.netcnf_files` on 2026-10-27.
+    const char *const kIndexHex =
+        "302c312c6e65743030302e636e662c436f6d62696e6174696f6e310a312c312c6966633030302e6461742c53657474696e6720310a"
+        "322c312c6465763030302e6461742c5343452f45746865726e657420284e6574776f726b2041646170746f72290a";
+    const char *const kCombinationHex =
+        "23203c536f6e7920436f6d707574657220456e7465727461696e6d656e7420496e632e3e0a0a696e74657266616365202243"
+        "6f6d62696e6174696f6e312220226966633030302e6461742220226465763030302e646174220a";
+    const char *const kInterfaceHex =
+        "37f71d66848cb7e1e485947ca2e2d46cfdd662e4d46c5cf4a46594d48c5cedb78ce48e0e7d7d5c347cd4e6b75cbcacdfe7257fac";
+    const char *const kDeviceHex =
+        "37f71d66848cb7e1e485947ca2e2d46cfdd662e4d46c5cf4a46594d48c5cedb78ce48e0e7d7d5c347cd4e6b75cbcac4fa466dc84"
+        "6efc6b37e5d5efaee36384dc54e4f7e2edd65cbca3668cd45efcec75d45c44846523fdf6dcf4e2e3846cb6ee63fdbc3404e5246"
+        "4ccb4c6fca2a75c84af";
+
+    std::vector<uint8_t> fromHex(const char *hex)
+    {
+        std::vector<uint8_t> out;
+        for (size_t i = 0; hex[i] && hex[i + 1]; i += 2)
+            out.push_back(static_cast<uint8_t>(std::stoul(std::string(hex + i, 2), nullptr, 16)));
+        return out;
+    }
+
+    std::vector<uint8_t> bytes(const char *text)
+    {
+        return std::vector<uint8_t>(text, text + std::strlen(text));
+    }
+
+    void putU32(std::vector<uint8_t> &v, uint32_t value)
+    {
+        for (int i = 0; i < 4; ++i)
+            v.push_back(static_cast<uint8_t>(value >> (8 * i)));
+    }
+
+    uint32_t getU32(const std::vector<uint8_t> &v, size_t offset)
+    {
+        uint32_t value = 0;
+        for (int i = 0; i < 4; ++i)
+            value |= static_cast<uint32_t>(offset + i < v.size() ? v[offset + i] : 0u) << (8 * i);
+        return value;
+    }
+
+    // netcnfif.c sce_callback_open's buffer: flags, mode, devlen, pathlen, device, path (lengths include the NUL).
+    std::vector<uint8_t> openRequest(const char *device, const char *path, uint32_t flags = 1u)
+    {
+        std::vector<uint8_t> v;
+        putU32(v, flags);
+        putU32(v, 0u);
+        putU32(v, static_cast<uint32_t>(std::strlen(device) + 1));
+        putU32(v, static_cast<uint32_t>(std::strlen(path) + 1));
+        v.insert(v.end(), device, device + std::strlen(device) + 1);
+        v.insert(v.end(), path, path + std::strlen(path) + 1);
+        return v;
+    }
+
+    // sce_callback_read's: fd, devlen, pathlen, offset, size, device, path.
+    std::vector<uint8_t> readRequest(uint32_t fd, uint32_t offset, uint32_t size, const char *device = "mc0:",
+                                     const char *path = "/BWNETCNF/BWNETCNF")
+    {
+        std::vector<uint8_t> v;
+        putU32(v, fd);
+        putU32(v, static_cast<uint32_t>(std::strlen(device) + 1));
+        putU32(v, static_cast<uint32_t>(std::strlen(path) + 1));
+        putU32(v, offset);
+        putU32(v, size);
+        v.insert(v.end(), device, device + std::strlen(device) + 1);
+        v.insert(v.end(), path, path + std::strlen(path) + 1);
+        return v;
+    }
+
+    std::vector<uint8_t> closeRequest(uint32_t fd)
+    {
+        std::vector<uint8_t> v;
+        putU32(v, fd);
+        return v;
+    }
+}
