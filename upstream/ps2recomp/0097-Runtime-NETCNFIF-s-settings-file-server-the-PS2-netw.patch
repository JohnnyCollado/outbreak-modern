diff --git a/ps2xRuntime/src/lib/ps2_netcnf.cpp b/ps2xRuntime/src/lib/ps2_netcnf.cpp
new file mode 100644
index 0000000..cb90ad6
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_netcnf.cpp
@@ -0,0 +1,195 @@
+#include "runtime/ps2_netcnf.h"
+
+#include <cstring>
+#include <sstream>
+
+namespace ps2x::netcnf
+{
+    namespace
+    {
+        constexpr const char *kMagic = "# <Sony Computer Entertainment Inc.>\n\n";
+        constexpr int32_t kNoEntry = -4, kBadHandle = -9, kTooManyOpen = -24; // as ioman's errno values
+
+        std::vector<uint8_t> text(const std::string &s)
+        {
+            return std::vector<uint8_t>(s.begin(), s.end());
+        }
+
+        uint32_t readU32(const std::vector<uint8_t> &v, size_t offset)
+        {
+            uint32_t value = 0;
+            for (size_t i = 0; i < 4; ++i)
+                value |= static_cast<uint32_t>(offset + i < v.size() ? v[offset + i] : 0u) << (8 * i);
+            return value;
+        }
+
+        void putU32(std::vector<uint8_t> &v, uint32_t value)
+        {
+            for (size_t i = 0; i < 4; ++i)
+                v.push_back(static_cast<uint8_t>(value >> (8 * i)));
+        }
+
+        // A NUL-terminated string at offset, at most `length` bytes (the length netcnfif sends includes the NUL).
+        std::string stringAt(const std::vector<uint8_t> &v, size_t offset, size_t length)
+        {
+            std::string s;
+            for (size_t i = 0; i < length && offset + i < v.size() && v[offset + i] != 0u; ++i)
+                s.push_back(static_cast<char>(v[offset + i]));
+            return s;
+        }
+
+        std::string lastName(const std::string &path)
+        {
+            const size_t cut = path.find_last_of("/\\:");
+            return cut == std::string::npos ? path : path.substr(cut + 1);
+        }
+    }
+
+    std::vector<uint8_t> scramble(const std::vector<uint8_t> &plain, const std::array<uint8_t, 8> &consoleId)
+    {
+        uint8_t key[24];
+        for (size_t i = 0; i < 8; ++i)
+        {
+            key[i * 3 + 0] = static_cast<uint8_t>((consoleId[i] >> 5) + 1);
+            key[i * 3 + 1] = static_cast<uint8_t>(((consoleId[i] >> 2) & 7) + 1);
+            key[i * 3 + 2] = static_cast<uint8_t>((consoleId[i] & 3) + 1);
+        }
+        std::vector<uint8_t> out;
+        out.reserve(plain.size());
+        size_t n = 0;
+        for (; n + 1 < plain.size(); n += 2)
+        {
+            const uint32_t word = plain[n] | (static_cast<uint32_t>(plain[n + 1]) << 8);
+            const uint32_t shift = key[(n / 2) % 24];
+            const uint32_t rotated = ((word << shift) | (word >> (16 - shift))) & 0xFFFFu;
+            const uint32_t value = rotated ^ 0xFFFFu;
+            out.push_back(static_cast<uint8_t>(value));
+            out.push_back(static_cast<uint8_t>(value >> 8));
+        }
+        if (n < plain.size())
+        {
+            const uint32_t byte = plain[n];
+            const uint32_t shift = key[(n / 2) % 24];
+            const uint32_t rotated = ((byte << shift) | (byte >> (8 - shift))) & 0xFFu;
+            out.push_back(static_cast<uint8_t>(rotated ^ 0xFFu));
+        }
+        return out;
+    }
+
+    std::vector<SettingsFile> settingsFiles(const NetworkConfig &config)
+    {
+        std::ostringstream ifc;
+        ifc << kMagic << "type eth\n";
+        if (config.dhcp)
+        {
+            ifc << "dhcp\n";
+        }
+        else
+        {
+            ifc << "address " << config.address << "\nnetmask " << config.netmask << "\ngateway " << config.gateway
+                << "\ndns1_address " << config.dns1 << "\n";
+            if (!config.dns2.empty())
+                ifc << "dns2_address " << config.dns2 << "\n";
+        }
+        const std::string dev = std::string(kMagic) +
+                                "type eth\nvendor \"SCE\"\nproduct \"Ethernet (Network Adaptor)\"\nphy_config auto\n";
+        return {
+            {"BWNETCNF", text("0,1,net000.cnf,Combination1\n1,1,ifc000.dat,Setting 1\n"
+                              "2,1,dev000.dat,SCE/Ethernet (Network Adaptor)\n")},
+            {"net000.cnf", text(std::string(kMagic) + "interface \"Combination1\" \"ifc000.dat\" \"dev000.dat\"\n")},
+            {"ifc000.dat", scramble(text(ifc.str()))},
+            {"dev000.dat", scramble(text(dev))},
+        };
+    }
+
+    std::optional<NetworkConfig> configFromEnvironment(const char *value)
+    {
+        const std::string mode = value ? value : "";
+        if (mode == "dhcp")
+            return NetworkConfig{};
+        if (mode.rfind("static:", 0) != 0)
+            return std::nullopt;
+        std::vector<std::string> fields;
+        std::string field;
+        std::istringstream list(mode.substr(7));
+        while (std::getline(list, field, ','))
+            fields.push_back(field);
+        if (fields.size() < 4 || fields.size() > 5)
+            return std::nullopt;
+        NetworkConfig config;
+        config.dhcp = false;
+        config.address = fields[0];
+        config.netmask = fields[1];
+        config.gateway = fields[2];
+        config.dns1 = fields[3];
+        if (fields.size() == 5)
+            config.dns2 = fields[4];
+        return config;
+    }
+
+    SettingsServer::SettingsServer(const NetworkConfig &config)
+        : m_files(settingsFiles(config))
+    {
+        m_open.fill(-1);
+    }
+
+    bool SettingsServer::call(uint32_t function, const std::vector<uint8_t> &send, std::vector<uint8_t> &reply)
+    {
+        reply.clear();
+        switch (function)
+        {
+        case 12: // open(flags, mode, devlen, pathlen, device, path) -> fd, filesize
+        {
+            const uint32_t deviceLength = readU32(send, 8);
+            const uint32_t pathLength = readU32(send, 12);
+            const std::string name = lastName(stringAt(send, 16u + deviceLength, pathLength));
+            int file = -1;
+            for (size_t i = 0; i < m_files.size(); ++i)
+                if (m_files[i].name == name)
+                    file = static_cast<int>(i);
+            int fd = -1;
+            for (int i = 0; i < kMaxOpen && fd < 0; ++i)
+                if (m_open[static_cast<size_t>(i)] < 0)
+                    fd = i;
+            if (file < 0 || fd < 0)
+            {
+                putU32(reply, static_cast<uint32_t>(file < 0 ? kNoEntry : kTooManyOpen));
+                putU32(reply, 0u);
+                return true;
+            }
+            m_open[static_cast<size_t>(fd)] = file;
+            putU32(reply, static_cast<uint32_t>(fd));
+            putU32(reply, static_cast<uint32_t>(m_files[static_cast<size_t>(file)].data.size()));
+            return true;
+        }
+        case 13: // read(fd, devlen, pathlen, offset, size, device, path) -> count, data
+        {
+            const uint32_t fd = readU32(send, 0);
+            const uint32_t offset = readU32(send, 12);
+            const uint32_t size = readU32(send, 16);
+            if (fd >= static_cast<uint32_t>(kMaxOpen) || m_open[fd] < 0)
+            {
+                putU32(reply, static_cast<uint32_t>(kBadHandle));
+                return true;
+            }
+            const std::vector<uint8_t> &data = m_files[static_cast<size_t>(m_open[fd])].data;
+            const size_t start = std::min<size_t>(offset, data.size());
+            const size_t count = std::min<size_t>(size, data.size() - start);
+            putU32(reply, static_cast<uint32_t>(count));
+            reply.insert(reply.end(), data.begin() + static_cast<std::ptrdiff_t>(start),
+                         data.begin() + static_cast<std::ptrdiff_t>(start + count));
+            return true;
+        }
+        case 14: // close(fd) -> 0
+        {
+            const uint32_t fd = readU32(send, 0);
+            if (fd < static_cast<uint32_t>(kMaxOpen))
+                m_open[fd] = -1;
+            putU32(reply, 0u);
+            return true;
+        }
+        default:
+            return false;
+        }
+    }
+}
