diff --git a/ps2xRuntime/include/runtime/ps2_netcnf.h b/ps2xRuntime/include/runtime/ps2_netcnf.h
new file mode 100644
index 0000000..816a8c3
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_netcnf.h
@@ -0,0 +1,76 @@
+#ifndef PS2_NETCNF_H
+#define PS2_NETCNF_H
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+// Sony's PS2 network settings (netcnf's BWNETCNF set) made for the player and served to the game's NETCNFIF
+// module (patch 0097). A game using Sony's NETCNFIF reads its settings through file callbacks that call the EE
+// RPC server 0x80001101 (ps2sdk netcnfif.c: 12 open, 13 read, 14 close), which the game itself registers to read
+// a memory card. The runtime serves that id instead, with the four files generated here, so a player needs
+// neither a memory card nor Sony's configuration utility.
+//
+// Files (ps2sdk iop/network/netcnf netcnf.c): the index "BWNETCNF" ("type,stat,sys_name,usr_name" lines; types
+// 0 combination, 1 interface, 2 device) and the combination "net000.cnf" are plain text; the interface
+// "ifc000.dat" and device "dev000.dat" are scrambled with a key from the console's i.Link ID (sceCdRI, which
+// patch 0093 answers with eight 0xAA bytes): three rotation amounts per ID byte ((b >> 5) + 1, ((b >> 2) & 7) + 1,
+// (b & 3) + 1), each 16-bit word rotated left by key[n % 24] then inverted, an odd last byte the same in 8 bits.
+// Each config file starts with the magic line "# <Sony Computer Entertainment Inc.>" and an empty line.
+namespace ps2x::netcnf
+{
+    struct NetworkConfig
+    {
+        bool dhcp = true;      // automatic address and DNS (the default); else the fields below
+        std::string address;   // "a.b.c.d"
+        std::string netmask;
+        std::string gateway;
+        std::string dns1;
+        std::string dns2;
+    };
+
+    struct SettingsFile
+    {
+        std::string name;
+        std::vector<uint8_t> data;
+    };
+
+    constexpr std::array<uint8_t, 8> kConsoleId{0xAAu, 0xAAu, 0xAAu, 0xAAu, 0xAAu, 0xAAu, 0xAAu, 0xAAu};
+
+    // netcnf's scrambling of an interface or device file for the given console ID.
+    std::vector<uint8_t> scramble(const std::vector<uint8_t> &plain, const std::array<uint8_t, 8> &consoleId = kConsoleId);
+
+    // The four files, in order: BWNETCNF (index), net000.cnf, ifc000.dat (scrambled), dev000.dat (scrambled).
+    std::vector<SettingsFile> settingsFiles(const NetworkConfig &config);
+
+    // PS2X_NETCNF: unset, "" or "off" = none (the game reads a memory card, as before); "dhcp" = automatic;
+    // "static:address,netmask,gateway,dns1[,dns2]" = fixed. Anything else = none.
+    std::optional<NetworkConfig> configFromEnvironment(const char *value);
+
+    // NETCNFIF's file callbacks as an RPC server (ps2sdk netcnfif.c sce_callback_open/read/close):
+    //   12 open:  send {int flags, int mode, int devlen, int pathlen, char device[devlen], char path[pathlen]}
+    //             reply {int fd (< 0 = no such file), int filesize}
+    //   13 read:  send {int fd, int devlen, int pathlen, int offset, int size, device, path}
+    //             reply {int count, char data[count]}
+    //   14 close: send {int fd} reply {int 0}
+    // The path's last component names the file ("mc0:" + "/BWNETCNF/ifc000.dat"); the device is not checked.
+    class SettingsServer
+    {
+    public:
+        static constexpr uint32_t kSid = 0x80001101u;
+        static constexpr int kMaxOpen = 8;
+
+        explicit SettingsServer(const NetworkConfig &config);
+
+        // False for a function it does not serve; else reply holds the answer.
+        bool call(uint32_t function, const std::vector<uint8_t> &send, std::vector<uint8_t> &reply);
+
+    private:
+        std::vector<SettingsFile> m_files;
+        std::array<int, kMaxOpen> m_open{}; // fd -> index into m_files, -1 = free
+    };
+}
+
+#endif
