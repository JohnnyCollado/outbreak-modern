+namespace
+{
+    // The game's network settings served to its NETCNFIF module (patch 0097): made once from PS2X_NETCNF on the
+    // first bind; none when it is unset or "off" (the game then reads a memory card through its own EE server,
+    // which our IOP cannot call: it asks the player for settings).
+    ps2x::netcnf::SettingsServer *netcnfServer()
+    {
+        static std::optional<ps2x::netcnf::SettingsServer> server = []() -> std::optional<ps2x::netcnf::SettingsServer> {
+            const char *value = std::getenv("PS2X_NETCNF");
+            const std::optional<ps2x::netcnf::NetworkConfig> config = ps2x::netcnf::configFromEnvironment(value);
+            if (!config)
+            {
+                if (value && *value && std::string(value) != "off")
+                    std::cout << "[netcnf] PS2X_NETCNF=" << value << " not understood (dhcp | static:address,netmask,gateway,dns1[,dns2] | off): off" << std::endl;
+                return std::nullopt;
+            }
+            std::cout << "[netcnf] serving the game's network settings (PS2X_NETCNF=" << value << ")" << std::endl;
+            return ps2x::netcnf::SettingsServer{*config};
+        }();
+        return server ? &*server : nullptr;
+    }
+}
+
+bool PS2IopHostAdapter::hasEeRpcServer(uint32_t sid) const
+{
+    return sid == ps2x::netcnf::SettingsServer::kSid && netcnfServer() != nullptr;
+}
+
+bool PS2IopHostAdapter::eeRpc(uint32_t sid, uint32_t function, const std::vector<uint8_t> &send, std::vector<uint8_t> &reply)
+{
+    ps2x::netcnf::SettingsServer *server = netcnfServer();
+    return server != nullptr && sid == ps2x::netcnf::SettingsServer::kSid && server->call(function, send, reply);
+}
+
 bool PS2IopHostAdapter::sendSifCommand(uint32_t commandId,
                                        const void *packet,
                                        size_t packetSize)
