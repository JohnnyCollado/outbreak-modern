diff --git a/ps2xRuntime/src/lib/ps2_ui_external.cpp b/ps2xRuntime/src/lib/ps2_ui_external.cpp
new file mode 100644
index 0000000..b954baa
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_ui_external.cpp
@@ -0,0 +1,18 @@
+#include "runtime/ps2_ui_external.h"
+
+#include <atomic>
+
+namespace
+{
+    std::atomic<PS2ExternalUi *> s_externalUi{nullptr};
+}
+
+PS2ExternalUi *ps2ExternalUi()
+{
+    return s_externalUi.load(std::memory_order_acquire);
+}
+
+void ps2SetExternalUi(PS2ExternalUi *ui)
+{
+    s_externalUi.store(ui, std::memory_order_release);
+}
