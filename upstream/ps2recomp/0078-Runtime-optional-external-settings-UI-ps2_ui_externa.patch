+bool PS2Runtime::openLauncherWindow(const char *title)
+{
+    SelectGs();
+    if (!ps2ExternalGS())
+        return false; // the UI draws through the external GS
+    OpenHostWindow(title);
+    SetTargetFPS(60);
+    s_launcherWindow = true;
+    return !IsWindowHidden();
+}
