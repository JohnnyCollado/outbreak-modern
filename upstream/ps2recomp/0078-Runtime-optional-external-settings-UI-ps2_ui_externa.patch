@@ -0,0 +1,39 @@
+#pragma once
+
+// Optional external settings UI (patch 0078): a launcher before the game and a menu over it, provided by the library
+// that provides the external GS (outbreak-modern: native/ob_ui, drawn by its GS). Null (the default, and every build
+// without one) = the runner as before. One pointer, one null check per site, as PS2ExternalGS.
+
+#include <cstdint>
+#include <filesystem>
+
+class PS2ExternalUi
+{
+public:
+    virtual ~PS2ExternalUi() = default;
+
+    // Main thread, before the game is resolved. interactive: the runner has opened its window and the external GS
+    // (PS2Runtime::openLauncherWindow) and the UI runs its launcher there until the player picks Play (true) or Quit
+    // (false); it may rewrite the settings file, which the runner reads again afterwards. Not interactive (hidden
+    // window, PS2X_LAUNCHER=0, no external GS): no window, the UI may still check or translate the game.
+    // gamePath: in = the game the runner would boot (command line or settings), out = the one to boot.
+    virtual bool launch(std::filesystem::path &gamePath, bool interactive) = 0;
+
+    enum class HostAction : int
+    {
+        Run,  // the game runs
+        Hold, // the menu is open: the runner holds the game (EeScheduler::setHeld) and pauses its sound
+        Quit, // the player chose Quit: the runner stops as at a window close
+    };
+    // Main thread, once per host frame while the game runs (PS2Runtime::run), after input was polled.
+    virtual HostAction hostFrame() = 0;
+
+    // Game thread, at each host pad read (PSPadBackend::readState): may hide buttons (the menu's own button combo,
+    // or everything while the menu is open). buttons: PS2 active-low mask; sticks: rx, ry, lx, ly (0x80 = centre).
+    virtual uint16_t filterPad(int port, uint16_t buttons, uint8_t sticks[4]) = 0;
+};
+
+PS2ExternalUi *ps2ExternalUi();
+void ps2SetExternalUi(PS2ExternalUi *ui);
+// Defined by the external library (with PS2X_EXTERNAL_GS); null = it has no UI.
+PS2ExternalUi *ps2CreateExternalUi();
