diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_detail.h b/ps2xRuntime/src/lib/vu/ps2_vu1_detail.h
index ed0ee71..9c13b0a 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_detail.h
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_detail.h
@@ -3,6 +3,18 @@
 
 #include <cstdint>
 
+// VU arithmetic rounds every multiply and every add separately (the FMAC is not a fused multiply-add, and MSVC
+// x64 builds never fuse). Clang (Android NDK, -ffp-contract=on by default) and GCC (-ffp-contract=fast) would
+// turn `acc + a * b` into one fused operation on arm64 or with FMA, and the results would differ from Windows
+// in the last bits. Every VU translation unit includes this header before its code.
+#if defined(__clang__)
+#pragma STDC FP_CONTRACT OFF
+#elif defined(_MSC_VER)
+#pragma fp_contract(off)
+#elif defined(__GNUC__)
+#pragma GCC optimize("fp-contract=off")
+#endif
+
 // Instruction field extraction helpers
 static inline uint8_t DEST(uint32_t i) { return (uint8_t)((i >> 21) & 0xF); }
 static inline uint8_t FT(uint32_t i) { return (uint8_t)((i >> 16) & 0x1F); }
