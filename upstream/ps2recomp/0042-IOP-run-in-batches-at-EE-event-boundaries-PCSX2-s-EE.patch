+        // The IOP cycle of its next event: a delayed thread's wake (DelayThread, vblank waits), a DMA
+        // completion, a scheduled guest callback (CDVD), a timer compare/overflow. UINT64_MAX = none.
+        uint64_t nextEventCycle() const
+        {
+            uint64_t next = kernel.nextWakeCycle(UINT64_MAX);
+            for (const auto &[irq, pending] : pendingDmaInterrupts)
+                next = std::min(next, pending.completionCycle);
+            if (!pendingGuestCallbacks.empty())
+                next = std::min(next, pendingGuestCallbacks.begin()->first);
+            return timrman.nextEventCycle(next);
+        }
+
+        // Batching (patch 0042): the banked EE cycles at which the IOP must run next. PCSX2 sets the EE's
+        // next event test so the IOP's next event is never overshot (R5900.cpp nextIopEventDeta,
+        // R3000A.cpp PSX_INT -> cpuSetNextEventDelta), and never further than eeWaitCycles.
+        void scheduleBatch()
+        {
+            uint64_t eeUntil = kEeBatchCycles;
+            const uint64_t next = nextEventCycle();
+            if (next != UINT64_MAX)
+            {
+                const uint64_t iopUntil = next > totalCycles ? next - totalCycles : 0u;
+                if (iopUntil < kEeBatchCycles / kEeCyclesPerIopCycle)
+                    eeUntil = iopUntil * kEeCyclesPerIopCycle;
+            }
+            // At least one IOP cycle, so a due event is serviced by the flush that reaches it.
+            flushAtEeCycles = std::max(eeUntil, kEeCyclesPerIopCycle);
+        }
+
+        // Run the IOP up to the EE's time (whole IOP cycles; the remainder stays banked), then schedule
+        // the next batch. Not while IOP code is running (an EE callback called from an IOP call): the
+        // outermost caller catches up afterwards.
+        void flushBatch() noexcept
+        {
+            if (iopDepth != 0u)
+                return;
+            const uint64_t iopCycles = pendingEeCycles / kEeCyclesPerIopCycle;
+            pendingEeCycles %= kEeCyclesPerIopCycle;
+            if (iopCycles)
+                runCycles(iopCycles);
+            try
+            {
+                scheduleBatch();
+            }
+            catch (...)
+            {
+                flushAtEeCycles = kEeCyclesPerIopCycle;
+            }
+        }
+
+        void runEeCycles(uint64_t eeCycles) noexcept
+        {
+            pendingEeCycles += eeCycles;
+            if (!eeBatching)
+            {
+                // Per-checkpoint stepping (PS2X_IOP_BATCH=0): the pre-0042 behaviour.
+                const uint64_t iopCycles = pendingEeCycles / kEeCyclesPerIopCycle;
+                pendingEeCycles %= kEeCyclesPerIopCycle;
+                if (iopCycles)
+                    runCycles(iopCycles);
+                return;
+            }
+            if (pendingEeCycles >= flushAtEeCycles)
+                flushBatch();
+        }
+
+        // Called before the EE touches IOP state (RPC, SIF transfer, IOP memory, module calls): the IOP
+        // first catches up with the EE, as PCSX2's SIF/DMA paths sync the IOP before acting.
+        void syncForEe() noexcept
+        {
+            if (eeBatching && iopDepth == 0u && pendingEeCycles >= kEeCyclesPerIopCycle)
+                flushBatch();
+        }
+
+        // After an EE call that may have changed IOP events (woken a thread, scheduled a DMA or a callback).
+        void afterEeCall() noexcept
+        {
+            if (!eeBatching || iopDepth != 0u)
+                return;
+            try
+            {
+                scheduleBatch();
+            }
+            catch (...)
+            {
+                flushAtEeCycles = kEeCyclesPerIopCycle;
+            }
+        }
+
+        // An EE-side call into the IOP: sync first; while it runs, IOP code reaching back into the
+        // emulator (host -> runtime -> IOP memory) does not sync again.
+        struct EeCall
+        {
+            Impl &impl;
+            bool changesEvents;
+            EeCall(Impl &owner, bool changes) noexcept
+                : impl(owner), changesEvents(changes)
+            {
+                impl.syncForEe();
+                ++impl.iopDepth;
+            }
+            ~EeCall()
+            {
+                --impl.iopDepth;
+                if (changesEvents)
+                    impl.afterEeCall();
+            }
+            EeCall(const EeCall &) = delete;
+            EeCall &operator=(const EeCall &) = delete;
+        };
+
         void runCycles(uint64_t cycles) noexcept
