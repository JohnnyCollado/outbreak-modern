new file mode 100644
index 0000000..c8893c2
--- /dev/null
+++ b/ps2xIOP/tests/iop_batch_tests.cpp
@@ -0,0 +1,208 @@
+// Patch 0042: the IOP runs in batches at EE event boundaries (PCSX2's EEsCycle scheme).
+#include "iop_compat_test_support.h"
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <string>
+
+namespace
+{
+    using namespace iop_test;
+
+    constexpr uint32_t kEeCheckpoint = 32u; // the recompiler's backward-branch charge (ps2x_eeCheckpointDue)
+    constexpr uint32_t kEeBatch = 3072u;    // PCSX2 eeWaitCycles
+
+    uint32_t jal(uint32_t target) { return 0x0C000000u | ((target >> 2u) & 0x03FFFFFFu); }
+
+    // Entry: CreateThread(descriptor 0x10300) + StartThread, returns 0. The thread (0x10100) is `body`.
+    // thbase stubs at 0x10180: CreateThread +20, StartThread +28, DelayThread +36. stdio putchar at 0x101C0+20.
+    Irx threadModule(std::initializer_list<uint32_t> body)
+    {
+        constexpr uint32_t base = 0x10000u;
+        constexpr uint32_t createThread = base + 0x180u + 20u;
+        constexpr uint32_t startThread = base + 0x180u + 28u;
+        Irx image(base);
+        image.words(0x000u, {
+            0x27BDFFE0u, 0xAFBF001Cu,
+            0x3C040001u, 0x34840300u, jal(createThread), 0u,
+            0x00402021u, 0x00002821u, jal(startThread), 0u,
+            0x8FBF001Cu, 0x00001021u, 0x27BD0020u, 0x03E00008u, 0u,
+        });
+        image.words(0x100u, body);
+        image.words(0x180u, {
+            0x41E00000u, 0u, 0x00000101u, 0x61626874u, 0x00006573u, // "thbase"
+            0x03E00008u, 0x24000004u,                                // CreateThread
+            0x03E00008u, 0x24000006u,                                // StartThread
+            0x03E00008u, 0x24000021u,                                // DelayThread (33)
+            0u, 0u,
+        });
+        image.words(0x1C0u, {
+            0x41E00000u, 0u, 0x00000101u, 0x69647473u, 0x0000006Fu, // "stdio"
+            0x03E00008u, 0x24000006u,                                // putchar
+            0u, 0u,
+        });
+        image.words(0x300u, {0u, 0u, base + 0x100u, 0x400u, 20u});
+        return image;
+    }
+
+    // DelayThread(1001 us) = 36901 IOP cycles: the wake falls inside a 3072-cycle batch, so fixed batches
+    // alone see it late (by 160 EE cycles in this test). Then putchar('W'), then return.
+    Irx delayThenMarkModule()
+    {
+        constexpr uint32_t delayThread = 0x10000u + 0x180u + 36u;
+        constexpr uint32_t putchar = 0x10000u + 0x1C0u + 20u;
+        return threadModule({
+            0x240403E9u, jal(delayThread), 0u, // DelayThread(1001)
+            0x24040057u, jal(putchar), 0u,     // putchar('W')
+            0x03E00008u, 0u,
+        });
+    }
+
+    Irx spinModule()
+    {
+        return threadModule({0x1000FFFFu, 0u}); // b . (a thread that is always ready)
+    }
+
+    bool marked(const Host &host)
+    {
+        return std::any_of(host.logs.begin(), host.logs.end(),
+                           [](const std::string &line) { return line.find("[IOP putchar] W") != std::string::npos; });
+    }
+
+    void load(IopSubsystem &iop, Host &host, const Irx &image)
+    {
+        image.install(host, 0x1000u);
+        const ModuleLoadResult result = iop.loadModuleBuffer(0x1000u);
+        require(result.handled && result.moduleId > 0 && result.startResult == 0, "synthetic IRX did not start");
+    }
+
+    struct Run
+    {
+        uint64_t cycles = 0u;
+        uint64_t runs = 0u;
+        uint64_t instructions = 0u;
+    };
+
+    // `checkpoints` backward-branch checkpoints of 32 EE cycles each, then catch up.
+    Run stepCheckpoints(const Irx *image, bool batching, uint32_t checkpoints)
+    {
+        Host host;
+        IopSubsystem iop(host);
+        iop.setEeBatching(batching);
+        if (image)
+            load(iop, host, *image);
+        const uint64_t runsBefore = iop.debugSnapshot().emulatorRuns;
+        for (uint32_t i = 0; i < checkpoints; ++i)
+            iop.runEeCycles(kEeCheckpoint);
+        iop.syncEe();
+        const DebugSnapshot after = iop.debugSnapshot();
+        require(after.emulatorPendingEeCycles < 8u, "syncEe left whole IOP cycles unrun");
+        return {after.emulatorCycles, after.emulatorRuns - runsBefore, after.emulatorInstructions};
+    }
+
+    void batchingRunsTheIopFewerTimes()
+    {
+        constexpr uint32_t checkpoints = 9600u; // 307200 EE cycles = 38400 IOP cycles
+        const Irx spin = spinModule();
+        const std::array<const Irx *, 2> images{nullptr, &spin};
+        for (const Irx *image : images)
+        {
+            const Run off = stepCheckpoints(image, false, checkpoints);
+            const Run on = stepCheckpoints(image, true, checkpoints);
+            std::cout << "  " << (image ? "spinning thread" : "idle IOP") << ": per-checkpoint " << off.runs
+                      << " runs, batched " << on.runs << " runs, IOP cycles " << off.cycles << " / " << on.cycles
+                      << ", instructions " << off.instructions << " / " << on.instructions << '\n';
+            require(off.runs == checkpoints, "per-checkpoint stepping must run the IOP at every checkpoint");
+            require(on.cycles == off.cycles, "batching must run the IOP for the same number of cycles");
+            require(on.runs <= uint64_t{checkpoints} * kEeCheckpoint / kEeBatch + 2u,
+                    "batching must run the IOP about once per 3072 EE cycles");
+        }
+    }
+
+    // The EE cycle (after the thread is delayed) at which the woken thread's putchar is seen.
+    uint64_t wakeSeenAt(bool batching, uint64_t &runs)
+    {
+        Host host;
+        IopSubsystem iop(host);
+        iop.setEeBatching(batching);
+        load(iop, host, delayThenMarkModule());
+        iop.runEeCycles(8u * 64u); // the thread starts and calls DelayThread
+        iop.syncEe();
+        require(!marked(host), "the thread woke before its delay");
+        const uint64_t runsBefore = iop.debugSnapshot().emulatorRuns;
+        for (uint64_t ee = kEeCheckpoint; ee <= 8u * 40000u; ee += kEeCheckpoint)
+        {
+            iop.runEeCycles(kEeCheckpoint);
+            if (marked(host))
+            {
+                runs = iop.debugSnapshot().emulatorRuns - runsBefore;
+                return ee;
+            }
+        }
+        throw std::runtime_error("the delayed thread never woke");
+    }
+
+    void iopEventFiresOnTime()
+    {
+        uint64_t runsOff = 0u, runsOn = 0u;
+        const uint64_t off = wakeSeenAt(false, runsOff);
+        const uint64_t on = wakeSeenAt(true, runsOn);
+        std::cout << "  DelayThread(1001 us) wake seen at EE +" << off << " per-checkpoint (" << runsOff
+                  << " runs), +" << on << " batched (" << runsOn << " runs)\n";
+        // PCSX2: the EE's next event test is set to the IOP's next event (nextIopEventDeta), so the IOP
+        // reaches the wake at its EE time. Here the EE yields only at checkpoints: one checkpoint of slack.
+        require(on <= off + kEeCheckpoint, "the IOP event fired later than its EE deadline allows");
+        require(on + kEeCheckpoint >= off, "the IOP event fired before it was due");
+        require(runsOn * 20u < runsOff, "the wait was not batched");
+    }
+
+    void eeCallsIntoTheIopSyncFirst()
+    {
+        using Call = void (*)(IopSubsystem &);
+        const std::array<std::pair<const char *, Call>, 6> calls{{
+            {"SIF transfer", [](IopSubsystem &iop) {
+                 iop.onSifTransfer({SifTransferKind::SetDma, SifTransferPhase::AfterCopy, 0x800u, 0x20000u, 16u});
+             }},
+            {"IOP memory write (SIF DMA)", [](IopSubsystem &iop) {
+                 const uint32_t value = 1u;
+                 require(iop.writeMemory(0x20000u, &value, sizeof(value)), "write failed");
+             }},
+            {"IOP memory read", [](IopSubsystem &iop) {
+                 uint32_t value = 0u;
+                 require(iop.readMemory(0x20000u, &value, sizeof(value)), "read failed");
+             }},
+            {"RPC", [](IopSubsystem &iop) { (void)iop.handleRpc(request(0x12345u, 0u)); }},
+            {"RPC bind poll", [](IopSubsystem &iop) { (void)iop.canBindRpc(0x12345u); }},
+            {"IOP heap alloc", [](IopSubsystem &iop) { (void)iop.allocateMemory(64u); }},
+        }};
+        for (const auto &[name, call] : calls)
+        {
+            Host host;
+            IopSubsystem iop(host);
+            iop.runEeCycles(kEeCheckpoint); // the first checkpoint after reset runs and schedules a batch
+            const uint64_t before = iop.debugSnapshot().emulatorCycles;
+            for (int i = 0; i < 10; ++i)
+                iop.runEeCycles(kEeCheckpoint);
+            const DebugSnapshot banked = iop.debugSnapshot();
+            require(banked.emulatorCycles == before && banked.emulatorPendingEeCycles == 10u * kEeCheckpoint,
+                    "an idle IOP must bank checkpoints until its batch is due");
+            call(iop);
+            const DebugSnapshot synced = iop.debugSnapshot();
+            std::cout << "  " << name << ": IOP +" << synced.emulatorCycles - before << " cycles, "
+                      << synced.emulatorPendingEeCycles << " EE cycles still banked\n";
+            require(synced.emulatorCycles == before + 10u * kEeCheckpoint / 8u && synced.emulatorPendingEeCycles == 0u,
+                    "an EE call into the IOP must first run the IOP up to the EE's time");
+        }
+    }
+}
+
+int main()
+{
+    const Test tests[] = {
+        {"batching runs the IOP fewer times for the same EE cycles", batchingRunsTheIopFewerTimes},
+        {"an IOP event fires no later than its EE deadline", iopEventFiresOnTime},
+        {"an EE call into the IOP (SIF, RPC, memory) syncs it first", eeCallsIntoTheIopSyncFirst},
+    };
+    return run(tests);
+}
