diff --git a/ps2xAnalyzer/include/ps2recomp/toml_generator.h b/ps2xAnalyzer/include/ps2recomp/toml_generator.h
index 72d2b8c..d43416a 100644
--- a/ps2xAnalyzer/include/ps2recomp/toml_generator.h
+++ b/ps2xAnalyzer/include/ps2recomp/toml_generator.h
@@ -24,6 +24,7 @@ namespace ps2recomp
         const std::map<uint32_t, uint32_t> &patches;
         const std::map<uint32_t, std::string> &patchReasons;
