         return TomlGenerator::generate(input, outputPath);
     }
@@ -537,6 +539,22 @@ namespace ps2recomp
         }
     }
 
+    std::map<uint32_t, uint32_t> ElfAnalyzer::detectInstructionPatchesForHeuristics(
+        const std::vector<Function> &functions,
+        const std::vector<Section> &sections,
+        std::vector<SelfModifyingStoreSuspect> *suspects)
+    {
+        ElfAnalyzer analyzer("");
+        analyzer.m_context.functions = functions;
+        analyzer.m_context.sections = sections;
+        analyzer.identifyPotentialPatches();
+        if (suspects)
+        {
+            *suspects = analyzer.m_selfModifyingSuspects;
+        }
+        return analyzer.m_patches;
+    }
+
     bool ElfAnalyzer::tryPatchSelfModifyingStore(
         const Function &func,
         const std::vector<Instruction> &instructions,
@@ -574,10 +592,12 @@ namespace ps2recomp
         std::cout << "Potential self-modifying code at " << formatAddress(storeInst.address)
                   << " writing to " << formatAddress(targetAddr)
                   << " then jumping to " << formatAddress(jumpTarget)
-                  << " in function " << func.name << std::endl;
+                  << " in function " << func.name << " (not patched; review by hand)" << std::endl;
 
-        m_patches[storeInst.address] = 0x00000000;
-        m_patchReasons[storeInst.address] = "Potential self-modifying code";
+        // Only reported: replacing the store with a NOP doesn't make self-modifying code work,
+        // and when code and data share one executable section (common in PS2 ELFs) most hits
+        // are ordinary data writes.
+        m_selfModifyingSuspects.push_back({storeInst.address, targetAddr, jumpTarget, func.name});
         return true;
     }
 
diff --git a/ps2xAnalyzer/src/toml_generator.cpp b/ps2xAnalyzer/src/toml_generator.cpp
index cf4a251..00d2fc0 100644
--- a/ps2xAnalyzer/src/toml_generator.cpp
+++ b/ps2xAnalyzer/src/toml_generator.cpp
@@ -201,6 +201,20 @@ namespace ps2recomp
             file << "]\n\n";
         }
 
+        if (!input.selfModifyingSuspects.empty())
+        {
+            file << "# Possible self-modifying code: a store into an executable section followed by a jump.\n";
+            file << "# NOT patched. Most are ordinary data writes when code and data share one section.\n";
+            file << "# After checking one by hand, copy its line into [patches] instructions to replace it.\n";
+            for (const auto &suspect : input.selfModifyingSuspects)
+            {
+                file << "#   { address = \"0x" << std::hex << suspect.storeAddress << "\", value = \"0x0\" },"
+                     << "  # writes 0x" << suspect.targetAddress << ", then jumps to 0x" << suspect.jumpTarget
+                     << std::dec << " in " << suspect.functionName << "\n";
+            }
+            file << "\n";
+        }
+
         file << "# Performance critical functions (may need manual optimization)\n";
         file << "[performance]\n";
         file << "critical = [\n";
diff --git a/ps2xTest/src/elf_analyzer_tests.cpp b/ps2xTest/src/elf_analyzer_tests.cpp
index 8cba9b5..eac3089 100644
--- a/ps2xTest/src/elf_analyzer_tests.cpp
+++ b/ps2xTest/src/elf_analyzer_tests.cpp
@@ -177,6 +177,46 @@ void register_elf_analyzer_tests()
             (void)hasLargeComplexMMI;
             (void)hasSelfModifying; });
 
+                       tc.Run("suspected self-modifying stores are reported, never patched", [](TestCase &t)
+                              {
+            // Outbreak (SLPM-65428): lui $s1,0x21 ... sw $s0,-0x4000($s1) at 0x141034; jal 0x11b5f0.
+            // Its ELF has one executable section over code and data, so this ordinary store to
+            // the global 0x20c000 looks like "write to code, then jump". The old auto-nop
+            // removed it and left a transfer buffer NULL, hanging the game.
+            Instruction lui = makeInstruction(0x141028, OPCODE_LUI);
+            lui.rt = 17;
+            lui.immediate = 0x21;
+            Instruction sw = makeInstruction(0x141034, OPCODE_SW);
+            sw.rs = 17;
+            sw.rt = 16;
+            sw.immediate = 0xC000;
+            Instruction jal = makeInstruction(0x141038, OPCODE_JAL);
+            jal.target = 0x11B5F0 >> 2;
+            Instruction delay = makeInstruction(0x14103C, OPCODE_ADDIU);
+
+            Function func{};
+            func.name = "func_00140FC0";
+            func.start = 0x141028;
+            func.end = 0x141040;
+            func.instructions = {lui, sw, jal, delay};
+
+            Section merged{};
+            merged.address = 0x100000;
+            merged.size = 0x13BA00;
+            merged.isCode = true;
+
+            std::vector<SelfModifyingStoreSuspect> suspects;
+            const auto patches = ElfAnalyzer::detectInstructionPatchesForHeuristics({func}, {merged}, &suspects);
+            t.IsTrue(patches.empty(), "the analyzer must not replace a suspected self-modifying store");
+            t.Equals(suspects.size(), static_cast<size_t>(1), "the store must still be reported for review");
+            if (suspects.size() == 1)
+            {
+                t.Equals(suspects[0].storeAddress, 0x141034u, "store address");
+                t.Equals(suspects[0].targetAddress, 0x20C000u, "written address");
+                t.Equals(suspects[0].jumpTarget, 0x11B5F0u, "jump target");
+                t.IsTrue(suspects[0].functionName == "func_00140FC0", "containing function");
+            } });
+
                        tc.Run("jump-table detection finds canonical sltiu/bne/lw/jr pattern", [](TestCase &t)
                               {
             // sltiu -> bne/beq bounds check -> ... -> lui/addiu base -> lw -> jr loadedReg
