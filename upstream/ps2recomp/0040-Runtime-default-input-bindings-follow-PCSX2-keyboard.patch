-//   deadzone = 0.15                0..1, per axis, the rest rescaled to 0..1 (default 0)
+//   deadzone = 0.15                0..1, both sticks, per axis, the rest rescaled to 0..1
+//   deadzone_left = 0.24           per stick; overrides deadzone wherever it appears in the file
+//   deadzone_right = 0.265
+//   trigger_threshold = 0.12       0..1 of trigger travel: a trigger axis bound to a button presses it above this
 //   cross = RIGHT_FACE_DOWN
+//   l2 = LEFT_TRIGGER_2, LEFT_TRIGGER   a button list may name the trigger axes LEFT_TRIGGER / RIGHT_TRIGGER
 //   stick_left = LEFT_X, LEFT_Y    two axes: x, y
 // Buttons: up down left right cross circle square triangle l1 r1 l2 r2 l3 r3 start select. An empty value or NONE
 // unbinds. A bad line is reported once ("[input] line N: ...") and that entry keeps its default.
@@ -32,6 +44,15 @@ namespace ps2input
 
