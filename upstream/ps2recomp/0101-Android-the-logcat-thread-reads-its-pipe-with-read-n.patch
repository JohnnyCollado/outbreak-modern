 ps2xRuntime/src/main.cpp                   |  21 +---
 ps2xTest/CMakeLists.txt                    |   1 +
 ps2xTest/src/main.cpp                      |   2 +
 ps2xTest/src/ps2_log_pump_tests.cpp        | 106 +++++++++++++++++++++
 5 files changed, 195 insertions(+), 16 deletions(-)
 create mode 100644 ps2xRuntime/include/runtime/ps2_log_pump.h
 create mode 100644 ps2xTest/src/ps2_log_pump_tests.cpp

diff --git a/ps2xRuntime/include/runtime/ps2_log_pump.h b/ps2xRuntime/include/runtime/ps2_log_pump.h
new file mode 100644
index 0000000..30f7c82
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_log_pump.h
@@ -0,0 +1,81 @@
+#ifndef PS2_LOG_PUMP_H
+#define PS2_LOG_PUMP_H
+
+#include <cstddef>
+#include <functional>
+
+#if defined(_WIN32)
+#include <io.h>
+#else
+#include <cerrno>
+#include <unistd.h>
+#endif
+
+// Lines from a pipe (Android: the runner's stdout/stderr, copied to logcat). The pipe is read with read() on the
+// descriptor, not fgets on a FILE*: a FILE* waiting in fgets holds its stream lock, and every fflush(nullptr) in the
+// process (the memory card's, after each write) then waited for the next line (reports/2026-10-26-online-play.md
+// entry 54).
+class Ps2LinePump
+{
+public:
+    static constexpr size_t kMaxLine = 1023; // a longer line comes out in pieces of this size
+
+    explicit Ps2LinePump(std::function<void(const char *)> emit) : m_emit(std::move(emit)) {}
+
+    void feed(const char *data, size_t size)
+    {
+        for (size_t i = 0; i < size; ++i)
+        {
+            if (data[i] == '\n')
+            {
+                flushLine();
+                continue;
+            }
+            if (m_size == kMaxLine)
+                flushLine();
+            m_line[m_size++] = data[i];
+        }
+    }
+
+    // End of input: an unterminated last line.
+    void finish()
+    {
+        if (m_size > 0)
+            flushLine();
+    }
+
+private:
+    void flushLine()
+    {
+        m_line[m_size] = '\0';
+        m_emit(m_line);
+        m_size = 0;
+    }
+
+    std::function<void(const char *)> m_emit;
+    char m_line[kMaxLine + 1] = {};
+    size_t m_size = 0;
+};
+
+// Reads fd until end of input or an error, one emit per line.
+inline void ps2PumpLines(int fd, std::function<void(const char *)> emit)
+{
+    Ps2LinePump pump(std::move(emit));
+    char buffer[4096];
+    for (;;)
+    {
+#if defined(_WIN32)
+        const int got = _read(fd, buffer, sizeof(buffer));
+#else
+        const ssize_t got = read(fd, buffer, sizeof(buffer));
+        if (got < 0 && errno == EINTR)
+            continue;
+#endif
+        if (got <= 0)
+            break;
+        pump.feed(buffer, static_cast<size_t>(got));
+    }
+    pump.finish();
+}
+
+#endif
