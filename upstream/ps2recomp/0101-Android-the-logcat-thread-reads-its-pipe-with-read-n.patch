diff --git a/ps2xTest/src/ps2_log_pump_tests.cpp b/ps2xTest/src/ps2_log_pump_tests.cpp
new file mode 100644
index 0000000..0a92ea4
--- /dev/null
+++ b/ps2xTest/src/ps2_log_pump_tests.cpp
@@ -0,0 +1,106 @@
+#include "MiniTest.h"
+#include "runtime/ps2_log_pump.h"
+
+#include <chrono>
+#include <cstdio>
+#include <future>
+#include <string>
+#include <thread>
+#include <vector>
+
+#if defined(_WIN32)
+#include <fcntl.h>
+#include <io.h>
+#else
+#include <unistd.h>
+#endif
+
+namespace
+{
+    bool makePipe(int fds[2])
+    {
+#if defined(_WIN32)
+        return _pipe(fds, 4096, _O_BINARY) == 0;
+#else
+        return pipe(fds) == 0;
+#endif
+    }
+
+    void writeFd(int fd, const std::string &s)
+    {
+#if defined(_WIN32)
+        (void)_write(fd, s.data(), static_cast<unsigned>(s.size()));
+#else
+        (void)write(fd, s.data(), s.size());
+#endif
+    }
+
+    void closeFd(int fd)
+    {
+#if defined(_WIN32)
+        _close(fd);
+#else
+        close(fd);
+#endif
+    }
+}
+
+void register_ps2_log_pump_tests()
+{
+    MiniTest::Case("LogPump", [](TestCase &tc)
+    {
+        tc.Run("splits bytes into lines, whatever the chunks", [](TestCase &t)
+        {
+            std::vector<std::string> lines;
+            Ps2LinePump pump([&](const char *line) { lines.emplace_back(line); });
+            pump.feed("ab", 2);
+            pump.feed("c\nde", 4);
+            pump.feed("\n\n", 2);
+            pump.feed("tail", 4);
+            t.Equals(lines.size(), size_t(3), "three complete lines so far");
+            pump.finish();
+            t.Equals(lines.size(), size_t(4), "the unterminated tail at the end");
+            t.Equals(lines[0], std::string("abc"), "line 1");
+            t.Equals(lines[1], std::string("de"), "line 2");
+            t.Equals(lines[2], std::string(""), "an empty line stays a line");
+            t.Equals(lines[3], std::string("tail"), "the tail");
+        });
+
+        tc.Run("a line longer than the buffer comes out in pieces", [](TestCase &t)
+        {
+            std::vector<std::string> lines;
+            Ps2LinePump pump([&](const char *line) { lines.emplace_back(line); });
+            const std::string longLine(Ps2LinePump::kMaxLine + 10, 'x');
+            pump.feed((longLine + "\n").data(), longLine.size() + 1);
+            t.Equals(lines.size(), size_t(2), "two pieces");
+            t.Equals(lines[0].size(), size_t(Ps2LinePump::kMaxLine), "the first is the buffer's size");
+            t.Equals(lines[1].size(), size_t(10), "the rest");
+        });
+
+        // reports/2026-10-26-online-play.md entry 54: the Android logcat thread read the pipe with fgets on a FILE*,
+        // holding that stream's lock while it waited; every fflush(nullptr) (the memory card's, after each write)
+        // then waited for the next log line, about a second, so a card format crawled. The pump reads the fd itself.
+        tc.Run("pumping a pipe holds no stdio lock: fflush(nullptr) does not wait for a line", [](TestCase &t)
+        {
+            int fds[2] = {-1, -1};
+            t.IsTrue(makePipe(fds), "pipe");
+            std::vector<std::string> lines;
+            std::thread reader([&]() { ps2PumpLines(fds[0], [&](const char *line) { lines.emplace_back(line); }); });
+            std::this_thread::sleep_for(std::chrono::milliseconds(50)); // the pump is now waiting on the empty pipe
+            auto flushed = std::async(std::launch::async, []() { return std::fflush(nullptr); });
+            const bool prompt = flushed.wait_for(std::chrono::seconds(2)) == std::future_status::ready;
+            t.IsTrue(prompt, "fflush(nullptr) returns while the pump waits");
+            writeFd(fds[1], "one\ntwo");
+            closeFd(fds[1]);
+            reader.join();
+            closeFd(fds[0]);
+            flushed.wait();
+            t.Equals(lines.size(), size_t(2), "both lines, the last at end of input");
+            if (lines.size() == 2)
+            {
+                t.Equals(lines[0], std::string("one"), "line 1");
+                t.Equals(lines[1], std::string("two"), "line 2");
+            }
+        });
+    });
+}
