+#ifndef PS2_GAME_SOURCE_H
+#define PS2_GAME_SOURCE_H
+
+// Where the game's files come from, and the start-up settings file (patch 0043).
+//
+// The runner takes a copy of the game in one of three forms:
+//   - a disc image (ISO 9660, 2048-byte sectors): cdrom0: is the image; sceCdSearchFile answers with the files' real
+//     LSNs and sceCdRead reads the image; the boot ELF is SYSTEM.CNF's BOOT2 inside the image;
+//   - an extracted folder (the disc's files copied out): the boot ELF is BOOT2 of the folder's SYSTEM.CNF;
+//   - the boot ELF itself inside an extracted folder (the original form): its folder is cdrom0:.
+// Memory cards (mc0) and host: live beside the image, or in the folder, as before.
+//
+// Settings file: PS2X_SETTINGS=<path>, else <settings dir>/outbreak.ini (the exe's folder; on Android the app's
+// external files dir, /sdcard/Android/data/<package>/files). Read once at start-up. One "key = value" per line;
+// a line whose first non-blank character is ';' or '#' is a comment (so paths may contain both); keys are
+// case-insensitive; a value may be in double quotes; a relative path is relative to the settings file's folder.
+//   game = <ISO image, extracted folder or boot ELF>   the command-line argument wins over it
+//   textures = <root>   PCSX2 layout: <root>/<serial>/replacements (recorded and exposed; not used yet)
+//   mods = <root>       reserved for mod support (recorded only)
+// A bad line is reported once ("[settings] line N: ...") and ignored.
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace ps2game
+{
+    struct Settings
+    {
+        std::filesystem::path file;     // the file read; empty = none
+        std::filesystem::path game;     // empty = not set
+        std::filesystem::path textures; // empty = not set
+        std::filesystem::path mods;     // empty = not set
+    };
+
+    // Parses settings text; relative paths are resolved against baseDirectory. Bad lines go to messages.
+    void parseSettingsIni(const std::string &text, const std::filesystem::path &baseDirectory, Settings &settings,
+                          std::vector<std::string> &messages);
+    // PS2X_SETTINGS, else <settingsDirectory()>/outbreak.ini; logs what it read once. False = no file read.
+    bool loadSettingsAtStartup();
+    const Settings &activeSettings();
+    void setActiveSettings(const Settings &settings);
+
+    // The exe's folder; on Android the app's external files dir. Empty when unknown.
+    std::filesystem::path settingsDirectory();
+    // <textures>/<serial>/replacements (PCSX2's texture replacement layout); empty when textures is not set.
+    std::filesystem::path textureReplacementDirectory(std::string_view serial);
+
+    struct GameSource
+    {
+        enum class Kind
+        {
+            None,
+            Elf,    // the boot ELF of an extracted folder
+            Folder, // an extracted folder (boot ELF from its SYSTEM.CNF)
+            Image,  // an ISO 9660 disc image
+        };
+        Kind kind = Kind::None;
+        std::filesystem::path given;   // the path as given (game key or command line)
+        std::filesystem::path elfPath; // Elf / Folder: the boot ELF on the host
+        std::filesystem::path image;   // Image: the image file
+        std::filesystem::path folder;  // Elf / Folder: cdrom0:; Image: the image's folder (mc0, host:)
+        std::string bootPath;          // SYSTEM.CNF BOOT2, e.g. "cdrom0:\SLPM_654.28;1"; empty without SYSTEM.CNF
+        std::string elfName;           // "SLPM_654.28"
+        std::string serial;            // "SLPM-65428"; empty when the name is not a serial
+        std::vector<uint8_t> elfBytes; // Image: the boot ELF read from the image
+        std::string error;             // why resolveGameSource failed
+    };
+
+    // Classifies path (directory = extracted folder; ISO 9660 file = image; any other file = the boot ELF) and finds
+    // the boot ELF. False with out.error set when it cannot.
+    bool resolveGameSource(const std::filesystem::path &path, GameSource &out);
+    const char *gameSourceKindName(GameSource::Kind kind);
+
+    // The one *.iso (any case) in directory; empty when there are none or several (Android default game).
+    std::filesystem::path singleIsoIn(const std::filesystem::path &directory);
+}
+
+#endif
