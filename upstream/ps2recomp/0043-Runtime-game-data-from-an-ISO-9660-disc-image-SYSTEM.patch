diff --git a/ps2xRuntime/src/lib/ps2_game_source.cpp b/ps2xRuntime/src/lib/ps2_game_source.cpp
new file mode 100644
index 0000000..2bb42d3
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_game_source.cpp
@@ -0,0 +1,334 @@
+#include "runtime/ps2_game_source.h"
+
+#include "ps2x/iop/iso9660.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <sstream>
+
+#if defined(_WIN32)
+// windows.h clashes with raylib.h elsewhere in the runtime: declare the one call needed.
+extern "C" __declspec(dllimport) unsigned long __stdcall GetModuleFileNameW(void *module, wchar_t *name,
+                                                                           unsigned long size);
+#endif
+
+#if defined(__ANDROID__)
+#include <android_native_app_glue.h>
+// raylib's Android platform layer (rcore_android.c) keeps the NativeActivity's app here.
+extern "C" struct android_app *GetAndroidApp(void);
+#endif
+
+#ifndef PS2X_SETTINGS_FILE_NAME
+#define PS2X_SETTINGS_FILE_NAME "outbreak.ini"
+#endif
+
+namespace ps2game
+{
+    namespace
+    {
+        std::string trim(std::string_view s)
+        {
+            while (!s.empty() && std::isspace(static_cast<unsigned char>(s.front())))
+                s.remove_prefix(1u);
+            while (!s.empty() && std::isspace(static_cast<unsigned char>(s.back())))
+                s.remove_suffix(1u);
+            return std::string(s);
+        }
+
+        std::string lower(std::string s)
+        {
+            std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c)
+                           { return static_cast<char>(std::tolower(c)); });
+            return s;
+        }
+
+        Settings &activeStorage()
+        {
+            static Settings s_active;
+            return s_active;
+        }
+
+        bool readText(const std::filesystem::path &path, std::string &text)
+        {
+            std::ifstream file(path, std::ios::binary);
+            if (!file)
+                return false;
+            std::stringstream buffer;
+            buffer << file.rdbuf();
+            text = buffer.str();
+            return true;
+        }
+
+        // A child of directory whose name matches name ignoring ASCII case; empty when none.
+        std::filesystem::path childIgnoringCase(const std::filesystem::path &directory, const std::string &name)
+        {
+            std::error_code ec;
+            const std::filesystem::path direct = directory / name;
+            if (std::filesystem::exists(direct, ec))
+                return direct;
+            const std::string wanted = lower(name);
+            for (const auto &entry : std::filesystem::directory_iterator(directory, ec))
+            {
+                if (lower(entry.path().filename().string()) == wanted)
+                    return entry.path();
+            }
+            return {};
+        }
+
+        // relative = "IOP/MODULES/X.IRX" under folder, each component matched ignoring case.
+        std::filesystem::path findIgnoringCase(const std::filesystem::path &folder, const std::string &relative)
+        {
+            std::filesystem::path current = folder;
+            size_t begin = 0u;
+            while (begin < relative.size())
+            {
+                size_t end = relative.find('/', begin);
+                if (end == std::string::npos)
+                    end = relative.size();
+                current = childIgnoringCase(current, relative.substr(begin, end - begin));
+                if (current.empty())
+                    return {};
+                begin = end + 1u;
+            }
+            return current;
+        }
+
+        std::string leafOf(const std::string &normalized)
+        {
+            const size_t slash = normalized.rfind('/');
+            return slash == std::string::npos ? normalized : normalized.substr(slash + 1u);
+        }
+    }
+
+    void parseSettingsIni(const std::string &text, const std::filesystem::path &baseDirectory, Settings &settings,
+                          std::vector<std::string> &messages)
+    {
+        std::stringstream in(text);
+        std::string raw;
+        int lineNo = 0;
+        while (std::getline(in, raw))
+        {
+            ++lineNo;
+            const std::string line = trim(raw);
+            if (line.empty() || line.front() == ';' || line.front() == '#')
+                continue;
+            auto bad = [&](const std::string &why)
+            { messages.push_back("[settings] line " + std::to_string(lineNo) + ": " + why); };
+            const size_t equals = line.find('=');
+            if (equals == std::string::npos)
+            {
+                bad("expected key = value");
+                continue;
+            }
+            const std::string key = lower(trim(std::string_view(line).substr(0u, equals)));
+            std::string value = trim(std::string_view(line).substr(equals + 1u));
+            if (value.size() >= 2u && value.front() == '"' && value.back() == '"')
+                value = value.substr(1u, value.size() - 2u);
+            std::filesystem::path *target = nullptr;
+            if (key == "game")
+                target = &settings.game;
+            else if (key == "textures")
+                target = &settings.textures;
+            else if (key == "mods")
+                target = &settings.mods;
+            else
+            {
+                bad("unknown key '" + key + "' (game, textures, mods)");
+                continue;
+            }
+            if (value.empty())
+            {
+                target->clear();
+                continue;
+            }
+            std::filesystem::path path = std::filesystem::u8path(value);
+            if (path.is_relative() && !baseDirectory.empty())
+                path = baseDirectory / path;
+            *target = path.lexically_normal();
+        }
+    }
+
+    const Settings &activeSettings() { return activeStorage(); }
+    void setActiveSettings(const Settings &settings) { activeStorage() = settings; }
+
+    std::filesystem::path settingsDirectory()
+    {
+#if defined(__ANDROID__)
+        struct android_app *app = GetAndroidApp();
+        if (app && app->activity && app->activity->externalDataPath)
+            return std::filesystem::path(app->activity->externalDataPath);
+        return {};
+#elif defined(_WIN32)
+        wchar_t buffer[1040];
+        const unsigned long n = GetModuleFileNameW(nullptr, buffer, 1040u);
+        if (n == 0u || n >= 1040u)
+            return {};
+        return std::filesystem::path(std::wstring(buffer, n)).parent_path();
+#else
+        std::error_code ec;
+        const std::filesystem::path exe = std::filesystem::read_symlink("/proc/self/exe", ec);
+        return ec ? std::filesystem::path{} : exe.parent_path();
+#endif
+    }
+
+    bool loadSettingsAtStartup()
+    {
+        std::filesystem::path path;
+        bool named = false;
+        if (const char *env = std::getenv("PS2X_SETTINGS"); env && *env)
+        {
+            path = std::filesystem::u8path(env);
+            named = true;
+        }
+        else
+        {
+            const std::filesystem::path dir = settingsDirectory();
+            if (dir.empty())
+                return false;
+            path = dir / PS2X_SETTINGS_FILE_NAME;
+        }
+        std::string text;
+        if (!readText(path, text))
+        {
+            if (named)
+                std::cout << "[settings] cannot open PS2X_SETTINGS=" << path.string() << std::endl;
+            return false;
+        }
+        Settings settings;
+        settings.file = path;
+        std::vector<std::string> messages;
+        parseSettingsIni(text, path.parent_path(), settings, messages);
+        for (const std::string &m : messages)
+            std::cout << m << std::endl;
+        setActiveSettings(settings);
+        std::cout << "[settings] from " << path.string() << " (" << messages.size() << " bad line(s)): game="
+                  << (settings.game.empty() ? "-" : settings.game.string())
+                  << " textures=" << (settings.textures.empty() ? "-" : settings.textures.string())
+                  << " mods=" << (settings.mods.empty() ? "-" : settings.mods.string()) << std::endl;
+        return true;
+    }
+
+    std::filesystem::path textureReplacementDirectory(std::string_view serial)
+    {
+        const Settings &settings = activeSettings();
+        if (settings.textures.empty() || serial.empty())
+            return {};
+        return settings.textures / std::string(serial) / "replacements";
+    }
+
+    const char *gameSourceKindName(GameSource::Kind kind)
+    {
+        switch (kind)
+        {
+        case GameSource::Kind::Elf:
+            return "elf";
+        case GameSource::Kind::Folder:
+            return "folder";
+        case GameSource::Kind::Image:
+            return "image";
+        default:
+            return "none";
+        }
+    }
+
+    bool resolveGameSource(const std::filesystem::path &path, GameSource &out)
+    {
+        out = {};
+        out.given = path;
+        std::error_code ec;
+        const std::filesystem::path absolute = std::filesystem::absolute(path, ec).lexically_normal();
+        if (path.empty() || !std::filesystem::exists(absolute, ec))
+        {
+            out.error = "no such file or folder: " + path.string();
+            return false;
+        }
+
+        if (std::filesystem::is_directory(absolute, ec))
+        {
+            out.kind = GameSource::Kind::Folder;
+            out.folder = absolute;
+            const std::filesystem::path cnf = childIgnoringCase(absolute, "SYSTEM.CNF");
+            std::string text;
+            if (cnf.empty() || !readText(cnf, text))
+            {
+                out.error = "no SYSTEM.CNF in " + absolute.string();
+                return false;
+            }
+            out.bootPath = ps2x::iop::systemCnfBootPath(text);
+            const std::string relative = ps2x::iop::normalizeIsoPath(out.bootPath);
+            out.elfPath = relative.empty() ? std::filesystem::path{} : findIgnoringCase(absolute, relative);
+            if (out.elfPath.empty())
+            {
+                out.error = "SYSTEM.CNF boot file '" + out.bootPath + "' not found in " + absolute.string();
+                return false;
+            }
+            out.elfName = out.elfPath.filename().string();
+            out.serial = ps2x::iop::ps2SerialFromBootPath(out.bootPath);
+            return true;
+        }
+
+        if (ps2x::iop::IsoImage::probe(absolute))
+        {
+            out.kind = GameSource::Kind::Image;
+            out.image = absolute;
+            out.folder = absolute.parent_path();
+            std::string why;
+            const std::shared_ptr<ps2x::iop::IsoImage> iso = ps2x::iop::IsoImage::open(absolute, &why);
+            ps2x::iop::IsoEntry cnf;
+            std::vector<uint8_t> bytes;
+            if (!iso)
+            {
+                out.error = why;
+                return false;
+            }
+            if (!iso->find("SYSTEM.CNF", cnf) || !iso->readFile(cnf, bytes))
+            {
+                out.error = "no SYSTEM.CNF in " + absolute.string();
+                return false;
+            }
+            out.bootPath = ps2x::iop::systemCnfBootPath(std::string(bytes.begin(), bytes.end()));
+            ps2x::iop::IsoEntry elf;
+            if (out.bootPath.empty() || !iso->find(out.bootPath, elf) || elf.directory || !iso->readFile(elf, out.elfBytes))
+            {
+                out.error = "SYSTEM.CNF boot file '" + out.bootPath + "' not found in " + absolute.string();
+                return false;
+            }
+            out.elfName = elf.name;
+            out.serial = ps2x::iop::ps2SerialFromBootPath(out.bootPath);
+            return true;
+        }
+
+        // A file that is not an image: the boot ELF itself, its folder is the disc (the original form).
+        out.kind = GameSource::Kind::Elf;
+        out.elfPath = absolute;
+        out.folder = absolute.parent_path();
+        out.elfName = absolute.filename().string();
+        const std::filesystem::path cnf = childIgnoringCase(out.folder, "SYSTEM.CNF");
+        std::string text;
+        if (!cnf.empty() && readText(cnf, text))
+            out.bootPath = ps2x::iop::systemCnfBootPath(text);
+        // The serial from the boot path when SYSTEM.CNF names this ELF, else from the ELF's own name.
+        const std::string bootLeaf = leafOf(ps2x::iop::normalizeIsoPath(out.bootPath));
+        std::string elfUpper = ps2x::iop::normalizeIsoPath(out.elfName);
+        out.serial = ps2x::iop::ps2SerialFromBootPath(!bootLeaf.empty() && bootLeaf == elfUpper ? out.bootPath : out.elfName);
+        return true;
+    }
+
+    std::filesystem::path singleIsoIn(const std::filesystem::path &directory)
+    {
+        std::filesystem::path found;
+        int count = 0;
+        std::error_code ec;
+        for (const auto &entry : std::filesystem::directory_iterator(directory, ec))
+        {
+            if (!entry.is_regular_file(ec) || lower(entry.path().extension().string()) != ".iso")
+                continue;
+            found = entry.path();
+            ++count;
+        }
+        return count == 1 ? found : std::filesystem::path{};
+    }
+}
