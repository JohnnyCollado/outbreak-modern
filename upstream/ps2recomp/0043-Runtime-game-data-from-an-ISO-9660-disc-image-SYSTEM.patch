diff --git a/ps2xIOP/src/iso9660.cpp b/ps2xIOP/src/iso9660.cpp
new file mode 100644
index 0000000..e8f391e
--- /dev/null
+++ b/ps2xIOP/src/iso9660.cpp
@@ -0,0 +1,399 @@
+#include "ps2x/iop/iso9660.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+#include <limits>
+
+#if !defined(_WIN32)
+#include <sys/types.h>
+#endif
+
+namespace ps2x::iop
+{
+    namespace
+    {
+        // ECMA-119 directory record: length, extended attribute length, extent (LE at 2, BE at 6), data length
+        // (LE at 10, BE at 14), date (18..24), flags (25), unit size, gap, volume sequence (28..31), identifier
+        // length (32), identifier (33...).
+        constexpr size_t kRecordFixedSize = 33u;
+        constexpr uint8_t kFlagDirectory = 0x02u;
+        constexpr size_t kMaxReadFileBytes = 512u * 1024u * 1024u;
+
+        uint32_t le32(const uint8_t *p)
+        {
+            return static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) |
+                   (static_cast<uint32_t>(p[2]) << 16) | (static_cast<uint32_t>(p[3]) << 24);
+        }
+
+        uint16_t le16(const uint8_t *p)
+        {
+            return static_cast<uint16_t>(p[0] | (p[1] << 8));
+        }
+
+        std::string upperAscii(std::string_view value)
+        {
+            std::string out(value);
+            std::transform(out.begin(), out.end(), out.begin(), [](unsigned char c)
+                           { return static_cast<char>((c >= 'a' && c <= 'z') ? c - ('a' - 'A') : c); });
+            return out;
+        }
+
+        // "NAME.EXT;1" -> "NAME.EXT"; "DIR." -> "DIR" (some mastering tools end extension-less names with '.').
+        std::string stripVersion(std::string_view identifier)
+        {
+            std::string name(identifier);
+            const size_t semicolon = name.rfind(';');
+            if (semicolon != std::string::npos && semicolon + 1u < name.size() &&
+                std::all_of(name.begin() + static_cast<std::ptrdiff_t>(semicolon + 1u), name.end(),
+                            [](unsigned char c) { return std::isdigit(c) != 0; }))
+                name.erase(semicolon);
+            if (name.size() > 1u && name.back() == '.')
+                name.pop_back();
+            return name;
+        }
+
+        bool seekTo(std::FILE *file, uint64_t offset)
+        {
+#if defined(_WIN32)
+            return offset <= static_cast<uint64_t>(std::numeric_limits<int64_t>::max()) &&
+                   _fseeki64(file, static_cast<int64_t>(offset), SEEK_SET) == 0;
+#else
+            return offset <= static_cast<uint64_t>(std::numeric_limits<off_t>::max()) &&
+                   fseeko(file, static_cast<off_t>(offset), SEEK_SET) == 0;
+#endif
+        }
+
+        std::FILE *openRead(const std::filesystem::path &path)
+        {
+#if defined(_WIN32)
+            return ::_wfopen(path.c_str(), L"rb");
+#else
+            return std::fopen(path.string().c_str(), "rb");
+#endif
+        }
+    }
+
+    std::string normalizeIsoPath(std::string_view path)
+    {
+        std::string value(path);
+        const size_t colon = value.find(':');
+        if (colon != std::string::npos && value.find_first_of("/\\") > colon)
+            value.erase(0u, colon + 1u);
+        std::replace(value.begin(), value.end(), '\\', '/');
+        while (!value.empty() && (value.front() == '/' || std::isspace(static_cast<unsigned char>(value.front()))))
+            value.erase(value.begin());
+        while (!value.empty() && (value.back() == '/' || std::isspace(static_cast<unsigned char>(value.back()))))
+            value.pop_back();
+        std::string out;
+        size_t begin = 0u;
+        while (begin <= value.size())
+        {
+            size_t end = value.find('/', begin);
+            if (end == std::string::npos)
+                end = value.size();
+            const std::string component = stripVersion(std::string_view(value).substr(begin, end - begin));
+            if (!component.empty() && component != ".")
+            {
+                if (!out.empty())
+                    out.push_back('/');
+                out += upperAscii(component);
+            }
+            begin = end + 1u;
+        }
+        return out;
+    }
+
+    std::string systemCnfBootPath(std::string_view text)
+    {
+        std::string fallback;
+        size_t begin = 0u;
+        while (begin < text.size())
+        {
+            size_t end = text.find_first_of("\r\n", begin);
+            if (end == std::string_view::npos)
+                end = text.size();
+            const std::string_view line = text.substr(begin, end - begin);
+            begin = end + 1u;
+            const size_t equals = line.find('=');
+            if (equals == std::string_view::npos)
+                continue;
+            auto trim = [](std::string_view s)
+            {
+                while (!s.empty() && std::isspace(static_cast<unsigned char>(s.front())))
+                    s.remove_prefix(1u);
+                while (!s.empty() && std::isspace(static_cast<unsigned char>(s.back())))
+                    s.remove_suffix(1u);
+                return s;
+            };
+            const std::string key = upperAscii(trim(line.substr(0u, equals)));
+            const std::string value(trim(line.substr(equals + 1u)));
+            if (key == "BOOT2" && !value.empty())
+                return value;
+            if (key == "BOOT" && fallback.empty())
+                fallback = value;
+        }
+        return fallback;
+    }
+
+    std::string ps2SerialFromBootPath(std::string_view bootPath)
+    {
+        std::string leaf = normalizeIsoPath(bootPath);
+        const size_t slash = leaf.rfind('/');
+        if (slash != std::string::npos)
+            leaf.erase(0u, slash + 1u);
+        // SLPM_654.28 -> SLPM-65428
+        if (leaf.size() != 11u || leaf[4] != '_' || leaf[8] != '.')
+            return {};
+        for (size_t i = 0u; i < 4u; ++i)
+            if (!std::isalpha(static_cast<unsigned char>(leaf[i])))
+                return {};
+        for (const size_t i : {5u, 6u, 7u, 9u, 10u})
+            if (!std::isdigit(static_cast<unsigned char>(leaf[i])))
+                return {};
+        return leaf.substr(0u, 4u) + "-" + leaf.substr(5u, 3u) + leaf.substr(9u, 2u);
+    }
+
+    std::shared_ptr<IsoImage> IsoImage::open(const std::filesystem::path &path, std::string *error)
+    {
+        auto fail = [&](const std::string &why) -> std::shared_ptr<IsoImage>
+        {
+            if (error)
+                *error = why;
+            return nullptr;
+        };
+        std::error_code ec;
+        const uint64_t size = std::filesystem::file_size(path, ec);
+        if (ec)
+            return fail("cannot stat " + path.string() + ": " + ec.message());
+        if (size < static_cast<uint64_t>(kPrimaryVolumeDescriptorLsn + 1u) * kSectorSize)
+            return fail(path.string() + " is too small for an ISO 9660 image");
+
+        std::shared_ptr<IsoImage> image(new IsoImage());
+        image->m_path = path;
+        image->m_sizeBytes = size;
+        image->m_file = openRead(path);
+        if (!image->m_file)
+            return fail("cannot open " + path.string());
+        // Large reads go straight to the destination; the buffer serves the small sequential ones (directory
+        // records, file headers) without a host call each.
+        std::setvbuf(image->m_file, nullptr, _IOFBF, 64u * 1024u);
+
+        uint8_t pvd[kSectorSize];
+        if (image->readLocked(static_cast<uint64_t>(kPrimaryVolumeDescriptorLsn) * kSectorSize, pvd, kSectorSize) != kSectorSize)
+            return fail("cannot read the volume descriptor of " + path.string());
+        if (pvd[0] != 1u || std::memcmp(pvd + 1, "CD001", 5u) != 0)
+            return fail(path.string() + " has no ISO 9660 primary volume descriptor at sector 16");
+        if (le16(pvd + 128) != kSectorSize)
+            return fail(path.string() + ": logical block size " + std::to_string(le16(pvd + 128)) + " (only 2048 supported)");
+        image->m_volumeSectors = le32(pvd + 80);
+        const uint8_t *rootRecord = pvd + 156;
+        image->m_root.lsn = le32(rootRecord + 2);
+        image->m_root.size = le32(rootRecord + 10);
+        image->m_root.directory = true;
+        if (image->m_root.size == 0u || static_cast<uint64_t>(image->m_root.lsn) * kSectorSize >= size)
+            return fail(path.string() + ": root directory out of range");
+        return image;
+    }
+
+    namespace
+    {
+        struct SharedImages
+        {
+            std::mutex mutex;
+            std::unordered_map<std::string, std::shared_ptr<IsoImage>> images;
+        };
+
+        SharedImages &sharedImages()
+        {
+            static SharedImages s_shared;
+            return s_shared;
+        }
+    }
+
+    std::shared_ptr<IsoImage> IsoImage::shared(const std::filesystem::path &path)
+    {
+        if (path.empty())
+            return nullptr;
+        SharedImages &shared = sharedImages();
+        const std::string key = path.lexically_normal().string();
+        std::lock_guard<std::mutex> lock(shared.mutex);
+        const auto found = shared.images.find(key);
+        if (found != shared.images.end())
+            return found->second;
+        std::shared_ptr<IsoImage> image = open(path);
+        if (image)
+            shared.images.emplace(key, image);
+        return image;
+    }
+
+    void IsoImage::dropShared(const std::filesystem::path &path)
+    {
+        SharedImages &shared = sharedImages();
+        std::lock_guard<std::mutex> lock(shared.mutex);
+        shared.images.erase(path.lexically_normal().string());
+    }
+
+    bool IsoImage::probe(const std::filesystem::path &path)
+    {
+        std::error_code ec;
+        if (!std::filesystem::is_regular_file(path, ec) || ec)
+            return false;
+        std::FILE *file = openRead(path);
+        if (!file)
+            return false;
+        uint8_t header[8] = {};
+        const bool ok = seekTo(file, static_cast<uint64_t>(kPrimaryVolumeDescriptorLsn) * kSectorSize) &&
+                        std::fread(header, 1u, sizeof(header), file) == sizeof(header) &&
+                        header[0] == 1u && std::memcmp(header + 1, "CD001", 5u) == 0;
+        std::fclose(file);
+        return ok;
+    }
+
+    IsoImage::~IsoImage()
+    {
+        if (m_file)
+            std::fclose(m_file);
+    }
+
+    size_t IsoImage::readLocked(uint64_t offset, void *destination, size_t size) const
+    {
+        if (!m_file || size == 0u || offset >= m_sizeBytes)
+            return 0u;
+        size = static_cast<size_t>(std::min<uint64_t>(size, m_sizeBytes - offset));
+        ++m_hostReads;
+        if (m_position != offset)
+        {
+            ++m_hostSeeks;
+            if (!seekTo(m_file, offset))
+            {
+                m_position = UINT64_MAX;
+                return 0u;
+            }
+        }
+        const size_t got = std::fread(destination, 1u, size, m_file);
+        if (got < size)
+        {
+            std::clearerr(m_file);
+            m_position = UINT64_MAX;
+        }
+        else
+            m_position = offset + got;
+        return got;
+    }
+
+    size_t IsoImage::read(uint64_t offset, void *destination, size_t size) const
+    {
+        if (!destination && size != 0u)
+            return 0u;
+        std::lock_guard<std::mutex> lock(m_mutex);
+        return readLocked(offset, destination, size);
+    }
+
+    bool IsoImage::readSectors(uint32_t lsn, uint32_t count, void *destination) const
+    {
+        const uint64_t end = static_cast<uint64_t>(lsn) + count;
+        if (end > imageSectors() || (!destination && count != 0u))
+            return false;
+        const size_t bytes = static_cast<size_t>(count) * kSectorSize;
+        return read(static_cast<uint64_t>(lsn) * kSectorSize, destination, bytes) == bytes;
+    }
+
+    bool IsoImage::readFile(const IsoEntry &file, std::vector<uint8_t> &bytes) const
+    {
+        bytes.clear();
+        if (file.directory || file.size > kMaxReadFileBytes)
+            return false;
+        bytes.resize(file.size);
+        return read(static_cast<uint64_t>(file.lsn) * kSectorSize, bytes.data(), bytes.size()) == bytes.size();
+    }
+
+    bool IsoImage::directoryEntries(const IsoEntry &directory, const std::vector<IsoEntry> *&out) const
+    {
+        // Caller holds m_mutex.
+        const auto cached = m_directories.find(directory.lsn);
+        if (cached != m_directories.end())
+        {
+            out = &cached->second;
+            return true;
+        }
+        if (!directory.directory || directory.size == 0u || directory.size > 16u * 1024u * 1024u)
+            return false;
+        std::vector<uint8_t> bytes(directory.size);
+        if (readLocked(static_cast<uint64_t>(directory.lsn) * kSectorSize, bytes.data(), bytes.size()) != bytes.size())
+            return false;
+
+        std::vector<IsoEntry> entries;
+        size_t offset = 0u;
+        while (offset < bytes.size())
+        {
+            const uint8_t length = bytes[offset];
+            if (length == 0u)
+            {
+                // Records never cross a sector: a zero length pads to the next sector.
+                offset = (offset / kSectorSize + 1u) * kSectorSize;
+                continue;
+            }
+            if (length < kRecordFixedSize || offset + length > bytes.size())
+                break;
+            const uint8_t *record = bytes.data() + offset;
+            const uint8_t nameLength = record[32];
+            if (kRecordFixedSize + nameLength <= length)
+            {
+                const bool self = nameLength == 1u && (record[33] == 0u || record[33] == 1u);
+                if (!self)
+                {
+                    IsoEntry entry;
+                    entry.lsn = le32(record + 2);
+                    entry.size = le32(record + 10);
+                    entry.directory = (record[25] & kFlagDirectory) != 0u;
+                    entry.name = stripVersion(std::string_view(reinterpret_cast<const char *>(record + 33), nameLength));
+                    entries.push_back(std::move(entry));
+                }
+            }
+            offset += length;
+        }
+        out = &m_directories.emplace(directory.lsn, std::move(entries)).first->second;
+        return true;
+    }
+
+    bool IsoImage::list(const IsoEntry &directory, std::vector<IsoEntry> &out) const
+    {
+        out.clear();
+        std::lock_guard<std::mutex> lock(m_mutex);
+        const std::vector<IsoEntry> *entries = nullptr;
+        if (!directoryEntries(directory, entries))
+            return false;
+        out = *entries;
+        return true;
+    }
+
+    bool IsoImage::find(std::string_view path, IsoEntry &out) const
+    {
+        const std::string wanted = normalizeIsoPath(path);
+        std::lock_guard<std::mutex> lock(m_mutex);
+        IsoEntry current = m_root;
+        size_t begin = 0u;
+        while (begin < wanted.size())
+        {
+            size_t end = wanted.find('/', begin);
+            if (end == std::string::npos)
+                end = wanted.size();
+            const std::string_view component = std::string_view(wanted).substr(begin, end - begin);
+            begin = end + 1u;
+            if (component == "..")
+                return false;
+            const std::vector<IsoEntry> *entries = nullptr;
+            if (!current.directory || !directoryEntries(current, entries))
+                return false;
+            // ISO 9660 sorts records, but patched images do not always keep them sorted: scan.
+            const auto match = std::find_if(entries->begin(), entries->end(), [&](const IsoEntry &entry)
+                                            { return upperAscii(entry.name) == component; });
+            if (match == entries->end())
+                return false;
+            current = *match;
+        }
+        out = current;
+        return true;
+    }
+}
