+// Patch 0043: game data from an ISO 9660 disc image, extracted folders through SYSTEM.CNF, and the settings file.
+// Every case builds a tiny synthetic image (27 sectors) in a temp folder; no game data is used.
+#include "MiniTest.h"
+#include "ps2_runtime.h"
+#include "ps2_stubs.h"
+#include "ps2_syscalls.h"
+#include "ps2x/iop/iso9660.h"
+#include "runtime/ps2_game_source.h"
+
+#include <chrono>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace
+{
+    constexpr uint32_t kSector = 2048u;
+    constexpr uint32_t kRootLsn = 18u;    // two sectors: the second starts after zero padding
+    constexpr uint32_t kDataDirLsn = 20u;
+    constexpr uint32_t kCnfLsn = 21u;
+    constexpr uint32_t kElfLsn = 22u;
+    constexpr uint32_t kBigLsn = 23u;     // three sectors, the last one partial
+    constexpr uint32_t kSmallLsn = 26u;
+    constexpr uint32_t kTotalSectors = 27u;
+    constexpr uint32_t kBigSize = 3u * kSector - 100u;
+    const std::string kCnfText = "BOOT2 = cdrom0:\\SLUS_123.45;1\r\nVER = 1.00\r\nVMODE = NTSC\r\n";
+
+    uint8_t bigByte(uint32_t offset) { return static_cast<uint8_t>((offset * 7u + offset / kSector) & 0xFFu); }
+
+    std::vector<uint8_t> fakeElf()
+    {
+        std::vector<uint8_t> elf(100u, 0x5Au);
+        elf[0] = 0x7F;
+        elf[1] = 'E';
+        elf[2] = 'L';
+        elf[3] = 'F';
+        return elf;
+    }
+
+    void put32Both(uint8_t *p, uint32_t v)
+    {
+        for (int i = 0; i < 4; ++i)
+        {
+            p[i] = static_cast<uint8_t>(v >> (8 * i));
+            p[7 - i] = static_cast<uint8_t>(v >> (8 * i));
+        }
+    }
+
+    size_t putRecord(uint8_t *p, uint32_t lsn, uint32_t size, bool dir, const std::string &id)
+    {
+        const size_t idLen = id.size();
+        const size_t length = 33u + idLen + ((idLen % 2u) == 0u ? 1u : 0u);
+        std::memset(p, 0, length);
+        p[0] = static_cast<uint8_t>(length);
+        put32Both(p + 2, lsn);
+        put32Both(p + 10, size);
+        p[25] = dir ? 2u : 0u;
+        p[28] = 1u; // volume sequence number
+        p[32] = static_cast<uint8_t>(idLen);
+        std::memcpy(p + 33, id.data(), idLen);
+        return length;
+    }
+
+    // Root: ".", "..", SYSTEM.CNF;1, SLUS_123.45;1 (records not sorted), zero padding, DATA (second sector).
+    // DATA: ".", "..", BIG.DAT;1, SMALL.TXT;1.
+    void writeSyntheticIso(const std::filesystem::path &path)
+    {
+        std::vector<uint8_t> image(static_cast<size_t>(kTotalSectors) * kSector, 0u);
+        uint8_t *pvd = image.data() + 16u * kSector;
+        pvd[0] = 1u;
+        std::memcpy(pvd + 1, "CD001", 5u);
+        pvd[6] = 1u;
+        put32Both(pvd + 80, kTotalSectors);
+        pvd[128] = 0x00;
+        pvd[129] = 0x08; // 2048, little-endian half
+        pvd[130] = 0x08;
+        pvd[131] = 0x00;
+        putRecord(pvd + 156, kRootLsn, 2u * kSector, true, std::string(1, '\0'));
+        uint8_t *term = image.data() + 17u * kSector;
+        term[0] = 255u;
+        std::memcpy(term + 1, "CD001", 5u);
+
+        uint8_t *root = image.data() + kRootLsn * kSector;
+        size_t o = 0u;
+        o += putRecord(root + o, kRootLsn, 2u * kSector, true, std::string(1, '\0'));
+        o += putRecord(root + o, kRootLsn, 2u * kSector, true, std::string(1, '\1'));
+        o += putRecord(root + o, kCnfLsn, static_cast<uint32_t>(kCnfText.size()), false, "SYSTEM.CNF;1");
+        o += putRecord(root + o, kElfLsn, static_cast<uint32_t>(fakeElf().size()), false, "SLUS_123.45;1");
+        putRecord(root + kSector, kDataDirLsn, kSector, true, "DATA");
+
+        uint8_t *data = image.data() + kDataDirLsn * kSector;
+        o = 0u;
+        o += putRecord(data + o, kDataDirLsn, kSector, true, std::string(1, '\0'));
+        o += putRecord(data + o, kRootLsn, 2u * kSector, true, std::string(1, '\1'));
+        o += putRecord(data + o, kBigLsn, kBigSize, false, "BIG.DAT;1");
+        o += putRecord(data + o, kSmallLsn, 5u, false, "SMALL.TXT;1");
+
+        std::memcpy(image.data() + kCnfLsn * kSector, kCnfText.data(), kCnfText.size());
+        const std::vector<uint8_t> elf = fakeElf();
+        std::memcpy(image.data() + kElfLsn * kSector, elf.data(), elf.size());
+        for (uint32_t i = 0u; i < kBigSize; ++i)
+            image[kBigLsn * kSector + i] = bigByte(i);
+        std::memcpy(image.data() + kSmallLsn * kSector, "hello", 5u);
+
+        std::ofstream out(path, std::ios::binary);
+        out.write(reinterpret_cast<const char *>(image.data()), static_cast<std::streamsize>(image.size()));
+    }
+
+    struct TempDir
+    {
+        std::filesystem::path base;
+        std::filesystem::path iso;
+        TempDir()
+        {
+            const auto now = std::chrono::steady_clock::now().time_since_epoch().count();
+            base = std::filesystem::temp_directory_path() / ("ps2recomp-iso-" + std::to_string(now));
+            std::filesystem::create_directories(base / "mc0");
+            iso = base / "disc.iso";
+            writeSyntheticIso(iso);
+        }
+        ~TempDir()
+        {
+            ps2x::iop::IsoImage::dropShared(iso);
+            PS2Runtime::setIoPaths({});
+            std::error_code ec;
+            std::filesystem::remove_all(base, ec);
+        }
+        void mount() const
+        {
+            PS2Runtime::IoPaths io;
+            io.elfPath = iso;
+            io.elfDirectory = base;
+            io.hostRoot = base;
+            io.cdRoot = base;
+            io.mcRoot = base / "mc0";
+            io.cdImage = iso;
+            PS2Runtime::setIoPaths(io);
+        }
+    };
+
+    void setReg(R5900Context &ctx, int reg, uint32_t value) { ctx.r[reg] = _mm_set_epi64x(0, static_cast<int64_t>(value)); }
+    int32_t retS32(const R5900Context &ctx) { return static_cast<int32_t>(::getRegU32(&ctx, 2)); }
+    uint32_t u32At(const std::vector<uint8_t> &ram, uint32_t addr)
+    {
+        uint32_t v = 0u;
+        std::memcpy(&v, ram.data() + addr, 4u);
+        return v;
+    }
+}
+
+void register_ps2_game_source_tests()
+{
+    MiniTest::Case("GameSource", [](TestCase &tc)
+    {
+        tc.Run("ISO 9660: directory lookup ignores case, separators, device and ;1", [](TestCase &t)
+        {
+            TempDir dir;
+            std::string why;
+            const auto iso = ps2x::iop::IsoImage::open(dir.iso, &why);
+            t.IsTrue(iso != nullptr, "synthetic image opens: " + why);
+            if (!iso)
+                return;
+            t.Equals(iso->volumeSectors(), kTotalSectors, "volume size from the primary volume descriptor");
+            ps2x::iop::IsoEntry e;
+            t.IsTrue(iso->find("cdrom0:\\DATA\\BIG.DAT;1", e), "device prefix, backslashes, ;1");
+            t.Equals(e.lsn, kBigLsn, "BIG.DAT extent");
+            t.Equals(e.size, kBigSize, "BIG.DAT size");
+            t.IsTrue(iso->find("data/small.txt", e) && e.lsn == kSmallLsn, "lower case, slashes, no version");
+            t.IsTrue(iso->find("\\SLUS_123.45", e) && e.lsn == kElfLsn, "root file listed after SYSTEM.CNF (unsorted)");
+            t.IsTrue(iso->find("\\DATA", e) && e.directory && e.lsn == kDataDirLsn,
+                     "directory record in the root's second sector, after zero padding");
+            t.IsFalse(iso->find("\\DATA\\NOPE.DAT;1", e), "a missing file is not found");
+            t.IsFalse(iso->find("\\SYSTEM.CNF\\X", e), "a file is not a directory");
+            t.IsTrue(iso->find("", e) && e.directory && e.lsn == kRootLsn, "empty path = root");
+        });
+
+        tc.Run("ISO 9660: sector reads come from the image; sequential reads do not seek", [](TestCase &t)
+        {
+            TempDir dir;
+            const auto iso = ps2x::iop::IsoImage::open(dir.iso);
+            t.IsTrue(iso != nullptr, "synthetic image opens");
+            if (!iso)
+                return;
+            std::vector<uint8_t> buf(3u * kSector, 0xEEu);
+            t.IsTrue(iso->readSectors(kBigLsn, 3u, buf.data()), "three sectors of BIG.DAT");
+            bool same = true;
+            for (uint32_t i = 0u; i < kBigSize; ++i)
+                same = same && buf[i] == bigByte(i);
+            t.IsTrue(same, "the bytes are the file's");
+            t.IsFalse(iso->readSectors(kTotalSectors - 1u, 2u, buf.data()), "a read past the end fails");
+            const uint64_t seeks = iso->hostSeeks();
+            uint8_t sector[kSector];
+            t.IsTrue(iso->readSectors(kBigLsn, 1u, sector), "stream: sector 0");
+            t.IsTrue(iso->readSectors(kBigLsn + 1u, 1u, sector), "stream: sector 1");
+            t.IsTrue(iso->readSectors(kBigLsn + 2u, 1u, sector), "stream: sector 2");
+            t.Equals(iso->hostSeeks() - seeks, uint64_t{1}, "one seek for three consecutive sector reads");
+        });
+
+        tc.Run("SYSTEM.CNF: BOOT2 path and serial", [](TestCase &t)
+        {
+            t.Equals(ps2x::iop::systemCnfBootPath(kCnfText), std::string("cdrom0:\\SLUS_123.45;1"), "BOOT2 value");
+            t.Equals(ps2x::iop::systemCnfBootPath("BOOT = cdrom:\\SCUS_944.55;1\n"), std::string("cdrom:\\SCUS_944.55;1"),
+                     "a PS1 BOOT line when there is no BOOT2");
+            t.Equals(ps2x::iop::ps2SerialFromBootPath("cdrom0:\\SLPM_654.28;1"), std::string("SLPM-65428"), "serial");
+            t.Equals(ps2x::iop::ps2SerialFromBootPath("cdrom0:\\GAME.ELF;1"), std::string(), "no serial in a plain name");
+        });
+
+        tc.Run("game source: an image boots SYSTEM.CNF's BOOT2 from inside the image", [](TestCase &t)
+        {
+            TempDir dir;
+            ps2game::GameSource source;
+            t.IsTrue(ps2game::resolveGameSource(dir.iso, source), "image resolves: " + source.error);
+            t.IsTrue(source.kind == ps2game::GameSource::Kind::Image, "kind image");
+            t.Equals(source.elfName, std::string("SLUS_123.45"), "boot ELF name");
+            t.Equals(source.serial, std::string("SLUS-12345"), "serial");
+            t.IsTrue(source.elfBytes == fakeElf(), "boot ELF bytes read from the image");
+            t.IsTrue(source.folder == dir.base, "memory cards and host: beside the image");
+        });
+
+        tc.Run("game source: an extracted folder boots its SYSTEM.CNF's BOOT2 (any case)", [](TestCase &t)
+        {
+            TempDir dir;
+            const std::filesystem::path folder = dir.base / "extracted";
+            std::filesystem::create_directories(folder);
+            std::ofstream(folder / "system.cnf", std::ios::binary) << kCnfText;
+            std::ofstream(folder / "slus_123.45", std::ios::binary) << "elf";
+            ps2game::GameSource source;
+            t.IsTrue(ps2game::resolveGameSource(folder, source), "folder resolves: " + source.error);
+            t.IsTrue(source.kind == ps2game::GameSource::Kind::Folder, "kind folder");
+            std::error_code ec;
+            t.IsTrue(std::filesystem::equivalent(source.elfPath, folder / "slus_123.45", ec),
+                     "boot ELF matched ignoring case: " + source.elfPath.string());
+            t.Equals(source.serial, std::string("SLUS-12345"), "serial");
+
+            ps2game::GameSource elf;
+            t.IsTrue(ps2game::resolveGameSource(folder / "slus_123.45", elf), "the ELF path itself still works");
+            t.IsTrue(elf.kind == ps2game::GameSource::Kind::Elf && elf.folder == folder, "kind elf, its folder is the disc");
+            std::filesystem::remove(folder / "system.cnf");
+            t.IsFalse(ps2game::resolveGameSource(folder, source), "a folder without SYSTEM.CNF is refused");
+        });
+
+        tc.Run("sceCdSearchFile + sceCdRead: real LSNs and sectors from a mounted image", [](TestCase &t)
+        {
+            TempDir dir;
+            dir.mount();
+            std::vector<uint8_t> ram(PS2_RAM_SIZE, 0u);
+            R5900Context ctx{};
+            constexpr uint32_t fileAddr = 0x3000u, pathAddr = 0x1000u, bufAddr = 0x10000u;
+            const char path[] = "\\data\\big.dat;1";
+            std::memcpy(ram.data() + pathAddr, path, sizeof(path));
+            setReg(ctx, 4, fileAddr);
+            setReg(ctx, 5, pathAddr);
+            ps2_stubs::sceCdSearchFile(ram.data(), &ctx, nullptr);
+            t.Equals(retS32(ctx), 1, "found in the image");
+            t.Equals(u32At(ram, fileAddr), kBigLsn, "sceCdlFILE.lsn is the image's LSN, not a pseudo LSN");
+            t.Equals(u32At(ram, fileAddr + 4u), kBigSize, "sceCdlFILE.size");
+
+            std::memset(&ctx, 0, sizeof(ctx));
+            setReg(ctx, 4, kBigLsn + 1u);
+            setReg(ctx, 5, 2u);
+            setReg(ctx, 6, bufAddr);
+            ps2_stubs::sceCdRead(ram.data(), &ctx, nullptr);
+            t.Equals(retS32(ctx), 1, "sceCdRead accepted");
+            bool same = true;
+            for (uint32_t i = 0u; i < kBigSize - kSector; ++i)
+                same = same && ram[bufAddr + i] == bigByte(kSector + i);
+            t.IsTrue(same, "sectors 1-2 of BIG.DAT");
+        });
+
+        tc.Run("cdrom0: file I/O opens, seeks and reads files inside a mounted image", [](TestCase &t)
+        {
+            TempDir dir;
+            dir.mount();
+            PS2Runtime runtime;
+            std::vector<uint8_t> ram(PS2_RAM_SIZE, 0u);
+            R5900Context ctx{};
+            const char path[] = "cdrom0:\\DATA\\BIG.DAT;1";
+            std::memcpy(ram.data() + 0x1000u, path, sizeof(path));
+            setReg(ctx, 4, 0x1000u);
+            setReg(ctx, 5, PS2_FIO_O_RDONLY);
+            ps2_syscalls::fioOpen(ram.data(), &ctx, &runtime);
+            const int32_t fd = retS32(ctx);
+            t.IsTrue(fd >= 3, "open inside the image");
+            setReg(ctx, 4, static_cast<uint32_t>(fd));
+            setReg(ctx, 5, 4000u);
+            setReg(ctx, 6, SEEK_SET);
+            ps2_syscalls::fioLseek(ram.data(), &ctx, &runtime);
+            t.Equals(retS32(ctx), 4000, "seek");
+            setReg(ctx, 4, static_cast<uint32_t>(fd));
+            setReg(ctx, 5, 0x20000u);
+            setReg(ctx, 6, 10000u);
+            ps2_syscalls::fioRead(ram.data(), &ctx, &runtime);
+            t.Equals(retS32(ctx), static_cast<int32_t>(kBigSize - 4000u), "read stops at the end of the file");
+            bool same = true;
+            for (uint32_t i = 0u; i < kBigSize - 4000u; ++i)
+                same = same && ram[0x20000u + i] == bigByte(4000u + i);
+            t.IsTrue(same, "bytes from the image");
+            setReg(ctx, 4, static_cast<uint32_t>(fd));
+            ps2_syscalls::fioClose(ram.data(), &ctx, &runtime);
+
+            setReg(ctx, 4, 0x1000u);
+            setReg(ctx, 5, PS2_FIO_O_WRONLY | PS2_FIO_O_CREAT);
+            ps2_syscalls::fioOpen(ram.data(), &ctx, &runtime);
+            t.IsTrue(retS32(ctx) < 0, "the image is read only");
+            PS2VfsStat st;
+            const PS2VfsMounts mounts{dir.base, dir.base, dir.base / "mc0", dir.iso};
+            t.IsTrue(runtime.vfs().stat("cdrom0:\\DATA", mounts, runtime.romDevice(), st) && st.directory, "stat a directory");
+            std::filesystem::path host;
+            t.IsFalse(runtime.vfs().resolveHostPath("cdrom0:\\DATA\\BIG.DAT", mounts, host),
+                      "no host path for a file inside the image");
+        });
+
+        tc.Run("settings: game, textures, mods; comments, quotes, relative paths, bad lines", [](TestCase &t)
+        {
+            const std::filesystem::path base = std::filesystem::path("C:/games");
+            ps2game::Settings s;
+            std::vector<std::string> messages;
+            ps2game::parseSettingsIni("; comment\n"
+                                      "# another\n"
+                                      "GAME = \"discs/Outbreak #1; v2.iso\"\n"
+                                      "textures = D:/packs\n"
+                                      "mods =\n"
+                                      "colour = red\n"
+                                      "no equals here\n",
+                                      base, s, messages);
+            t.IsTrue(s.game == (base / "discs/Outbreak #1; v2.iso").lexically_normal(),
+                     "quoted value with ';' and '#', relative to the settings folder: " + s.game.string());
+            t.IsTrue(s.textures == std::filesystem::path("D:/packs").lexically_normal(), "absolute textures root");
+            t.IsTrue(s.mods.empty(), "empty value = not set");
+            t.Equals(messages.size(), size_t{2}, "two bad lines reported");
+            ps2game::setActiveSettings(s);
+            t.IsTrue(ps2game::textureReplacementDirectory("SLPM-65428") ==
+                         std::filesystem::path("D:/packs").lexically_normal() / "SLPM-65428" / "replacements",
+                     "PCSX2 layout <root>/<serial>/replacements");
+            ps2game::setActiveSettings({});
+            t.IsTrue(ps2game::textureReplacementDirectory("SLPM-65428").empty(), "no textures root, no directory");
+        });
+    });
+}
