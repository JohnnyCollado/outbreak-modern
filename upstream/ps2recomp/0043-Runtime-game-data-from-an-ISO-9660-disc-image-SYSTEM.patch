new file mode 100644
index 0000000..3d0f1a9
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/iso9660.h
@@ -0,0 +1,103 @@
+#pragma once
+
+// Read-only ISO 9660 disc image (2048-byte sectors, as PS2 DVD and CD-ROM dumps are): the primary volume
+// descriptor at sector 16, directory lookup by path, and sector/byte reads straight from the image file. One host
+// file handle per image, reads under a mutex, and no seek when a read continues where the last one ended, so
+// streamed files (sound, movies, archives of several GB) cost one buffered fread per request and the image is never
+// loaded whole. Paths are matched as the PS2's CDVD manager does: case-insensitive, '\' or '/' separators, an
+// optional device prefix ("cdrom0:") and an optional ";1" version suffix on either side.
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <filesystem>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include <vector>
+
+namespace ps2x::iop
+{
+    struct IsoEntry
+    {
+        uint32_t lsn = 0u;      // first logical sector of the extent
+        uint32_t size = 0u;     // bytes
+        bool directory = false;
+        std::string name;       // identifier as on the disc, without the ";N" suffix ("SLPM_654.28")
+    };
+
+    class IsoImage
+    {
+    public:
+        static constexpr uint32_t kSectorSize = 2048u;
+        static constexpr uint32_t kPrimaryVolumeDescriptorLsn = 16u;
+
+        // Opens the file and checks sector 16 holds a primary volume descriptor ("CD001", type 1, 2048-byte
+        // blocks). nullptr (and *error) when the file is missing, too small or not ISO 9660.
+        [[nodiscard]] static std::shared_ptr<IsoImage> open(const std::filesystem::path &path, std::string *error = nullptr);
+        // One instance per path for the whole process, so the EE CD calls, the file I/O device and the IOP share
+        // one handle and one directory cache. nullptr when open() fails (retried on the next call).
+        [[nodiscard]] static std::shared_ptr<IsoImage> shared(const std::filesystem::path &path);
+        // Forgets the shared instance of path (its handle closes once no caller holds it): for tests that delete
+        // their image, or an image replaced on disk.
+        static void dropShared(const std::filesystem::path &path);
+        // True when the file starts like an ISO 9660 image (cheap: reads one sector).
+        [[nodiscard]] static bool probe(const std::filesystem::path &path);
+
+        ~IsoImage();
+        IsoImage(const IsoImage &) = delete;
+        IsoImage &operator=(const IsoImage &) = delete;
+
+        [[nodiscard]] const std::filesystem::path &path() const noexcept { return m_path; }
+        [[nodiscard]] uint64_t sizeBytes() const noexcept { return m_sizeBytes; }
+        [[nodiscard]] uint32_t imageSectors() const noexcept { return static_cast<uint32_t>(m_sizeBytes / kSectorSize); }
+        [[nodiscard]] uint32_t volumeSectors() const noexcept { return m_volumeSectors; }
+        [[nodiscard]] const IsoEntry &root() const noexcept { return m_root; }
+
+        // Looks a path up from the root ("cdrom0:\IOP\MODULES\DRIVE.DAT;1", "\SYSTEM.CNF", "prog/game.bin").
+        // An empty path or "\" is the root directory.
+        [[nodiscard]] bool find(std::string_view path, IsoEntry &out) const;
+        // The entries of a directory, without "." and "..", in disc order.
+        [[nodiscard]] bool list(const IsoEntry &directory, std::vector<IsoEntry> &out) const;
+        // Reads count whole sectors; false (destination untouched) when the range is past the end of the image.
+        [[nodiscard]] bool readSectors(uint32_t lsn, uint32_t count, void *destination) const;
+        // Reads up to size bytes at a byte offset of the image; returns the bytes read (short at the end).
+        [[nodiscard]] size_t read(uint64_t offset, void *destination, size_t size) const;
+        // A whole file into bytes (files of up to 512 MiB; larger ones are read with read()).
+        [[nodiscard]] bool readFile(const IsoEntry &file, std::vector<uint8_t> &bytes) const;
+
+        // Counters for tests and logs: host reads issued and how many of them needed a seek.
+        [[nodiscard]] uint64_t hostReads() const noexcept { return m_hostReads; }
+        [[nodiscard]] uint64_t hostSeeks() const noexcept { return m_hostSeeks; }
+
+    private:
+        IsoImage() = default;
+        [[nodiscard]] bool directoryEntries(const IsoEntry &directory, const std::vector<IsoEntry> *&out) const;
+        [[nodiscard]] size_t readLocked(uint64_t offset, void *destination, size_t size) const;
+
+        std::filesystem::path m_path;
+        std::FILE *m_file = nullptr;
+        uint64_t m_sizeBytes = 0u;
+        uint32_t m_volumeSectors = 0u;
+        IsoEntry m_root;
+        mutable std::mutex m_mutex;
+        mutable uint64_t m_position = UINT64_MAX; // host file position after the last read (UINT64_MAX = unknown)
+        mutable uint64_t m_hostReads = 0u;
+        mutable uint64_t m_hostSeeks = 0u;
+        mutable std::unordered_map<uint32_t, std::vector<IsoEntry>> m_directories; // by directory LSN
+    };
+
+    // Upper-cases ASCII, turns '\' into '/', drops a device prefix, leading/trailing separators and a numeric ";N"
+    // suffix: the form IsoImage::find compares.
+    [[nodiscard]] std::string normalizeIsoPath(std::string_view path);
+
+    // The boot path of a SYSTEM.CNF ("BOOT2 = cdrom0:\SLPM_654.28;1" -> "cdrom0:\SLPM_654.28;1"; a PS1 disc's
+    // "BOOT = ..." is accepted too). Empty when there is none.
+    [[nodiscard]] std::string systemCnfBootPath(std::string_view systemCnf);
+
+    // The disc serial from a boot path as PCSX2 writes it ("cdrom0:\SLPM_654.28;1" -> "SLPM-65428"). Empty when the
+    // file name does not look like a serial (four letters, '_', three digits, '.', two digits).
+    [[nodiscard]] std::string ps2SerialFromBootPath(std::string_view bootPath);
+}
