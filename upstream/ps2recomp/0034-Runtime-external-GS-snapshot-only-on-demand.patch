+    // Snapshot demand: the guest waits kDemandVSyncs vsyncs (resuming at itself), then stops.
+    constexpr uint32_t kDemandDrivePc = 0x00172000u;
+    constexpr uint32_t kDemandVSyncs = 6u;
+    uint32_t s_demandVSyncsSeen = 0u;
+
+    void demandDrive(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        if (s_demandVSyncsSeen++ >= kDemandVSyncs)
+        {
+            ctx->pc = 0u;
+            runtime->requestStop();
+            return;
+        }
+        ctx->pc = kDemandDrivePc;
