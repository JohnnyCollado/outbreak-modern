+// Hands one presented frame (tick = the vsync it shows) to the frame consumers: a capture step of the input
+// script, or PS2X_FRAME_DUMP_DIR's every-frame dump. Main thread.
+static void DeliverFrameToConsumers(const char *dumpDir, uint64_t tick, const uint8_t *rgba, uint32_t width,
+                                    uint32_t height)
+{
+    if (Ps2InputScript *script = ps2ActiveInputScript())
+    {
+        // Script mode: dump only while a capture step is active, one <screen>-<k>.png per frame tick.
+        std::string fileName;
+        std::string screen;
+        uint32_t k = 0u;
+        if (dumpDir != nullptr && script->takeCapture(tick, fileName, screen, k))
+        {
+            const bool written = ps2DumpPresentedFrameNamed(dumpDir, fileName.c_str(), rgba, width, height);
+            script->commitCapture(written);
+            if (written)
+                std::cout << "[script] capture " << screen << " k=" << k << " tick=" << tick << std::endl;
+            else
+                std::cerr << "[script] capture " << screen << " k=" << k << " write failed" << std::endl;
+        }
+    }
+    else if (dumpDir != nullptr)
+    {
+        ps2DumpPresentedFrame(dumpDir, tick, rgba, width, height);
+    }
+}
+
+// External GS frame demand (gs_external.h): a script wants frames only during a capture step; a plain
+// PS2X_FRAME_DUMP_DIR wants every frame.
+static bool ScriptCaptureFrameDemand(uint64_t)
+{
+    const Ps2InputScript *script = ps2ActiveInputScript();
+    return script != nullptr && script->captureWanted();
+}
+
+static bool EveryFrameDemand(uint64_t)
+{
+    return true;
+}
