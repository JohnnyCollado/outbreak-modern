+    // Runs demandDrive with a recording external GS; returns its events, and the latched frame tick.
+    std::vector<ExternalGSEvent> runDemandVSyncs(uint64_t &latchedTick)
+    {
+        std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0u);
+        PS2Runtime runtime;
+        runtime.registerFunction(kDemandDrivePc, demandDrive);
+        s_demandVSyncsSeen = 0u;
+        RecordingExternalGS rec;
+        ExternalGSScope scope(&rec);
+        R5900Context mainContext{};
+        mainContext.pc = kDemandDrivePc;
+        runtime.eeScheduler().reset(rdram.data(), mainContext);
+        runtime.eeScheduler().run();
+        runtime.gs().latchHostPresentationFrame();
+        latchedTick = runtime.gs().latchedHostPresentationTick();
+        return rec.events;
+    }
