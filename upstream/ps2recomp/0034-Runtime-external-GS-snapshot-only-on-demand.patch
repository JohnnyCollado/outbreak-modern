+        static uint64_t s_lastExternalFrameTick = std::numeric_limits<uint64_t>::max();
+        static std::vector<uint8_t> s_externalScratch;
+        const uint64_t tick = rt->eeScheduler().currentVSyncTick();
+        if (s_frameDumpDir == nullptr || tick == s_lastExternalTick)
+            return;
+        s_lastExternalTick = tick;
+        rt->gs().latchHostPresentationFrame();
+        const uint64_t frameTick = rt->gs().latchedHostPresentationTick();
+        uint32_t width = 0u;
+        uint32_t height = 0u;
+        if (frameTick == s_lastExternalFrameTick ||
+            !rt->gs().copyLatchedHostPresentationFrame(s_externalScratch, width, height))
+            return;
+        s_lastExternalFrameTick = frameTick;
+        DeliverFrameToConsumers(s_frameDumpDir, frameTick, s_externalScratch.data(), width, height);
+        return;
+    }
