From c9c45f4812ee2bb2661781a708b5821ae76c7a9f Mon Sep 17 00:00:00 2001
From: JohnnyC96 <54557697+JohnnyC96@users.noreply.github.com>
Date: Tue, 27 Oct 2026 19:08:48 -0400
Subject: [PATCH] IOP sysmem: freed memory is reused (first fit)

IopMemory::allocate started every allocation at the heap's high-water mark and only skipped live blocks, so freed
memory below the mark was never reused: a module allocating and freeing in a loop ran the 832 KB heap dry. Sony's
NETCNF (netcnf.irx, heaplib on sysmem) reads its 100-byte index file on every frame of a game's network settings
menu, allocating and freeing each time; after a few hundred frames its allocations failed and loading a settings
entry returned -2 (Resident Evil Outbreak then showed the entry as unusable). Patch 0075 had worked around the
same limitation by pooling RPC handler stacks.

Now the allocator takes the first gap from the heap's start that fits (allocations kept sorted by address), and
QueryMaxFreeMemSize/QueryTotalFreeMemSize answer with the largest gap.

Test (written first): iop_emulator_tests, a module on its own IOP calls AllocSysMemory(0, 256) and FreeSysMemory
10,000 times: every call succeeds and the last block has the first one's address. Fails without: IOP 4/5.
---
 ps2xIOP/src/emulator/core/iop_memory.cpp | 35 +++++++++-------
 ps2xIOP/tests/iop_emulator_tests.cpp     | 53 ++++++++++++++++++++++++
 2 files changed, 74 insertions(+), 14 deletions(-)

diff --git a/ps2xIOP/src/emulator/core/iop_memory.cpp b/ps2xIOP/src/emulator/core/iop_memory.cpp
index 31cb23e..ea4c269 100644
--- a/ps2xIOP/src/emulator/core/iop_memory.cpp
+++ b/ps2xIOP/src/emulator/core/iop_memory.cpp
@@ -504,21 +504,17 @@ namespace ps2x::iop::detail
             return address;
         }
 
-        uint32_t candidate = alignUp(m_heapCursor, alignment);
-        for (;;)
+        // First fit from the heap's start (patch 0098): freed blocks are reused, as sysmem's own allocator does.
+        // Before, each allocation started at the high-water mark, so a module allocating and freeing in a loop
+        // (Sony's NETCNF reads a 100-byte file per menu frame) ran the 832 KB heap dry.
+        std::sort(m_allocations.begin(), m_allocations.end(),
+                  [](const Allocation &a, const Allocation &b) { return a.address < b.address; });
+        uint32_t candidate = alignUp(HeapBase, alignment);
+        for (const auto &block : m_allocations)
         {
-            bool overlap = false;
-            for (const auto &block : m_allocations)
-            {
-                if (candidate < block.address + block.size && block.address < candidate + size)
-                {
-                    candidate = alignUp(block.address + block.size, alignment);
-                    overlap = true;
-                    break;
-                }
-            }
-            if (!overlap)
+            if (candidate + size <= block.address)
                 break;
+            candidate = alignUp(std::max(candidate, block.address + block.size), alignment);
         }
         if (candidate > HeapLimit || size > HeapLimit - candidate)
             return 0u;
@@ -544,7 +540,18 @@ namespace ps2x::iop::detail
 
     uint32_t IopMemory::maxFreeMemory() const
     {
-        return m_heapCursor < HeapLimit ? HeapLimit - m_heapCursor : 0u;
+        // The largest gap between allocations (patch 0098), the way QueryMaxFreeMemSize answers.
+        std::vector<Allocation> blocks = m_allocations;
+        std::sort(blocks.begin(), blocks.end(),
+                  [](const Allocation &a, const Allocation &b) { return a.address < b.address; });
+        uint32_t largest = 0u, cursor = HeapBase;
+        for (const auto &block : blocks)
+        {
+            if (block.address > cursor)
+                largest = std::max(largest, block.address - cursor);
+            cursor = std::max(cursor, block.address + block.size);
+        }
+        return std::max(largest, cursor < HeapLimit ? HeapLimit - cursor : 0u);
     }
 
     std::optional<IopMemory::Allocation> IopMemory::allocationContaining(uint32_t address) const
diff --git a/ps2xIOP/tests/iop_emulator_tests.cpp b/ps2xIOP/tests/iop_emulator_tests.cpp
index 5ac9c1c..d417334 100644
--- a/ps2xIOP/tests/iop_emulator_tests.cpp
+++ b/ps2xIOP/tests/iop_emulator_tests.cpp
@@ -469,6 +469,50 @@ namespace
         std::memcpy(image + 0x240u, "0123456789abcdef", 16);
     }
 
+    // A module churning sysmem (patch 0098): 10,000 times AllocSysMemory(0, 256) then FreeSysMemory; returns 1 when
+    // every allocation succeeded and the last one got the first one's address again (freed memory is reused).
+    void writeHeapChurnIrx(TestHost &host, uint32_t address)
+    {
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t loadAddress = 0x00019000u;
+        const auto jal = [](uint32_t target) { return 0x0C000000u | ((target >> 2) & 0x03FFFFFFu); };
+        const uint32_t stubAlloc = loadAddress + 0x194u, stubFree = loadAddress + 0x19Cu;
+        ElfHeader header{};
+        header.ident[0] = 0x7Fu; header.ident[1] = 'E'; header.ident[2] = 'L'; header.ident[3] = 'F';
+        header.ident[4] = 1u; header.ident[5] = 1u; header.ident[6] = 1u;
+        header.type = 2u; header.machine = 8u; header.version = 1u;
+        header.entry = loadAddress; header.phoff = sizeof(ElfHeader);
+        header.ehsize = sizeof(ElfHeader); header.phentsize = sizeof(ProgramHeader); header.phnum = 1u;
+        ProgramHeader program{};
+        program.type = 1u; program.offset = codeOffset; program.vaddr = loadAddress; program.paddr = loadAddress;
+        program.filesz = 0x200u; program.memsz = 0x200u; program.flags = 7u; program.align = 4u;
+        const uint32_t code[] = {
+            0x27BDFFE0u, 0xAFBF001Cu, 0xAFB00018u, 0xAFB10014u, 0xAFB20010u, // frame; save ra, s0-s2
+            0x00008021u, 0x24112710u,                           // s0 = first address (0), s1 = 10000
+            0x00002021u, 0x24050100u, jal(stubAlloc), 0x00003021u, // loop: AllocSysMemory(0, 256, 0)
+            0x00409021u,                                        // s2 = address
+            0x16000002u, 0u, 0x00408021u,                       // if (s0 == 0) s0 = address
+            jal(stubFree), 0x02402021u,                         // FreeSysMemory(address)
+            0x2631FFFFu, 0x1620FFF4u, 0u,                       // while (--s1)
+            0x02501026u, 0x2C420001u, 0x0010402Bu, 0x00481024u, // v0 = (s2 == s0) & (s0 != 0)
+            0x8FB20010u, 0x8FB10014u, 0x8FB00018u, 0x8FBF001Cu, 0u,
+            0x03E00008u, 0x27BD0020u,
+        };
+        const uint32_t imports[] = {
+            0x41E00000u, 0u, 0x00000101u,
+            0x6D737973u, 0x00006D65u, // "sysmem"
+            0x03E00008u, 0x24000004u, // 4 AllocSysMemory
+            0x03E00008u, 0x24000005u, // 5 FreeSysMemory
+            0u, 0u,
+        };
+        uint8_t *image = host.guest.data() + address + codeOffset;
+        std::memset(host.guest.data() + address, 0, codeOffset + program.filesz);
+        std::memcpy(host.guest.data() + address, &header, sizeof(header));
+        std::memcpy(host.guest.data() + address + sizeof(header), &program, sizeof(program));
+        std::memcpy(image, code, sizeof(code));
+        std::memcpy(image + 0x180u, imports, sizeof(imports));
+    }
+
     // A module calling cdvdman import `number` as f(buf, &result), buf[0] and result preset to -1; returns
     // buf[first] | buf[second] << 8 | (result & 0xFF) << 16 | f's return << 24. sceCdRI (22): the console ID NETCNF
     // keys its settings files' encoding on; sceCdReadClock (24): the clock USBSRCH polls.
@@ -1983,6 +2027,15 @@ int main()
                     "sceSifBindRpc must set cd.server for a host-served sid, sceSifCallRpc must deliver the host's "
                     "reply ('1'..'g') into the receive buffer, and bind/check/call must return 0")) return 1;
 
+        // sysmem reuses freed memory (patch 0098): Sony's NETCNF reads a 100-byte file per menu frame, allocating and
+        // freeing each time; a heap that only grows runs dry and its loads fail with -2.
+        TestHost churnHost(0x4000u); // its own IOP: the heap as a fresh module finds it
+        IopSubsystem churnIop(churnHost);
+        writeHeapChurnIrx(churnHost, 0x100u);
+        const ModuleLoadResult churn = churnIop.loadModuleBuffer(0x100u);
+        if (!expect(churn.handled && churn.startResult == 1,
+                    "10,000 AllocSysMemory/FreeSysMemory cycles must all succeed and reuse the freed block")) return 1;
+
         // A module loading another through modload 19 + 8 (Capcom's LOADHIGH.IRX for its network stack).
         writeArgvIrx(host, 0xA00u);
         host.files["argv.irx"].assign(host.guest.begin() + 0xA00, host.guest.begin() + 0xA00 + 0x200);
-- 
