+        // Inline checks for the interpreter's per-instruction path (patch 0049): is a DMA start waiting to be
+        // taken, and the RAM word at a 4-aligned physical address below RamSize.
+        [[nodiscard]] bool hasDmaStart() const noexcept { return m_dmaStart.has_value(); }
+        [[nodiscard]] uint32_t ramWord(uint32_t phys) const noexcept
