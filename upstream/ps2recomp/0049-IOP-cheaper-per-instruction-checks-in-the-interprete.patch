@@ -186,8 +188,22 @@ namespace ps2x::iop::detail
 
         void schedulePendingDma()
         {
+            if (fastLoop && !memory.hasDmaStart())
+                return;
             if (const auto dma = memory.takeDmaStart())
+            {
                 pendingDmaInterrupts[dma->irq] = PendingDma{totalCycles + dma->delayCycles, *dma};
+                updateNextDmaCompletion();
+            }
+        }
+
+        // The earliest completion cycle in pendingDmaInterrupts (UINT64_MAX: none), so the per-instruction
+        // check is one compare (patch 0049). A restart of a channel replaces its entry: recompute, don't min.
+        void updateNextDmaCompletion() noexcept
+        {
+            nextDmaCompletionCycle = UINT64_MAX;
+            for (const auto &[irq, pending] : pendingDmaInterrupts)
+                nextDmaCompletionCycle = std::min(nextDmaCompletionCycle, pending.completionCycle);
         }
 
         bool readRam(uint32_t address, void *destination, size_t size) const
@@ -394,7 +410,12 @@ namespace ps2x::iop::detail
             if (checkInterrupt(cpu))
                 return true;
 
-            if (const auto import = imports.decode(cpu.pc))
+            // decode() returns nothing unless the word at pc is `jr ra` (an import stub's first word): test that
+            // inline first for an aligned RAM pc, the only case where decode()'s read32 is this same RAM read.
+            const uint32_t physicalPc = physicalAddress(cpu.pc);
+            const bool maybeImport = !fastLoop || (physicalPc & 3u) != 0u ||
+                                     memory.ramWord(physicalPc) == kImportStubFirstWord;
+            if (const auto import = maybeImport ? imports.decode(cpu.pc) : std::nullopt)
             {
                 const ImportDisposition disposition = dispatchImport(*import, cpu);
                 ++totalInstructions;
@@ -407,7 +428,8 @@ namespace ps2x::iop::detail
             }
 
             const bool running = cpuCore.executeInstruction(cpu);
-            schedulePendingDma();
+            if (!fastLoop || memory.hasDmaStart())
+                schedulePendingDma();
             ++totalInstructions;
             ++totalCycles;
             return running;
@@ -422,6 +444,16 @@ namespace ps2x::iop::detail
             {
                 if (!step(cpu))
                     break;
+                if (fastLoop)
+                {
+                    // Patch 0049: only when something is due. The service calls do nothing otherwise.
+                    if (!servicingDmaInterrupts && totalCycles >= nextDmaCompletionCycle)
+                        servicePendingDmaInterrupts();
+                    if (!servicingGuestCallbacks && !pendingGuestCallbacks.empty() &&
+                        pendingGuestCallbacks.begin()->first <= totalCycles)
+                        servicePendingGuestCallbacks();
+                    continue;
+                }
                 if (!servicingDmaInterrupts && !pendingDmaInterrupts.empty())
                     servicePendingDmaInterrupts();
                 if (!servicingGuestCallbacks && !pendingGuestCallbacks.empty())
@@ -516,6 +548,7 @@ namespace ps2x::iop::detail
                 completed.push_back(it->first);
                 it = pendingDmaInterrupts.erase(it);
             }
+            updateNextDmaCompletion();
             try
             {
                 for (const int irq : completed)
@@ -853,12 +886,14 @@ namespace ps2x::iop::detail
             IopMemory::DmaStart dma;
         };
         std::map<int, PendingDma> pendingDmaInterrupts;
+        uint64_t nextDmaCompletionCycle = UINT64_MAX; // earliest completionCycle above (patch 0049)
         std::multimap<uint64_t, ScheduledGuestCallback> pendingGuestCallbacks;
         uint32_t nextModuleId = 1;
         uint32_t moduleCursor = kModuleLoadBase;
         uint64_t totalCycles = 0;
         uint64_t totalInstructions = 0;
         bool eeBatching = true;       // patch 0042; a setting, kept across reset()
+        bool fastLoop = true;         // patch 0049: cheap per-instruction checks; a setting, kept across reset()
         uint64_t pendingEeCycles = 0; // EE cycles the IOP has not run yet (with the sub-IOP-cycle remainder)
         uint64_t flushAtEeCycles = 0; // run the IOP when pendingEeCycles reaches this (0: at the next checkpoint)
         uint32_t iopDepth = 0u;       // > 0 while IOP code runs (runCycles or an EE call into the IOP)
@@ -928,6 +963,16 @@ namespace ps2x::iop::detail
