     }
+
+    // Patch 0049 (the fast loop) must not change what the IOP computes or when. The thread starts two SPU2
+    // DMAs with CPU stores to the channel registers: core 0 a block (streaming) transfer of 16 bytes
+    // (16 x 192 = 3072 cycles), core 1 a voice transfer (64 cycles). It polls each channel's MADR, which moves
+    // past the data when the DMA completes, counting its reads, and stores the counts (core 1, core 0) and a
+    // done flag at IOP 0x20000. The counts pin each completion to the instruction.
+    Irx spu2DmaModule()
+    {
+        return threadModule({
+            0x00008821u, 0x00009021u, // s1 = s2 = 0
+            0x3C081F80u,              // lui t0, 0x1F80
+            0x3C0B1F90u,              // lui t3, 0x1F90
+            0x340C0001u,              // ori t4, zero, 1
+            0xAD6C01B0u,              // sw t4, 0x1B0(t3): core 0 block-transfer mode (libsd)
+            0x3C090001u, 0x35292000u, // t1 = 0x12000 (MADR)
+            0x3C0A0001u, 0x354A0004u, // t2 = 1 block of 4 words (BCR)
+            0x3C0D0100u, 0x35AD0201u, // t5 = 0x01000201 (CHCR: start)
+            0xAD0910C0u, 0xAD0A10C4u, // core 0 MADR, BCR
+            0xAD091500u, 0xAD0A1504u, // core 1 MADR, BCR
+            0xAD0D10C8u,              // start core 0
+            0xAD0D1508u,              // start core 1
+            0x252E0010u,              // t6 = 0x12010: MADR after the transfer
+            0x8D0F1500u, 0x26310001u, 0x15EEFFFDu, 0u, // poll core 1 MADR, ++s1
+            0x8D0F10C0u, 0x26520001u, 0x15EEFFFDu, 0u, // poll core 0 MADR, ++s2
+            0x3C130002u,                                // s3 = 0x20000
+            0xAE710000u, 0xAE720004u,                   // store s1, s2
+            0x24140001u, 0xAE740008u,                   // store done = 1 (s4)
+            0x1000FFFFu, 0u,                            // b .
+        });
+    }
+
+    struct DmaRun
+    {
+        uint32_t voicePolls = 0u; // MADR reads until the core 1 DMA completed: its completion instruction
+        uint32_t blockPolls = 0u; // ... core 0
+        uint64_t cycles = 0u;
+        uint64_t instructions = 0u;
+    };
+
+    DmaRun runSpu2Dma(bool fastLoop, bool batching)
+    {
+        Host host;
+        IopSubsystem iop(host);
+        iop.setFastLoop(fastLoop);
+        iop.setEeBatching(batching);
+        require(iop.fastLoop() == fastLoop, "setFastLoop did not take");
+        load(iop, host, spu2DmaModule());
+        for (uint32_t i = 0; i < 2000u; ++i) // 64000 EE cycles = 8000 IOP cycles, past both DMAs
+            iop.runEeCycles(kEeCheckpoint);
+        iop.syncEe();
+        DmaRun run;
+        uint32_t polls[3]{};
+        require(iop.readMemory(0x20000u, polls, sizeof(polls)), "could not read the poll counts");
+        require(polls[2] == 1u, "the thread did not get past both DMAs");
+        run.voicePolls = polls[0];
+        run.blockPolls = polls[1];
+        const DebugSnapshot after = iop.debugSnapshot();
+        run.cycles = after.emulatorCycles;
+        run.instructions = after.emulatorInstructions;
+        return run;
+    }
+
+    void fastLoopKeepsDmaTiming()
+    {
+        for (const bool batching : {true, false})
+        {
+            const DmaRun off = runSpu2Dma(false, batching);
+            const DmaRun on = runSpu2Dma(true, batching);
+            std::cout << "  " << (batching ? "batched" : "per-checkpoint") << ": polls core 1 " << off.voicePolls
+                      << " / " << on.voicePolls << ", core 0 " << off.blockPolls << " / " << on.blockPolls
+                      << ", instructions " << off.instructions << " / " << on.instructions << " (full checks / fast loop)\n";
+            // The voice DMA takes 64 cycles, the block DMA 3072 (one poll = 4 instructions = 4 cycles).
+            require(off.voicePolls >= 8u && off.voicePolls <= 32u, "the voice transfer did not take ~64 cycles");
+            require(off.voicePolls * 4u + off.blockPolls * 4u >= 3072u, "the block transfer finished before its playback time");
+            require(on.voicePolls == off.voicePolls && on.blockPolls == off.blockPolls,
+                    "the fast loop changed when a DMA completed");
+            require(on.cycles == off.cycles && on.instructions == off.instructions,
+                    "the fast loop changed how many IOP instructions ran");
+        }
+    }
+
+    // The fast loop's import pre-check: stub calls (DelayThread, putchar) still dispatch at the same EE cycle,
+    // and a thread that never calls one runs the same instructions both ways.
+    void fastLoopKeepsImportsAndPlainCode()
+    {
+        uint64_t runsOff = 0u, runsOn = 0u;
+        const uint64_t off = wakeSeenAt(true, runsOff, false);
+        const uint64_t on = wakeSeenAt(true, runsOn, true);
+        require(on == off && runsOn == runsOff, "the fast loop changed when an import call's wake was seen");
+        const Irx spin = spinModule();
+        auto spinRun = [&](bool fastLoop) {
+            Host host;
+            IopSubsystem iop(host);
+            iop.setFastLoop(fastLoop);
+            load(iop, host, spin);
+            for (int i = 0; i < 4000; ++i)
+                iop.runEeCycles(kEeCheckpoint);
+            iop.syncEe();
+            return iop.debugSnapshot().emulatorInstructions;
+        };
+        const uint64_t spinOff = spinRun(false);
+        const uint64_t spinOn = spinRun(true);
+        std::cout << "  spinning thread: " << spinOff << " / " << spinOn << " instructions; DelayThread wake at EE +"
+                  << off << " / +" << on << " (full checks / fast loop)\n";
+        require(spinOn == spinOff, "the fast loop changed a plain thread's instruction count");
+    }
 }
 
 int main()
@@ -203,6 +310,8 @@ int main()
         {"batching runs the IOP fewer times for the same EE cycles", batchingRunsTheIopFewerTimes},
         {"an IOP event fires no later than its EE deadline", iopEventFiresOnTime},
         {"an EE call into the IOP (SIF, RPC, memory) syncs it first", eeCallsIntoTheIopSyncFirst},
+        {"the fast loop completes SPU2 DMAs at the same cycles", fastLoopKeepsDmaTiming},
+        {"the fast loop keeps import calls and plain code", fastLoopKeepsImportsAndPlainCode},
     };
     return run(tests);
 }
