From 0611dd14d7ef88076e33287dff3cf9d0951d4805 Mon Sep 17 00:00:00 2001
From: JohnnyC96 <54557697+JohnnyC96@users.noreply.github.com>
Date: Wed, 21 Oct 2026 10:36:48 -0400
Subject: [PATCH 11/12] ChangeThreadPriority: return the previous priority

On success the EE kernel returns the thread's old priority; errors are
still returned as negative codes. The runtime returned KE_OK (0).

Found with Resident Evil Outbreak (SLPM-65428): CRI ADX locks with
old = ChangeThreadPriority(self, 1) and unlocks with
ChangeThreadPriority(self, old). With 0 returned, every unlock left the
main thread at priority 0, above ADX's server thread, which never ran.
---
 .../src/lib/Kernel/Syscalls/Thread.cpp        |  4 ++-
 ps2xTest/src/ps2_runtime_kernel_tests.cpp     | 31 +++++++++++++++++++
 2 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/ps2xRuntime/src/lib/Kernel/Syscalls/Thread.cpp b/ps2xRuntime/src/lib/Kernel/Syscalls/Thread.cpp
index 5110ee2..fbb9746 100644
--- a/ps2xRuntime/src/lib/Kernel/Syscalls/Thread.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Syscalls/Thread.cpp
@@ -112,7 +112,9 @@ namespace ps2_syscalls
             const int priority = static_cast<int>(getRegU32(ctx, 5));
             int oldPriority = 0;
             const int result = ee.changePriority(id, priority, interruptSafe, oldPriority);
-            setReturnS32(ctx, result);
+            // On success the EE kernel returns the previous priority (CRI ADX saves it and
+            // restores it with a second call).
+            setReturnS32(ctx, result == KE_OK ? oldPriority : result);
             ee.transferIfRequested(interruptSafe);
         }
 
diff --git a/ps2xTest/src/ps2_runtime_kernel_tests.cpp b/ps2xTest/src/ps2_runtime_kernel_tests.cpp
index 22b149d..b17b6e0 100644
--- a/ps2xTest/src/ps2_runtime_kernel_tests.cpp
+++ b/ps2xTest/src/ps2_runtime_kernel_tests.cpp
@@ -613,6 +613,37 @@ void register_ps2_runtime_kernel_tests()
             t.Equals(getRegS32(env.ctx, 2), KE_ILLEGAL_PRIORITY, "a negative priority is out of range");
         });
 
+        tc.Run("ChangeThreadPriority returns the previous priority", [](TestCase &t)
+        {
+            // CRI ADX locks with old = ChangeThreadPriority(self, 1) and unlocks with
+            // ChangeThreadPriority(self, old). Returning KE_OK (0) left Outbreak's main
+            // thread at priority 0 after every unlock, starving ADX's server thread.
+            TestEnv env;
+            EeThreadCreateAbi threadParam{};
+            threadParam.func = K_SCHED_HIGH;
+            threadParam.stack = 0x00018000u;
+            threadParam.stack_size = 0x1000;
+            threadParam.initial_priority = 40;
+            std::memcpy(env.rdram.data() + K_PARAM_ADDR, &threadParam, sizeof(threadParam));
+            setRegU32(env.ctx, 4, K_PARAM_ADDR);
+            CreateThread(env.rdram.data(), &env.ctx, &env.runtime);
+            const int threadId = getRegS32(env.ctx, 2);
+
+            setRegU32(env.ctx, 4, static_cast<uint32_t>(threadId));
+            setRegU32(env.ctx, 5, 9u);
+            ChangeThreadPriority(env.rdram.data(), &env.ctx, &env.runtime);
+            t.Equals(getRegS32(env.ctx, 2), 40, "ChangeThreadPriority must return the old priority");
+            setRegU32(env.ctx, 4, static_cast<uint32_t>(threadId));
+            setRegU32(env.ctx, 5, 12u);
+            iChangeThreadPriority(env.rdram.data(), &env.ctx, &env.runtime);
+            t.Equals(getRegS32(env.ctx, 2), 9, "iChangeThreadPriority must return the old priority");
+
+            setRegU32(env.ctx, 4, static_cast<uint32_t>(threadId));
+            setRegU32(env.ctx, 5, 200u);
+            ChangeThreadPriority(env.rdram.data(), &env.ctx, &env.runtime);
+            t.Equals(getRegS32(env.ctx, 2), KE_ILLEGAL_PRIORITY, "errors are still returned as error codes");
+        });
+
         tc.Run("CreateThread and CreateSema decode the exact PS2SDK EE layouts", [](TestCase &t)
         {
             TestEnv env;
