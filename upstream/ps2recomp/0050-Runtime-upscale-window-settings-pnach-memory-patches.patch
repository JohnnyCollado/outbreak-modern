+void PS2Runtime::applyPnachAtBoot()
+{
+    ps2game::PnachSet set = ps2game::activePnach();
+    if (set.writes.empty())
+        return;
+    std::vector<std::pair<uint32_t, uint32_t>> code;
+    code.emplace_back(g_ps2RecompiledFunctionTableBase, g_ps2RecompiledFunctionTableEnd);
+    for (const PS2GuestModule &module : guestModuleRegistry())
+        code.emplace_back(module.base, module.end);
+    std::vector<std::string> messages;
+    ps2game::dropCodeWrites(set, code, messages);
+    for (const std::string &m : messages)
+        std::cout << m << std::endl;
+    ps2game::setActivePnach(set);
+    ps2game::applyPnach(set, m_memory.getRDRAM(), PS2_RAM_SIZE, true);
+    std::cout << "[pnach] applied " << set.writes.size() << " write(s) at boot" << std::endl;
+}
