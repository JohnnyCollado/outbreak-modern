diff --git a/ps2xRuntime/src/lib/ps2_pnach.cpp b/ps2xRuntime/src/lib/ps2_pnach.cpp
new file mode 100644
index 0000000..f8183b0
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_pnach.cpp
@@ -0,0 +1,245 @@
+#include "runtime/ps2_pnach.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <sstream>
+
+namespace ps2game
+{
+    namespace
+    {
+        std::string trim(std::string_view s)
+        {
+            while (!s.empty() && std::isspace(static_cast<unsigned char>(s.front())))
+                s.remove_prefix(1u);
+            while (!s.empty() && std::isspace(static_cast<unsigned char>(s.back())))
+                s.remove_suffix(1u);
+            return std::string(s);
+        }
+
+        std::string lower(std::string s)
+        {
+            std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c)
+                           { return static_cast<char>(std::tolower(c)); });
+            return s;
+        }
+
+        // Hex digits only (an optional 0x prefix), at most 8 of them.
+        bool parseHex(std::string s, uint32_t &out)
+        {
+            s = lower(trim(s));
+            if (s.rfind("0x", 0u) == 0u)
+                s = s.substr(2u);
+            if (s.empty() || s.size() > 8u)
+                return false;
+            uint32_t n = 0u;
+            for (const char c : s)
+            {
+                uint32_t digit;
+                if (c >= '0' && c <= '9')
+                    digit = static_cast<uint32_t>(c - '0');
+                else if (c >= 'a' && c <= 'f')
+                    digit = static_cast<uint32_t>(c - 'a' + 10);
+                else
+                    return false;
+                n = (n << 4u) | digit;
+            }
+            out = n;
+            return true;
+        }
+
+        std::vector<std::string> splitCommas(const std::string &s)
+        {
+            std::vector<std::string> parts;
+            size_t begin = 0u;
+            while (true)
+            {
+                const size_t comma = s.find(',', begin);
+                parts.push_back(trim(std::string_view(s).substr(begin, comma == std::string::npos ? std::string::npos
+                                                                                                   : comma - begin)));
+                if (comma == std::string::npos)
+                    return parts;
+                begin = comma + 1u;
+            }
+        }
+
+        std::string hex(uint32_t v)
+        {
+            std::ostringstream out;
+            out << "0x" << std::hex << std::uppercase << v;
+            return out.str();
+        }
+
+        PnachSet &activeStorage()
+        {
+            static PnachSet s_active;
+            return s_active;
+        }
+    }
+
+    void parsePnach(const std::string &text, std::string_view name, PnachSet &out, std::vector<std::string> &messages)
+    {
+        std::stringstream in(text);
+        std::string raw;
+        int lineNo = 0;
+        while (std::getline(in, raw))
+        {
+            ++lineNo;
+            std::string line = raw;
+            if (const size_t comment = line.find("//"); comment != std::string::npos)
+                line = line.substr(0u, comment);
+            line = trim(line);
+            if (line.empty() || line.front() == '[')
+                continue;
+            auto note = [&](const std::string &why)
+            { messages.push_back("[pnach] " + std::string(name) + " line " + std::to_string(lineNo) + ": " + why); };
+            const size_t equals = line.find('=');
+            if (equals == std::string::npos)
+            {
+                note("expected key=value");
+                continue;
+            }
+            const std::string key = lower(trim(std::string_view(line).substr(0u, equals)));
+            const std::string value = trim(std::string_view(line).substr(equals + 1u));
+            if (key == "gametitle" || key == "description" || key == "author" || key == "comment")
+                continue;
+            if (key == "gsaspectratio")
+            {
+                if (value == "4:3" || value == "16:9")
+                    out.aspect = value;
+                else
+                    note("gsaspectratio " + value + " not supported (4:3, 16:9)");
+                continue;
+            }
+            if (key != "patch")
+            {
+                note("'" + key + "' not supported, ignored");
+                continue;
+            }
+            const std::vector<std::string> f = splitCommas(value);
+            if (f.size() != 5u)
+            {
+                note("patch needs place,cpu,address,type,value");
+                continue;
+            }
+            uint32_t address = 0u, data = 0u;
+            if ((f[0] != "0" && f[0] != "1" && f[0] != "2") || !parseHex(f[2], address) || !parseHex(f[4], data))
+            {
+                note("bad place, address or value");
+                continue;
+            }
+            if (lower(f[1]) != "ee")
+            {
+                note("cpu " + f[1] + " not supported (EE only), skipped");
+                continue;
+            }
+            PnachWrite w;
+            w.once = f[0] != "1";
+            w.continuous = f[0] != "0";
+            const std::string type = lower(f[3]);
+            if (type == "byte" || type == "short" || type == "word")
+            {
+                w.size = type == "byte" ? 1u : (type == "short" ? 2u : 4u);
+                w.address = address;
+            }
+            else if (type == "extended")
+            {
+                // Code type in the top nibble: 0 = 8-bit, 1 = 16-bit, 2 = 32-bit constant write.
+                const uint32_t code = address >> 28u;
+                if (code > 2u)
+                {
+                    note("extended code type " + std::to_string(code) + " not supported (0, 1, 2 writes), skipped");
+                    continue;
+                }
+                w.size = code == 0u ? 1u : (code == 1u ? 2u : 4u);
+                w.address = address & 0x0FFFFFFFu;
+            }
+            else
+            {
+                note("type " + f[3] + " not supported (byte, short, word, extended), skipped");
+                continue;
+            }
+            w.address &= 0x1FFFFFFFu;
+            w.value = w.size == 4u ? data : (data & ((1u << (8u * w.size)) - 1u));
+            if ((w.address & (w.size - 1u)) != 0u)
+            {
+                note("address " + hex(w.address) + " not aligned to the write size, skipped");
+                continue;
+            }
+            out.writes.push_back(w);
+        }
+    }
+
+    void dropCodeWrites(PnachSet &set, const std::vector<std::pair<uint32_t, uint32_t>> &codeRanges,
+                        std::vector<std::string> &messages)
+    {
+        auto inCode = [&](const PnachWrite &w)
+        {
+            return std::any_of(codeRanges.begin(), codeRanges.end(), [&](const auto &r)
+                               { return w.address < r.second && w.address + w.size > r.first; });
+        };
+        for (const PnachWrite &w : set.writes)
+        {
+            if (inCode(w))
+                messages.push_back("[pnach] write at " + hex(w.address) +
+                                   " is in recompiled code: needs a recompile, skipped");
+        }
+        set.writes.erase(std::remove_if(set.writes.begin(), set.writes.end(), inCode), set.writes.end());
+    }
+
+    void applyPnach(const PnachSet &set, uint8_t *rdram, size_t ramSize, bool boot)
+    {
+        if (!rdram)
+            return;
+        for (const PnachWrite &w : set.writes)
+        {
+            if (!(boot ? w.once : w.continuous) || w.address >= ramSize || ramSize - w.address < w.size)
+                continue;
+            std::memcpy(rdram + w.address, &w.value, w.size); // little-endian host, as the EE
+        }
+    }
+
+    bool loadPnachAtStartup(const std::filesystem::path &mods, std::string_view serial)
+    {
+        if (mods.empty() || serial.empty())
+            return false;
+        std::error_code ec;
+        std::filesystem::path folder;
+        for (const auto &entry : std::filesystem::directory_iterator(mods, ec))
+        {
+            if (entry.is_directory(ec) && lower(entry.path().filename().string()) == lower(std::string(serial)))
+                folder = entry.path();
+        }
+        if (folder.empty())
+            return false;
+        std::vector<std::filesystem::path> files;
+        for (const auto &entry : std::filesystem::directory_iterator(folder, ec))
+        {
+            if (entry.is_regular_file(ec) && lower(entry.path().extension().string()) == ".pnach")
+                files.push_back(entry.path());
+        }
+        std::sort(files.begin(), files.end());
+        PnachSet set;
+        std::vector<std::string> messages;
+        for (const auto &file : files)
+        {
+            std::ifstream in(file, std::ios::binary);
+            std::stringstream text;
+            text << in.rdbuf();
+            parsePnach(text.str(), file.filename().string(), set, messages);
+            set.files.push_back(file);
+        }
+        for (const std::string &m : messages)
+            std::cout << m << std::endl;
+        std::cout << "[pnach] " << folder.string() << ": " << files.size() << " file(s), " << set.writes.size()
+                  << " write(s), aspect=" << (set.aspect.empty() ? "-" : set.aspect) << std::endl;
+        setActivePnach(set);
+        return true;
+    }
+
+    const PnachSet &activePnach() { return activeStorage(); }
+    void setActivePnach(const PnachSet &set) { activeStorage() = set; }
+}
