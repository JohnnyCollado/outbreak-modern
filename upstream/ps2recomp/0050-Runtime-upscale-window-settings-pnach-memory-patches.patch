index 0000000..492743d
--- /dev/null
+++ b/ps2xTest/src/ps2_pnach_tests.cpp
@@ -0,0 +1,139 @@
+// Patch 0051: PCSX2 .pnach memory writes (parse, drop writes into recompiled code, apply at boot / per vsync) and
+// the <mods>/<serial>/ folder lookup. Synthetic patches only; no game data.
+#include "MiniTest.h"
+#include "runtime/ps2_pnach.h"
+
+#include <chrono>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace
+{
+    uint32_t word(const std::vector<uint8_t> &ram, uint32_t address)
+    {
+        uint32_t v = 0u;
+        std::memcpy(&v, ram.data() + address, sizeof(v));
+        return v;
+    }
+}
+
+void register_ps2_pnach_tests()
+{
+    MiniTest::Case("Pnach", [](TestCase &tc)
+    {
+        tc.Run("parse: word/short/byte and extended writes, places, gsaspectratio; comments and sections ignored",
+               [](TestCase &t)
+        {
+            const std::string text =
+                "gametitle=Test (SLUS-12345)\n"
+                "[Widescreen 16:9]\n"
+                "gsaspectratio=16:9\n"
+                "description=a test\n"
+                "//gameplay\n"
+                "patch=1,EE,20239d48,extended,3fe38e38\n"
+                "patch=0,EE,00100010,word,0x12345678 // trailing comment\n"
+                "patch=2,EE,00200002,short,0000BEEF\n"
+                "patch=0,EE,00300003,byte,000000AB\n"
+                "patch=1,EE,10200006,extended,0000CAFE\n";
+            ps2game::PnachSet set;
+            std::vector<std::string> messages;
+            ps2game::parsePnach(text, "t.pnach", set, messages);
+            t.Equals(messages.size(), size_t{0}, "no problems: " + (messages.empty() ? std::string() : messages[0]));
+            t.IsTrue(set.aspect == "16:9", "aspect: " + set.aspect);
+            t.Equals(set.writes.size(), size_t{5}, "five writes");
+            if (set.writes.size() != 5u)
+                return;
+            t.IsTrue(set.writes[0].address == 0x239D48u && set.writes[0].size == 4u && set.writes[0].value == 0x3FE38E38u,
+                     "extended 2xxxxxxx = 32-bit write");
+            t.IsTrue(!set.writes[0].once && set.writes[0].continuous, "place 1 = every vsync only");
+            t.IsTrue(set.writes[1].once && !set.writes[1].continuous && set.writes[1].value == 0x12345678u,
+                     "place 0 = boot only, 0x prefix accepted");
+            t.IsTrue(set.writes[2].once && set.writes[2].continuous && set.writes[2].size == 2u &&
+                         set.writes[2].value == 0xBEEFu,
+                     "place 2 = both; short");
+            t.IsTrue(set.writes[3].size == 1u && set.writes[3].value == 0xABu, "byte");
+            t.IsTrue(set.writes[4].address == 0x200006u && set.writes[4].size == 2u, "extended 1xxxxxxx = 16-bit");
+        });
+
+        tc.Run("parse: other CPUs, types, extended codes and malformed lines are skipped with a reason", [](TestCase &t)
+        {
+            const std::string text =
+                "patch=1,IOP,00001000,word,1\n"
+                "patch=1,EE,00001000,double,1\n"
+                "patch=1,EE,E0020000,extended,1\n"
+                "patch=1,EE,00001001,word,1\n"
+                "patch=3,EE,00001000,word,1\n"
+                "patch=1,EE,00001000,word\n"
+                "gsaspectratio=21:9\n"
+                "gsinterlacemode=1\n"
+                "nonsense\n";
+            ps2game::PnachSet set;
+            std::vector<std::string> messages;
+            ps2game::parsePnach(text, "bad.pnach", set, messages);
+            t.Equals(set.writes.size(), size_t{0}, "nothing applied");
+            t.Equals(messages.size(), size_t{9}, "one reason per line");
+            t.IsTrue(set.aspect.empty(), "an unsupported aspect is not taken");
+            t.IsTrue(messages.size() == 9u && messages[0].find("EE only") != std::string::npos &&
+                         messages[2].find("extended code type 14") != std::string::npos &&
+                         messages[3].find("not aligned") != std::string::npos &&
+                         messages[0].rfind("[pnach] bad.pnach line 1:", 0u) == 0u,
+                     "reasons name the file, line and cause");
+        });
+
+        tc.Run("code writes are dropped; boot and vsync apply their own places", [](TestCase &t)
+        {
+            ps2game::PnachSet set;
+            std::vector<std::string> messages;
+            ps2game::parsePnach("patch=1,EE,001BA0E4,word,00000000\n"   // inside the code range: dropped
+                                "patch=1,EE,00239D48,word,3FE38E38\n"   // data, every vsync
+                                "patch=0,EE,00240000,word,11111111\n"   // data, boot only
+                                "patch=1,EE,00540010,word,22222222\n",  // inside a module range: dropped
+                                "w.pnach", set, messages);
+            ps2game::dropCodeWrites(set, {{0x100000u, 0x1D9ABCu}, {0x540000u, 0x5A0000u}}, messages);
+            t.Equals(set.writes.size(), size_t{2}, "two data writes left");
+            t.Equals(messages.size(), size_t{2}, "one line per dropped write");
+            t.IsTrue(messages.size() == 2u && messages[0].find("0x1BA0E4 is in recompiled code") != std::string::npos,
+                     "reason: " + (messages.empty() ? std::string() : messages[0]));
+            std::vector<uint8_t> ram(0x300000u, 0u);
+            const uint32_t fourThirds = 0x3FAAAAABu;
+            std::memcpy(ram.data() + 0x239D48u, &fourThirds, 4u);
+            ps2game::applyPnach(set, ram.data(), ram.size(), true);
+            t.IsTrue(word(ram, 0x240000u) == 0x11111111u, "boot applies place 0");
+            t.IsTrue(word(ram, 0x239D48u) == fourThirds, "boot does not apply place 1");
+            ps2game::applyPnach(set, ram.data(), ram.size(), false);
+            t.IsTrue(word(ram, 0x239D48u) == 0x3FE38E38u, "vsync applies place 1");
+            std::memcpy(ram.data() + 0x239D48u, &fourThirds, 4u); // the game writes it back
+            ps2game::applyPnach(set, ram.data(), ram.size(), false);
+            t.IsTrue(word(ram, 0x239D48u) == 0x3FE38E38u, "re-applied at the next vsync");
+            ps2game::PnachSet past;
+            ps2game::parsePnach("patch=0,EE,01FFFFFE,short,1\npatch=0,EE,01FFFFFC,word,1\n", "e.pnach", past, messages);
+            std::vector<uint8_t> small(0x100u, 0u);
+            ps2game::applyPnach(past, small.data(), small.size(), true); // out of range: nothing written, no crash
+            t.IsTrue(word(small, 0u) == 0u, "writes past the end of RAM are ignored");
+        });
+
+        tc.Run("load: <mods>/<serial>/*.pnach, folder in any case, files in name order", [](TestCase &t)
+        {
+            const std::filesystem::path root = std::filesystem::temp_directory_path() /
+                ("ps2x_pnach_" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+            std::filesystem::create_directories(root / "slpm-65428");
+            std::ofstream(root / "slpm-65428" / "b.pnach") << "patch=0,EE,00100004,word,2\n";
+            std::ofstream(root / "slpm-65428" / "a.PNACH") << "gsaspectratio=16:9\npatch=0,EE,00100000,word,1\n";
+            std::ofstream(root / "slpm-65428" / "notes.txt") << "patch=0,EE,00100008,word,3\n";
+            t.IsTrue(ps2game::loadPnachAtStartup(root, "SLPM-65428"), "folder found");
+            const ps2game::PnachSet &set = ps2game::activePnach();
+            t.Equals(set.files.size(), size_t{2}, "two .pnach files (any case), not the .txt");
+            t.IsTrue(set.writes.size() == 2u && set.writes[0].value == 1u && set.writes[1].value == 2u,
+                     "a.pnach before b.pnach");
+            t.IsTrue(set.aspect == "16:9", "aspect from a.pnach");
+            t.IsTrue(!ps2game::loadPnachAtStartup(root, "SLUS-20765"), "no folder for another serial");
+            t.IsTrue(!ps2game::loadPnachAtStartup({}, "SLPM-65428"), "no mods root");
+            ps2game::setActivePnach({});
+            std::error_code ec;
+            std::filesystem::remove_all(root, ec);
+        });
+    });
+}
