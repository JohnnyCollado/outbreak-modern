diff --git a/ps2xRuntime/include/runtime/ps2_pnach.h b/ps2xRuntime/include/runtime/ps2_pnach.h
new file mode 100644
index 0000000..451e181
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_pnach.h
@@ -0,0 +1,58 @@
+#ifndef PS2_PNACH_H
+#define PS2_PNACH_H
+
+// PCSX2 .pnach patch files, memory writes only (patch 0051).
+//
+// The runner reads every *.pnach in <mods>/<serial>/ (outbreak.ini mods, any case; e.g. mods/SLPM-65428/) at
+// start-up. Lines: patch=<place>,EE,<address>,<type>,<value> with hex address and value; place 0 = once at boot,
+// 1 = continuously (every vsync), 2 = both (PCSX2's PPT_ONCE_ON_LOAD / PPT_CONTINUOUSLY / PPT_COMBINED_0_1); type
+// byte | short | word, or extended with a 0/1/2 (8/16/32-bit write) code type in the address's top nibble.
+// gsaspectratio=4:3|16:9 sets the display aspect. [section] headers, //-comments, gametitle, description, author
+// and comment lines are accepted and ignored: every patch in the folder is applied.
+//
+// A recompiled game's code is compiled ahead of time, so a patch that rewrites instructions has no effect at run
+// time: writes into the boot ELF's executable segments are dropped with one "[pnach] ... code" line each (they
+// need a recompile). Other CPUs (IOP), other types (double, be*, conditional extended codes) are skipped with a line.
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace ps2game
+{
+    struct PnachWrite
+    {
+        uint32_t address = 0u; // EE physical address
+        uint32_t value = 0u;
+        uint8_t size = 4u;     // bytes: 1, 2 or 4
+        bool once = true;      // applied at boot
+        bool continuous = false; // applied every vsync
+    };
+
+    struct PnachSet
+    {
+        std::vector<PnachWrite> writes;
+        std::string aspect; // "4:3", "16:9"; empty = not set
+        std::vector<std::filesystem::path> files;
+    };
+
+    // Adds text's patches to out; problems go to messages ("[pnach] <name> line N: ...").
+    void parsePnach(const std::string &text, std::string_view name, PnachSet &out, std::vector<std::string> &messages);
+    // Drops writes that fall inside any [begin, end) code range, one message each.
+    void dropCodeWrites(PnachSet &set, const std::vector<std::pair<uint32_t, uint32_t>> &codeRanges,
+                        std::vector<std::string> &messages);
+    // Writes the patches with once (boot) or continuous (vsync) set into rdram (little-endian), within ramSize.
+    void applyPnach(const PnachSet &set, uint8_t *rdram, size_t ramSize, bool boot);
+
+    // Reads <mods>/<serial>/*.pnach (folder name in any case, files sorted by name) into the active set and logs
+    // what it found. False when mods or serial is empty or the folder does not exist.
+    bool loadPnachAtStartup(const std::filesystem::path &mods, std::string_view serial);
+    const PnachSet &activePnach();
+    void setActivePnach(const PnachSet &set);
+}
+
+#endif
