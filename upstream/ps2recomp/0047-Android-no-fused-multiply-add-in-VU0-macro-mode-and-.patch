@@ -81,6 +81,23 @@ void register_ps2_vu_tests()
 {
     MiniTest::Case("PS2VU0Math", [](TestCase &tc)
     {
+        tc.Run("InnerProduct_rounds_each_product_before_the_add", [](TestCase &t)
+        {
+            // -1 + (1+2^-12)^2: the product rounds to 1+2^-11 (the 2^-24 tail is half an ulp, ties to even), so the
+            // sum is 2^-11 = 0x3A000000. Fused into the running sum (NDK clang's default contraction on arm64,
+            // fma(x3, y3, -1)) it would be 2^-11 + 2^-24 = 0x3A000400.
+            VuEnv env;
+            const float a = 1.0f + 1.0f / 4096.0f;
+            writeVec4(env, kA, 1.0f, 0.0f, 0.0f, a);
+            writeVec4(env, kB, -1.0f, 0.0f, 0.0f, a);
+            SET_GPR_U32(&env.ctx, 4, kA);
+            SET_GPR_U32(&env.ctx, 5, kB);
+            ps2_stubs::sceVu0InnerProduct(env.rdram.data(), &env.ctx, &env.runtime);
+            uint32_t raw = 0u;
+            std::memcpy(&raw, &env.ctx.f[0], sizeof(raw));
+            t.Equals(raw, 0x3A000000u, "InnerProduct: -1 + (1+2^-12)^2 rounds the product first (fused: 0x3A000400)");
+        });
+
         tc.Run("MulVector_componentwise", [](TestCase &t)
         {
