<?xml version="1.0" encoding="utf-8"?>
<!-- Outbreak Modern (tools/ob/android.sh, docs/ops/android.md). Two activities, Kotlin (native/android/kotlin):
     LauncherActivity, the Compose settings launcher (docs/plans/2026-10-26-settings-menu.md, decisions A13-A14), and
     OutbreakActivity, the game: a NativeActivity subclass that loads lib/arm64-v8a/libps2EntryRunner.so
     (android.app.lib_name), whose raylib platform layer (android_native_app_glue) calls the runner's main(), and that
     shows the in-game menu as a Compose dialog over the game. Built by Gradle (build.gradle.kts): the package name is
     its namespace/applicationId, and extractNativeLibs="true" comes from packaging.jniLibs.useLegacyPackaging. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="1"
    android:versionName="0.1-a1">

    <!-- Online play: PCSX2's network adapter opens real sockets to the server (without this every socket() is
         refused with EPERM; reports/2026-10-26-online-play.md entry 58). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Local play (docs/plans/2026-10-28-local-play.md): this device's Wi-Fi address and subnet (network state), the
         nearby hosts' broadcasts (multicast lock: some Wi-Fi drivers drop broadcasts without it), and the host's
         foreground service with its Stop notification. No location permission: the address comes from the link. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- raylib's window is OpenGL ES (released when PCSX2's Vulkan GS attaches); the GS needs Vulkan 1.1. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Outbreak Modern"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="true"
        android:isGame="true"
        android:appCategory="game"
        android:allowBackup="false">
        <activity
            android:name="com.outbreakmodern.app.LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.GAME" />
            </intent-filter>
        </activity>
        <!-- The game runs in its own process (":game", developer 2026-10-27): Quit game ends that process completely
             and returns to the launcher, and each Play starts from a fresh process (no runner state left over from the
             last game; a leftover froze the relaunch). -->
        <activity
            android:name="com.outbreakmodern.app.OutbreakActivity"
            android:process=":game"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="ps2EntryRunner" />
        </activity>
        <!-- Restarts the app in a fresh process (a new graphics driver loads once per process): RestartActivity.kt. -->
        <activity
            android:name="com.outbreakmodern.app.RestartActivity"
            android:exported="false"
            android:process=":restart"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- The built-in host (HostService.kt): in the launcher's process, which stays alive while the game (":game")
             runs. Not exported: only this app starts or stops it. Started only by the player's Host button. -->
        <service
            android:name="com.outbreakmodern.app.HostService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hosts a local-network game lobby for nearby players of this game" />
        </service>
    </application>
</manifest>
