# machine-local state written by the tools (originals to restore), not results
legacy/results/*-state.json
__pycache__/
legacy/mod/build/

# user's disc dump: never stored in the repo (docs/native-port-design.md)
game_files/

# Texture packs: gigabytes, and someone else's work -- keep them out of git (docs/native-port-design.md)
textures/
replacements/
*.zip
*.7z
*.rar
REOB by NoBigDeal La*/
ps2_emu/

# Project Architect 3.0
.run/
__pycache__/
.claude-state/

# This PC's paths for the online-play harness (sourced by tools/net/net-env.sh)
tools/net/net-env.local.sh

# Johnny's local playtest launcher (machine-specific paths)
play.bat

# Johnny's profiling playtest launcher (play.bat on the OB_PROFILE=1 copy in C:/ob/r-profile)
play-profile.bat

# Johnny's VU1 capture playtest launcher (play.bat + ob_diag PS2X_VU1_CAPTURE into C:/ob/vu1-captures-play)
play-capture.bat

# Security queue H5 (docs/plans/2026-10-29-security-queue.md): disc images, game executables, memory cards, signing
# keys, the developer's network overrides and local logs never enter git. Tracked gate evidence logs stay tracked.
*.iso
*.ISO
*.elf
*.ps2
*.keystore
*.jks
net.env
*.log
!gate/evidence/**/*.log
build/

# build-all.bat output
dist/
dist-symbols/
dist-user-data/

# Crash reports written by the game (crash_capture.cpp, CrashReport.kt): they hold this machine's paths and state
crash-report-*.zip
outbreak-crash-report.zip

# Local-only: personal paths, device ids and LAN addresses from runs (kept on disk, not published)
.claude/
legacy/results/
